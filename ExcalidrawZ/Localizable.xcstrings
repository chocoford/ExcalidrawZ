    "whatsNewSidebarFilesMultiSelectDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك الآن تحديد ملفات متعددة في وقت واحد وتنفيذ إجراءات عليها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie können jetzt mehrere Dateien auf einmal auswählen und Aktionen mit ihnen durchführen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can now select multiple files at once and perform actions on them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora puedes seleccionar múltiples archivos a la vez y realizar acciones sobre ellos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez maintenant sélectionner plusieurs fichiers à la fois et effectuer des actions sur eux."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अब आप एक साथ कई फ़ाइलें चुन सकते हैं और उन पर क्रियाएँ कर सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ora puoi selezionare più file contemporaneamente e eseguire azioni su di essi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "複数のファイルを同時に選択し、それらに対してアクションを実行できるようになりました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 여러 파일을 동시에 선택하고 작업을 수행할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt nu meerdere bestanden tegelijk selecteren en acties op ze uitvoeren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz teraz wybrać wiele plików jednocześnie i wykonać na nich akcje."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Agora você pode selecionar vários arquivos ao mesmo tempo e realizar ações sobre eles."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Теперь вы можете выбирать несколько файлов одновременно и выполнять действия с ними."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณสามารถเลือกไฟล์หลายไฟล์พร้อมกันและทำการดำเนินการกับไฟล์เหล่านั้นได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Artık birden fazla dosyayı aynı anda seçebilir ve onlarla işlemler gerçekleştirebilirsiniz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bây giờ bạn có thể chọn nhiều tệp cùng một lúc và thực hiện các hành động trên chúng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您现在可以一次选择多个文件并对它们执行操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您現在可以一次選擇多個文件並對其執行操作。"
          }
