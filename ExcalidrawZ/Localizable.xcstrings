    "featureTipsResetToastTitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم عرض نصائح الميزات مرة أخرى في المرة القادمة التي تفتح فيها ExcalidrawZ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Feature-Tipps werden das nächste Mal angezeigt, wenn Sie ExcalidrawZ öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Feature tips will be shown again the next time you open ExcalidrawZ."
          }
        },
        "es": {
