    "aiChatFileAccessHelpAccessAllowed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن للذكاء الاصطناعي قراءة وتعديل هذا الملف. انقر لمنع الوصول إلى الملف واستخدام التعديلات المقترحة بدلاً من ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die KI kann diese Datei lesen und bearbeiten. Klicken Sie hier, um den Dateizugriff zu verhindern und stattdessen Vorschlagsänderungen zu verwenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI can read and edit this file. Click to prevent file access and use proposal edits instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La IA puede leer y editar este archivo. Haz clic para evitar el acceso al archivo y utilizar propuestas de edición en su lugar."
