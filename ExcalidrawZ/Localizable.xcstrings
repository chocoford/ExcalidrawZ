    "paywallPlanProDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختبر التعاون غير المحدود والميزات المتقدمة. مصمم للمحترفين والفرق التي تحتاج إلى تعاون واسع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erleben Sie grenzenlose Zusammenarbeit und erweiterte Funktionen. Entwickelt für Fachleute und Teams mit umfangreichen Kooperationsbedürfnissen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything in Starter, plus monthly AI credits for regular AI work."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimenta colaboración ilimitada y características avanzadas. Diseñado para profesionales y equipos con amplias necesidades de colaboración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Découvrez une collaboration illimitée et des fonctionnalités avancées. Conçu pour les professionnels et les équipes ayant des besoins de collaboration étendus."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "असीमित सहयोग और उन्नत सुविधाओं का अनुभव करें। पेशेवरों और टीमों के लिए डिज़ाइन किया गया जो व्यापक सहयोगी जरूरतें रखते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sperimenta collaborazione illimitata e funzionalità avanzate. Progettato per professionisti e team con esigenze collaborative estese."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無限のコラボレーションと高度な機能を体験してください。幅広いコラボレーションニーズを持つ専門家やチーム向けに設計されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제한 없는 협업과 고급 기능을 경험하세요. 광범위한 협업 요구가 있는 전문가 및 팀을 위해 설계되었습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ervaar onbeperkte samenwerking en geavanceerde functies. Ontworpen voor professionals en teams met uitgebreide samenwerkingsbehoeften."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doświadcz nieograniczonej współpracy i zaawansowanych funkcji. Zaprojektowany dla profesjonalistów i zespołów z rozbudowanymi potrzebami współpracy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimente colaboração ilimitada e recursos avançados. Projetado para profissionais e equipes com necessidades colaborativas extensas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Испытайте безграничное сотрудничество и расширенные функции. Создан для профессионалов и команд с обширными потребностями в сотрудничестве."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สัมผัสการทำงานร่วมกันแบบไม่มีขีดจำกัดและฟีเจอร์ขั้นสูง ออกแบบมาสำหรับมืออาชีพและทีมที่มีความต้องการในการทำงานร่วมกันสูง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sınırsız iş birliği ve gelişmiş özelliklerin tadını çıkarın. Geniş iş birliği ihtiyaçları olan profesyoneller ve ekipler için tasarlandı."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trải nghiệm sự hợp tác không giới hạn và các tính năng nâng cao. Dành cho các chuyên gia và nhóm có nhu cầu hợp tác rộng rãi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "体验无限制的协作和高级功能。为有广泛协作需求的专业人士和团队设计。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "體驗無限的合作和高級功能。為具有廣泛協作需求的專業人士和團隊設計。"
          }
        }
      }
    },
