    "missingFileCheckpointRecoverSheetMessage": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر استرداد الملف “%@” من iCloud. يمكنك استعادته من إصدار سابق لنقطة التحقق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei „%@“ konnte nicht aus iCloud wiederhergestellt werden. Sie können sie aus einer früheren Checkpoint-Version wiederherstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file “%@” could not be recovered from iCloud. You can restore it from a previous checkpoint version."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo recuperar el archivo “%@” de iCloud. Puedes restaurarlo desde un punto de control anterior."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier “%@” n'a pas pu être récupéré depuis iCloud. Vous pouvez le restaurer à partir d'une version antérieure du point de contrôle."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud से फ़ाइल “%@” को पुनर्प्राप्त नहीं किया जा सका। आप इसे किसी पिछले चेकपॉइंट संस्करण से पुनर्स्थापित कर सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile recuperare il file “%@” da iCloud. Puoi ripristinarlo da una versione checkpoint precedente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイル“%@”はiCloudから復元できませんでした。以前のチェックポイント版から復元できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 “%@”을(를) iCloud에서 복원할 수 없습니다. 이전 체크포인트 버전에서 복원할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het bestand “%@” kon niet uit iCloud worden hersteld. U kunt het terugzetten uit een eerdere checkpointversie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się odzyskać pliku „%@” z iCloud. Możesz przywrócić go z wcześniejszej wersji punktu kontrolnego."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo “%@” não pôde ser recuperado do iCloud. Você pode restaurá-lo a partir de uma versão anterior do ponto de verificação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл “%@” не удалось восстановить из iCloud. Вы можете восстановить его из предыдущей контрольной точки."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถกู้คืนไฟล์ “%@” จาก iCloud ได้ คุณสามารถกู้คืนได้จากเวอร์ชันของจุดตรวจก่อนหน้า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” adlı dosya iCloud'dan kurtarılamadı. Önceki bir kontrol noktası sürümünden geri yükleyebilirsiniz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tệp “%@” không thể được khôi phục từ iCloud. Bạn có thể khôi phục nó từ một phiên bản lưu trước đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法从 iCloud 恢复文件“%@”。您可以从先前的检查点版本恢复它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檔案 “%@” 無法從 iCloud 還原。您可以從先前的檢查點版本還原它。"
          }
        }
      }
    },
