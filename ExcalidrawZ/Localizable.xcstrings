    "WhatsNewItemMultiplatformDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الآن، يمكن لـ ExcalidrawZ العمل على أجهزة Mac و iPhone و iPad، مع مزامنة البيانات بسلاسة عبر الأجهزة المختلفة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jetzt kann ExcalidrawZ auf Mac, iPhone und iPad-Geräten ausgeführt werden, wobei die Daten nahtlos über verschiedene Geräte synchronisiert werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Now, ExcalidrawZ can run on Mac, iPhone, and iPad devices, with data seamlessly synchronized across different devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora, ExcalidrawZ puede ejecutarse en dispositivos Mac, iPhone y iPad, con datos sincronizados sin problemas entre diferentes dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenant, ExcalidrawZ peut fonctionner sur des appareils Mac, iPhone et iPad, avec des données synchronisées sans problème entre différents appareils."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अब, ExcalidrawZ मैक, आईफोन और आईपैड उपकरणों पर चल सकता है, डेटा विभिन्न उपकरणों के बीच निर्बाध रूप से समन्वयित होता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ora, ExcalidrawZ può funzionare su dispositivi Mac, iPhone e iPad, con dati sincronizzati senza problemi tra i diversi dispositivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZは、Mac、iPhone、iPadデバイスで実行でき、データが異なるデバイス間でシームレスに同期されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 ExcalidrawZ는 Mac, iPhone 및 iPad에서 실행할 수 있으며, 데이터가 다양한 장치 간에 원활하게 동기화됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ kan nu draaien op Mac, iPhone en iPad, met gegevens die naadloos gesynchroniseerd worden tussen verschillende apparaten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Teraz ExcalidrawZ może działać na urządzeniach Mac, iPhone i iPad, z danymi płynnie synchronizowanymi między różnymi urządzeniami."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Agora, ExcalidrawZ pode ser executado em dispositivos Mac, iPhone e iPad, com dados sincronizados perfeitamente entre diferentes dispositivos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Теперь ExcalidrawZ может работать на устройствах Mac, iPhone и iPad, с синхронизацией данных между разными устройствами."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอนนี้ ExcalidrawZ สามารถทำงานบนอุปกรณ์ Mac, iPhone และ iPad โดยข้อมูลจะซิงโครไนซ์ได้อย่างราบรื่นระหว่างอุปกรณ์ต่างๆ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Artık ExcalidrawZ, Mac, iPhone ve iPad cihazlarında çalışabilir ve veriler farklı cihazlar arasında sorunsuz bir şekilde senkronize edilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giờ đây, ExcalidrawZ có thể chạy trên các thiết bị Mac, iPhone và iPad, với dữ liệu được đồng bộ hóa liền mạch giữa các thiết bị khác nhau."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在，ExcalidrawZ 可以在 Mac、iPhone 和 iPad 设备上运行，且数据能够在不同设备间实现无缝同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "現在，ExcalidrawZ 可以在 Mac、iPhone 和 iPad 設備上運行，並能在不同設備之間無縫同步數據。"
          }
        }
      }
    },
