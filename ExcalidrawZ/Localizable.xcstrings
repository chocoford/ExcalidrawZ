    "settingsAIMCPClaudeUnsupportedHelp": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم VS Code أو عميل MCP محلي آخر في الوقت الحالي. يمكن إضافة دعم HTTPS عن بُعد لاحقًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie vorerst VS Code oder einen anderen lokalen MCP-Client. Die Unterstützung für Remote-HTTPS kann später hinzugefügt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use VS Code or another local MCP client for now. Remote HTTPS support can be added later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa VS Code u otro cliente MCP local por ahora. El soporte para HTTPS remoto puede ser añadido más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez VS Code ou un autre client MCP local pour le moment. Le support HTTPS distant peut être ajouté plus tard."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी के लिए VS कोड या किसी अन्य स्थानीय MCP क्लाइंट का उपयोग करें। दूरस्थ HTTPS समर्थन बाद में जोड़ा जा सकता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilizza VS Code o un altro client MCP locale per ora. Il supporto per HTTPS remoto può essere aggiunto in seguito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今のところVS Codeまたは他のローカルMCPクライアントを使用してください。リモートHTTPSサポートは後で追加できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 VS 코드를 사용하거나 다른 로컬 MCP 클라이언트를 사용하세요. 원격 HTTPS 지원은 나중에 추가될 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik voorlopig VS Code of een andere lokale MCP-client. Ondersteuning voor externe HTTPS kan later worden toegevoegd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na razie użyj VS Code lub innego lokalnego klienta MCP. Obsługa zdalnego HTTPS może być dodana później."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Use o VS Code ou outro cliente MCP local por enquanto. O suporte a HTTPS remoto pode ser adicionado depois."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте VS Code или другой локальный клиент MCP на данный момент. Поддержка удаленного HTTPS может быть добавлена позже."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ VS Code หรือคลินต์ MCP ท้องถิ่นอื่นในขณะนี้ การสนับสนุน HTTPS ระยะไกลสามารถเพิ่มเติมในภายหลัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şimdilik VS Code veya başka bir yerel MCP istemcisi kullanın. Uzaktan HTTPS desteği daha sonra eklenebilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiện tại, hãy sử dụng VS Code hoặc một khách hàng MCP cục bộ khác. Hỗ trợ HTTPS từ xa có thể được thêm sau."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时使用 VS Code 或其他本地 MCP 客户端。远程 HTTPS 支持可以稍后添加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前請使用 VS Code 或其他本地 MCP 客戶端。遠程 HTTPS 支持可以稍後添加。"
          }
        }
      }
    },
    "settingsAIMCPClaudeUnsupportedMessage": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "موصلات عميل Claude Desktop تقبل حاليًا عناوين URL عن بُعد HTTPS فقط. يقوم ExcalidrawZ بتشغيل خادم HTTP MCP محلي، لذا لا يمكن الاتصال من تلك الشاشة حتى الآن."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die benutzerdefinierten Connectoren von Claude Desktop akzeptieren derzeit nur Remote-HTTPS-URLs. ExcalidrawZ führt einen lokalen HTTP-MCP-Server aus, sodass dieser derzeit nicht von diesem Connector-Bildschirm aus verbunden werden kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Desktop custom connectors currently accept remote HTTPS URLs only. ExcalidrawZ runs a local HTTP MCP server, so it cannot be connected from that connector screen yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los conectores personalizados de Claude Desktop actualmente aceptan solo URLs HTTPS remotas. ExcalidrawZ ejecuta un servidor HTTP MCP local, por lo que no se puede conectar desde esa pantalla de conectores aún."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les connecteurs personnalisés de Claude Desktop acceptent actuellement uniquement les URL HTTPS distantes. ExcalidrawZ exécute un serveur HTTP MCP local, donc il ne peut pas être connecté depuis cet écran de connecteur pour l'instant."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude डेस्कटॉप कस्टम कनेक्टर वर्तमान में केवल दूरस्थ HTTPS URLs स्वीकार करते हैं। ExcalidrawZ एक स्थानीय HTTP MCP सर्वर चलाता है, इसलिए इसे उस कनेक्टर स्क्रीन से अभी कनेक्ट नहीं किया जा सकता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I connettori personalizzati di Claude Desktop attualmente accettano solo URL HTTPS remoti. ExcalidrawZ esegue un server HTTP MCP locale, quindi non può essere collegato da quella schermata del connettore per il momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Desktopのカスタムコネクタは現在、リモートHTTPS URLのみを受け付けます。ExcalidrawZはローカルHTTP MCPサーバーを実行しているため、そのコネクタ画面からは接続できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Desktop의 사용자 지정 커넥터는 현재 원격 HTTPS URL만 수락합니다. ExcalidrawZ는 로컬 HTTP MCP 서버를 실행하므로 해당 커넥터 화면에서 연결할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Desktop aangepaste connectors accepteren momenteel alleen externe HTTPS-URL's. ExcalidrawZ draait een lokale HTTP MCP-server, dus het kan nog niet vanuit dat connector-scherm worden verbonden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kustomowe konektory Claude Desktop obecnie akceptują tylko zdalne adresy URL HTTPS. ExcalidrawZ działa jako lokalny serwer HTTP MCP, więc nie można się podłączyć z tego ekranu konektora na razie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectores personalizados do Claude Desktop atualmente aceitam apenas URLs HTTPS remotas. O ExcalidrawZ executa um servidor HTTP MCP local, portanto, não pode ser conectado a partir dessa tela de conectores ainda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пользовательские соединители Claude Desktop в настоящее время принимают только удаленные HTTPS URL. ExcalidrawZ запускает локальный HTTP MCP сервер, поэтому пока нельзя подключиться с этого экрана соединителей."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตัวเชื่อมที่กำหนดเองของ Claude Desktop ขณะนี้รับเฉพาะ URL HTTPS ระยะไกล ExcalidrawZ รันเซิร์ฟเวอร์ HTTP MCP ท้องถิ่น ดังนั้นจึงไม่สามารถเชื่อมต่อจากหน้าจอนั้นได้ในขณะนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Desktop özel bağlayıcıları şu anda yalnızca uzaktan HTTPS URL'lerini kabul ediyor. ExcalidrawZ yerel bir HTTP MCP sunucusu çalıştırıyor, bu nedenle o bağlayıcı ekranından henüz bağlanamaz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các kết nối tùy chỉnh trên Claude Desktop hiện chỉ chấp nhận các URL HTTPS từ xa. ExcalidrawZ chạy một máy chủ HTTP MCP cục bộ, vì vậy không thể kết nối từ màn hình kết nối đó vào lúc này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Desktop 自定义连接器目前仅接受远程 HTTPS URL。ExcalidrawZ 运行一个本地 HTTP MCP 服务器，因此无法从该连接器界面连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Desktop 自定義連接器目前僅接受遠程 HTTPS URL。ExcalidrawZ 運行一個本地 HTTP MCP 伺服器，因此目前無法從該連接器畫面連接。"
          }
        }
      }
    },
