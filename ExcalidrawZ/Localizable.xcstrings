    "drawingPreferencesIsCustomizedMessage": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تجاوزت هذه اللوحة الإعدادات الافتراضية العالمية. قم بإيقاف التشغيل لإعادة الضبط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Leinwand überschreibt die globalen Standardeinstellungen. Deaktivieren, um zurückzusetzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This canvas overrides the global defaults. Turn off to reset."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este lienzo anula los valores predeterminados globales. Desactívalo para restablecer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette toile remplace les paramètres par défaut globaux. Désactivez pour réinitialiser."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह कैनवस वैश्विक डिफ़ॉल्ट्स को ओवरराइड करता है। रीसेट करने के लिए इसे बंद करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo canvas sovrascrive le impostazioni globali. Disattiva per ripristinare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このキャンバスはグローバルデフォルトを上書きしています。オフにするとリセットされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 캔버스는 전역 기본값을 덮어씁니다. 초기화하려면 끄세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit canvas overschrijft de globale standaardinstellingen. Zet het uit om te resetten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten obszar roboczy nadpisuje globalne ustawienia domyślne. Wyłącz, aby zresetować."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta tela substitui as configurações globais. Desative para redefinir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот холст переопределяет глобальные настройки. Отключите, чтобы сбросить."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผืนผ้านี้จะครอบคลุมค่าเริ่มต้นทั่วโลก ปิดเพื่อรีเซ็ต"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu tuval, küresel varsayılanları geçersiz kılar. Sıfırlamak için kapatın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Canvas này ghi đè các cài đặt mặc định toàn cầu. Tắt để đặt lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此画布覆盖全局默认设置。关闭以重置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此畫布覆蓋全局默認設置。關閉以重置。"
          }
        }
      }
    },
