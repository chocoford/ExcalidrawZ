    "aiChatEnableConsentAgreement": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أفهم وأوافق على سياسة الخصوصية وشروط الاستخدام."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich verstehe und stimme der Datenschutzerklärung und den Nutzungsbedingungen zu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I understand and agree to the Privacy Policy and Terms of Use."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entiendo y acepto la Política de Privacidad y los Términos de Uso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je comprends et j'accepte la politique de confidentialité et les conditions d'utilisation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैं समझता हूँ और गोपनीयता नीति और उपयोग की शर्तों से सहमति देता हूँ।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprendo e accetto l'informativa sulla privacy e i termini di utilizzo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プライバシーポリシーと利用規約に同意します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저는 개인정보 보호정책 및 이용 약관에 동의하고 이해합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik begrijp en ga akkoord met het Privacybeleid en de Gebruiksvoorwaarden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozumiem i zgadzam się z Polityką prywatności oraz Warunkami korzystania."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Eu entendo e concordo com a Política de Privacidade e os Termos de Uso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Я понимаю и согласен с Политикой конфиденциальности и Условиями использования."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฉันเข้าใจและยอมรับนโยบายความเป็นส่วนตัวและข้อกำหนดการใช้งาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gizlilik Politikası ve Kullanım Şartları’nı anlıyorum ve kabul ediyorum."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tôi hiểu và đồng ý với Chính sách Bảo mật và Điều khoản Sử dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我理解并同意隐私政策和使用条款。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我理解並同意隱私政策和使用條款。"
          }
        }
      }
    },
    "aiChatEnableConsentCloudMessage": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتم معالجة طلبات الذكاء الاصطناعي بواسطة خدمات الذكاء الاصطناعي لـ ExcalidrawZ. لا تتم معالجتها بالكامل على هذا الجهاز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-Anfragen werden von den ExcalidrawZ AI-Diensten verarbeitet. Sie werden nicht vollständig auf diesem Gerät verarbeitet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI requests are processed by ExcalidrawZ AI services. They are not handled entirely on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las solicitudes de IA son procesadas por los servicios de IA de ExcalidrawZ. No se manejan completamente en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les demandes AI sont traitées par les services AI d'ExcalidrawZ. Elles ne sont pas gérées entièrement sur cet appareil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "AI अनुरोध ExcalidrawZ AI सेवाओं द्वारा संसाधित किए जाते हैं। इन्हें पूरी तरह से इस डिवाइस पर नहीं संभाला जाता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le richieste AI sono elaborate dai servizi AI di ExcalidrawZ. Non vengono gestite interamente su questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIリクエストはExcalidrawZ AIサービスによって処理されます。これらはこのデバイス上では完全には処理されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 요청은 ExcalidrawZ AI 서비스에 의해 처리됩니다. 이 장치에서 완전히 처리되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-aanvragen worden verwerkt door de ExcalidrawZ AI-diensten. Ze worden niet volledig op dit apparaat verwerkt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapytania AI są przetwarzane przez usługi AI ExcalidrawZ. Nie są one obsługiwane w całości na tym urządzeniu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As solicitações de IA são processadas pelos serviços de IA do ExcalidrawZ. Elas não são tratadas inteiramente neste dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запросы ИИ обрабатываются службами ExcalidrawZ AI. Они не обрабатываются полностью на этом устройстве."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำขอ AI จะถูกประมวลผลโดยบริการ AI ของ ExcalidrawZ ซึ่งจะไม่ดำเนินการทั้งหมดในอุปกรณ์นี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "AI istekleri ExcalidrawZ AI hizmetleri tarafından işlenir. Tamamen bu cihazda işlenmez."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các yêu cầu AI được xử lý bởi dịch vụ AI của ExcalidrawZ. Chúng không được xử lý hoàn toàn trên thiết bị này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI请求由ExcalidrawZ AI服务处理。它们并不完全在此设备上处理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 請求由 ExcalidrawZ AI 服務處理，並非完全在此設備上處理。"
          }
        }
      }
    },
