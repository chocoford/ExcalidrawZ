    "settingsAIMCPServiceModeFeatureOptimizedVisualCheckBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اقرأ صورة اللوحة المعروضة بعد التغييرات حتى يتمكن العميل من فحص التخطيط والتداخل وقراءة النص."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lesen Sie das gerenderte Canvas-Bild nach Änderungen, damit der Kunde Layout, Überlappung und Lesbarkeit überprüfen kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read the rendered canvas image after changes so the client can inspect layout, overlap, and readability."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee la imagen del lienzo renderizado después de los cambios para que el cliente pueda inspeccionar el diseño, la superposición y la legibilidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisez l'image de la toile rendue après les modifications afin que le client puisse inspecter la mise en page, le chevauchement et la lisibilité."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "परिवर्तनों के बाद रेंडर की गई कैनवास छवि पढ़ें ताकि ग्राहक लेआउट, ओवरलैप और पठनीयता का निरीक्षण कर सके।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Leggi l'immagine della tela renderizzata dopo le modifiche in modo che il cliente possa ispezionare layout, sovrapposizione e leggibilità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更後にレンダリングされたキャンバス画像を読み取り、クライアントがレイアウト、重なり、可読性を確認できるようにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경 후 렌더링된 캔버스 이미지를 읽어 클라이언트가 레이아웃, 겹침 및 가독성을 검사할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lees de weergegeven canvasafbeelding na veranderingen zodat de cliënt de lay-out, overlap en leesbaarheid kan inspecteren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeczytaj renderowany obraz kanwy po zmianach, aby klient mógł sprawdzić układ, nakładanie się i czytelność."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Leia a imagem do canvas renderizado após as mudanças para que o cliente possa inspecionar o layout, sobreposição e legibilidade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Просмотр изображения рендеринга холста после изменений, чтобы клиент мог проверить компоновку, перекрытие и читаемость."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่านภาพผ้าใบที่เรนเดอร์หลังจากการเปลี่ยนแปลง เพื่อให้ลูกค้าสามารถตรวจสอบเลย์เอาต์ การซ้อนทับ และความสามารถในการอ่าน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değişikliklerden sonra görüntülenen tuval resmini okuyun, böylece istemci düzeni, örtüşmeyi ve okunabilirliği inceleyebilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đọc hình ảnh canvas đã được tạo ra sau khi thay đổi để khách hàng có thể kiểm tra bố cục, sự chồng chéo và độ dễ đọc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在更改后读取渲染的画布图像，以便客户端可以检查布局、重叠和可读性。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在更改後閱讀渲染的畫布圖像，以便客戶可以檢查佈局、重疊和可讀性。"
          }
        }
