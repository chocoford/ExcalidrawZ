    "paywallSubtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر مقدار قوة الذكاء الاصطناعي الذي تحتاجه. كل خطة مدفوعة تحتفظ بميزات الرسم الأساسية، والمزامنة، والتصدير، والمكتبة، والتعاون مفتوحة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie die Menge an KI-Power, die Sie benötigen. Jeder kostenpflichtige Plan hält die grundlegenden Funktionen Zeichnen, Synchronisieren, Exportieren, Bibliothek und Zusammenarbeit freigeschaltet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick the amount of AI power you need. Every paid plan keeps the core drawing, sync, export, library, and collaboration features unlocked."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige la cantidad de potencia de IA que necesites. Cada plan de pago mantiene desbloqueadas las funciones básicas de dibujo, sincronización, exportación, biblioteca y colaboración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez la puissance d'IA dont vous avez besoin. Chaque plan payant déverrouille les fonctionnalités essentielles de dessin, de synchronisation, d'exportation, de bibliothèque et de collaboration."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपको जितनी AI शक्ति की आवश्यकता है, उसे चुनें। हर भुगतानित योजना मूल खींचने, समन्वय, निर्यात, पुस्तकालय, और सहयोग सुविधाओं को अनलॉक रखती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli la quantità di potenza AI di cui hai bisogno. Ogni piano a pagamento mantiene sbloccate le funzionalità principali di disegno, sincronizzazione, esportazione, libreria e collaborazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "必要なAIパワーの量を選択してください。すべての有料プランでは、コアの描画、同期、エクスポート、ライブラリ、およびコラボレーション機能がアンロックされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "필요한 AI 파워의 양을 선택하세요. 모든 유료 요금제가 핵심 그리기, 동기화, 내보내기, 라이브러리 및 협업 기능을 잠금 해제합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies de hoeveelheid AI-kracht die je nodig hebt. Elk betaald plan houdt de kerntekeningen, synchronisatie, export, bibliotheek en samenwerkingsfuncties ontgrendeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz ilość mocy AI, której potrzebujesz. Każdy płatny plan odblokowuje podstawowe funkcje rysowania, synchronizacji, eksportu, biblioteki i współpracy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha a quantidade de poder de IA de que você precisa. Cada plano pago mantém as funções principais de desenho, sincronização, exportação, biblioteca e colaboração desbloqueadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите количество AI-ресурсов, которое вам необходимо. Каждый оплаченный тариф разблокирует основные функции рисования, синхронизации, экспорта, библиотеки и сотрудничества."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกความสามารถของ AI ที่คุณต้องการ แผนที่ชำระเงินทุกแผนจะปลดล็อคฟีเจอร์หลักการวาด ซิงค์ ส่งออก ห้องสมุด และการทำงานร่วมกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İhtiyacınız olan AI gücünü seçin. Her ücretli plan, temel çizim, senkronizasyon, dışa aktarma, kütüphane ve iş birliği özelliklerini açık tutar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn mức năng lượng AI bạn cần. Mỗi gói trả phí đều giữ các tính năng vẽ, đồng bộ, xuất, thư viện và hợp tác được mở khóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择你所需的 AI 力量。每个付费计划都保持核心绘图、同步、导出、库和协作功能解锁。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇所需的 AI 功能量。每個付費計劃都解鎖核心繪圖、同步、導出、庫和協作功能。"
          }
        }
      }
    },
    "paywallSwitchToAppStoreDialogTitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حالياً، الطريقة الوحيدة المدعومة للدفع هي من خلال متجر التطبيقات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Derzeit ist die einzige unterstützte Zahlungsmethode über den App Store."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Currently, the only payment method supported is through the App Store."
          }
        },
        "es": {
