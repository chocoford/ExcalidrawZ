    "migrationMoveContentToICloudDriveDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينقل محتوى الملفات من قاعدة البيانات المحلية إلى نظام تخزين ملفات موحّد (محلي + مزامنة iCloud). يحسّن ذلك أداء التطبيق عن طريق تخزين بيانات تعريف الملفات محليًا فقط مع الاحتفاظ بالبيانات الفعلية للملف في نظام الملفات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschiebt Dateiinhalte aus der lokalen Datenbank in ein einheitliches Dateispeichersystem (lokal + iCloud‑Sync). Dies verbessert die Leistung der App, indem nur Dateimetadaten lokal gespeichert werden, während die eigentlichen Dateien im Dateisystem verbleiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moves file content from local database to unified file storage system (local + iCloud sync). This improves app performance by storing only file metadata locally while keeping actual file data in the file system."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mueve el contenido de los archivos desde la base de datos local a un sistema de almacenamiento unificado (local + sincronización con iCloud). Esto mejora el rendimiento de la aplicación al almacenar solo los metadatos de los archivos localmente, mientras mantiene los datos reales de los archivos en el sistema de archivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplace le contenu des fichiers depuis la base de données locale vers un système de stockage unifié (stockage local + synchronisation iCloud). Cela améliore les performances de l'application en ne stockant localement que les métadonnées des fichiers, tandis que les données réelles sont conservées dans le système de fichiers."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थानीय डेटाबेस से फ़ाइल सामग्री को एकीकृत फ़ाइल संग्रहण प्रणाली (स्थानीय + iCloud सिंक) में स्थानांतरित करता है। यह केवल फ़ाइल मेटाडेटा को स्थानीय रूप से संग्रहीत करके और वास्तविक फ़ाइल डेटा को फ़ाइल सिस्टम में रखकर ऐप के प्रदर्शन में सुधार करता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sposta il contenuto dei file dal database locale a un sistema di archiviazione unificato (locale + sincronizzazione iCloud). Questo migliora le prestazioni dell'app memorizzando solo i metadati dei file localmente, mentre i dati effettivi dei file restano nel file system."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルの内容をローカルデータベースから統合ファイルストレージ（ローカル＋iCloud同期）へ移動します。実際のファイルデータをファイルシステムに保持し、ローカルにはファイルのメタデータのみを保存することで、アプリのパフォーマンスが向上します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 데이터베이스에서 통합 파일 저장 시스템(로컬 + iCloud 동기화)으로 파일 콘텐츠를 이동합니다. 이렇게 하면 실제 파일 데이터는 파일 시스템에 보관하고 로컬에는 파일 메타데이터만 저장하여 앱 성능이 향상됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verplaatst bestandsinhoud van de lokale database naar een verenigd bestandopslagsysteem (lokaal + iCloud-synchronisatie). Dit verbetert de app-prestaties doordat alleen bestandsmetadata lokaal worden opgeslagen, terwijl de daadwerkelijke bestandsgegevens in het bestandssysteem blijven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przenosi zawartość plików z lokalnej bazy danych do zunifikowanego systemu przechowywania plików (lokalnie z synchronizacją iCloud). Poprawia to wydajność aplikacji — lokalnie przechowywane są tylko metadane plików, a rzeczywiste dane plików pozostają w systemie plików."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Move o conteúdo dos arquivos do banco de dados local para um sistema unificado de armazenamento de arquivos (local + sincronização com iCloud). Isso melhora o desempenho do aplicativo ao armazenar apenas os metadados dos arquivos localmente, mantendo os dados reais dos arquivos no sistema de arquivos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переносит содержимое файлов из локальной базы данных в единое файловое хранилище (локально + синхронизация с iCloud). Это повышает производительность приложения за счёт хранения в локальной базе данных только метаданных файлов, в то время как сами файлы остаются в файловой системе."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ย้ายเนื้อหาไฟล์จากฐานข้อมูลภายในเครื่องไปยังระบบเก็บไฟล์แบบรวม (พื้นที่เก็บในเครื่องและการซิงค์กับ iCloud) ช่วยปรับปรุงประสิทธิภาพแอปโดยเก็บเฉพาะข้อมูลเมตาของไฟล์ไว้ในเครื่อง ขณะที่ข้อมูลไฟล์จริงจะถูกเก็บไว้ในระบบไฟล์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya içeriğini yerel veritabanından birleşik dosya depolama sistemine (yerel + iCloud eşitlemeli) taşır. Bu, gerçek dosya verilerini dosya sisteminde tutarken sadece dosya meta verilerini yerel olarak saklayarak uygulama performansını iyileştirir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Di chuyển nội dung tệp từ cơ sở dữ liệu cục bộ sang hệ thống lưu trữ tệp hợp nhất (cục bộ + đồng bộ iCloud). Việc này cải thiện hiệu năng ứng dụng bằng cách chỉ lưu siêu dữ liệu tệp ở cục bộ trong khi giữ dữ liệu tệp thực tế trong hệ thống tệp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将文件内容从本地数据库迁移到统一的文件存储系统（本地 + iCloud 同步）。这通过在本地仅存储文件元数据并将实际文件数据保存在文件系统中来提升应用性能。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將檔案內容從本機資料庫移至統一的檔案儲存系統（本機 + iCloud 同步）。這可改善應用程式效能：僅在本機儲存檔案的描述性資訊（metadata），而實際檔案資料則保存在檔案系統中。"
          }
        }
      }
    },
