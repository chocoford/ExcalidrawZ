    "whatsNewLiveCollaborationDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعاون مع الآخرين في الوقت الحقيقي، مما يجعل العمل الجماعي سلسًا ومنتجًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kollaborieren Sie in Echtzeit mit anderen, um die Teamarbeit nahtlos und produktiv zu gestalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Collaborate with others in real-time, making teamwork seamless and productive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Colabore con otros en tiempo real, haciendo que el trabajo en equipo sea fluido y productivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Collaborez avec d'autres en temps réel, rendant le travail d'équipe fluide et productif."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अन्य लोगों के साथ वास्तविक समय में सहयोग करें, जिससे टीम वर्क सुचारू और प्रभावी बनता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Collabora con altri in tempo reale, rendendo il lavoro di squadra fluido e produttivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他の人とリアルタイムでコラボレーションし、チームワークをシームレスで生産的にします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실시간으로 다른 사람과 협업하여 팀워크를 매끄럽고 생산적으로 만드세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Werk samen met anderen in real-time, waardoor teamwork naadloos en productief wordt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Współpracuj z innymi w czasie rzeczywistym, co sprawia, że praca zespołowa jest płynna i produktywna."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Colabore com outras pessoas em tempo real, tornando o trabalho em equipe fluido e produtivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сотрудничайте с другими в реальном времени, делая командную работу бесшовной и продуктивной."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำงานร่วมกับผู้อื่นแบบเรียลไทม์ ทำให้การทำงานร่วมกันราบรื่นและมีประสิทธิภาพ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diğerleriyle gerçek zamanlı işbirliği yaparak ekip çalışmasını sorunsuz ve verimli hale getirin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hợp tác với người khác theo thời gian thực, giúp công việc nhóm trở nên liền mạch và hiệu quả."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与他人实时协作，使团队合作更加顺畅和高效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "與他人實時協作，使團隊合作無縫且高效。"
          }
        }
      }
    },
