    "paywallFeatureOptimizedMCPMessage": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح البدء خدمات MCP المخصصة لـ ExcalidrawZ للحصول على تحكم أغنى في اللوحة وتدفقات العمل الأصلية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starter schaltet die für ExcalidrawZ optimierten MCP-Dienste für eine reichere Steuerung der Leinwand und native Workflows frei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starter unlocks ExcalidrawZ-optimized MCP services for richer canvas control and native workflows."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El paquete inicial desbloquea servicios MCP optimizados para ExcalidrawZ para un control de lienzo más rico y flujos de trabajo nativos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le plan Starter débloque les services MCP optimisés pour ExcalidrawZ pour un meilleur contrôle de la toile et des flux de travail natifs."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्टार्टर ExcalidrawZ-ऑप्टिमाइज़्ड MCP सेवाओं को समृद्ध कैनवास नियंत्रण और मूल कार्यप्रवाहों के लिए अनलॉक करता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo Starter sblocca i servizi MCP ottimizzati per ExcalidrawZ per un controllo più ricco della tela e flussi di lavoro nativi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Starterは、より豊かなキャンバス制御とネイティブワークフローのためにExcalidrawZに最適化されたMCPサービスを解除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Starter는 더 풍부한 캔버스 제어 및 기본 워크플로우를 위한 ExcalidrawZ 최적화 MCP 서비스를 잠금 해제합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Starter ontgrendelt ExcalidrawZ-geoptimaliseerde MCP-diensten voor rijkere canvasbesturing en native workflows."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Starter odblokowuje zoptymalizowane usługi MCP dla ExcalidrawZ, oferując bogatszą kontrolę nad płótnem i natywne przepływy pracy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O plano inicial desbloqueia serviços MCP otimizados para o ExcalidrawZ para um controle de canvas mais rico e fluxos de trabalho nativos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стартовая версия разблокирует оптимизированные для ExcalidrawZ услуги MCP для более богатого управления холстом и нативными рабочими процессами."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Starter ปลดล็อคบริการ MCP ที่ปรับให้เหมาะสมกับ ExcalidrawZ สำหรับการควบคุมผืนผ้าใบที่ดียิ่งขึ้นและกระบวนการทำงานแบบเนทีฟ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Starter, daha zengin tuval kontrolü ve yerel iş akışları için ExcalidrawZ optimize edilmiş MCP hizmetlerini açar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gói khởi đầu mở khóa các dịch vụ MCP tối ưu hóa cho ExcalidrawZ để kiểm soát canvas phong phú hơn và quy trình làm việc tự nhiên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "入门版解锁了 ExcalidrawZ 优化的 MCP 服务，以实现更丰富的画布控制和本地工作流。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "入門版解鎖 ExcalidrawZ 優化的 MCP 服務，提供更豐富的畫布控制和本地工作流程。"
          }
        }
      }
    },
