    "lockedContentUnlockRecoveryKeyMessage": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل مفتاح الاسترداد الخاص بك لفتح المحتوى المقفل المتطابق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie Ihren Wiederherstellungsschlüssel ein, um übereinstimmende gesperrte Inhalte zu entsperren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter your Recovery Key to unlock matching locked content."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingresa tu clave de recuperación para desbloquear el contenido bloqueado correspondiente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrez votre clé de récupération pour déverrouiller le contenu verrouillé correspondant."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मेल खाते की लॉक की गई सामग्री को अनलॉक करने के लिए अपना रिकवरी की दर्ज करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci il tuo Codice di Recupero per sbloccare il contenuto bloccato corrispondente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一致するロックされたコンテンツを解除するには、リカバリーキーを入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일치하는 잠긴 콘텐츠를 잠금 해제하려면 복구 키를 입력하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer uw Herstelcode in om bijpassende vergrendelde inhoud te ontgrendelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wprowadź swój klucz odzyskiwania, aby odblokować odpowiadającą zablokowaną zawartość."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite sua Chave de Recuperação para desbloquear o conteúdo bloqueado correspondente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите ваш ключ восстановления для разблокировки соответствующего заблокированного контента."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใส่รหัสกู้คืนของคุณเพื่อลดล็อกเนื้อหาที่ถูกล็อคที่ตรงกัน."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eşleşen kilitli içeriğin kilidini açmak için Kurtarma Anahtarınızı girin."
