    "dropLocalFileToGroupConfirmationMessage": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي هذا إلى استيراد المجلد وكل محتوياته إلى هذه المجموعة، وسيتم مزامنته مع iCloud."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird der Ordner mitsamt allen Inhalten in diese Gruppe importiert und mit iCloud synchronisiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will import the folder and all its contents into this group, and it will be synced with iCloud."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto importará la carpeta y todo su contenido a este grupo, y se sincronizará con iCloud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce dossier et tout son contenu seront importés dans ce groupe et synchronisés avec iCloud."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह फ़ोल्डर और इसकी सभी सामग्री इस समूह में आयात की जाएगी, और यह iCloud के साथ सिंक हो जाएगी।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo importerà la cartella e tutti i suoi contenuti in questo gruppo, e verrà sincronizzata con iCloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このフォルダとそのすべての内容をこのグループにインポートし、iCloudと同期します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 폴더와 그 안의 모든 내용이 이 그룹으로 가져와지며 iCloud와 동기화됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit zal de map en alle inhoud daarvan in deze groep importeren, en deze zal met iCloud worden gesynchroniseerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder i cała jego zawartość zostaną zaimportowane do tej grupy i zsynchronizowane z iCloud."
          }
        },
        "pt": {
