    "paywallReachReasonRoomLimit": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد وصلت إلى الحد الأقصى لعدد الغرف التعاونية في خطتك الحالية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie haben die maximale Anzahl kollaborativer Räume in Ihrem aktuellen Plan erreicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You’ve reached the maximum number of collaborative rooms limitation in current Plan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has alcanzado el número máximo de salas colaborativas en tu plan actual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez atteint le nombre maximal de salles collaboratives autorisé par votre forfait actuel."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप वर्तमान योजना में सहयोगात्मक कमरों की अधिकतम संख्या तक पहुँच चुके हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai raggiunto il numero massimo di stanze collaborative previsto dal tuo piano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のプランで利用できる共同ルームの上限に達しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 요금제에서 허용된 협업 룸의 최대 수에 도달했습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt het maximale aantal samenwerkingsruimtes voor je huidige abonnement bereikt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Osiągnięto maksymalną liczbę pokoi współpracy w bieżącym planie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você atingiu o número máximo de salas colaborativas no plano atual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы достигли максимального числа совместных комнат, предусмотренного вашим текущим планом."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณได้ถึงขีดจำกัดจำนวนห้องทำงานร่วมตามแผนปัจจุบันแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçerli plandaki ortak çalışma odalarının maksimum sayısına ulaştınız."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã đạt giới hạn tối đa về số phòng cộng tác trong gói hiện tại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您已达到当前计划允许的协作房间数量上限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您已達到目前方案允許的協作房間數上限。"
          }
        }
      }
    },
