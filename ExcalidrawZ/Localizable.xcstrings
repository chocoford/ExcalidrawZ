    "openURLSheetPopUpTipsPopoverHelp": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك فتح الرابط مباشرةً بالضغط المستمر على مفتاح ⌘."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie können den Link direkt öffnen, indem Sie die ⌘-Taste gedrückt halten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can directly open the link by holding down the ⌘ key."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes abrir el enlace directamente manteniendo pulsada la tecla ⌘."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez ouvrir le lien directement en maintenant la touche ⌘ enfoncée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप ⌘ कुंजी दबाकर लिंक को सीधे खोल सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi aprire direttamente il link tenendo premuto il tasto ⌘."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘キーを押し続けると、リンクを直接開けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘ 키를 누른 채로 링크를 직접 열 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd de ⌘-toets ingedrukt om de link direct te openen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz bezpośrednio otworzyć link, przytrzymując klawisz ⌘."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode abrir o link diretamente mantendo pressionada a tecla ⌘."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы можете открыть ссылку напрямую, удерживая клавишу ⌘."
          }
        },
        "th": {
