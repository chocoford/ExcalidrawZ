    "migrationSheetDownloadDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتوفر إصداران من ExcalidrawZ: إصدار متجر التطبيقات وإصدار غير متجر التطبيقات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es sind zwei Versionen von ExcalidrawZ verfügbar: die App Store-Version und die Nicht-App Store-Version."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two versions of ExcalidrawZ are available: the App Store version and the non-App Store version."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Están disponibles dos versiones de ExcalidrawZ: la versión de la App Store y la versión que no es de la App Store."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deux versions d'ExcalidrawZ sont disponibles : la version App Store et la version non-App Store."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ के दो संस्करण उपलब्ध हैं: ऐप स्टोर संस्करण और गैर-ऐप स्टोर संस्करण।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono disponibili due versioni di ExcalidrawZ: la versione dell'App Store e la versione non dell'App Store."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2 つのバージョンの ExcalidrawZ が利用可能です：App Store バージョンと非 App Store バージョン。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ의 두 가지 버전이 있습니다: 앱 스토어 버전과 비앱 스토어 버전입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twee versies van ExcalidrawZ zijn beschikbaar: de App Store-versie en de niet-App Store-versie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostępne są dwie wersje ExcalidrawZ: wersja z App Store i wersja nie z App Store."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Duas versões do ExcalidrawZ estão disponíveis: a versão da App Store e a versão não-App Store."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступны две версии ExcalidrawZ: версия из App Store и версия вне App Store."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มี ExcalidrawZ สองเวอร์ชัน: เวอร์ชัน App Store และเวอร์ชันที่ไม่ใช่ App Store"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İki ExcalidrawZ sürümü mevcuttur: App Store sürümü ve App Store dışı sürüm."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có hai phiên bản của ExcalidrawZ: phiên bản App Store và phiên bản không phải App Store."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ 有两个版本：App Store 版本和非 App Store 版本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有兩個版本的 ExcalidrawZ 可用：App Store 版本和非 App Store 版本。"
          }
        }
      }
    },
    "migrationSheetDownloadHeadline": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتحميل ExcalidrawZ الجديد"
          }
        },
