    "settingsAIMCPServiceModeFeatureOptimizedIncrementalBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إجراء تغييرات مستهدفة على القماش الحالي، والتي تعمل بشكل أفضل للملفات المعقدة من استبدال العرض بالكامل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zielgerichtete Änderungen an bestehenden Leinwänden vornehmen, was bei komplexen Dateien besser funktioniert als das Ersetzen der gesamten Ansicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make targeted changes to existing canvases, which works better for complex files than replacing the whole view."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Realizar cambios específicos en lienzos existentes, lo que funciona mejor para archivos complejos que reemplazar toda la vista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apporter des modifications ciblées aux canevas existants, ce qui fonctionne mieux pour les fichiers complexes que de remplacer l'ensemble de la vue."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मौजूदा कैनवास में लक्षित परिवर्तन करें, जो जटिल फ़ाइलों के लिए पूरे दृश्य को बदलने की तुलना में बेहतर काम करता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apporta modifiche mirate a tele esistenti, che funzionano meglio per file complessi rispetto alla sostituzione dell'intera vista."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既存のキャンバスにターゲットを絞った変更を加えます。これは複雑なファイルには全体の表示を置き換えるよりも効果的です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 뷰를 교체하는 것보다 복잡한 파일에 더 효과적인 기존 캔버스에 대한 특정 변경을 수행하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak gerichte wijzigingen aan bestaande canvassen, wat beter werkt voor complexe bestanden dan het vervangen van het volledige weergave."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wprowadź celowe zmiany w istniejących płótnach, co lepiej działa w przypadku złożonych plików niż zastępowanie całego widoku."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça alterações direcionadas em canvases existentes, que funcionam melhor para arquivos complexos do que substituir toda a visualização."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вносите целевые изменения в существующие холсты, что работает лучше для сложных файлов, чем замена всего представления."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำการเปลี่ยนแปลงที่เฉพาะเจาะจงกับผืนผ้าใบที่มีอยู่ ซึ่งทำงานได้ดีกว่าสำหรับไฟล์ที่ซับซ้อนกว่าการแทนที่มุมมองทั้งหมด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mevcut kanvaslarda hedefli değişiklikler yapın, bu, karmaşık dosyalar için tüm görünümü değiştirmekten daha iyi çalışır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thực hiện các thay đổi có mục tiêu đối với các bề mặt hiện có, cái này hoạt động tốt hơn cho các tệp phức tạp so với việc thay thế toàn bộ chế độ xem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对现有画布进行有针对性的更改，这对于复杂文件比替换整个视图更有效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對現有畫布進行有針對性的更改，這對於複雜檔案比替換整個視圖更有效。"
          }
        }
      }
    },
