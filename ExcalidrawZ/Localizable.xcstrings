    "aiChatWelcomeFeatureRevertSubtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل تعديل AI مُسجل — يمكنك التراجع عنه فوراً إذا لم يعجبك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede KI-Änderung wird gespeichert — rollen Sie sofort zurück, wenn Sie sie nicht mögen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every AI edit is checkpointed — roll back instantly if you don't like it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada edición de IA se guarda como un punto de control: vuelve atrás al instante si no te gusta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque modification par IA est sauvegardée — revenez en arrière instantanément si cela ne vous plaît pas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर एआई संपादन की चेकपॉइंटिंग होती है - यदि आपको यह पसंद नहीं है तो तुरंत वापस रहें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni modifica dell'AI è registrata — torna indietro istantaneamente se non ti piace."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのAI編集はチェックポイントが設定されているため、気に入らない場合は即座に元に戻すことができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 AI 편집은 체크포인트로 저장됩니다 — 마음에 들지 않으면 즉시 롤백하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke AI-wijziging is opgeslagen — keer direct terug als je het niet leuk vindt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każda edycja AI jest zapisywana — cofnij ją natychmiast, jeśli ci się nie podoba."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toda edição de IA é verificada — reverta instantaneamente se você não gostar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждое изменение ИИ сохраняется — вы можете тут же отменить, если оно вам не нравится."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกการแก้ไข AI จะถูกบันทึกเป็นจุดตรวจสอบ — สามารถยกเลิกได้ทันทีหากคุณไม่ชอบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her AI düzenlemesi kontrol noktalarıyla kaydedilir — hoşlanmazsanız anında geri alın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi chỉnh sửa AI đều được lưu lại — quay lại ngay lập tức nếu bạn không thích."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次 AI 编辑都被记录为检查点——如果您不喜欢可以立即撤回。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每次 AI 編輯都有檢查點 - 如果不喜歡，可以立即恢復。"
          }
        }
      }
    },
