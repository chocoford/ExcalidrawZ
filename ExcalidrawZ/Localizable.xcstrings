    "settingsAIMCPServiceModeFeatureOptimizedToolsBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم أدوات أصلية متعددة، بما في ذلك ميرميد، صيغ LaTeX، مخططات الدوال، تفضيلات اللوحة، وتحريرات العناصر الدقيقة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie mehrere native Werkzeuge, einschließlich Mermaid, LaTeX-Formeln, Funktionsdiagrammen, Canvas-Voreinstellungen und präzisen Elementbearbeitungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use multiple native tools, including Mermaid, LaTeX formulas, function plots, canvas preferences, and precise element edits."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliza múltiples herramientas nativas, incluyendo Mermaid, fórmulas LaTeX, gráficos de funciones, preferencias del lienzo y ediciones precisas de elementos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez plusieurs outils natifs, y compris Mermaid, formules LaTeX, graphiques de fonctions, préférences de toile et éditions précises des éléments."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mermaid, LaTeX सूत्र, फ़ंक्शन प्लॉट, कैनवास प्राथमिकताएँ और सटीक तत्व संपादन सहित कई मूल उपकरणों का उपयोग करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilizza più strumenti nativi, inclusi Mermaid, formule LaTeX, grafici di funzioni, preferenze della tela e modifiche precise degli elementi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mermaid、LaTeX数式、関数プロット、キャンバス設定、精密要素編集を含む複数のネイティブツールを使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mermaid, LaTeX 수식, 함수 그래프, 캔버스 기본 설정 및 정밀 요소 편집을 포함한 여러 네이티브 도구를 사용하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik meerdere native tools, waaronder Mermaid, LaTeX-formules, functieplottisaties, canvasvoorkeursinstellingen en nauwkeurige elementbewerkingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Używaj wielu natywnych narzędzi, w tym Mermaid, formuł LaTeX, wykresów funkcji, preferencji kanwy i precyzyjnych edycji elementów."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Use várias ferramentas nativas, incluindo Mermaid, fórmulas LaTeX, gráficos de funções, preferências de canvas e edições precisas de elementos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте несколько встроенных инструментов, включая Mermaid, формулы LaTeX, графики функций, настройки холста и точные редактирования элементов."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้เครื่องมือในตัวหลายรายการ รวมถึง Mermaid, สูตร LaTeX, กราฟฟังก์ชัน, การตั้งค่าผ้าใบ และการแก้ไของค์ประกอบที่แม่นยำ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mermaid, LaTeX formülleri, fonksiyon grafikleri, tuval tercihleri ve kesin eleman düzenlemeleri dahil olmak üzere birden fazla yerel aracı kullanın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sử dụng nhiều công cụ gốc, bao gồm Mermaid, công thức LaTeX, đồ thị hàm, tùy chọn canvas và chỉnh sửa phần tử chính xác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用多个本地工具，包括 Mermaid、LaTeX 公式、函数图、画布偏好和精确元素编辑。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用多種原生工具，包括 Mermaid、LaTeX 公式、函數圖、畫布偏好和精確的元素編輯。"
          }
        }
      }
    },
