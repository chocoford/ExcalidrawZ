    "whatsNewSupportLocalFoldersDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح واحفظ ملفات Excalidraw بسهولة مباشرةً من المجلدات المرتبطة — تكامل سلس مع سير عملك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne und speichere Excalidraw-Dateien ganz einfach direkt aus deinen verknüpften Ordnern – nahtlos in deinen Workflow integriert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Easily open and save Excalidraw files directly from your linked folders—seamless integration for your workflow."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre y guarda archivos de Excalidraw directamente desde tus carpetas vinculadas: integración perfecta para tu flujo de trabajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez et enregistrez facilement des fichiers Excalidraw directement depuis vos dossiers liés — intégration transparente à votre flux de travail."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लिंक किए गए फ़ोल्डरों से Excalidraw फ़ाइलें सीधे और आसानी से खोलें और सहेजें — आपके कार्य प्रवाह के लिए निर्बाध एकीकरण।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri e salva facilmente i file di Excalidraw direttamente dalle tue cartelle collegate — integrazione perfetta nel tuo flusso di lavoro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンク済みフォルダからExcalidrawファイルを直接簡単に開いたり保存したりでき、ワークフローにシームレスに統合されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결된 폴더에서 Excalidraw 파일을 바로 열고 저장하세요 — 작업 흐름에 원활하게 통합됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open en sla Excalidraw-bestanden eenvoudig rechtstreeks vanuit je gekoppelde mappen op — naadloze integratie in je workflow."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Łatwo otwieraj i zapisuj pliki Excalidraw bezpośrednio z powiązanych folderów — płynna integracja z Twoim przepływem pracy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra e salve facilmente arquivos do Excalidraw diretamente das suas pastas vinculadas — integração perfeita ao seu fluxo de trabalho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Легко открывайте и сохраняйте файлы Excalidraw прямо из ваших локальных папок — бесшовная интеграция в ваш рабочий процесс."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดและบันทึกไฟล์ Excalidraw ได้อย่างง่ายดายโดยตรงจากโฟลเดอร์ที่เชื่อมโยงของคุณ — การผสานอย่างราบรื่นกับกระบวนการทำงานของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlı klasörlerinizden Excalidraw dosyalarını kolayca doğrudan açın ve kaydedin—iş akışınıza sorunsuz entegrasyon."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dễ dàng mở và lưu các tệp Excalidraw trực tiếp từ các thư mục liên kết của bạn — tích hợp liền mạch cho quy trình làm việc của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻松直接从已链接的文件夹打开和保存 Excalidraw 文件，与你的工作流程无缝集成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕鬆從已連結的資料夾直接開啟與儲存 Excalidraw 檔案，無縫融入您的工作流程。"
          }
        }
      }
    },
