    "whatsNewSearchableAndSpotlightDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح أي ملف من ExcalidrawZ بسرعة باستخدام البحث المدمج أو مباشرة عبر Spotlight."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie schnell jede ExcalidrawZ-Datei mit der integrierten Suche oder direkt über Spotlight."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quickly open any ExcalidrawZ file with built-in search or directly via Spotlight."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra rápidamente cualquier archivo de ExcalidrawZ con la búsqueda integrada o directamente a través de Spotlight."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez rapidement n'importe quel fichier ExcalidrawZ avec la recherche intégrée ou directement via Spotlight."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बिल्ट-इन खोज या सीधे स्पॉटलाइट के माध्यम से किसी भी ExcalidrawZ फ़ाइल को जल्दी से खोलें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri rapidamente qualsiasi file di ExcalidrawZ con la ricerca integrata o direttamente tramite Spotlight."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内蔵の検索機能やSpotlightを使用して、任意のExcalidrawZファイルを迅速に開けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내장된 검색 기능이나 Spotlight를 통해 어떤 ExcalidrawZ 파일도 빠르게 열 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open snel elk ExcalidrawZ-bestand met de ingebouwde zoekfunctie of rechtstreeks via Spotlight."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szybko otwieraj dowolny plik ExcalidrawZ za pomocą wbudowanej wyszukiwarki lub bezpośrednio przez Spotlight."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra rapidamente qualquer arquivo do ExcalidrawZ com a busca integrada ou diretamente pelo Spotlight."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Быстро открывайте любой файл ExcalidrawZ с помощью встроенного поиска или напрямую через Spotlight."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดไฟล์ ExcalidrawZ ใด ๆ ได้อย่างรวดเร็วด้วยการค้นหาที่ติดตั้งไว้หรือโดยตรงผ่าน Spotlight"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Herhangi bir ExcalidrawZ dosyasını yerleşik arama veya doğrudan Spotlight aracılığıyla hızlıca açın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở bất kỳ tệp ExcalidrawZ nào một cách nhanh chóng bằng tìm kiếm tích hợp hoặc trực tiếp qua Spotlight."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过内置搜索或直接通过 Spotlight 快速打开任何 ExcalidrawZ 文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通過內建搜尋或直接使用 Spotlight 快速打開任何 ExcalidrawZ 檔案。"
          }
        }
      }
    },
