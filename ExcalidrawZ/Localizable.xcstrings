    "aiChatWelcomeGetStartedCaption": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك تغيير إعدادات AI في أي وقت من قائمة المزيد."
          }
        },
        "de": {
