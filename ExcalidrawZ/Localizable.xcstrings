    "whatsNewTabbedInspectorDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم الآن تجميع المكتبة وسجل الملفات وبحث اللوحة وتفضيلات اللوحة في لوحة جانبية قابلة للتبديل — افتح أو أغلق أيًا منها بنقرة واحدة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bibliothek, Dateiverlauf, Leinwandsuche und Leinwand‑Einstellungen sind jetzt in einem umschaltbaren Seitenbereich zusammengefasst – öffnen oder schließen Sie jeden Bereich mit einem einzigen Klick."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Library, file history, canvas search, and canvas preferences are now grouped into one switchable side panel — open and close any of them with a single click."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La biblioteca, el historial de archivos, la búsqueda del lienzo y las preferencias del lienzo se han agrupado en un único panel lateral que permite alternarlos; ábrelos o ciérralos con un solo clic."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La bibliothèque, l'historique des fichiers, la recherche et les préférences de la surface de travail sont désormais regroupés dans un même panneau latéral basculable — ouvrez ou fermez n'importe lequel d'entre eux d'un simple clic."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लाइब्रेरी, फ़ाइल इतिहास, कैनवास खोज और कैनवास प्राथमिकताएँ अब एक स्विच करने योग्य साइड पैनल में समूहीकृत हैं — उन्हें एक क्लिक से खोलें या बंद करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Libreria, cronologia dei file, ricerca nella tela e preferenze della tela sono ora raggruppati in un unico pannello laterale commutabile — apri e chiudi ciascuno di essi con un solo clic."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブラリ、ファイル履歴、キャンバス検索、キャンバスの環境設定が切り替え可能なサイドパネルにまとめられました。ワンクリックで任意のパネルを開閉できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라이브러리, 파일 히스토리, 캔버스 검색 및 캔버스 환경설정이 이제 하나의 전환식 사이드 패널로 그룹화되어 클릭 한 번으로 언제든지 열고 닫을 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bibliotheek, bestandsgeschiedenis, canvas-zoekfunctie en canvasvoorkeuren zijn nu gebundeld in één omschakelbaar zijpaneel — open of sluit elk onderdeel met een enkele klik."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Biblioteka, historia plików, wyszukiwanie na płótnie i preferencje płótna są teraz zgrupowane w jednym przełączanym panelu bocznym — otwieraj i zamykaj dowolny z nich jednym kliknięciem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Biblioteca, histórico de arquivos, busca no canvas e preferências do canvas agora estão agrupados em um painel lateral alternável — abra e feche qualquer um deles com um único clique."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Библиотека, история файлов, поиск по холсту и настройки холста теперь собраны в одной переключаемой боковой панели — открывайте и закрывайте любую из них одним щелчком."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไลบรารี, ประวัติไฟล์, การค้นหาแคนวาส และการตั้งค่าแคนวาส ถูกจัดรวมไว้ในแผงด้านข้างที่สลับได้ — สามารถเปิดหรือปิดแต่ละรายการได้ด้วยการคลิกเพียงครั้งเดียว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kitaplık, dosya geçmişi, tuval araması ve tuval tercihleri artık tek bir geçiş yapılabilen yan panelde gruplandı — bunların herhangi birini tek bir tıklamayla açıp kapatabilirsiniz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thư viện, lịch sử tệp, tìm kiếm khung vẽ và tùy chọn khung vẽ giờ được gom vào cùng một ngăn bên có thể chuyển đổi — mở hoặc đóng bất kỳ mục nào chỉ với một cú nhấp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "资源库、文件历史记录、画布搜索和画布偏好现在被归入同一个可切换侧边面板 —— 只需单击即可打开或关闭其中任意一个。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "資源庫、檔案歷史紀錄、畫布搜尋與畫布偏好設定現已群組於同一可切換的側邊面板——只需單擊即可開啟或關閉任一項。"
          }
        }
      }
    },
