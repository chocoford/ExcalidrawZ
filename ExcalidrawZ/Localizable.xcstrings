    "applePencilInterationModeNoneDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**None**\n    • Use Excalidraw's default pointer behavior\n    • Finger and Pencil follow the same input rules"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**无**\n    • 使用 Excalidraw 的默认指针行为\n    • 手指和铅笔遵循相同的输入规则"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "**無**\n    • 使用 Excalidraw 的預設指標行為\n    • 手指和 Pencil 遵循相同的輸入規則"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "**لا شيء**\n    • استخدم سلوك المؤشر الافتراضي ل Excalidraw\n    • تعمل الأصابع والقلم بنفس قواعد الإدخال"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Keine**\n    • Verwenden Sie das Standardzeigerverhalten von Excalidraw\n    • Finger und Stift folgen denselben Eingaberegeln"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Ninguno**\n    • Utiliza el comportamiento de puntero predeterminado de Excalidraw\n    • El dedo y el lápiz siguen las mismas reglas de entrada"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Aucun**\n    • Utilisez le comportement par défaut du pointeur d'Excalidraw\n    • Doigt et Stylet suivent les mêmes règles d'entrée"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "**कोई नहीं**\n    • Excalidraw के डिफ़ॉल्ट पॉइंटर व्यवहार का उपयोग करें\n    • ऊंगली और पेंसिल समान इनपुट नियमों का पालन करते हैं"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "**Nessuno**\n    • Utilizza il comportamento predefinito del puntatore di Excalidraw\n    • Il dito e la matita seguono le stesse regole di input"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**無し**\n    • Excalidrawのデフォルトのポインタ動作を使用\n    • 指とペンシルは同じ入力ルールに従います"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "**없음**\n    • Excalidraw의 기본 포인터 동작 사용\n    • 손가락과 펜슬은 동일한 입력 규칙 따름"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "**Geen**\n    • Gebruik de standaard pointergedrag van Excalidraw\n    • Vinger en Pencil volgen dezelfde invoerregels"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "**Brak**\n    • Użyj domyślnego zachowania wskaźnika Excalidraw\n    • Palec i ołówek podążają za tymi samymi zasadami wejścia"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "**Nenhum**\n    • Use o comportamento padrão do ponteiro do Excalidraw\n    • Dedo e Lápis seguem as mesmas regras de entrada"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "**Нет**\n    • Используйте поведение указателя по умолчанию Excalidraw\n    • Палец и карандаш следуют одним и тем же правилам ввода"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "**ไม่มี**\n    • ใช้พฤติกรรมของตัวชี้เริ่มต้นของ Excalidraw\n    • นิ้วและดินสอจะปฏิบัติตามกฎการป้อนข้อมูลเดียวกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Hiçbiri**\n    • Excalidraw'ın varsayılan imleç davranışını kullanın\n    • Parmak ve Kalem aynı giriş kurallarını izler"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "**Không**\n    • Sử dụng hành vi con trỏ mặc định của Excalidraw\n    • Ngón tay và Bút đều theo cùng một quy tắc đầu vào"
          }
        }
      }
    },
