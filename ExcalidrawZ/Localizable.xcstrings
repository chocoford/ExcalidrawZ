    "migrationSheetTips": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يزال بإمكانك الاستمرار في استخدام التطبيق الحالي، وستظل بياناتك آمنة، لكن التحديثات المستقبلية لن يتم دفعها هنا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie können die aktuelle App weiterhin verwenden, und Ihre Daten bleiben sicher, aber zukünftige Updates werden hier nicht bereitgestellt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can still continue to use the current app, and your data remains safe, but future updates will not be pushed here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún puedes seguir utilizando la aplicación actual, y tus datos permanecen seguros, pero las futuras actualizaciones no se enviarán aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez continuer à utiliser l'application actuelle, et vos données restent en sécurité, mais les futures mises à jour ne seront pas poussées ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप अभी भी वर्तमान ऐप का उपयोग जारी रख सकते हैं, और आपके डेटा सुरक्षित हैं, लेकिन भविष्य के अपडेट यहां नहीं भेजे जाएंगे।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi ancora continuare a utilizzare l'app attuale e i tuoi dati rimangono al sicuro, ma gli aggiornamenti futuri non verranno inviati qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のアプリを引き続き使用できますし、データは安全ですが、今後の更新はここには配信されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 앱을 계속 사용할 수 있으며, 데이터는 안전하게 유지되지만 향후 업데이트는 여기에서 푸시되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt de huidige app nog steeds blijven gebruiken, en je gegevens blijven veilig, maar toekomstige updates worden hier niet meer gepusht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz nadal używać obecnej aplikacji, a twoje dane pozostaną bezpieczne, ale przyszłe aktualizacje nie będą tutaj dostępne."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você ainda pode continuar a usar o aplicativo atual, e seus dados permanecem seguros, mas futuras atualizações não serão enviadas aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы все еще можете продолжать использовать текущее приложение, и ваши данные останутся в безопасности, но будущие обновления не будут доступны здесь."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณยังสามารถใช้แอปปัจจุบันต่อไปได้ และข้อมูลของคุณยังคงปลอดภัย แต่การอัปเดตในอนาคตจะไม่ถูกส่งมาที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mevcut uygulamayı kullanmaya devam edebilirsiniz ve verileriniz güvende kalır, ancak gelecekteki güncellemeler burada sunulmayacaktır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn vẫn có thể tiếp tục sử dụng ứng dụng hiện tại, và dữ liệu của bạn vẫn an toàn, nhưng các bản cập nhật trong tương lai sẽ không được đẩy lên đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您仍然可以继续使用当前的应用程序，您的数据仍然安全，但未来的更新将不会推送到这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您仍然可以繼續使用當前應用程序，您的數據保持安全，但未來的更新將不會推送到這裡。"
          }
        }
      }
    },
