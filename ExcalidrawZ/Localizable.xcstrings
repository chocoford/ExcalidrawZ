    "lockedContentRecoveryKeyExportNote": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احتفظ بهذا الملف في مكان آمن. هذا مفتاح الاسترداد يقوم بفتح محتوى ExcalidrawZ المقفل إذا لم يكن متاحًا Touch ID أو كلمة مرور Mac الخاصة بك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewahren Sie diese Datei an einem sicheren Ort auf. Dieser Wiederherstellungsschlüssel entsperrt gesperrte ExcalidrawZ-Inhalte, wenn Touch ID oder Ihr Mac-Passwort nicht verfügbar sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep this file somewhere safe. This Recovery Key unlocks locked ExcalidrawZ content if Touch ID or your Mac password is not available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda este archivo en un lugar seguro. Esta clave de recuperación desbloquea el contenido bloqueado de ExcalidrawZ si Touch ID o tu contraseña de Mac no están disponibles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservez ce fichier en lieu sûr. Cette clé de récupération débloque le contenu verrouillé d'ExcalidrawZ si Touch ID ou votre mot de passe Mac n'est pas disponible."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस फ़ाइल को कहीं सुरक्षित रखें। यह रिकवरी की लॉक्ड ExcalidrawZ सामग्री को अनलॉक करती है यदि टच आईडी या आपका मैक पासवर्ड उपलब्ध नहीं है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni questo file in un luogo sicuro. Questa chiave di recupero sblocca i contenuti bloccati di ExcalidrawZ se Touch ID o la password del tuo Mac non sono disponibili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルを安全な場所に保管してください。この復旧キーは、Touch IDまたはMacのパスワードが利用できない場合にロックされたExcalidrawZコンテンツのロックを解除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 파일을 안전한 곳에 보관하세요. 이 복구 키는 Touch ID나 Mac 비밀번호가 없을 경우 잠긴 ExcalidrawZ 콘텐츠를 잠금 해제합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaar dit bestand op een veilige plek. Deze herstelcode ontgrendelt vergrendelde ExcalidrawZ-inhoud als Touch ID of je Mac-wachtwoord niet beschikbaar is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przechowuj ten plik w bezpiecznym miejscu. Ten klucz odzyskiwania odblokowuje zablokowane treści ExcalidrawZ, jeśli Touch ID lub hasło do Maca nie są dostępne."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarde este arquivo em um lugar seguro. Esta Chave de Recuperação desbloqueia conteúdo bloqueado do ExcalidrawZ se o Touch ID ou sua senha do Mac não estiver disponível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраните этот файл в безопасном месте. Этот ключ восстановления разблокирует заблокированный контент ExcalidrawZ, если Touch ID или пароль вашего Mac недоступны."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เก็บไฟล์นี้ไว้ในที่ปลอดภัย Recovery Key นี้จะปลดล็อกเนื้อหาที่ถูกล็อกใน ExcalidrawZ หากไม่มี Touch ID หรือรหัสผ่าน Mac ของคุณ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dosyayı güvende bir yerde saklayın. Bu Kurtarma Anahtarı, Touch ID veya Mac şifreniz mevcut değilse kilitlenmiş ExcalidrawZ içeriğini açar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu tập tin này ở nơi an toàn. Khóa Khôi phục này mở khóa nội dung ExcalidrawZ đã bị khóa nếu Touch ID hoặc mật khẩu Mac của bạn không khả dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将此文件保存在安全的地方。此恢复密钥在无法使用 Touch ID 或您的 Mac 密码时，可以解锁被锁定的 ExcalidrawZ 内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請將此檔案妥善保管。此恢復金鑰可在無法使用 Touch ID 或 Mac 密碼時解鎖鎖定的 ExcalidrawZ 內容。"
          }
        }
      }
    },
