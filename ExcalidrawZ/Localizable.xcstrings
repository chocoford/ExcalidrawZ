    "migrationPhaseMigratingSubtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرجى الانتظار بينما نقوم بتحديث بياناتك لتعمل بشكل أفضل مع أحدث إصدار من التطبيق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte warten Sie, während wir Ihre Daten aktualisieren, damit sie besser mit der neuesten Version der App funktionieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please wait while we update your data to work better with the latest version of the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor, espere mientras actualizamos sus datos para que funcionen mejor con la versión más reciente de la aplicación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veuillez patienter pendant que nous mettons à jour vos données pour qu'elles fonctionnent mieux avec la dernière version de l'application."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कृपया प्रतीक्षा करें, हम आपके डेटा को ऐप के नवीनतम संस्करण के साथ बेहतर ढंग से काम करने के लिए अपडेट कर रहे हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attendere mentre aggiorniamo i tuoi dati per farli funzionare meglio con l'ultima versione dell'app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最新バージョンのアプリに対応するためデータを更新しています。しばらくお待ちください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 최신 버전과 더 잘 작동하도록 데이터를 업데이트하는 동안 기다려 주세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wacht even terwijl we uw gegevens bijwerken zodat ze beter werken met de nieuwste versie van de app."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Proszę czekać — aktualizujemy Twoje dane, aby lepiej działały z najnowszą wersją aplikacji."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguarde enquanto atualizamos seus dados para funcionarem melhor com a versão mais recente do aplicativo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пожалуйста, подождите, пока мы обновим ваши данные, чтобы они работали лучше с последней версией приложения."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กรุณารอในขณะที่เรากำลังอัปเดตข้อมูลของคุณเพื่อให้ทำงานได้ดียิ่งขึ้นกับเวอร์ชันล่าสุดของแอป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamanın en son sürümüyle daha iyi çalışması için verilerinizi güncellerken lütfen bekleyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vui lòng đợi trong khi chúng tôi cập nhật dữ liệu của bạn để hoạt động tốt hơn với phiên bản mới nhất của ứng dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请稍候，我们正在更新您的数据，使其更好地适配应用的最新版本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請稍候，我們正在更新您的資料，以便更好地配合應用程式的最新版本。"
          }
        }
      }
    },
