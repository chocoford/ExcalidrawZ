    "whatsNewMoreToolsSupportDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في هذه النسخة، تم دمج المزيد من الأدوات من Excalidraw في ExcalidrawZ، بما في ذلك أدوات التوليد بواسطة الذكاء الاصطناعي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In dieser Version wurden weitere Werkzeuge aus Excalidraw in ExcalidrawZ integriert, einschließlich der KI-Generierungswerkzeuge."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In this version, more tools from Excalidraw have been integrated into ExcalidrawZ, including the AI Generate tools."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En esta versión, se han integrado más herramientas de Excalidraw en ExcalidrawZ, incluyendo las herramientas de generación de IA."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans cette version, plus d'outils d'Excalidraw ont été intégrés dans ExcalidrawZ, y compris les outils de génération AI."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस संस्करण में, Excalidraw के और भी उपकरण ExcalidrawZ में एकीकृत किए गए हैं, जिसमें AI जनरेट उपकरण शामिल हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In questa versione, più strumenti di Excalidraw sono stati integrati in ExcalidrawZ, inclusi gli strumenti di generazione AI."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバージョンでは、ExcalidrawからのさらなるツールがExcalidrawZに統合され、AI生成ツールも含まれています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 버전에서는 Excalidraw의 더 많은 도구가 ExcalidrawZ에 통합되었으며, AI 생성 도구도 포함됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In deze versie zijn meer tools van Excalidraw geïntegreerd in ExcalidrawZ, inclusief de AI Generate-tools."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W tej wersji zintegrowano więcej narzędzi z Excalidraw w ExcalidrawZ, w tym narzędzia AI Generate."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nesta versão, mais ferramentas do Excalidraw foram integradas ao ExcalidrawZ, incluindo as ferramentas de Geração de IA."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этой версии в ExcalidrawZ были интегрированы больше инструментов из Excalidraw, включая инструменты AI Generate."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ในเวอร์ชันนี้ เครื่องมือจาก Excalidraw ได้ถูกผนวกเข้าไปใน ExcalidrawZ มากขึ้น รวมถึงเครื่องมือ AI Generate"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sürümde, Excalidraw'dan daha fazla araç ExcalidrawZ'ye entegre edilmiştir, bunlar arasında AI Üretim araçları da bulunmaktadır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trong phiên bản này, nhiều công cụ từ Excalidraw đã được tích hợp vào ExcalidrawZ, bao gồm các công cụ AI Generate."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这个版本中，更多来自 Excalidraw 的工具已被整合到 ExcalidrawZ 中，包括 AI 生成工具。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在此版本中，Excalidraw 的更多工具已整合進 ExcalidrawZ，包括 AI 生成工具。"
          }
        }
      }
    },
