    "settingsAIMCPServiceModeComparisonBasicBestFor": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحافظ على توافق قريب مع العملاء الذين يدعمون بالفعل excalidraw-mcp."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hält enge Kompatibilität mit Klienten, die bereits excalidraw-mcp unterstützen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Best for clients that already support excalidraw-mcp and only need basic canvas generation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene una compatibilidad cercana con clientes que ya soportan excalidraw-mcp."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintient une compatibilité proche avec les clients qui prennent déjà en charge excalidraw-mcp."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उन ग्राहकों के साथ निकट संगतता बनाए रखता है जो पहले से excalidraw-mcp का समर्थन करते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene una compatibilità elevata con i clienti che supportano già excalidraw-mcp."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "excalidraw-mcpをすでにサポートしているクライアントとの互換性を保持します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 excalidraw-mcp를 지원하는 클라이언트와의 호환성을 유지합니다."
          }
        },
        "nl": {
