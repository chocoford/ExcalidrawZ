    "migrationSheetBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وصلت ExcalidrawZ إلى مرحلة جديدة—الإصدار الرسمي من النسخة 1.0. وقد تغيرت معرف التطبيق في الإصدار الجديد، لذا ستحتاج إلى تحميله يدويًا ونقل ملفاتك الحالية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ hat einen neuen Meilenstein erreicht—die offizielle Veröffentlichung von Version 1.0. Die neue Version hat die Anwendungs-ID geändert, sodass Sie sie manuell herunterladen und Ihre vorhandenen Dateien migrieren müssen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ has reached a new milestone—the official release of version 1.0. The new version has changed the application ID, so you will need to manually download it and migrate your existing files."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ ha alcanzado un nuevo hito: el lanzamiento oficial de la versión 1.0. La nueva versión ha cambiado el ID de la aplicación, por lo que necesitarás descargarla manualmente y migrar tus archivos existentes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ a atteint une nouvelle étape—la sortie officielle de la version 1.0. La nouvelle version a changé l'ID de l'application, vous devrez donc le télécharger manuellement et migrer vos fichiers existants."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ ने एक नए मील के पत्थर को हासिल किया है—संस्करण 1.0 का आधिकारिक रिलीज। नए संस्करण ने एप्लिकेशन आईडी को बदल दिया है, इसलिए आपको इसे मैन्युअल रूप से डाउनलोड करना होगा और अपनी मौजूदा फ़ाइलों को माइग्रेट करना होगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ ha raggiunto un nuovo traguardo—il rilascio ufficiale della versione 1.0. La nuova versione ha cambiato l'ID dell'applicazione, quindi dovrai scaricarla manualmente e migrare i tuoi file esistenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ は新たなマイルストーンに達しました—バージョン 1.0 の正式リリースです。新しいバージョンではアプリケーション ID が変更されたため、手動でダウンロードし、既存のファイルを移行する必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ가 새로운 이정표에 도달했습니다—버전 1.0의 공식 릴리스입니다. 새 버전은 애플리케이션 ID가 변경되었으므로, 수동으로 다운로드하고 기존 파일을 마이그레이션해야 합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ heeft een nieuwe mijlpaal bereikt—de officiële release van versie 1.0. De nieuwe versie heeft de applicatie-ID gewijzigd, dus je moet deze handmatig downloaden en je bestaande bestanden migreren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ osiągnęło nowy kamień milowy – oficjalne wydanie wersji 1.0. Nowa wersja zmieniła identyfikator aplikacji, więc będziesz musiał ręcznie ją pobrać i przenieść swoje istniejące pliki."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ alcançou um novo marco—o lançamento oficial da versão 1.0. A nova versão mudou o ID do aplicativo, então você precisará baixá-lo manualmente e migrar seus arquivos existentes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ достиг нового этапа — официального релиза версии 1.0. Новая версия изменила идентификатор приложения, поэтому вам нужно будет вручную загрузить её и мигрировать свои существующие файлы."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ ได้ก้าวเข้าสู่จุดสำคัญใหม่—การเปิดตัวอย่างเป็นทางการของเวอร์ชัน 1.0 เวอร์ชันใหม่ได้เปลี่ยนรหัสแอปพลิเคชัน ดังนั้นคุณจะต้องดาวน์โหลดด้วยตนเองและย้ายไฟล์ที่มีอยู่ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ yeni bir dönüm noktasına ulaştı—1.0 sürümünün resmi yayımlanması. Yeni sürüm uygulama kimliğini değiştirdi, bu nedenle manuel olarak indirip mevcut dosyalarınızı taşımak zorundasınız."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ đã đạt đến một cột mốc mới - phát hành chính thức phiên bản 1.0. Phiên bản mới đã thay đổi ID ứng dụng, vì vậy bạn sẽ cần tải xuống thủ công và di chuyển các tệp hiện có của mình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ迎来了新的里程碑--1.0版本正式发布。新版本更改了应用程序 ID，因此您需要手动下载并迁移现有文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ 已達到一個新里程碑——1.0 版本的官方發布。新版本更改了應用程序 ID，因此您需要手動下載它並遷移您的現有文件。"
          }
        }
      }
    },
