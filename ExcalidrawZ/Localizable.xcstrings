    "settingsAIMCPConnectionGuideMessage": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احتفظ بExcalidrawZ مفتوحًا مع خادم MCP ممكّن، ثم انسخ هذا تكوين في Claude أو أي عميل MCP آخر يدعم خوادم HTTP MCP."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halten Sie ExcalidrawZ mit aktiviertem MCP-Server geöffnet und kopieren Sie diese Konfiguration in Claude oder einen anderen MCP-Client, der HTTP MCP-Server unterstützt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep ExcalidrawZ open with the MCP server enabled, then copy this configuration into Claude or another MCP client that supports HTTP MCP servers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén ExcalidrawZ abierto con el servidor MCP habilitado, luego copia esta configuración en Claude u otro cliente MCP que soporte servidores HTTP MCP."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez ExcalidrawZ ouvert avec le serveur MCP activé, puis copiez cette configuration dans Claude ou un autre client MCP qui prend en charge les serveurs HTTP MCP."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ को चालू रखें और MCP सर्वर को सक्षम रखें, फिर इस कॉन्फ़िगरेशन को Claude या किसी दूसरे MCP क्लाइंट में कॉपी करें जो HTTP MCP सर्वरों का समर्थन करता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni aperto ExcalidrawZ con il server MCP attivato, quindi copia questa configurazione in Claude o in un altro client MCP che supporta i server HTTP MCP."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MCPサーバーを有効にしてExcalidrawZを開いたままにし、この設定をClaudeやHTTP MCPサーバーをサポートする他のMCPクライアントにコピーします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "MCP 서버가 활성화된 상태로 ExcalidrawZ를 열어두고, 이 구성을 Claude 또는 HTTP MCP 서버를 지원하는 다른 MCP 클라이언트에 복사하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd ExcalidrawZ geopend met de MCP-server ingeschakeld en kopieer deze configuratie naar Claude of een andere MCP-client die HTTP MCP-servers ondersteunt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utrzymaj otwarte ExcalidrawZ z włączonym serwerem MCP, a następnie skopiuj tę konfigurację do Claude'a lub innego klienta MCP, który obsługuje serwery HTTP MCP."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha o ExcalidrawZ aberto com o servidor MCP habilitado, e então copie esta configuração para o Claude ou outro cliente MCP que suporte servidores MCP HTTP."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Держите ExcalidrawZ открытым с включенным сервером MCP, затем скопируйте эту конфигурацию в Claude или другой клиент MCP, который поддерживает HTTP-серверы MCP."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ให้เปิด ExcalidrawZ พร้อมเซิร์ฟเวอร์ MCP เปิดอยู่ จากนั้นคัดลอกการตั้งค่านี้ไปยัง Claude หรือคลินต์ MCP อื่นที่รองรับเซิร์ฟเวอร์ HTTP MCP"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ açık kalsın ve MCP sunucusu etkin olsun, ardından bu yapılandırmayı Claude veya HTTP MCP sunucularını destekleyen başka bir MCP istemcisine kopyalayın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ cho ExcalidrawZ mở với máy chủ MCP được bật, sau đó sao chép cấu hình này vào Claude hoặc một khách hàng MCP khác hỗ trợ máy chủ HTTP MCP."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持 ExcalidrawZ 开放并启用 MCP 服务器，然后将此配置复制到 Claude 或其他支持 HTTP MCP 服务器的 MCP 客户端。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保持 ExcalidrawZ 開啟並啟用 MCP 伺服器，然後將此配置複製到 Claude 或其他支持 HTTP MCP 伺服器的 MCP 客戶端中。"
          }
        }
      }
    },
