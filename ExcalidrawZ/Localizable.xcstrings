    "lockedContentFeatureAIOutMessage": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تستطيع أدوات الذكاء الاصطناعي قراءة محتوى الملفات المقفلة، حتى لو تم فتحها لأجلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KI-Tools können den Inhalt gesperrter Dateien nicht lesen, selbst wenn sie für Sie entsperrt sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI tools cannot read locked file content, even while it is unlocked for you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las herramientas de IA no pueden leer el contenido del archivo bloqueado, incluso cuando está desbloqueado para usted."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les outils d'IA ne peuvent pas lire le contenu des fichiers verrouillés, même s'ils sont déverrouillés pour vous."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "AI उपकरण लॉक की गई फ़ाइल की सामग्री को नहीं पढ़ सकते, भले ही यह आपके लिए अनलॉक हो।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli strumenti AI non possono leggere il contenuto dei file bloccati, anche quando è sbloccato per te."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIツールは、あなたのためにロックが解除されていても、ロックされたファイルの内容を読むことができません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 도구는 잠금을 해제한 후에도 잠긴 파일의 내용을 읽을 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-tools kunnen geen vergrendelde bestand inhoud lezen, zelfs niet terwijl het voor u is ontgrendeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Narzędzia AI nie mogą odczytywać treści zablokowanych plików, nawet gdy są odblokowane dla ciebie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As ferramentas de IA não podem ler o conteúdo de arquivos bloqueados, mesmo quando estão desbloqueados para você."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Инструменты ИИ не могут читать содержимое зашифрованного файла, даже когда он разблокирован для вас."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เครื่องมือ AI ไม่สามารถอ่านเนื้อหาของไฟล์ที่ถูกล็อก แม้ว่าจะปลดล็อกให้คุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "AI araçları, içerik sizin için açılmış olsa bile kilitli dosya içeriğini okuyamaz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Công cụ AI không thể đọc nội dung tệp bị khóa, ngay cả khi nó được mở khóa cho bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 工具无法读取锁定文件内容，即使在解锁后。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即使對您解鎖，AI 工具也無法讀取鎖定文件的內容。"
          }
        }
      }
    },
