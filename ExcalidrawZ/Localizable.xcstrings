    "migrationSheetArchiveDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتصدير جميع الملفات واستيرادها إلى الإصدار الجديد من ExcalidrawZ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportieren Sie alle Dateien und importieren Sie sie in die neue Version von ExcalidrawZ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export all files and import them to the new version of ExcalidrawZ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporta todos los archivos e impórtalos a la nueva versión de ExcalidrawZ."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportez tous les fichiers et importez-les dans la nouvelle version d'ExcalidrawZ."
