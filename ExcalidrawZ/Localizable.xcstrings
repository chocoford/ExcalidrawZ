          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバックアップファイルは新しいサポートされていないバージョンのExcalidrawZによって作成されました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 백업 파일은 지원되지 않는 최신 버전의 ExcalidrawZ에 의해 생성되었습니다."
          }
        },
        "nl": {
          "stringUnit": {
