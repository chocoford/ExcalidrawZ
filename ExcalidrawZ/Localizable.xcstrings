    "WhatsNewItemFileLoadPerformanceDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من خلال تخزين ملفات الوسائط بشكل منفصل عن محتويات الملفات الأخرى، تم تحسين سرعة تحميل تبديل الملفات بشكل كبير."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durch die separate Speicherung von Mediendateien von anderen Dateiinhalten wurde die Ladegeschwindigkeit beim Dateiwwechsel erheblich verbessert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "By storing media files separately from other file contents, the file switching loading speed has been significantly improved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al almacenar archivos multimedia por separado de otros contenidos de archivo, se ha mejorado significativamente la velocidad de carga al cambiar de archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En stockant les fichiers multimédias séparément des autres contenus de fichiers, la vitesse de chargement lors du changement de fichier a été considérablement améliorée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मीडिया फ़ाइलों को अन्य फ़ाइल सामग्री से अलग रखते हुए, फ़ाइल स्विचिंग लोडिंग गति को काफी बेहतर किया गया है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Memorizzando i file multimediali separatamente dai contenuti di altri file, la velocità di caricamento del passaggio tra file è stata notevolmente migliorata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メディアファイルを他のファイル内容とは別に保存することにより、ファイル切り替えの読み込み速度が大幅に向上しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미디어 파일을 다른 파일 내용과 별도로 저장하여 파일 전환 로딩 속도가 크게 향상되었습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Door mediabestanden apart van andere bestandsinhoud op te slaan, is de laadsnelheid bij het wisselen van bestanden aanzienlijk verbeterd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poprzez przechowywanie plików multimedialnych oddzielnie od innych treści plików, szybkość ładowania przełączania plików została znacznie poprawiona."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao armazenar arquivos de mídia separadamente de outros conteúdos de arquivo, a velocidade de carregamento ao alternar arquivos foi significativamente melhorada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хранение медиафайлов отдельно от других содержаний файлов значительно улучшило скорость загрузки при переключении файлов."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โดยการจัดเก็บไฟล์มัลติมีเดียแยกต่างหากจากเนื้อหาไฟล์อื่นๆ ความเร็วในการโหลดเมื่อสลับไฟล์ได้ถูกปรับปรุงอย่างมีนัยสำคัญ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Medya dosyalarını diğer dosya içeriklerinden ayrı depolayarak, dosya geçiş yükleme hızı önemli ölçüde artırılmıştır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bằng cách lưu trữ các tệp media riêng biệt khỏi nội dung tệp khác, tốc độ tải khi chuyển đổi giữa các tệp đã được cải thiện đáng kể."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过将媒体文件与其他文件内容分开存储，文件切换的加载速度得到了显著提升。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通過將媒體文件與其他文件內容分開存儲，文件切換的加載速度得到了顯著提高。"
          }
        }
      }
    },
