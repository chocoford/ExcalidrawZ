    "whatsNewSubgroupsSupportDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نظم مساحة عملك بشكل أفضل من أي وقت مضى من خلال إضافة مجموعات فرعية ومجلدات فرعية داخل كل مجموعة أو مجلد. ابقَ منظمًا، بسهولة!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Organisieren Sie Ihren Arbeitsbereich besser denn je, indem Sie Untergruppen und Unterordner innerhalb jeder Gruppe oder jedes Ordners hinzufügen. Bleiben Sie mühelos strukturiert!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Organize your workspace better than ever by adding subgroups and subfolders within each group or folder. Stay structured, effortlessly!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Organiza tu espacio de trabajo mejor que nunca añadiendo subgrupos y subcarpetas dentro de cada grupo o carpeta. ¡Mantente estructurado, sin esfuerzo!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Organisez votre espace de travail mieux que jamais en ajoutant des sous-groupes et des sous-dossiers dans chaque groupe ou dossier. Restez structuré, sans effort !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रत्येक समूह या फ़ोल्डर के भीतर उप-समूह और उप-फ़ोल्डर जोड़कर अपने कार्यक्षेत्र को पहले से बेहतर व्यवस्थित करें। बिना किसी प्रयास के संरचित रहें!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Organizza il tuo spazio di lavoro meglio che mai aggiungendo sottogruppi e sottocartelle all'interno di ciascun gruppo o cartella. Rimani strutturato, senza sforzo!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各グループやフォルダ内にサブグループやサブフォルダを追加して、作業スペースをこれまで以上に整理しましょう。簡単に構造を保ちます！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 그룹이나 폴더 내에서 하위 그룹과 하위 폴더를 추가하여 작업 공간을 그 어느 때보다 잘 조직하세요. 수월하게 구조를 유지하세요!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Organiseer je werkruimte beter dan ooit door subgroepen en submappen binnen elke groep of map toe te voegen. Blijf moeiteloos gestructureerd!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lepsza organizacja przestrzeni roboczej dzięki dodawaniu podgrup i podfolderów w każdej grupie lub folderze. Zachowaj porządek, bez wysiłku!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Organize seu espaço de trabalho melhor do que nunca, adicionando subgrupos e subpastas dentro de cada grupo ou pasta. Mantenha-se estruturado, sem esforço!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Организуйте свое рабочее пространство лучше, чем когда-либо, добавляя подгруппы и подпапки в каждой группе или папке. Поддерживайте структуру без усилий!"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จัดระเบียบพื้นที่ทำงานของคุณได้ดีกว่าเคยโดยการเพิ่มกลุ่มย่อยและโฟลเดอร์ย่อยภายในแต่ละกลุ่มหรือโฟลเดอร์ เพื่อการจัดระเบียบที่ไม่ยุ่งยาก!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her grup veya klasör içinde alt gruplar ve alt klasörler ekleyerek çalışma alanınızı hiç olmadığı kadar iyi organize edin. Yapıyı koruyun, zahmetsizce!"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tổ chức không gian làm việc của bạn tốt hơn bao giờ hết bằng cách thêm nhóm phụ và thư mục con trong mỗi nhóm hoặc thư mục. Giữ sự ngăn nắp, một cách dễ dàng!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
