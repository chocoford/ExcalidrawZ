    "archiveFilesDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تصدير ملفات قاعدة البيانات كملفات .excalidraw عادية يمكن فتحها خارج ExcalidrawZ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Datenbankdateien als reguläre .excalidraw-Dateien exportieren, die außerhalb von ExcalidrawZ geöffnet werden können."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export database files as regular .excalidraw files that can be opened outside ExcalidrawZ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportar archivos de base de datos como archivos .excalidraw regulares que pueden abrirse fuera de ExcalidrawZ."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporter les fichiers de base de données en tant que fichiers .excalidraw réguliers pouvant être ouverts en dehors d'ExcalidrawZ."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डेटाबेस फ़ाइलों को नियमित .excalidraw फ़ाइलों के रूप में निर्यात करें जिन्हें ExcalidrawZ के बाहर खोला जा सकता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esporta i file del database come normali file .excalidraw che possono essere aperti al di fuori di ExcalidrawZ."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データベースファイルを、ExcalidrawZの外で開ける普通の.excalidrawファイルとしてエクスポートします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터베이스 파일을 일반 .excalidraw 파일로 내보내어 ExcalidrawZ 외부에서 열 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporteer databasebestanden als reguliere .excalidraw-bestanden die buiten ExcalidrawZ kunnen worden geopend."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksportowanie plików bazy danych jako zwykłych plików .excalidraw, które można otworzyć poza ExcalidrawZ."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporte arquivos do banco de dados como arquivos .excalidraw regulares que podem ser abertos fora do ExcalidrawZ."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экспортировать файлы базы данных как обычные .excalidraw файлы, которые можно открыть вне ExcalidrawZ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งออกไฟล์ฐานข้อมูลเป็นไฟล์ .excalidraw ปกติที่สามารถเปิดนอก ExcalidrawZ ได้."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veritabanı dosyalarını, ExcalidrawZ dışında açılabilecek normal .excalidraw dosyaları olarak dışa aktarın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xuất các tệp cơ sở dữ liệu dưới dạng tệp .excalidraw thông thường có thể được mở bên ngoài ExcalidrawZ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将数据库文件导出为常规 .excalidraw 文件，以便在 ExcalidrawZ 外部打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將資料庫檔案導出為普通 .excalidraw 檔案，可以在 ExcalidrawZ 之外打開。"
          }
        }
      }
