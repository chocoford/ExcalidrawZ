    "whatsNewMCPServicesDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توصيل ExcalidrawZ بعملاء MCP. الوضع الأساسي يتطابق مع excalidraw-mcp، بينما الوضع المحسن يمكنه تحرير الملفات، وفحص اللوحة، واستخدام المكتبات، وتصدير النتائج."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinden Sie ExcalidrawZ mit MCP-Clients. Der Basismodus entspricht excalidraw-mcp, während der optimierte Modus Dateien bearbeiten, die Leinwand inspizieren, Bibliotheken verwenden und Ergebnisse exportieren kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect ExcalidrawZ to MCP clients. Basic mode matches excalidraw-mcp, while Optimized mode can edit files, inspect the canvas, use libraries, and export results."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta ExcalidrawZ a clientes MCP. El modo básico coincide con excalidraw-mcp, mientras que el modo Optimizado puede editar archivos, inspeccionar el lienzo, usar bibliotecas y exportar resultados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez ExcalidrawZ aux clients MCP. Le mode de base correspond à excalidraw-mcp, tandis que le mode Optimisé permet d'éditer des fichiers, d'inspecter la toile, d'utiliser des bibliothèques et d'exporter des résultats."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ को MCP क्लाइंट्स से कनेक्ट करें। बेसिक मोड excalidraw-mcp से मेल खाता है, जबकि ऑप्टिमाइज़्ड मोड फ़ाइलों को संपादित कर सकता है, कैनवास की जांच कर सकता है, लाइब्रेरी का उपयोग कर सकता है, और परिणामों का निर्यात कर सकता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Collega ExcalidrawZ ai client MCP. La modalità base corrisponde a excalidraw-mcp, mentre la modalità Ottimizzata può modificare file, ispezionare la tela, utilizzare librerie ed esportare risultati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZをMCPクライアントに接続します。基本モードはexcalidraw-mcpに一致し、最適化モードではファイルを編集したり、キャンバスを検査したり、ライブラリを使用したり、結果をエクスポートしたりできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ를 MCP 클라이언트에 연결하세요. 기본 모드는 excalidraw-mcp와 일치하며, 최적화된 모드는 파일 편집, 캔버스 검사, 라이브러리 사용 및 결과 내보내기가 가능합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbind ExcalidrawZ met MCP-klanten. De basismodus komt overeen met excalidraw-mcp, terwijl de geoptimaliseerde modus bestanden kan bewerken, het canvas kan inspecteren, bibliotheken kan gebruiken en resultaten kan exporteren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podłącz ExcalidrawZ do klientów MCP. Tryb podstawowy odpowiada excalidraw-mcp, podczas gdy tryb zoptymalizowany może edytować pliki, inspekcjonować płótno, korzystać z bibliotek i eksportować wyniki."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte o ExcalidrawZ aos clientes MCP. O modo básico combina com excalidraw-mcp, enquanto o modo otimizado pode editar arquivos, inspecionar o canvas, usar bibliotecas e exportar resultados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Соедините ExcalidrawZ с клиентами MCP. Базовый режим соответствует excalidraw-mcp, в то время как Оптимизированный режим может редактировать файлы, проверять холст, использовать библиотеки и экспортировать результаты."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่อ ExcalidrawZ กับลูกค้า MCP โหมดพื้นฐานตรงกับ excalidraw-mcp ขณะที่โหมดที่ปรับแต่งแล้วสามารถแก้ไขไฟล์ ตรวจสอบผืนผ้าใบ ใช้ไลบรารี และส่งออกผลลัพธ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ'yi MCP istemcilerine bağlayın. Temel mod excalidraw-mcp ile eşleşir, Optimize edilmiş mod ise dosyaları düzenleyebilir, tuvali inceleyebilir, kütüphaneleri kullanabilir ve sonuçları dışa aktarabilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết nối ExcalidrawZ với các khách hàng MCP. Chế độ cơ bản tương ứng với excalidraw-mcp, trong khi chế độ Tối ưu hóa có thể chỉnh sửa tệp, kiểm tra canvas, sử dụng thư viện và xuất kết quả."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 ExcalidrawZ 连接到 MCP 客户端。基本模式与 excalidraw-mcp 匹配，而优化模式则可以编辑文件、检查画布、使用库和导出结果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將 ExcalidrawZ 連接到 MCP 客戶端。基本模式匹配 excalidraw-mcp，而優化模式則可以編輯文件、檢查畫布、使用庫和導出結果。"
          }
        }
      }
    },
