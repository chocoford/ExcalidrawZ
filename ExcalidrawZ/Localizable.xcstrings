    "paywallFeatureMCPMessage": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يدعم MCP الأساسي توصيلًا مع excalidraw-mcp، بحيث يمكن للتطبيقات الذكية المتوافقة الرسم في ExcalidrawZ بنفس تدفق الأدوات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die grundlegende MCP-Unterstützung spiegelt excalidraw-mcp wider, sodass kompatible KI-Apps mit demselben Werkzeugfluss in ExcalidrawZ zeichnen können."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Basic MCP support mirrors excalidraw-mcp, so compatible AI apps can draw into ExcalidrawZ with the same tool flow."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El soporte básico de MCP refleja excalidraw-mcp, por lo que las aplicaciones de IA compatibles pueden dibujar en ExcalidrawZ con el mismo flujo de herramientas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le support de base de MCP reflète excalidraw-mcp, de sorte que les applications d'IA compatibles peuvent dessiner dans ExcalidrawZ avec le même flux d'outils."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बुनियादी MCP समर्थन excalidraw-mcp को मिरर करता है, ताकि संगत AI ऐप्स एक ही उपकरण प्रवाह के साथ ExcalidrawZ में चित्र बना सकें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il supporto MCP di base rispecchia excalidraw-mcp, quindi le app AI compatibili possono disegnare in ExcalidrawZ con lo stesso flusso di strumenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "基本的なMCPサポートはexcalidraw-mcpを反映しているため、互換性のあるAIアプリは同じツールフローでExcalidrawZに描画できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 MCP 지원은 excalidraw-mcp를 기반으로 하며, 호환 가능한 AI 앱이 동일한 도구 흐름으로 ExcalidrawZ에 그릴 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Basis MCP-ondersteuning weerspiegelt excalidraw-mcp, zodat compatibele AI-apps met dezelfde toolflow in ExcalidrawZ kunnen tekenen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podstawowe wsparcie MCP odwzorowuje excalidraw-mcp, dzięki czemu kompatybilne aplikacje AI mogą rysować w ExcalidrawZ z tym samym przepływem narzędzi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O suporte básico do MCP espelha o excalidraw-mcp, para que aplicativos de IA compatíveis possam desenhar no ExcalidrawZ com o mesmo fluxo de ferramenta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Базовая поддержка MCP отражает excalidraw-mcp, так что совместимые AI приложения могут рисовать в ExcalidrawZ с тем же рабочим процессом инструментов."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การสนับสนุน MCP เบื้องต้นสะท้อน excalidraw-mcp ดังนั้นแอป AI ที่เข้ากันได้สามารถวาดใน ExcalidrawZ ด้วยกระบวนการเครื่องมือเดียวกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temel MCP desteği, uyumlu AI uygulamalarının aynı araç akışı ile ExcalidrawZ'ye çizim yapabilmesine olanak tanır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hỗ trợ MCP cơ bản giống như excalidraw-mcp, vì vậy các ứng dụng AI tương thích có thể vẽ vào ExcalidrawZ với cùng quy trình công cụ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "基本的 MCP 支持与 excalidraw-mcp 一致，因此兼容的 AI 应用可以通过相同的工具流程在 ExcalidrawZ 中绘制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "基本的 MCP 支援與 excalidraw-mcp 鏈接，因此相容的 AI 應用可以使用相同的工具流程繪製到 ExcalidrawZ。"
          }
        }
      }
    },
