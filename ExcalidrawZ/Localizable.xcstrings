    "migrationPhaseidleWithPendingSubtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نحتاج إلى تحديث بياناتك لتتوافق مع أحدث إصدار. يمكنك أولاً أرشفة ملفاتك للحفاظ على سلامتها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir müssen Ihre Daten aktualisieren, damit sie mit der neuesten Version funktionieren. Sie können zur Sicherheit zuerst Ihre Dateien archivieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We need to update your data to work with the latest version. You can archive your files first for safety."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesitamos actualizar sus datos para que funcionen con la versión más reciente. Puede archivar sus archivos primero por seguridad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous devons mettre à jour vos données pour qu'elles fonctionnent avec la dernière version. Vous pouvez d'abord archiver vos fichiers pour plus de sécurité."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हमें आपके डेटा को नवीनतम संस्करण के साथ काम करने के लिए अपडेट करना होगा। सुरक्षा के लिए आप पहले अपनी फाइलें आर्काइव कर सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dobbiamo aggiornare i tuoi dati per renderli compatibili con l'ultima versione. Puoi archiviare i tuoi file prima, per sicurezza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最新バージョンで動作させるためにデータを更新する必要があります。安全のため、先にファイルをアーカイブすることをおすすめします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최신 버전과 호환되도록 데이터를 업데이트해야 합니다. 안전을 위해 먼저 파일을 백업할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We moeten uw gegevens bijwerken zodat ze compatibel zijn met de nieuwste versie. U kunt uw bestanden voor de zekerheid eerst archiveren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Musimy zaktualizować Twoje dane, aby działały z najnowszą wersją. Dla bezpieczeństwa możesz najpierw zarchiwizować pliki."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Precisamos atualizar seus dados para que funcionem com a versão mais recente. Você pode arquivar seus arquivos antes, por segurança."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нам нужно обновить ваши данные, чтобы они работали с последней версией. Для безопасности вы можете сначала заархивировать файлы."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เราจำเป็นต้องอัปเดตข้อมูลของคุณเพื่อให้สามารถทำงานกับเวอร์ชันล่าสุด คุณสามารถสำรองไฟล์ก่อนเพื่อความปลอดภัย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verilerinizin en son sürümle uyumlu olması için güncelleme yapmamız gerekiyor. Güvenlik için önce dosyalarınızı arşivleyebilirsiniz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng tôi cần cập nhật dữ liệu của bạn để tương thích với phiên bản mới nhất. Bạn có thể lưu trữ các tệp trước để đảm bảo an toàn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们需要更新您的数据以适配最新版本。为安全起见，您可以先将文件归档。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我們需要更新您的資料以配合最新版本。為安全起見，您可以先將檔案封存。"
          }
        }
      }
    },
