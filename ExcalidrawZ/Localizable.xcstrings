      }
    },
    "settingsMediaCleanupHistoryOnlyDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These items are no longer used by the current file, but are still required by file history. Cleaning them also deletes every checkpoint that references them."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些媒体已不再被当前文件使用，但文件历史仍需要它们。清理时也会删除所有引用它们的检查点。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些媒體已不再被目前檔案使用，但檔案歷史仍需要它們。清理時也會刪除所有參考它們的檢查點。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تعد هذه العناصر مستخدمة بواسطة الملف الحالي، ولكنها لا تزال مطلوبة لتاريخ الملف. تنظيفها سيؤدي أيضًا إلى حذف كل نقطة فحص تشير إليها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Elemente werden von der aktuellen Datei nicht mehr verwendet, sind jedoch weiterhin für den Datei Verlauf erforderlich. Das Löschen dieser Elemente entfernt auch jeden Kontrollpunkt, der sich auf sie bezieht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos elementos ya no son utilizados por el archivo actual, pero todavía son necesarios para el historial de archivos. Limpiarlos también elimina cada punto de control que los hace referencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces éléments ne sont plus utilisés par le fichier actuel, mais sont toujours nécessaires pour l'historique des fichiers. Les nettoyer supprime également chaque point de contrôle qui les référence."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ये आइटम वर्तमान फ़ाइल द्वारा अब उपयोग में नहीं हैं, लेकिन फ़ाइल इतिहास द्वारा अभी भी आवश्यक हैं। इन्हें साफ करने से उन सभी चेकपॉइंट्स को भी हटा दिया जाएगा जो उन पर संदर्भित हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questi elementi non sono più utilizzati dal file attuale, ma sono ancora richiesti dalla cronologia dei file. Pulirli elimina anche ogni checkpoint che li riferisce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのアイテムは現在のファイルで使用されていませんが、ファイルの履歴にはまだ必要です。それらをクリーンアップすると、それらを参照するすべてのチェックポイントも削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 항목은 현재 파일에서 더 이상 사용되지 않지만 파일 이력에는 여전히 필요합니다. 이를 정리하면 이를 참조하는 모든 체크포인트도 삭제됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze items worden niet meer gebruikt door het huidige bestand, maar zijn nog steeds vereist door de bestandsgeschiedenis. Het schoonmaken hiervan verwijdert ook elke checkpoint die naar hen verwijst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te elementy nie są już używane przez bieżący plik, ale są nadal wymagane przez historię plików. Ich usunięcie również usuwa każdy punkt kontrolny, który się do nich odnosi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Estes itens não são mais usados pelo arquivo atual, mas ainda são necessários pelo histórico de arquivos. Limpá-los também exclui todos os pontos de verificação que os referenciam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти элементы больше не используются текущим файлом, но все еще необходимы для истории файлов. Их очистка также удаляет каждую контрольную точку, которая ссылается на них."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายการเหล่านี้ไม่ได้ถูกใช้งานโดยไฟล์ปัจจุบัน แต่ยังคงจำเป็นต่อประวัติไฟล์ การทำความสะอาดพวกเขาจะลบจุดตรวจทั้งหมดที่อ้างถึงพวกเขา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu öğeler mevcut dosya tarafından artık kullanılmıyor, ancak dosya geçmişi için hâlâ gereklidir. Bunları temizlemek, onlara atıfta bulunan her kontrol noktasını da siler."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các mục này không còn được sử dụng bởi tệp hiện tại, nhưng vẫn cần thiết cho lịch sử tệp. Dọn dẹp chúng cũng sẽ xóa mọi điểm kiểm tra tham chiếu đến chúng."
          }
        }
      }
    },
    "settingsMediaCleanupHistoryConfirmationMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You selected %1$d media items used by %2$d checkpoints. Continuing will permanently delete those checkpoints and the selected media. This cannot be undone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你选择了 %1$d 个仅被 %2$d 个检查点引用的媒体项。继续操作将永久删除这些检查点及所选媒体，且无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你選擇了 %1$d 個僅被 %2$d 個檢查點參考的媒體項目。繼續操作將永久刪除這些檢查點及所選媒體，且無法復原。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد قمت باختيار %1$d عنصر وسائط مستخدم بواسطة %2$d نقاط فحص. سيؤدي الاستمرار إلى حذف تلك النقاط المحددة والوسائط بشكل دائم. لا يمكن التراجع عن ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie haben %1$d Mediendateien ausgewählt, die von %2$d Kontrollpunkten verwendet werden. Das Fortfahren löscht dauerhaft diese Kontrollpunkte und die ausgewählten Medien. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleccionaste %1$d elementos multimedia usados por %2$d puntos de control. Continuar eliminará permanentemente esos puntos de control y los medios seleccionados. Esto no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez sélectionné %1$d éléments multimédias utilisés par %2$d points de contrôle. Continuer supprimera définitivement ces points de contrôle et le média sélectionné. Ceci ne peut pas être annulé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपने %1$d मीडिया आइटम का चयन किया है जो %2$d चेकपॉइंट द्वारा उपयोग में है। आगे बढ़ने पर उन चेकपॉइंट्स और चुनी गई मीडिया को स्थायी रूप से हटा दिया जाएगा। इसे पूर्ववत नहीं किया जा सकता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai selezionato %1$d elementi multimediali utilizzati da %2$d checkpoint. Continuare comporterà l'eliminazione permanente di quei checkpoint e dei media selezionati. Questa operazione non può essere annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたは %1$d のメディアアイテムを %2$d のチェックポイントで選択しました。続行すると、それらのチェックポイントと選択したメディアが永久に削除されます。これは元に戻せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "당신은 %1$d 개의 미디어 항목이 %2$d 개의 체크포인트에 사용되고 있음을 선택했습니다. 계속 진행하면 해당 체크포인트와 선택된 미디어가 영구적으로 삭제됩니다. 이는 되돌릴 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "U heeft %1$d media-items geselecteerd die door %2$d checkpoints worden gebruikt. Voortzetten zal die checkpoints en de geselecteerde media permanent verwijderen. Dit kan niet ongedaan gemaakt worden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybrałeś %1$d elementów multimedialnych używanych przez %2$d punktów kontrolnych. Kontynuowanie spowoduje trwałe usunięcie tych punktów kontrolnych i wybranych mediów. Tego nie można cofnąć."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você selecionou %1$d itens de mídia usados por %2$d pontos de verificação. Continuar irá excluir permanentemente esses pontos de verificação e a mídia selecionada. Isso não pode ser desfeito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы выбрали %1$d медиа-элементов, используемых %2$d контрольными точками. Продолжение приведет к навсегда удалению этих контрольных точек и выбранных медиа. Это действие нельзя отменить."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณเลือกมีเดีย %1$d รายการที่ใช้โดยจุดตรวจ %2$d จุด การดำเนินการต่อจะลบจุดตรวจเหล่านั้นและมีเดียที่เลือกอย่างถาวร ซึ่งไม่สามารถทำการย้อนกลับได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d medya öğesi ve %2$d kontrol noktası seçtiniz. Devam etmek, bu kontrol noktalarını ve seçilen medyayı kalıcı olarak silecektir. Bu geri alınamaz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã chọn %1$d mục phương tiện được sử dụng bởi %2$d điểm kiểm tra. Tiếp tục sẽ xóa vĩnh viễn các điểm kiểm tra đó và các phương tiện đã chọn. Điều này không thể được khôi phục."
          }
        }
      }
    },
