    "aiChatWelcomeFeatureBrowseSubtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابحث عن الأعمال السابقة وقم بسحب العناصر من المكتبة - بموافقتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Finden Sie frühere Arbeiten und ziehen Sie Bibliothekselemente hinzu – mit Ihrer Genehmigung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find prior work and pull in library items — with your permission."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuentra trabajos anteriores y agrega elementos de la biblioteca — con tu permiso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouvez des travaux antérieurs et incorporez des éléments de la bibliothèque — avec votre permission."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूर्व के कार्यों को खोजें और लाइब्रेरी की वस्तुओं को लाएं - आपकी अनुमति से।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trova lavori precedenti e importa elementi dalla libreria - con il tuo permesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "過去の作業を見つけ、ライブラリアイテムを取り込む — あなたの許可のもとで。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 작업을 찾고 라이브러리 항목을 가져옵니다 — 귀하의 동의 하에."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoek eerder werk en haal bibliotheekitems op — met jouw toestemming."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Znajdź wcześniejsze prace i przynieś elementy z biblioteki — za Twoją zgodą."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontre trabalhos anteriores e adicione itens da biblioteca — com sua permissão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Найдите свою предыдущую работу и добавьте элементы из библиотеки — с вашего разрешения."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค้นหางานก่อนหน้าและดึงรายการในห้องสมุด - โดยมีการอนุญาตจากคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önceki çalışmaları bulun ve kütüphane öğelerini getirin — izninizle."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tìm công việc trước đây và nhập các mục từ thư viện - với sự cho phép của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找到之前的工作并在您的允许下提取库项目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "查找之前的作品並提取庫項目 - 在您的允許下。"
          }
        }
      }
    },
