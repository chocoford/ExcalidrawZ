    "whatsNewCanvasPreferencesDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضبط وضع Zen، وضع العرض، الشبكة، سلوك الالتقاط، ولون خلفية اللوحة من مكان واحد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zen-Modus, Ansichtsmodus, Raster, Einrastverhalten und die Hintergrundfarbe der Leinwand an einem Ort anpassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjust zen mode, view mode, grid, snap behavior, and the canvas background color from one place."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta el modo zen, el modo de vista, la cuadrícula, el comportamiento de ajuste y el color de fondo del lienzo desde un solo lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustez le mode zen, le mode d'affichage, la grille, le comportement d'accrochage et la couleur de fond du canevas en un seul endroit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक ही स्थान से ज़ेन मोड, व्यू मोड, ग्रिड, स्नैप व्यवहार और कैनवास की पृष्ठभूमि का रंग समायोजित करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Regola la modalità zen, la modalità di visualizzazione, la griglia, il comportamento dello snap e il colore di sfondo del canvas da un unico punto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Zenモード、表示モード、グリッド、スナップの挙動、キャンバスの背景色を一か所で調整できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 곳에서 젠 모드, 보기 모드, 격자, 스냅 동작 및 캔버스 배경색을 조정하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas zen-modus, weergavemodus, raster, snapgedrag en de achtergrondkleur van het canvas op één plek aan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostosuj tryb zen, tryb widoku, siatkę, zachowanie przyciągania oraz kolor tła płótna w jednym miejscu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste o modo zen, o modo de visualização, a grade, o comportamento de encaixe e a cor de fundo do canvas em um só lugar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройте режим Zen, режим просмотра, сетку, поведение привязки и цвет фона холста в одном месте."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปรับโหมด Zen, โหมดการแสดงผล, กริด, พฤติกรรมการจับตำแหน่ง (snap) และสีพื้นหลังของแคนวาสได้จากที่เดียว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zen modunu, görüntüleme modunu, ızgarayı, yapışma davranışını ve tuval arka plan rengini tek bir yerden ayarlayın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điều chỉnh chế độ Zen, chế độ xem, lưới, hành vi bắt điểm và màu nền khung vẽ từ một nơi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在一个位置调整禅模式、视图模式、网格、吸附行为和画布背景颜色。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從一處調整禪模式、檢視模式、格線、吸附行為與畫布背景色。"
          }
        }
      }
    },
