    "paywallPlanFreeDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استمتع بأغلب ميزات التطبيق القوية مجانًا. مثالي للاستخدام الشخصي والتعاون العرضي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Genießen Sie die meisten leistungsstarken Funktionen der App kostenlos. Perfekt für den persönlichen Gebrauch und gelegentliche Zusammenarbeit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enjoy most of the app's powerful features for free. Perfect for personal use and occasional collaboration."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Disfruta de la mayoría de las potentes funciones de la app de forma gratuita. Perfecto para uso personal y colaboración ocasional."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profitez de la plupart des fonctionnalités puissantes de l'application gratuitement. Parfait pour un usage personnel et une collaboration occasionnelle."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप की अधिकांश शक्तिशाली सुविधाओं का मुफ्त में आनंद लें। व्यक्तिगत उपयोग और कभी-कभार सहयोग के लिए उत्तम।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Goditi la maggior parte delle potenti funzionalità dell'app gratuitamente. Perfetto per uso personale e collaborazione occasionale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリの強力な機能のほとんどを無料で楽しめます。個人使用や時折のコラボレーションに最適です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대부분의 앱의 강력한 기능을 무료로 즐기세요. 개인 사용 및 가끔 협업에 적합합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geniet van de meeste krachtige functies van de app gratis. Perfect voor persoonlijk gebruik en af en toe samenwerking."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciesz się większością potężnych funkcji aplikacji za darmo. Idealne do użytku osobistego i okazjonalnej współpracy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aproveite a maioria dos poderosos recursos do aplicativo gratuitamente. Perfeito para uso pessoal e colaboração ocasional."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пользуйтесь большинством мощных функций приложения бесплатно. Идеально для личного использования и случайного сотрудничества."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สนุกกับฟีเจอร์ที่ทรงพลังของแอพส่วนใหญ่ได้ฟรี เหมาะสำหรับการใช้งานส่วนตัวและการทำงานร่วมกันเป็นครั้งคราว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamanın güçlü özelliklerinin çoğundan ücretsiz olarak yararlanın. Kişisel kullanım ve ara sıra iş birliği için mükemmel."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tận hưởng hầu hết các tính năng mạnh mẽ của ứng dụng miễn phí. Hoàn hảo cho việc sử dụng cá nhân và hợp tác thỉnh thoảng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "免费享受应用程序大部分强大功能。非常适合个人使用和偶尔协作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "免費享受應用程序大多數強大功能。非常適合個人使用和偶爾合作。"
          }
        }
      }
    },
