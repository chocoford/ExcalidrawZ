    "paywallSwitchToAppStoreStep2Description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نسخة ExcalidrawZ من متجر التطبيقات لا تحتوي فقط على أي قيود في الميزات مقارنةً بالنسخة غير المتوفرة في المتجر، بل تقدم أيضًا تجربة تطبيق أفضل، بما في ذلك التحديثات التلقائية وعملية دفع أكثر أمانًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App-Store-Version von ExcalidrawZ hat nicht nur keine Funktionsbeschränkungen im Vergleich zur Nicht-App-Store-Version, sondern bietet auch ein besseres App-Erlebnis, einschließlich automatischer Updates und eines sichereren Zahlungsprozesses."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The App Store version of ExcalidrawZ not only doesn't have any feature limitations compared to the non-App Store version, but it also offers a better app experience, including automatic updates and a more secure payment process."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La versión de ExcalidrawZ en la App Store no solo no tiene limitaciones de características en comparación con la versión que no está en la App Store, sino que también ofrece una mejor experiencia de aplicación, incluyendo actualizaciones automáticas y un proceso de pago más seguro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La version App Store d'ExcalidrawZ n'a non seulement aucune limitation de fonctionnalités par rapport à la version non-App Store, mais elle offre également une meilleure expérience utilisateur, y compris des mises à jour automatiques et un processus de paiement plus sécurisé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ का ऐप स्टोर संस्करण न केवल गैर-ऐप स्टोर संस्करण की तुलना में किसी भी फीचर की सीमाओं में नहीं है, बल्कि यह स्वचालित अपडेट और एक अधिक सुरक्षित भुगतान प्रक्रिया सहित बेहतर ऐप अनुभव भी प्रदान करता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La versione di ExcalidrawZ per l'App Store non ha alcuna limitazione di funzionalità rispetto alla versione non App Store, ma offre anche un'esperienza dell'app migliore, inclusi aggiornamenti automatici e un processo di pagamento più sicuro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZのApp Store版は、非App Store版と比べて機能制限がないだけでなく、自動更新やより安全な支払いプロセスを含む、より良いアプリ体験を提供します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ의 App Store 버전은 비-App Store 버전에 비해 기능 제한이 없을 뿐만 아니라, 자동 업데이트 및 더 안전한 결제 프로세스를 포함하여 더 나은 앱 경험을 제공합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De App Store-versie van ExcalidrawZ heeft niet alleen geen functiebeperkingen in vergelijking met de niet-App Store-versie, maar biedt ook een betere app-ervaring, inclusief automatische updates en een veiliger betalingsproces."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wersja ExcalidrawZ w App Store nie tylko nie ma żadnych ograniczeń funkcjonalnych w porównaniu do wersji bez App Store, ale także oferuje lepsze doświadczenie aplikacji, w tym automatyczne aktualizacje i bezpieczniejszy proces płatności."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A versão do ExcalidrawZ na App Store não só não tem limitações de recursos em comparação com a versão fora da App Store, mas também oferece uma melhor experiência de aplicativo, incluindo atualizações automáticas e um processo de pagamento mais seguro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Версия ExcalidrawZ для App Store не только не имеет ограничений по функционалу по сравнению с версией вне App Store, но и предлагает лучший опыт использования приложения, включая автоматические обновления и более безопасный процесс оплаты."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เวอร์ชัน App Store ของ ExcalidrawZ ไม่เพียงแต่ไม่มีข้อจำกัดด้านฟีเจอร์เมื่อเปรียบเทียบกับเวอร์ชันที่ไม่ใช่ App Store แต่ยังมอบประสบการณ์การใช้งานแอปที่ดีกว่า รวมถึงการอัปเดตอัตโนมัติและกระบวนการชำระเงินที่ปลอดภัยยิ่งขึ้น."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ'nin App Store versiyonu, App Store dışındaki versiyonla kıyaslandığında hiçbir özellik kısıtlamasına sahip değildir ve ayrıca otomatik güncellemeler ve daha güvenli bir ödeme süreci dahil olmak üzere daha iyi bir uygulama deneyimi sunar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiên bản ExcalidrawZ trên App Store không chỉ không có giới hạn tính năng so với phiên bản không phải App Store, mà còn cung cấp trải nghiệm ứng dụng tốt hơn, bao gồm cập nhật tự động và quy trình thanh toán an toàn hơn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与非 App Store 版本相比，ExcalidrawZ 的 App Store 版本不仅没有任何功能限制，还提供了更好的应用体验，包括自动更新和更安全的支付流程。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ 的 App Store 版本不僅在功能上與非 App Store 版本沒有任何限制，還提供更好的應用體驗，包括自動更新和更安全的付款流程。"
          }
        }
      }
    },
