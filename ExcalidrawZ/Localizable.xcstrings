        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يشغل التطبيق الآن مساحة أقل بكثير، مع تقليص الحجم بنحو %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App belegt jetzt deutlich weniger Speicherplatz – etwa %@ weniger."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app now takes up significantly less space, with roughly a %@ size reduction."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La aplicación ahora ocupa significativamente menos espacio, con una reducción de aproximadamente %@ en el tamaño."
