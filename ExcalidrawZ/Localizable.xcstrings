    "migrationAttentionContent": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تقم أبداً بتحميل إصدار جديد من ExcalidrawZ دون تصدير ملفاتك أولاً، أو ستفقد بياناتك الحالية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laden Sie niemals eine neue Version von ExcalidrawZ herunter, ohne Ihre Dateien zuerst zu exportieren, da Sie sonst Ihre vorhandenen Daten verlieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Never download a new version of ExcalidrawZ without exporting your files first, or you will lose your existing data."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca descargues una nueva versión de ExcalidrawZ sin exportar tus archivos primero, o perderás tus datos existentes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne téléchargez jamais une nouvelle version d'ExcalidrawZ sans d'abord exporter vos fichiers, sinon vous perdrez vos données existantes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने फ़ाइलों का निर्यात किए बिना ExcalidrawZ का नया संस्करण कभी न डाउनलोड करें, अन्यथा आप अपने मौजूदा डेटा को खो देंगे।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non scaricare mai una nuova versione di ExcalidrawZ senza prima esportare i tuoi file, altrimenti perderai i tuoi dati esistenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルをエクスポートせずに新しいバージョンの ExcalidrawZ をダウンロードしないでください。そうしないと、既存のデータが失われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일을 먼저 내보내지 않고 새 버전의 ExcalidrawZ를 다운로드하지 마세요. 그렇지 않으면 기존 데이터가 손실됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Download nooit een nieuwe versie van ExcalidrawZ zonder eerst je bestanden te exporteren, anders verlies je je bestaande gegevens."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nigdy nie pobieraj nowej wersji ExcalidrawZ bez wcześniejszego eksportu swoich plików, inaczej stracisz swoje istniejące dane."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca baixe uma nova versão do ExcalidrawZ sem exportar seus arquivos primeiro, ou você perderá seus dados existentes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Никогда не загружайте новую версию ExcalidrawZ без предварительного экспорта ваших файлов, иначе вы потеряете имеющиеся данные."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อย่าดาวน์โหลดเวอร์ชันใหม่ของ ExcalidrawZ โดยไม่ได้ส่งออกไฟล์ของคุณก่อน มิฉะนั้นคุณจะสูญเสียข้อมูลที่มีอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyalarınızı önce dışa aktarmadan yeni bir ExcalidrawZ sürümünü indirmeyin, aksi takdirde mevcut verilerinizi kaybedersiniz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không bao giờ tải xuống phiên bản mới của ExcalidrawZ mà không xuất các tệp của bạn trước, nếu không bạn sẽ mất dữ liệu hiện có."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你没有将所有文件导出，永远不要下载新版ExcalidrawZ，否则你的已有数据将会丢失。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在導出您的文件之前，切勿下載新版本的 ExcalidrawZ，否則您將丟失現有數據。"
          }
        }
      }
    },
