        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg LaTeX-formules en functieplottisaties in via de native wiskunde renderer van ExcalidrawZ."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wstawiaj formuły LaTeX i wykresy funkcji za pomocą natywnego renderera matematycznego ExcalidrawZ."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Insira fórmulas LaTeX e gráficos de funções através do renderizador matemático nativo do ExcalidrawZ."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставка формул LaTeX и графиков функций с помощью встроенного математического рендера ExcalidrawZ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แทรกรูปสูตร LaTeX และกราฟฟังก์ชันผ่านตัวเรนเดอร์คณิตศาสตร์ในตัวของ ExcalidrawZ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ'nin yerel matematik renderleyicisi aracılığıyla LaTeX formüllerini ve fonksiyon grafikleri ekleyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chèn công thức LaTeX và đồ thị hàm thông qua trình tạo toán học gốc của ExcalidrawZ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
