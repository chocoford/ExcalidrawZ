    "whatsnewExportPDFDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يدعم ExcalidrawZ الآن التصدير كملف PDF، ويمكن العثور على الخيار الجديد في ورقة التصدير."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ unterstützt jetzt den Export als PDF, und die neue Option finden Sie im Exportblatt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ now supports exporting as a PDF, and the new option can be found in the Export sheet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ ahora admite la exportación como PDF, y la nueva opción se puede encontrar en la hoja de Exportar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ prend désormais en charge l'exportation au format PDF, et la nouvelle option se trouve dans la feuille d'exportation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ अब PDF के रूप में निर्यात का समर्थन करता है, और नया विकल्प निर्यात शीट में पाया जा सकता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ ora supporta l'esportazione in PDF, e la nuova opzione può essere trovata nel foglio di esportazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZはPDFエクスポートをサポートしました。新しいオプションはエクスポートシートにあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ는 이제 PDF로 내보내기를 지원하며, 새로운 옵션은 내보내기 시트에서 찾을 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ ondersteunt nu het exporteren als PDF, en de nieuwe optie is te vinden in het exportvenster."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ teraz wspiera eksport do formatu PDF, a nowa opcja jest dostępna w arkuszu Eksportuj."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ agora suporta exportação como PDF, e a nova opção pode ser encontrada na folha de exportação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ теперь поддерживает экспорт в формате PDF, и новая опция доступна в меню экспорта."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ ตอนนี้สนับสนุนการส่งออกเป็น PDF และตัวเลือกใหม่สามารถพบได้ในแผ่นส่งออก."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ artık PDF olarak dışa aktarmayı destekliyor ve yeni seçenek Dışa Aktarma sayfasında bulunabilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ giờ đây hỗ trợ xuất dưới dạng PDF, và tùy chọn mới có thể được tìm thấy trong bảng xuất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ 现在支持导出为 PDF，新的选项可以在导出页面中找到。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ 現在支持導出為 PDF，新的選項可以在導出表單中找到。"
          }
        }
      }
    },
