    "aiChatUserMessageActionRevertHelp": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استرجع اللوحة إلى ما كانت عليه قبل هذه الرسالة، ثم أعد تحميل نصها إلى صندوق الإدخال، ثم أعد الإرسال."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Leinwand vor dieser Nachricht zurücksetzen, ihren Text in das Eingabefeld neu laden und dann erneut senden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Revert canvas to before this message, reload its text into the input box, then resend."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revertir el lienzo a antes de este mensaje, volver a cargar su texto en el cuadro de entrada y luego reenviarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Revenir à la toile avant ce message, recharger son texte dans la zone de saisie, puis renvoyer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैनवास को इस संदेश से पहले की स्थिति में वापस लाएँ, इसका पाठ इनपुट बॉक्स में पुनः लोड करें, फिर फिर से भेजें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripristina il canvas a prima di questo messaggio, ricarica il suo testo nella casella di input, quindi invia nuovamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このメッセージの前の状態にキャンバスを戻し、そのテキストを入力ボックスに再読み込みしてから再送信します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 메시지 이전의 캔버스로 되돌리고, 그 텍스트를 입력 상자로 다시 로드한 다음 재전송합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Keer het canvas terug naar vóór dit bericht, laad de tekst opnieuw in het invoerveld en verzend het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przywróć płótno do stanu sprzed tej wiadomości, załaduj jej tekst do pola wejściowego, a następnie wyślij ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Reverter o canvas para antes desta mensagem, recarregar seu texto na caixa de entrada e, em seguida, reenviar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Верните холст к состоянию до этого сообщения, перезагрузите его текст в поле ввода, а затем отправьте снова."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ย้อนกลับผืนผ้าใบไปก่อนข้อความนี้, โหลดข้อความนั้นกลับเข้าสู่กล่องป้อนข้อมูล, จากนั้นส่งใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuvali bu mesajdan önceki hale getir, metnini girdi kutusuna yeniden yükle ve sonra tekrar gönder."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khôi phục canvas về trước tin nhắn này, tải lại văn bản vào ô nhập, sau đó gửi lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将画布恢复到此消息之前，将其文本重新加载到输入框中，然后重新发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將畫布恢復到此消息之前的狀態，然後將其文本重新加載到輸入框中，再重新發送。"
          }
        }
      }
    },
