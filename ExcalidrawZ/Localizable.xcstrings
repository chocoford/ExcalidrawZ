    "lockedContentUseExistingRecoveryKeyMessage": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل مفتاح الاسترداد الذي يفتح ملفاتك المغلقة الحالية. ستستخدم هذه الملف نفس المفتاح."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie den Wiederherstellungsschlüssel ein, der Ihre bestehenden gesperrten Dateien entsperrt. Diese Datei verwendet denselben Schlüssel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the Recovery Key that unlocks your existing locked files. This file will use the same key."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce la clave de recuperación que desbloquea tus archivos bloqueados existentes. Este archivo utilizará la misma clave."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrez la clé de récupération qui déverrouille vos fichiers verrouillés existants. Ce fichier utilisera la même clé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने मौजूदा लॉक किए गए फ़ाइलों को अनलॉक करने के लिए रिकवरी कुंजी दर्ज करें। यह फ़ाइल उसी कुंजी का उपयोग करेगी।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci il Recovery Key che sblocca i tuoi file bloccati esistenti. Questo file utilizzerà la stessa chiave."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既存のロックされたファイルを解除するためのリカバリキーを入力してください。このファイルは同じキーを使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기존 잠긴 파일을 해제하는 복구 키를 입력하세요. 이 파일은 동일한 키를 사용할 것입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer de Herstelcode in die je bestaande vergrendelde bestanden ontgrendelt. Dit bestand zal dezelfde code gebruiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wprowadź klucz odzyskiwania, który odblokowuje twoje istniejące zablokowane pliki. Ten plik będzie korzystał z tego samego klucza."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Insira a Chave de Recuperação que desbloqueia seus arquivos bloqueados existentes. Este arquivo usará a mesma chave."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите ключ восстановления, который разблокирует ваши существующие заблокированные файлы. Этот файл будет использовать тот же ключ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กรอก Recovery Key ที่ปลดล็อกไฟล์ที่ล็อกอยู่ของคุณ ไฟล์นี้จะใช้คีย์เดียวกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mevcut kilitli dosyalarınızı açan Kurtarma Anahtarını girin. Bu dosya aynı anahtarı kullanacaktır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập Recovery Key để mở khóa các tệp đã khóa của bạn. Tệp này sẽ sử dụng cùng một khóa."
          }
        },
