    "toolbarLatexMathFormulaLibrarySubtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر قالبًا، ثم قم بتنقيح LaTeX قبل الإدراج."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie eine Vorlage und verfeinern Sie das LaTeX, bevor Sie es einfügen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a template, then refine the LaTeX before inserting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona una plantilla y luego refinála antes de insertar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un modèle, puis refinez le LaTeX avant de l'insérer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक टेम्पलेट चुनें, फिर सम्मिलित करने से पहले LaTeX को परिष्कृत करें."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un modello, quindi affina il LaTeX prima di inserire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テンプレートを選択し、挿入前にLaTeXを修正します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "템플릿을 선택한 다음 LaTeX를 수정하여 삽입하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een sjabloon en verfijn de LaTeX voordat je deze invoegt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz szablon, a następnie dopracuj LaTeX przed wstawieniem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um template e, em seguida, refine o LaTeX antes de inserir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите шаблон, затем уточните LaTeX перед вставкой."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกแม่แบบแล้วปรับแต่ง LaTeX ก่อนแทรก."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir şablon seçin, ardından eklemeden önce LaTeX'i iyileştirin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn một mẫu, sau đó tinh chỉnh LaTeX trước khi chèn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一个模板，然后在插入之前完善LaTeX。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇一個範本，然後在插入前細化LaTeX。"
          }
        }
      }
    },
