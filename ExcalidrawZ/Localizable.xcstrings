    "settingsAIMCPServiceModeFeatureOptimizedCrossFileBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قائمة، إنشاء، فتح، والتبديل بين ملفات ExcalidrawZ والملفات المحلية المصرح بها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liste erstellen, öffnen und zwischen ExcalidrawZ-Dateien und autorisierten lokalen Dateien wechseln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "List, create, open, and switch between ExcalidrawZ files and authorized local files."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Listar, crear, abrir y cambiar entre archivos de ExcalidrawZ y archivos locales autorizados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lister, créer, ouvrir et basculer entre les fichiers ExcalidrawZ et les fichiers locaux autorisés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ फ़ाइलों और अधिकृत स्थानीय फ़ाइलों के बीच सूची, निर्माण, खोलें और स्विच करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elenca, crea, apri e passa tra file ExcalidrawZ e file locali autorizzati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZファイルと承認されたローカルファイルのリスト作成、オープン、切り替えを行います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ 파일 및 승인된 로컬 파일 간에 목록을 작성하고, 열고, 전환하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lijst, maak, open en wissel tussen ExcalidrawZ-bestanden en geautoriseerde lokale bestanden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista, twórz, otwieraj i przełączaj się między plikami ExcalidrawZ oraz autoryzowanymi plikami lokalnymi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Liste, crie, abra e mude entre arquivos ExcalidrawZ e arquivos locais autorizados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Список, создание, открытие и переключение между файлами ExcalidrawZ и авторизованными локальными файлами."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายการ สร้าง เปิด และสลับระหว่างไฟล์ ExcalidrawZ และไฟล์ในท้องถิ่นที่ได้รับอนุญาต"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ dosyaları ve yetkilendirilmiş yerel dosyalar arasında listeleme, oluşturma, açma ve geçiş yapma."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Danh sách, tạo, mở và chuyển đổi giữa các tệp ExcalidrawZ và các tệp cục bộ được ủy quyền."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "列出、创建、打开并切换 ExcalidrawZ 文件和授权的本地文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "列出、創建、打開及切換 ExcalidrawZ 檔案和授權的本地檔案。"
          }
        }
      }
    },
