    "whatsNewElementLinksDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الآن يمكنك إرفاق روابط بعناصر Excalidraw، مما يربطها بمواقع ويب خارجية، أو عناصر أخرى، أو ملفات مختلفة، أو حتى تطبيقات أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jetzt können Sie Links zu Excalidraw-Elementen hinzufügen, die mit externen Websites, anderen Elementen, verschiedenen Dateien oder sogar anderen Apps verbunden sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Now you can attach links to Excalidraw elements, connecting to external websites, other elements, different files, or even other apps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora puedes adjuntar enlaces a los elementos de Excalidraw, conectando con sitios web externos, otros elementos, diferentes archivos o incluso otras aplicaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez désormais ajouter des liens aux éléments Excalidraw, en les connectant à des sites externes, d'autres éléments, différents fichiers ou même d'autres applications."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अब आप Excalidraw तत्वों के लिए लिंक संलग्न कर सकते हैं, बाहरी वेबसाइटों, अन्य तत्वों, विभिन्न फ़ाइलों, या यहां तक कि अन्य ऐप्स से जोड़कर।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ora puoi allegare link agli elementi di Excalidraw, collegandoti a siti web esterni, ad altri elementi, a file diversi o persino ad altre app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Excalidraw の要素にリンクを添付できるようになり、外部ウェブサイト、他の要素、異なるファイル、さらには他のアプリに接続できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 Excalidraw 요소에 링크를 첨부하여 외부 웹사이트, 다른 요소, 다른 파일 또는 다른 앱에 연결할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu kunt u links toevoegen aan Excalidraw-elementen, die verbinden met externe websites, andere elementen, verschillende bestanden of zelfs andere apps."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Teraz możesz dołączać linki do elementów Excalidraw, łącząc je z zewnętrznymi stronami internetowymi, innymi elementami, różnymi plikami, a nawet innymi aplikacjami."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Agora você pode anexar links a elementos do Excalidraw, conectando a sites externos, outros elementos, diferentes arquivos ou até mesmo outros aplicativos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Теперь вы можете прикреплять ссылки к элементам Excalidraw, связывая их с внешними веб-сайтами, другими элементами, различными файлами или даже другими приложениями."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอนนี้คุณสามารถแนบลิงก์กับองค์ประกอบของ Excalidraw เชื่อมต่อกับเว็บไซต์ภายนอก องค์ประกอบอื่น ๆ ไฟล์ต่าง ๆ หรือแม้แต่แอปอื่น ๆ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Artık Excalidraw öğelerine dış bağlantılar ekleyebilirsiniz; harici web sitelerine, diğer öğelere, farklı dosyalara veya hatta diğer uygulamalara bağlayabilirsiniz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bây giờ bạn có thể đính kèm liên kết vào các phần tử Excalidraw, kết nối đến các trang web bên ngoài, các phần tử khác, các tệp khác, hoặc thậm chí là các ứng dụng khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在，你可以为 Excalidraw 中的元素添加链接，快速跳转到外部网站、其他元素、不同文件，甚至其他应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "現在您可以將鏈接附加到 Excalidraw 元素，連接到外部網站、其他元素、不同的文件或甚至其他應用程式。"
          }
        }
      }
    },
