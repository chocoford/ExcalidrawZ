    "settingsAIDefaultModelHelp": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم للمحادثات الجديدة وكاختيار افتراضي. يمكن لكل محادثة تجاوز ذلك من اختيار النموذج الخاص بها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird für neue Gespräche und als Standard im Auswahlfeld verwendet. Jedes Gespräch kann dies über seinen eigenen Modellauswähler überschreiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used for new conversations and as the picker default. Each conversation can override this from its own model picker."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilizado para nuevas conversaciones y como predeterminado del selector. Cada conversación puede anular esto desde su propio selector de modelos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisé pour de nouvelles conversations et comme modèle par défaut dans le sélecteur. Chaque conversation peut remplacer cela à partir de son propre sélecteur de modèle."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नए वार्तालापों के लिए और प_picker_ डिफ़ॉल्ट के रूप में उपयोग किया जाता है। प्रत्येक वार्तालाप इसे अपने मॉडल प_picker_ से ओवरराइड कर सकता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilizzato per nuove conversazioni e come predefinito del selettore. Ogni conversazione può sovrascrivere questo dal proprio selettore di modelli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい会話に使用され、モデルピッカーのデフォルトとなります。各会話は自分自身のモデルピッカーからこれを上書きすることができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새로운 대화 및 선택기 기본값으로 사용됩니다. 각 대화는 자체 모델 선택기에서 이를 재정의할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wordt gebruikt voor nieuwe gesprekken en als standaard in de keuzelijst. Elk gesprek kan dit overschrijven vanuit zijn eigen modelkeuze."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Używane dla nowych rozmów i jako domyślny w wyborze modelu. Każda rozmowa może to zmienić w swoim wyborze modelu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Usado para novas conversas e como padrão no seletor. Cada conversa pode substituir isso a partir de seu próprio seletor de modelo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используется для новых разговоров и как модель по умолчанию. Каждый разговор может переопределить это в своем выборе модели."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้สำหรับการสนทนาใหม่และเป็นค่าตั้งต้นของตัวเลือกแต่ละรายการ การสนทนาสามารถเปลี่ยนแปลงจากตัวเลือกโมเดลของตนเองได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni konuşmalar için ve seçim arayüzü varsayılanı olarak kullanılır. Her konuşma kendi model seçim arayüzünden bunu geçersiz kılabilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Được sử dụng cho các cuộc trò chuyện mới và là mặc định trong trình chọn. Mỗi cuộc trò chuyện có thể ghi đè điều này từ trình chọn mô hình của riêng nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于新对话，并作为选择器的默认选项。每个对话可以从其自己的模型选择器覆盖此设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於新的對話並作為選擇的預設。每個對話可以從其自己的模型選擇中覆蓋這個設定。"
          }
        }
      }
    },
