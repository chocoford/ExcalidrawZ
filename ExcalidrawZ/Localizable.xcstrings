    "lockedContentFeatureUnlockMessage": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فتحها لاحقاً يتطلب مصادقة النظام أو مفتاح الاسترداد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Öffnen später erfordert eine Systemeauthentifizierung oder den Wiederherstellungsschlüssel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opening it later requires system authentication or the Recovery Key."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrirlo más tarde requiere autenticación del sistema o la clave de recuperación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'ouverture ultérieure nécessite une authentification système ou la clé de récupération."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे बाद में खोलने के लिए सिस्टम प्रमाणीकरण या रिकवरी की की आवश्यकता होती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprirlo in seguito richiede autenticazione di sistema o il codice di recupero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "後で開くには、システム認証またはリカバリキーが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나중에 열려면 시스템 인증 또는 복구 키가 필요합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het later openen vereist systeemauthenticatie of de herstelcode."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwarcie go później wymaga autoryzacji systemu lub klucza odzyskiwania."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abri-lo depois requer autenticação do sistema ou a Chave de Recuperação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Позже для открытия требуется аутентификация системы или ключ восстановления."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเปิดไฟล์ในภายหลังต้องการการตรวจสอบระบบหรือ Recovery Key"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunu daha sonra açmak için sistem kimlik doğrulaması veya Kurtarma Anahtarı gerekir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở nó sau này yêu cầu xác thực hệ thống hoặc Khóa Khôi phục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "稍后打开此文件需要系统认证或恢复密钥。"
          }
        },
