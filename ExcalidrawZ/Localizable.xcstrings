    "whatsNewExportDarkPNGDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتصدير صور PNG في وضع الألوان المفضل لديك - فاتح أو داكن - لتناسب أي سياق أو بيئة بشكل مثالي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportieren Sie PNG-Bilder in Ihrem bevorzugten Farbmodus – hell oder dunkel – um perfekt zu jedem Kontext oder Umfeld zu passen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export PNG images in your preferred color mode—light or dark—to perfectly suit any context or environment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporta imágenes PNG en tu modo de color preferido: claro u oscuro, para adaptarse perfectamente a cualquier contexto o entorno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporte des images PNG dans le mode de couleur de votre choix—clair ou sombre—pour s'adapter parfaitement à tout contexte ou environnement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने पसंदीदा रंग मोड—हल्का या डार्क—में PNG चित्रों का निर्यात करें, ताकि किसी भी संदर्भ या वातावरण के लिए पूरी तरह से उपयुक्त हो सके।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esporta immagini PNG nel tuo colore preferito—chiaro o scuro—per adattarsi perfettamente a qualsiasi contesto o ambiente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お好みのカラー モード（ライトまたはダーク）で PNG 画像をエクスポートし、あらゆるコンテキストや環境に完璧に適応させることができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원하는 색상 모드인 라이트 또는 다크로 PNG 이미지를 내보내어 어떤 맥락이나 환경에도 완벽하게 맞출 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporteer PNG-afbeeldingen in uw voorkeurkleurmodus—licht of donker—om perfect aan te sluiten bij elke context of omgeving."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksportuj obrazy PNG w preferowanym trybie kolorystycznym—jasnym lub ciemnym—aby idealnie pasowały do każdego kontekstu lub środowiska."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporte imagens PNG no seu modo de cor preferido—claro ou escuro—para se adequar perfeitamente a qualquer contexto ou ambiente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экспортируйте PNG-изображения в предпочитаемом цветовом режиме — светлом или темном — чтобы идеально подходить для любого контекста или окружения."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งออกภาพ PNG ในโหมดสีที่คุณต้องการ—โหมดสว่างหรือโหมดมืด—เพื่อให้เหมาะสมกับบริบทหรือสภาพแวดล้อมใด ๆ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tercih ettiğiniz renk modunda—aydınlık veya karanlık—PNG görüntüleri dışa aktarın, her bağlama veya ortama mükemmel uyum sağlamak için."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xuất hình ảnh PNG theo chế độ màu bạn thích - sáng hoặc tối - để hoàn hảo phù hợp với bất kỳ ngữ cảnh hoặc môi trường nào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导出 PNG 图片时，支持自由切换浅色或深色模式，更好地适应各种使用场景。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以您喜愛的顏色模式（淺色或深色）導出 PNG 圖像，以完美適應任何上下文或環境。"
          }
        }
      }
    },
    "whatsNewExportDarkPNGTitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تصدير PNG في وضع الظلام"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dunkelmodus PNG-Export"
          }
        },
