    "whatsNewIcloudSyncDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الآن، يمكن مزامنة بيانات ExcalidrawZ عبر منصات متعددة عبر iCloud."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jetzt können ExcalidrawZ-Daten plattformübergreifend über iCloud synchronisiert werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Now, ExcalidrawZ data can be synced across platforms via iCloud."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora, los datos de ExcalidrawZ se pueden sincronizar entre plataformas a través de iCloud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désormais, les données d'ExcalidrawZ peuvent être synchronisées sur différentes plateformes via iCloud."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अब, ExcalidrawZ डेटा को iCloud के माध्यम से विभिन्न प्लेटफार्मों में समन्वयित किया जा सकता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ora, i dati di ExcalidrawZ possono essere sincronizzati su diverse piattaforme tramite iCloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これで、ExcalidrawZのデータはiCloudを通じてプラットフォーム間で同期できるようになりました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 ExcalidrawZ 데이터는 iCloud를 통해 플랫폼 간에 동기화할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu kunnen ExcalidrawZ-gegevens worden gesynchroniseerd tussen platforms via iCloud."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Teraz dane ExcalidrawZ mogą być synchronizowane między platformami za pomocą iCloud."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Agora, os dados do ExcalidrawZ podem ser sincronizados entre plataformas via iCloud."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Теперь данные ExcalidrawZ можно синхронизировать между платформами через iCloud."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอนนี้ ข้อมูล ExcalidrawZ สามารถซิงค์ข้ามแพลตฟอร์มผ่าน iCloud ได้แล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Artık, ExcalidrawZ verileri iCloud üzerinden platformlar arasında senkronize edilebilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bây giờ, dữ liệu ExcalidrawZ có thể được đồng bộ hóa trên nhiều nền tảng thông qua iCloud."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在，ExcalidrawZ 数据可以通过 iCloud 在各个平台间同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "現在，ExcalidrawZ 數據可以通過 iCloud 在各平台之間同步。"
          }
        }
      }
    },
