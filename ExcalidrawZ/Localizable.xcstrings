    "settingsExcalidrawUseIndividualDrawingSettingsMessage": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند التعطيل، سيحتفظ كل ملف بإعدادات رسم خاصة به."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn deaktiviert, behält jede Datei ihre eigenen Zeicheneinstellungen bei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When disabled, each file will maintain its own individual drawing settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando esté desactivado, cada archivo mantendrá sus propios ajustes de dibujo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque désactivé, chaque fichier conservera ses propres paramètres de dessin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अक्षम होने पर प्रत्येक फ़ाइल अपनी व्यक्तिगत ड्रॉइंग सेटिंग्स बनाए रखेगी।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se disattivato, ogni file manterrà le proprie impostazioni di disegno individuali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無効にすると、各ファイルはそれぞれ個別の描画設定を保持します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비활성화하면 각 파일은 개별 그리기 설정을 유지합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wanneer uitgeschakeld, behoudt elk bestand zijn eigen tekeninstellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po wyłączeniu każdy plik będzie zachowywał własne ustawienia rysowania."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando desativado, cada arquivo manterá suas próprias configurações de desenho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если отключено, каждый файл будет хранить свои собственные настройки рисования."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อปิดใช้งาน แต่ละไฟล์จะมีการตั้งค่าการวาดของตัวเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Devre dışı bırakıldığında, her dosya kendi çizim ayarlarını korur."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi tắt, mỗi tệp sẽ giữ cài đặt vẽ riêng của nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "禁用时，每个文件将保留各自的绘图设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "停用時，每個檔案會保有各自的繪圖設定。"
          }
        }
      }
    },
    "settingsExcalidrawUseUnifiedDrawingSettingsMessage": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم تطبيق هذه الإعدادات عند فتح رسم جديد أو إنشائه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Einstellungen werden angewendet, wenn du eine neue Zeichnung öffnest oder erstellst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These settings will be applied when you open or create a new drawing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos ajustes se aplicarán al abrir o crear un dibujo nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces paramètres seront appliqués lorsque vous ouvrirez ou créerez un nouveau dessin.\n"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब आप कोई नया ड्रॉइंग खोलेंगे या बनाएँगे तो ये सेटिंग्स लागू होंगी।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Queste impostazioni verranno applicate quando apri o crei un nuovo disegno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの設定は、新しい描画を開くまたは作成する際に適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 설정은 새 그림을 열거나 만들 때 적용됩니다."
          }
        },
        "nl": {
