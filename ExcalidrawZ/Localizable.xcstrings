    "librariesRemoveAllConfirmationTitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل أنت متأكد من أنك تريد إزالة جميع العناصر؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sind Sie sicher, dass Sie alle Elemente entfernen möchten?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure to remove all items?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Estás seguro de que deseas eliminar todos los elementos?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Êtes-vous sûr de vouloir supprimer tous les éléments ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या आप सभी आइटम हटाने के लिए निश्चित हैं?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei sicuro di voler rimuovere tutti gli elementi?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのアイテムを削除してもよろしいですか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 항목을 제거하시겠습니까?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weet je zeker dat je alle items wilt verwijderen?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy na pewno chcesz usunąć wszystkie elementy?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem certeza de que deseja remover todos os itens?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы уверены, что хотите удалить все элементы?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณแน่ใจหรือไม่ว่าจะลบรายการทั้งหมด?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm öğeleri kaldırmak istediğinize emin misiniz?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có chắc chắn muốn xóa tất cả mục không?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你确定要移除所有素材？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您確定要移除所有項目嗎？"
          }
        }
