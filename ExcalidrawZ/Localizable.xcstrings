    "settingsSecurityLostRecoveryKeyBackupsMessage": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم مسح النسخ الاحتياطية المشفرة التي تعتمد على المفتاح المفقود أيضًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auch die verschlüsselten Sicherungskopien, die von dem verlorenen Schlüssel abhängen, werden gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Encrypted backup copies that depend on the lost key are cleared too."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las copias de seguridad encriptadas que dependen de la clave perdida también se eliminan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les copies de sauvegarde cryptées qui dépendent de la clé perdue sont également effacées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खोई हुई कुंजी पर निर्भर करते हुए एन्क्रिप्टेड बैकअप कॉपी भी हटा दी गई हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le copie di backup crittografate che dipendono dalla chiave persa sono state eliminate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "失われたキーに依存する暗号化されたバックアップコピーも削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잃어버린 키에 의존하는 암호화된 백업 사본도 삭제됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Versleutelde back-upkopieën die afhankelijk zijn van de verloren sleutel worden ook gewist."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szyfrowane kopie zapasowe, które zależą od utraconego klucza, również zostały usunięte."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cópias de backup criptografadas que dependem da chave perdida também são removidas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зашифрованные резервные копии, зависящие от утерянного ключа, также удаляются."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สำเนาสำรองที่เข้ารหัสซึ่งขึ้นอยู่กับกุญแจที่สูญหายจะถูกลบด้วยเช่นกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıp anahtara bağlı şifreli yedek kopyalar da silinir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các bản sao lưu được mã hóa phụ thuộc vào khóa đã mất cũng sẽ bị xóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "依赖丢失密钥的加密备份副本也将被清除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依賴於丟失的密鑰的加密備份也會被清除。"
          }
        }
      }
    },
