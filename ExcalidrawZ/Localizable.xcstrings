    "settingsMediasDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستظهر هنا ملفات الوسائط المستخدمة في رسوماتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In deinen Zeichnungen verwendete Mediendateien werden hier angezeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Media files used in your drawings will appear here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos multimedia utilizados en tus dibujos aparecerán aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers multimédias utilisés dans vos dessins apparaîtront ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके चित्रों में उपयोग की गई मीडिया फ़ाइलें यहाँ दिखाई देंगी।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I file multimediali usati nei tuoi disegni verranno visualizzati qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "描画で使用されているメディアファイルがここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그림에서 사용한 미디어 파일이 여기에 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mediabestanden die in je tekeningen worden gebruikt, verschijnen hier."
          }
        },
        "pl": {
