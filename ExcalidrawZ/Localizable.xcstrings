    "settingsAIMCPServiceModeBasicHelp": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطابق مع مجموعة أدوات excalidraw-mcp: اقرأ الدليل، قم بإنشاء عرض، وتبادل نقاط التفتيش MCP."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entspricht dem excalidraw-mcp-Toolset: Lesen Sie den Leitfaden, erstellen Sie eine Ansicht und tauschen Sie MCP-Checkpoints aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Matches the excalidraw-mcp tool set: read the guide, create a view, and exchange MCP checkpoints."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coincide con el conjunto de herramientas excalidraw-mcp: lee la guía, crea una vista e intercambia puntos de control MCP."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Correspond à l'ensemble d'outils excalidraw-mcp : lisez le guide, créez une vue et échangez des points de contrôle MCP."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "excalidraw-mcp टूल सेट से मेल खाता है: गाइड को पढ़ें, एक दृश्य बनाएं, और MCP चेकपॉइंट्स का आदान-प्रदान करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrisponde al set di strumenti di excalidraw-mcp: leggi la guida, crea una vista e scambia i checkpoint MCP."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "excalidraw-mcpツールセットに合わせています: ガイドを読み、ビューを作成し、MCPチェックポイントを交換します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "excalidraw-mcp 도구 세트와 일치합니다: 가이드를 읽고, 뷰를 만들고, MCP 체크포인트를 교환하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Komt overeen met de excalidraw-mcp toolset: lees de handleiding, maak een weergave en wissel MCP-controlepunten uit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zgadza się z zestawem narzędzi excalidraw-mcp: przeczytaj przewodnik, stwórz widok i wymień punkty kontrolne MCP."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Correspondências ao conjunto de ferramentas excalidraw-mcp: leia o guia, crie uma visualização e troque pontos de verificação MCP."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Совпадает с набором инструментов excalidraw-mcp: прочитайте руководство, создайте представление и обменивайтесь контрольными точками MCP."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรงกับเครื่องมือ excalidraw-mcp: อ่านคู่มือ สร้างมุมมอง และแลกเปลี่ยนเช็คพอยต์ MCP"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "excalidraw-mcp araç setiyle eşleşir: kılavuzu okuyun, bir görünüm oluşturun ve MCP kontrol noktalarını değiştirin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khớp với bộ công cụ excalidraw-mcp: đọc hướng dẫn, tạo một chế độ xem và trao đổi các checkpoint MCP."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与 excalidraw-mcp 工具集一致：读取指南、创建视图，并交换 MCP 检查点。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "與 excalidraw-mcp 工具集一致：讀取指南、建立視圖，並交換 MCP 檢查點。"
          }
        }
      }
    },
