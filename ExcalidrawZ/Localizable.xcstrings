    "whatsnewMultiTouchDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند استخدام إصبعين للمس الشاشة، ستقوم بعملية التراجع. عند استخدام ثلاثة أصابع للمس الشاشة، ستقوم بعملية الإعادة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Berühren des Bildschirms mit zwei Fingern wird eine Rückgängig-Operation ausgeführt. Beim Berühren des Bildschirms mit drei Fingern wird eine Wiederherstellen-Operation ausgeführt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When using two fingers to touch the screen, it will perform an undo operation. When using three fingers to touch the screen, it will perform a redo operation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al usar dos dedos para tocar la pantalla, se realizará una operación de deshacer. Al usar tres dedos para tocar la pantalla, se realizará una operación de rehacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque vous utilisez deux doigts pour toucher l'écran, cela effectuera une opération d'annulation. Lorsque vous utilisez trois doigts pour toucher l'écran, cela effectuera une opération de rétablissement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब आप स्क्रीन को दो उंगलियों से छूते हैं, तो यह एक पूर्ववत क्रिया करेगा। जब आप स्क्रीन को तीन उंगलियों से छूते हैं, तो यह एक पुनः क्रिया करेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando usi due dita per toccare lo schermo, eseguirà un'operazione di annullamento. Quando usi tre dita per toccare lo schermo, eseguirà un'operazione di ripetizione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2本指で画面をタッチすると元に戻す操作が実行され、3本指でタッチするとやり直し操作が実行されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 손가락으로 화면을 터치하면 실행 취소 작업이 수행됩니다. 세 손가락으로 화면을 터치하면 다시 실행 작업이 수행됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bij het gebruik van twee vingers om het scherm aan te raken, voert het een ongedaan maken operatie uit. Bij het gebruik van drie vingers om het scherm aan te raken, voert het een opnieuw uitvoeren operatie uit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy używasz dwóch palców do dotykania ekranu, wykona operację cofania. Gdy używasz trzech palców do dotykania ekranu, wykona operację ponawiania."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao usar dois dedos para tocar na tela, será realizada uma operação de desfazer. Ao usar três dedos para tocar na tela, será realizada uma operação de refazer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При использовании двух пальцев для касания экрана будет выполнена операция отмены. При использовании трех пальцев для касания экрана будет выполнена операция повтора."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อใช้สองนิ้วแตะที่หน้าจอจะทำการย้อนกลับ เมื่อใช้สามนิ้วแตะที่หน้าจอจะทำการทำซ้ำ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekrana iki parmakla dokunduğunuzda, geri alma işlemi gerçekleştirilir. Ekrana üç parmakla dokunduğunuzda, yineleme işlemi gerçekleştirilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi sử dụng hai ngón tay chạm vào màn hình, nó sẽ thực hiện thao tác hoàn tác. Khi sử dụng ba ngón tay chạm vào màn hình, nó sẽ thực hiện thao tác làm lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当使用两根手指触摸屏幕时，它将执行撤销操作。当使用三根手指触摸屏幕时，它将执行重做操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當使用兩根手指觸摸屏幕時，將執行撤銷操作。當使用三根手指觸摸屏幕時，將執行重做操作。"
          }
        }
      }
    },
