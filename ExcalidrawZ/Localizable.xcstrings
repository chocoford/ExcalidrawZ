    "settingsAIAccountSubtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يساعدك هذا المعرف في دعم بحثك عن أرصدة الذكاء الاصطناعي وطلباتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Kennung hilft, Ihre AI-Credits und Anfragen zu verwalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This identifier helps support look up your AI credits and requests."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este identificador ayuda a buscar tus créditos y solicitudes de IA."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet identifiant aide à retrouver vos crédits et demandes d'IA."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह पहचानकर्ता आपके AI क्रेडिट और अनुरोधों के लिए समर्थन खोजने में मदद करता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo identificatore aiuta a supportare la ricerca dei tuoi crediti e delle tue richieste AI."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この識別子は、AIクレジットとリクエストの参照をサポートするのに役立ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 식별자는 AI 크레딧 및 요청 조회를 지원하는 데 사용됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze identificatie helpt bij het opzoeken van uw AI-tegoeden en verzoeken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten identyfikator pomaga w odnajdywaniu Twoich kredytów AI i żądań."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este identificador ajuda a localizar seus créditos e solicitações de IA."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот идентификатор помогает поддержке находить ваши кредитные средства и запросы."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รหัสประจำตัวนี้ช่วยในการค้นหาสิทธิ์เครดิต AI และคำขอของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu tanımlayıcı, AI kredilerinizi ve taleplerinizi desteklemek için yardımcı olur."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mã định danh này giúp hỗ trợ tra cứu tín dụng và yêu cầu AI của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此标识符有助于支持查找您的 AI 信用和请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此識別碼有助於查詢您的 AI 積分和請求。"
          }
        }
      }
    },
