    "settingsMediaCleanupUnverifiedDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These items may still be referenced by content that could not be read. They were left unchanged to protect your files and history."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些媒体可能仍被无法读取的内容引用。为保护文件和历史记录，它们不会被删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些媒體可能仍被無法讀取的內容參考。為保護檔案和歷史記錄，它們不會被刪除。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد لا تزال هذه العناصر مرجعية من محتوى لا يمكن قراءته. تم تركها بدون تغيير لحماية ملفاتك وتاريخك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Elemente können möglicherweise weiterhin von Inhalten referenziert werden, die nicht gelesen werden konnten. Sie wurden unverändert gelassen, um Ihre Dateien und Ihre Historie zu schützen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos elementos pueden seguir siendo referenciados por contenido que no se pudo leer. Se dejaron sin cambios para proteger sus archivos e historial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces éléments peuvent encore être référencés par un contenu qui n'a pas pu être lu. Ils ont été laissés inchangés pour protéger vos fichiers et votre historique."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ये आइटम्स अभी भी उन सामग्री द्वारा संदर्भित हो सकते हैं जिन्हें पढ़ा नहीं जा सका। आपके फ़ाइलों और इतिहास की सुरक्षा के लिए इन्हें बिना किसी परिवर्तन के छोड़ दिया गया है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questi elementi potrebbero essere ancora referenziati da contenuti che non sono stati letti. Sono rimasti invariati per proteggere i tuoi file e la tua cronologia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのアイテムは、読み取れなかったコンテンツによってまだ参照されている可能性があります。ファイルと履歴を保護するために変更されることはありませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 항목들은 읽을 수 없는 콘텐츠에 의해 여전히 참조될 수 있습니다. 귀하의 파일과 기록을 보호하기 위해 변경되지 않은 상태로 남겨두었습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze items kunnen nog steeds worden verwezen naar inhoud die niet gelezen kon worden. Ze zijn onveranderd gelaten om uw bestanden en geschiedenis te beschermen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te elementy mogą być nadal używane przez treści, których nie można było odczytać. Pozostawiono je bez zmian, aby chronić Twoje pliki i historię."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esses itens podem ainda estar referenciados por conteúdo que não pôde ser lido. Eles foram deixados inalterados para proteger seus arquivos e histórico."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти элементы могут все еще использоваться в контенте, который не удалось прочитать. Они оставлены без изменений, чтобы защитить ваши файлы и историю."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายการเหล่านี้อาจยังถูกอ้างอิงโดยเนื้อหาที่ไม่สามารถอ่านได้ จึงไม่ถูกเปลี่ยนแปลงเพื่อปกป้องไฟล์และประวัติของคุณ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu öğeler, okunamayan içerik tarafından hala referans veriliyor olabilir. Dosyalarınızı ve geçmişinizi korumak için değişmeden bırakılmıştır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Những mục này có thể vẫn được tham chiếu bởi nội dung không thể đọc. Chúng được giữ nguyên để bảo vệ các tập tin và lịch sử của bạn."
          }
        }
      }
    },
