            "value": "इस फ़ाइल को संपादित करने के लिए, आपको इसे पुनर्प्राप्त करना होगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per modificare questo file, dovrai recuperarlo."
