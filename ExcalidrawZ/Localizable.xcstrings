        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次回ExcalidrawZを開くときに機能のヒントが再度表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ를 다음번에 열면 기능 팁이 다시 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
