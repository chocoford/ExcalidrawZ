    "settingsAIEnableFeatureHelp": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند إيقاف التشغيل، لن يقوم ExcalidrawZ بإرسال طلبات الذكاء الاصطناعي أو تحديث بيانات حساب الذكاء الاصطناعي والرصيد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn deaktiviert wird, sendet ExcalidrawZ keine AI-Anfragen oder aktualisiert keine Daten zu AI-Konten und -Guthaben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When off, ExcalidrawZ will not send AI requests or refresh AI account and credits data."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando está desactivado, ExcalidrawZ no enviará solicitudes de IA ni actualizará los datos de cuenta y créditos de IA."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque désactivé, ExcalidrawZ n'enverra pas de requêtes d'IA et ne mettra pas à jour les données de compte et de crédits d'IA."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बंद होने पर, ExcalidrawZ एआई अनुरोध नहीं भेजेगा या एआई खाता और क्रेडिट डेटा को रीफ्रेश नहीं करेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando disattivato, ExcalidrawZ non invierà richieste AI né aggiornerà i dati dell'account AI e dei crediti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無効にすると、ExcalidrawZはAIリクエストを送信せず、AIアカウントとクレジットデータを更新しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "꺼짐 상태에서는 ExcalidrawZ가 AI 요청을 전송하거나 AI 계정 및 크레딧 데이터를 새로 고치지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wanneer uitgeschakeld, zal ExcalidrawZ geen AI-verzoeken verzenden of AI-account- en kredietgegevens vernieuwen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy jest wyłączona, ExcalidrawZ nie będzie wysyłać żądań AI ani aktualizować danych konta i kredytów AI."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando desativado, o ExcalidrawZ não enviará solicitações de IA ou atualizará os dados da conta e créditos de IA."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда отключено, ExcalidrawZ не будет отправлять запросы AI или обновлять данные учетной записи и кредита AI."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อปิด ExcalidrawZ จะไม่ส่งคำขอ AI หรือรีเฟรชข้อมูลบัญชีและเครดิต AI."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapalı olduğunda, ExcalidrawZ AI talepleri göndermeyecek veya AI hesap ve kredi verilerini güncellemeyecek."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi tắt, ExcalidrawZ sẽ không gửi các yêu cầu AI hoặc làm mới dữ liệu tài khoản và tín dụng AI."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭时，ExcalidrawZ 将不会发送 AI 请求或刷新 AI 账户及积分数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當關閉時，ExcalidrawZ 將不會發送 AI 請求或更新 AI 帳戶和信用數據。"
          }
        }
      }
    },
