    "whatsNewCustomDrawingSettingsDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدد أدوات وأنماط الرسم المفضلة لديك كإعداد افتراضي لملفات Excalidraw الجديدة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege deine bevorzugten Zeichenwerkzeuge und -stile als Standard für neue Excalidraw-Dateien fest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set your preferred drawing tools and styles as the default for new Excalidraw files.\n"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Establece tus herramientas y estilos de dibujo preferidos como predeterminados para los archivos nuevos de Excalidraw.\n"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définissez vos outils et styles de dessin préférés comme paramètres par défaut pour les nouveaux fichiers Excalidraw.\n"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी पसंदीदा ड्रॉइंग टूल्स और स्टाइल्स को नए Excalidraw फ़ाइलों के लिए डिफ़ॉल्ट के रूप में सेट करें।\n"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta gli strumenti e gli stili di disegno preferiti come predefiniti per i nuovi file Excalidraw.\n"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいExcalidrawファイルのデフォルトとして、好みの描画ツールとスタイルを設定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선호하는 그리기 도구와 스타일을 새 Excalidraw 파일의 기본값으로 설정하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel je favoriete tekengereedschappen en -stijlen in als standaard voor nieuwe Excalidraw-bestanden.\n"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustaw preferowane narzędzia i style rysowania jako domyślne dla nowych plików Excalidraw."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina suas ferramentas e estilos de desenho preferidos como padrão para novos arquivos do Excalidraw."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установите предпочитаемые инструменты и стили рисования в качестве настроек по умолчанию для новых файлов Excalidraw.\n"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตั้งค่าเครื่องมือและสไตล์การวาดที่คุณต้องการเป็นค่าเริ่มต้นสำหรับไฟล์ Excalidraw ใหม่\n"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tercih ettiğiniz çizim araçları ve stilleri yeni Excalidraw dosyaları için varsayılan olarak ayarlayın.\n"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt công cụ và kiểu vẽ ưa thích của bạn làm mặc định cho các tệp Excalidraw mới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将您偏好的绘图工具和样式设为新的 Excalidraw 文件的默认值。\n"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將您偏好的繪圖工具與樣式設為新 Excalidraw 檔案的預設。"
          }
        }
      }
    },
