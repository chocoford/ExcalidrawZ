    "archiveFilesIncludeLockedFilesDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "^[%d ملف مقفل](inflect: true) سيتم التحقق منه، وفك تشفيره، وتصديره كملف عادي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "^[%d gesperrte Datei](inflect: true) wird authentifiziert, entschlüsselt und als reguläre Dateien exportiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "^[%d locked file](inflect: true) will be authenticated, decrypted, and exported as regular files."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "^[%d archivo bloqueado](inflect: true) será autenticado, descifrado y exportado como archivos regulares."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "^[%d fichier verrouillé](inflect: true) sera authentifié, déchiffré et exporté en tant que fichiers réguliers."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "^[%d लॉक की गई फ़ाइल](inflect: true) को प्रामाणिक किया जाएगा, डिक्रिप्ट किया जाएगा और नियमित फ़ाइलों के रूप में निर्यात किया जाएगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "^[%d file bloccato](inflect: true) verrà autenticato, decrittografato ed esportato come file normali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "^[%dロックされたファイル](inflect: true)が認証され、復号化され、通常のファイルとしてエクスポートされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "^[%d 개의 잠긴 파일](inflect: true)은 인증, 복호화 및 일반 파일로 내보내집니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "^[%d vergrendeld bestand](inflect: true) zal worden geverifieerd, ontsleuteld en geëxporteerd als reguliere bestanden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "^[%d zablokowany plik](inflect: true) zostanie uwierzytelniony, odszyfrowany i wyeksportowany jako zwykły plik."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "^[%d arquivo bloqueado](inflect: true) será autenticado, descriptografado e exportado como arquivos regulares."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "^[%d заблокированный файл](inflect: true) будет аутентифицирован, расшифрован и экспортирован как обычный файл."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "^[%d ไฟล์ที่ถูกล็อก](inflect: true) จะได้รับการตรวจสอบความถูกต้อง ถอดรหัส และส่งออกเป็นไฟล์ปกติ."
          }
        },
