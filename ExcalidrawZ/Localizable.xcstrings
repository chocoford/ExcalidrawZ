    "collaborationHomeDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تقلق، الجلسة مشفرة من طرف إلى طرف، وخاصة تمامًا. حتى خادمنا لا يمكنه رؤية ما ترسمه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Sorge, die Sitzung ist Ende-zu-Ende verschlüsselt und vollständig privat. Nicht einmal unser Server kann sehen, was du zeichnest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't worry, the session is end-to-end encrypted, and fully private. Not even our server can see what you draw."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No te preocupes, la sesión está cifrada de extremo a extremo y es completamente privada. Ni siquiera nuestro servidor puede ver lo que dibujas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne vous inquiétez pas, la session est chiffrée de bout en bout et entièrement privée. Même notre serveur ne peut pas voir ce que vous dessinez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चिंता न करें, सत्र एंड-टू-एंड एन्क्रिप्टेड है, और पूरी तरह से निजी है। हमारे सर्वर को भी यह नहीं दिखता कि आप क्या बनाते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non preoccuparti, la sessione è crittografata end-to-end e completamente privata. Nemmeno il nostro server può vedere cosa disegni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "心配しないでください。このセッションはエンドツーエンドで暗号化されており、完全にプライベートです。私たちのサーバーでも、あなたが描くものを見ることはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "걱정하지 마세요. 세션은 종단 간 암호화되어 있으며, 완전히 비공개입니다. 우리 서버조차도 여러분이 그리는 내용을 볼 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak je geen zorgen, de sessie is end-to-end versleuteld en volledig privé. Zelfs onze server kan zien wat je tekent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie martw się, sesja jest szyfrowana end-to-end i w pełni prywatna. Nawet nasz serwer nie może zobaczyć, co rysujesz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não se preocupe, a sessão é criptografada de ponta a ponta e totalmente privada. Nem mesmo nosso servidor pode ver o que você desenha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не беспокойтесь, сессия защищена сквозным шифрованием и полностью приватна. Даже наш сервер не может видеть, что вы рисуете."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ต้องกังวล เซสชันนี้เข้ารหัสจากปลายทางถึงปลายทางและเป็นส่วนตัวอย่างเต็มที่ แม้แต่เซิร์ฟเวอร์ของเราก็ไม่สามารถเห็นสิ่งที่คุณวาดได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Endişelenmeyin, oturum uçtan uca şifreli ve tamamen özel. Hatta sunucumuz bile ne çizdiğinizi göremez."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đừng lo, phiên làm việc được mã hóa đầu-cuối và hoàn toàn riêng tư. Ngay cả máy chủ của chúng tôi cũng không thể thấy những gì bạn vẽ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请放心，会议是端到端加密的，完全私人。连我们的服务器都无法看到你画的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不用擔心，會議是端到端加密的，並且完全私密。我們的伺服器甚至無法看到你所畫的內容。"
          }
        }
      }
    },
