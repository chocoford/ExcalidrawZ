        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak rozmowy. Wyślij najpierw jedną wiadomość, a potem zobacz kontekst następnego żądania."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não existe uma conversa. Envie uma mensagem primeiro, depois visualize o contexto da próxima solicitação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока нет существующего разговора. Сначала отправьте одно сообщение, затем просмотрите контекст следующего запроса."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีการสนทนาเกิดขึ้น ส่งข้อความหนึ่งก่อน จากนั้นดูตัวอย่างบริบทคำขอถัดไป。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz bir konuşma yok. Önce bir mesaj gönderin, ardından bir sonraki istek bağlamını önizleyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có cuộc hội thoại nào. Gửi một tin nhắn trước, sau đó xem trước ngữ cảnh yêu cầu tiếp theo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚不存在对话。请先发送一条消息，然后预览下一个请求上下文。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未存在對話。先發送一則消息，然後預覽下一個請求上下文。"
          }
        }
      }
    },
