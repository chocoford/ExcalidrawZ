        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルを編集するには、復元する必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 파일을 편집하려면 복원해야 합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om dit bestand te bewerken, moet je het herstellen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby edytować ten plik, musisz go przywrócić."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para editar este arquivo, você precisará recuperá-lo."
