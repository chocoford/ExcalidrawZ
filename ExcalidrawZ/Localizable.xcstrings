    "lockedContentFeatureEncryptMessage": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم تشفير الملف ونقاط التفتيش الخاصة به قبل كتابتهما إلى التخزين."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei und ihre Zwischenstände werden verschlüsselt, bevor sie im Speicher abgelegt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file and its checkpoints are encrypted before they are written to storage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo y sus puntos de control están cifrados antes de ser escritos en el almacenamiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier et ses points de contrôle sont chiffrés avant d'être écrits dans le stockage."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ाइल और इसके चेकपॉइंट्स स्टोरेज में लिखे जाने से पहले एन्क्रिप्ट किए जाते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file e i suoi checkpoint sono crittografati prima di essere scritti nello storage."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルとそのチェックポイントは、ストレージに書き込まれる前に暗号化されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일과 그 체크포인트는 저장소에 기록되기 전에 암호화됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het bestand en zijn checkpoints zijn versleuteld voordat ze naar de opslag worden geschreven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plik i jego punkty kontrolne są szyfrowane przed zapisaniem na nośniku."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo e seus pontos de verificação são criptografados antes de serem gravados no armazenamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл и его контрольные точки зашифровываются перед записью в хранилище."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์และจุดตรวจสอบของมันจะถูกเข้ารหัสก่อนที่จะเขียนลงในพื้นที่เก็บข้อมูล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya ve kontrol noktaları saklamaya yazılmadan önce şifrelenir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tệp và các điểm kiểm tra của nó được mã hóa trước khi chúng được ghi vào bộ nhớ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件及其检查点在写入存储之前会被加密。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "文件及其檢查點在寫入存儲之前會被加密。"
          }
        }
      }
    },
