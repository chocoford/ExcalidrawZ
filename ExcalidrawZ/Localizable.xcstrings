    "aiChatContextUsageHelp": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ من السياق المستخدم قبل الضغط التلقائي.\\nاضغط للضغط الآن"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ des Kontexts vor automatischer Verdichtung verwendet.\\nKlicken Sie jetzt, um zu verdichten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ of context used before auto-compact.\\nClick to compact now"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ de contexto utilizado antes de la compactación automática.\\nHaz clic para compactar ahora"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ de contexte utilisé avant l’auto-compactage.\nCliquez pour compacter maintenant"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ संदर्भ का उपयोग ऑटो-संकुचन से पहले।\\nअब संकुचन के लिए क्लिक करें"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ del contesto utilizzato prima del compattamento automatico.\\nClicca per compattare ora"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の文脈が自動圧縮の前に使用されました。\\n今すぐ圧縮するにはクリックしてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 문맥이 자동 압축 전에 사용되었습니다.\\n지금 압축하려면 클릭하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ van de context gebruikt voor auto-samenvoegen.\\nKlik om nu samen te voegen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ użytego kontekstu przed automatycznym kompresowaniem.\\nKliknij, aby skompaktować teraz"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ de contexto utilizado antes da compactação automática.\\nClique para compactar agora"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ контекста использовано до авто-сжатия.\\nНажмите, чтобы сжать сейчас"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ของบริบทที่ใช้ก่อนการบีบอัดอัตโนมัติ.\nคลิกเพื่อบีบอัดตอนนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ otomatik sıkıştırmadan önce kullanılan bağlam.\\nŞimdi sıkıştırmak için tıklayın"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ngữ cảnh đã sử dụng trước khi tự động thu gọn.\\nNhấn để thu gọn ngay"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的上下文已被使用，自动压缩前请点击压缩。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已使用%@的上下文，將自動壓縮。\\n點擊立即壓縮"
          }
        }
      }
    },
