    "aiChatWelcomeFeatureReadSubtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التقط صورة للوحة حتى يتمكن الذكاء الاصطناعي من التفكير فيها بصريًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Machen Sie einen Snapshot der Leinwand, damit die KI visuell darüber nachdenken kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapshot the canvas so the AI can reason about it visually."
          }
