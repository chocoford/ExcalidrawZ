    "aiChatActiveFileSwitchBlockedToastTitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توقف عن توليد الذكاء الاصطناعي قبل التبديل بين الملفات أو المساحات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppen Sie die KI-Generierung, bevor Sie die Dateien oder Bereiche wechseln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop AI generation before switching files or spaces."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detén la generación de IA antes de cambiar de archivos o espacios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêtez la génération d'IA avant de changer de fichiers ou d'espaces."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फाइलों या स्थानों को स्विच करने से पहले AI जनरेशन बंद करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrompi la generazione AI prima di cambiare file o spazi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルやスペースを切り替える前にAI生成を停止してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일이나 공간을 전환하기 전에 AI 생성을 중단하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop AI-generatie voordat je bestanden of ruimtes wisselt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatrzymaj generację AI przed przełączeniem plików lub przestrzeni."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pare a geração de IA antes de trocar de arquivos ou espaços."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остановите генерацию ИИ перед переключением файлов или пространств."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หยุดการสร้าง AI ก่อนที่จะสลับไฟล์หรือพื้นที่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyalara veya alanlara geçmeden önce AI üretimini durdurun."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngừng tạo AI trước khi chuyển đổi tệp hoặc không gian."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在切换文件或空间之前请停止AI生成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在切換檔案或空間之前，請停止 AI 生成。"
          }
        }
      }
    },
