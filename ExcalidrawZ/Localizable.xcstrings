    "settingsAIMCPServiceModeComparisonOptimizedBestFor": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أفضل عندما يجب أن يعمل العميل كمعاون على دراية بـ ExcalidrawZ، وليس فقط كمولد مخططات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am besten, wenn der Client wie ein ExcalidrawZ-bewusster Assistent arbeiten sollte und nicht nur als Diagrammgenerator."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Best when the client should work like an ExcalidrawZ-aware assistant, not just a diagram generator."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mejor cuando el cliente debe funcionar como un asistente consciente de ExcalidrawZ, no solo como un generador de diagramas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Meilleur lorsque le client doit fonctionner comme un assistant conscient d'ExcalidrawZ, et pas seulement comme un générateur de diagrammes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बेस्ट जब क्लाइंट को ExcalidrawZ-साक्षर सहायक की तरह काम करना चाहिए, न कि केवल एक आरेख जेनरेटर।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ideale quando il client dovrebbe funzionare come un assistente consapevole di ExcalidrawZ, non solo come un generatore di diagrammi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クライアントが単なる図を生成するだけでなく、ExcalidrawZに対応したアシスタントのように動作すべき場合に最適です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클라이언트가 단순한 다이어그램 생성기가 아니라 ExcalidrawZ 인식 도우미처럼 작동할 때 가장 좋습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het beste wanneer de cliënt moet werken als een ExcalidrawZ-bewuste assistent, niet alleen als een diagramgenerator."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najlepsze, gdy klient powinien działać jak asystent świadomy ExcalidrawZ, a nie tylko generator diagramów."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Melhor quando o cliente deve funcionar como um assistente ciente do ExcalidrawZ, não apenas como um gerador de diagramas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Лучше, когда клиент должен работать как ассистент, осведомленный о ExcalidrawZ, а не просто как генератор диаграмм."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดีที่สุดเมื่อไคลเอนต์ควรทำงานเหมือนผู้ช่วยที่รับรู้ ExcalidrawZ ไม่ใช่แค่เครื่องสร้างภาพ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İstemcinin yalnızca bir diyagram oluşturucu değil, ExcalidrawZ'yi bilen bir asistan gibi çalışması gerektiğinde en iyisidir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tốt nhất khi client hoạt động như một trợ lý nhận thức ExcalidrawZ, không chỉ là một trình tạo sơ đồ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当客户端应该像 ExcalidrawZ 识别助手一样工作，而不仅仅是图表生成器时最佳。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當客戶端應該像 ExcalidrawZ 知道的助手而不僅僅是圖表生成器時效果最佳。"
          }
        }
      }
    },
    "settingsAIMCPServiceModeComparisonOptimizedCanvasTools": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنه فحص اللوحة المنبعثة، تصدير الملفات، تغيير تفضيلات اللوحة، التنقل في العرض، استخدام المكتبات، إدراج ميرميد، إدراج الرياضيات، وترقيع العناصر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kann die gerenderte Leinwand inspizieren, Dateien exportieren, Leinwandeinstellungen ändern, die Ansicht navigieren, Bibliotheken nutzen, Mermaid einfügen, Mathematik einfügen und Elemente patchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can inspect the rendered canvas, export files, change canvas preferences, navigate the view, use libraries, insert Mermaid, insert math, and patch elements."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede inspeccionar el lienzo renderizado, exportar archivos, cambiar preferencias del lienzo, navegar por la vista, usar bibliotecas, insertar Mermaid, insertar matemáticas y parchear elementos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Peut inspecter le canevas rendu, exporter des fichiers, changer les préférences du canevas, naviguer dans la vue, utiliser des bibliothèques, insérer Mermaid, insérer des mathématiques et patcher des éléments."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभिव्यक्त किए गए कैनवास की जांच कर सकता है, फ़ाइलें निर्यात कर सकता है, कैनवास प्राथमिकताएँ बदल सकता है, दृश्य को नेविगेट कर सकता है, पुस्तकालयों का उपयोग कर सकता है, Mermaid डाल सकता है, गणित डाल सकता है, और तत्वों को पैच कर सकता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Può ispezionare la tela renderizzata, esportare file, modificare preferenze della tela, navigare nella vista, utilizzare librerie, inserire Mermaid, inserire matematica e patchare elementi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レンダリングされたキャンバスの検査、ファイルのエクスポート、キャンバスの設定の変更、ビューのナビゲート、ライブラリの使用、Mermaidの挿入、数学の挿入、要素のパッチなどが可能です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "렌더링된 캔버스를 검사하고 파일을 내보내며, 캔버스 기본 설정을 변경하고, 뷰를 탐색하고, 라이브러리를 사용하며, Mermaid를 삽입하고, 수학을 삽입하며, 요소를 패치할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan het weergegeven canvas inspecteren, bestanden exporteren, canvasvoorkeuren wijzigen, de weergave navigeren, bibliotheken gebruiken, Mermaid invoegen, wiskunde invoegen en elementen patchen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Może przeglądać renderowany obszar roboczy, eksportować pliki, zmieniać preferencje obszaru roboczego, nawigować widokiem, korzystać z bibliotek, wstawiać Mermaid, wstawiać matematykę i patchować elementy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode inspecionar o canvas renderizado, exportar arquivos, alterar preferências do canvas, navegar na visualização, usar bibliotecas, inserir Mermaid, inserir matemática e corrigir elementos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Может инспектировать отрисованный холст, экспортировать файлы, изменять предпочтения холста, навигировать по виду, использовать библиотеки, вставлять Mermaid, вставлять математику и редактировать элементы."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สามารถตรวจสอบผืนผ้าใบที่เรนเดอร์ ส่งออกไฟล์ เปลี่ยนการตั้งค่าผืนผ้าใบ นำทางมุมมอง ใช้ไลบรารี แทรก Mermaid แทรกคณิตศาสตร์ และแพตช์องค์ประกอบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oluşturulan kanvası inceleyebilir, dosyaları dışa aktarabilir, kanvas tercihlerini değiştirebilir, görünümü gezinebilir, kütüphaneleri kullanabilir, Mermaid ekleyebilir, matematik ekleyebilir ve öğeleri yamanız mümkündür."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có thể kiểm tra canvas đã được hiển thị, xuất tập tin, thay đổi sở thích canvas, điều hướng xem, sử dụng thư viện, chèn Mermaid, chèn toán học và vá các phần tử."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以检查渲染的画布，导出文件，更改画布偏好，导航视图，使用库，插入 Mermaid，插入数学，和修补元素。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可以檢查渲染的畫布、導出檔案、改變畫布首選項、導航視圖、使用庫、插入 Mermaid、插入數學和補丁元素。"
          }
        }
      }
    },
    "settingsAIMCPServiceModeComparisonOptimizedDrawingFlow": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعدل ملف ExcalidrawZ النشط مباشرة بدلاً من إنشاء عرض مولد فقط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bearbeitet die aktive ExcalidrawZ-Datei direkt, anstatt nur eine generierte Ansicht zu erstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edits the active ExcalidrawZ file directly instead of only creating a generated view."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Edita el archivo activo de ExcalidrawZ directamente en lugar de solo crear una vista generada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifie directement le fichier ExcalidrawZ actif au lieu de créer uniquement une vue générée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिर्फ उत्पन्न दृश्य बनाने के बजाय सक्रिय ExcalidrawZ फ़ाइल को सीधे संपादित करता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifica direttamente il file ExcalidrawZ attivo invece di creare solo una vista generata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "生成されたビューを作成するだけでなく、アクティブなExcalidrawZファイルを直接編集します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "생성된 보기만 만드는 대신 활성 ExcalidrawZ 파일을 직접 편집합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewerkt het actieve ExcalidrawZ-bestand direct in plaats van alleen een gegenereerde weergave te maken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Edytuje aktywny plik ExcalidrawZ bezpośrednio zamiast tylko tworzenia wygenerowanego widoku."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Edita o arquivo ativo do ExcalidrawZ diretamente em vez de apenas criar uma visualização gerada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Редактирует активный файл ExcalidrawZ напрямую, а не только создает сгенерированный вид."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แก้ไขไฟล์ ExcalidrawZ ที่เปิดใช้งานโดยตรงแทนที่จะเพียงสร้างมุมมองที่สร้างขึ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkin ExcalidrawZ dosyasını doğrudan düzenler, yalnızca oluşturulmuş bir görünüm oluşturmakla kalmaz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉnh sửa tệp ExcalidrawZ đang hoạt động trực tiếp thay vì chỉ tạo một chế độ xem được tạo ra."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直接编辑活动的 ExcalidrawZ 文件，而不仅仅是创建生成的视图。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "直接編輯活動的 ExcalidrawZ 檔案，而不僅僅是創建生成視圖。"
          }
        }
      }
    },
    "settingsAIMCPServiceModeComparisonOptimizedFileAwareness": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنه سرد وإنشاء وفتح وتأكيد ملفات ExcalidrawZ والملفات المحلية المعتمدة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kann ExcalidrawZ-Dateien und autorisierte lokale Dateien auflisten, erstellen, öffnen und bestätigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can list, create, open, and confirm ExcalidrawZ files and authorized local files."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede listar, crear, abrir y confirmar archivos de ExcalidrawZ y archivos locales autorizados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Peut lister, créer, ouvrir et confirmer des fichiers ExcalidrawZ et des fichiers locaux autorisés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ फ़ाइलों और अधिकृत स्थानीय फ़ाइलों को सूचीबद्ध, बनाना, खोलना और पुष्टि कर सकता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Può elencare, creare, aprire e confermare file ExcalidrawZ e file locali autorizzati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZファイルおよび認可されたローカルファイルをリスト、作成、オープン、および確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ 파일 및 승인된 로컬 파일을 나열, 생성, 열고 확인할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan ExcalidrawZ-bestanden en geautoriseerde lokale bestanden opsommen, maken, openen en bevestigen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Może wylistować, utworzyć, otworzyć i potwierdzić pliki ExcalidrawZ oraz autoryzowane pliki lokalne."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode listar, criar, abrir e confirmar arquivos do ExcalidrawZ e arquivos locais autorizados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Может перечислять, создавать, открывать и подтверждать файлы ExcalidrawZ и авторизованные локальные файлы."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สามารถจัดรายการ สร้าง เปิด และยืนยันไฟล์ ExcalidrawZ และไฟล์โลคัลที่ได้รับอนุญาต"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ dosyalarını ve yetkilendirilmiş yerel dosyaları listeleyebilir, oluşturabilir, açabilir ve onaylayabilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có thể liệt kê, tạo, mở và xác nhận các tệp ExcalidrawZ và các tệp cục bộ được ủy quyền."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以列出、创建、打开和确认 ExcalidrawZ 文件及授权的本地文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可以列出、創建、打開和確認 ExcalidrawZ 檔案和授權本地檔案。"
          }
        }
      }
    },
    "settingsAIMCPServiceModeComparisonOptimizedHistory": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسجل تاريخ ملف ExcalidrawZ حول التغييرات ويمكنه استعادة نقاط التفتيش المحفوظة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufzeichnungen zur ExcalidrawZ-Dateiversionierung in Bezug auf Änderungen und kann gespeicherte Kontrollpunkte wiederherstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Records ExcalidrawZ File History around changes and can restore saved checkpoints."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra el historial de archivos de ExcalidrawZ en torno a los cambios y puede restaurar puntos de control guardados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre l'historique des fichiers ExcalidrawZ autour des changements et peut restaurer des points de contrôle enregistrés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बदलावों के चारों ओर ExcalidrawZ फ़ाइल इतिहास को रिकॉर्ड करता है और सहेजे गए चेकपॉइंट को पुनर्स्थापित कर सकता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra la cronologia del file ExcalidrawZ attorno ai cambiamenti e può ripristinare checkpoint salvati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更にあたるExcalidrawZファイルの履歴を記録し、保存されたチェックポイントを復元できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경 사항 주위에 ExcalidrawZ 파일 히스토리를 기록하고 저장된 체크포인트를 복원할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Registreert ExcalidrawZ-bestandgeschiedenis rond wijzigingen en kan opgeslagen controlepunten herstellen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rejestruje historię plików ExcalidrawZ dotyczących zmian i może przywracać zapisane punkty kontrolne."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra o histórico de arquivos do ExcalidrawZ em torno de mudanças e pode restaurar pontos de verificação salvos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записывает историю файлов ExcalidrawZ вокруг изменений и может восстанавливать сохраненные контрольные точки."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกประวัติไฟล์ ExcalidrawZ รอบการเปลี่ยนแปลงและสามารถคืนค่าจุดตรวจสอบที่บันทึกไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değişiklikler etrafında ExcalidrawZ Dosya Geçmişini kaydeder ve kaydedilmiş kontrol noktalarını geri yükleyebilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi lại Lịch sử Tệp ExcalidrawZ xung quanh các thay đổi và có thể khôi phục các điểm kiểm tra đã lưu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录关于更改的 ExcalidrawZ 文件历史，并可以恢复保存的检查点。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在更改周圍記錄 ExcalidrawZ 檔案歷史並可以恢復已保存的檢查點。"
          }
        }
      }
    },
