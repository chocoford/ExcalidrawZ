    "whatsNewLassoToolDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم أداة اللاسو للتحديد الحر، والتبديل بين أوضاع تحديد الصندوق 'التغليف' أو 'التداخل'."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Lasso-Werkzeug für freihändige Auswahlen verwenden und zwischen den Box-Auswahlmodi 'Umschließen' und 'Überlappen' wechseln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the lasso tool for free-form selection, and switch between Wrap or Overlap box selection modes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa la herramienta Lazo para selección libre y alterna entre los modos de selección por caja Envolver o Superponer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez l'outil lasso pour des sélections en forme libre, et choisissez entre les modes de sélection par boîte « Envelopper » ou « Chevauchement »."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ्री-फॉर्म चयन के लिए लासो टूल का उपयोग करें, और बॉक्स चयन मोड में Wrap या Overlap के बीच स्विच करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa lo strumento lasso per selezioni a mano libera e passa tra le modalità di selezione a casella Wrap o Overlap."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ラッソツールを使用して自由形式の選択を行い、ラップまたはオーバーラップのボックス選択モードに切り替えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라소 도구로 자유형 선택을 하고, 박스 선택 모드에서 감싸기(Wrap) 또는 겹치기(Overlap)로 전환하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik het lasso-gereedschap voor vrijvormselecties en wissel tussen 'Omsluiten' of 'Overlappen' als kaderselectiemodus."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj narzędzia lasso do swobodnego zaznaczania i przełączaj tryby zaznaczania prostokątnego: Wrap lub Overlap."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a ferramenta laço para seleção livre e alterne entre os modos de seleção por caixa: Envolver (Wrap) ou Sobrepor (Overlap)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте инструмент лассо для произвольного выделения и переключайтесь между режимами выделения рамкой (Wrap) и с перекрытием (Overlap)."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้เครื่องมือลาสโซเพื่อเลือกแบบอิสระ และสลับระหว่างโหมดการเลือกกรอบแบบ Wrap หรือ Overlap"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Serbest biçimli seçim için Lasso aracını kullanın ve kutu seçim modları arasında Wrap veya Overlap moduna geçiş yapın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng công cụ lasso để chọn theo hình tự do, và chuyển giữa hai chế độ chọn hộp Wrap hoặc Overlap."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用套索工具进行自由形状选择，并在包裹（Wrap）或重叠（Overlap）框选模式之间切换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用套索工具進行自由選取，並可在「包覆」或「重疊」方框選取模式間切換。"
          }
        }
      }
    },
