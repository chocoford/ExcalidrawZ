    "sidebarFileRowDeletePermanentlyAlertTitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل أنت متأكد من أنك تريد حذف الملف نهائيًا: %@ ؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sind Sie sicher, dass Sie die Datei: %@ dauerhaft löschen möchten?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure to permanently delete the file: %@ ?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Estás seguro de que deseas eliminar permanentemente el archivo: %@ ?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Êtes-vous sûr de vouloir supprimer définitivement le fichier : %@ ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या आप निश्चित रूप से फ़ाइल को स्थायी रूप से हटाना चाहते हैं: %@ ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei sicuro di voler eliminare permanentemente il file: %@ ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルを完全に削除してもよろしいですか: %@ ?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일: %@ 을(를) 영구 삭제하시겠습니까?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weet u zeker dat u het bestand: %@ permanent wilt verwijderen?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy na pewno chcesz trwale usunąć plik: %@ ?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem certeza de que deseja excluir permanentemente o arquivo: %@ ?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы уверены, что хотите навсегда удалить файл: %@ ?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณแน่ใจหรือไม่ที่จะลบไฟล์นี้ถาวร: %@ ?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyayı kalıcı olarak silmek istediğinize emin misiniz: %@ ?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có chắc chắn muốn xóa vĩnh viễn tệp: %@ ?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您确定要永久删除文件%@ 吗？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您確定要永久刪除文件: %@ 嗎？"
