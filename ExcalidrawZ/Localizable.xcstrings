    "settingsSecurityFooter": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احتفظ بمفتاح الاسترداد كخيار احتياطي. ExcalidrawZ يحفظه في سلسلة مفاتيح هذا الجهاز من أجل القفل المستقبلي وفتح النظام."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewahren Sie Ihren Wiederherstellungsschlüssel als Fallback auf. ExcalidrawZ speichert ihn im Schlüsselbund dieses Geräts für zukünftiges Sperren und Entsperren des Systems."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your Recovery Key as the fallback. ExcalidrawZ saves it in this device's Keychain for future locking and system unlock."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda tu Clave de Recuperación como respaldo. ExcalidrawZ la guarda en el llavero de este dispositivo para futuros bloqueos y desbloqueos del sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservez votre clé de récupération comme solution de secours. ExcalidrawZ l'enregistre dans le trousseau de ce dispositif pour les futurs verrous et déverrouillages du système."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी पुनर्प्राप्ति कुंजी को बैकअप के रूप में रखें। ExcalidrawZ इसे इस डिवाइस के कीचेन में भविष्य की लॉकिंग और सिस्टम अनलॉक के लिए सहेजता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni la tua Chiave di Recupero come backup. ExcalidrawZ la salva nel portachiavi di questo dispositivo per futuri blocchi e sblocco del sistema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リカバリーキーをバックアップとして保管してください。ExcalidrawZは将来のロックおよびシステムのロック解除のために、このデバイスのキーチェーンに保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복구 키를 백업으로 보관하세요. ExcalidrawZ는 이 장치의 키체인에 저장하여 향후 잠금을 해제합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaar uw Herstelcode als de back-up. ExcalidrawZ slaat deze op in de sleutelhanger van dit apparaat voor toekomstige vergrendeling en ontgrendeling van het systeem."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachowaj swój Klucz Odzyskiwania jako awaryjny. ExcalidrawZ zapisuje go w Pęku Kluczy tego urządzenia na przyszłe blokowanie i odblokowywanie systemu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha sua Chave de Recuperação como backup. ExcalidrawZ a salva no Chaveiro deste dispositivo para futuros bloqueios e desbloqueios do sistema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраните ваш ключ восстановления как резервный. ExcalidrawZ сохраняет его в связке ключей этого устройства для будущей блокировки и разблокировки системы."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เก็บ Recovery Key ของคุณไว้เป็นทางเลือกสำรอง ExcalidrawZ จะบันทึกไว้ใน Keychain ของอุปกรณ์นี้สำหรับการล็อคในอนาคตและการปลดล็อคระบบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurtarma Anahtarınızı yedekte saklayın. ExcalidrawZ, bunu bu cihazın Anahtar Zinciri'nde gelecekteki kilitleme ve sistem kilidini açma için kaydeder."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ Khóa Khôi Phục của bạn như một phương án dự phòng. ExcalidrawZ lưu nó trong Keychain của thiết bị này để khóa trong tương lai và mở khóa hệ thống."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留恢复密钥作为备用。ExcalidrawZ 将其保存在此设备的钥匙串中，以便将来的锁定和系统解锁。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將您的恢復密鑰保留作為備用。ExcalidrawZ 將其保存在此設備的鑰匙鏈中，以便將來鎖定和系統解鎖。"
          }
        }
      }
    },
