    "aiChatUnavailableNonAppStoreMessage": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الذكاء الاصطناعي متوفر فقط في نسخة متجر التطبيقات حتى الآن. الدفعات خارج عملية الشراء داخل التطبيق غير مدعومة بعد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AI ist derzeit nur in der App Store-Version verfügbar. Zahlungen außerhalb der In-App-Käufe im App Store werden noch nicht unterstützt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI is available only in the App Store version for now. Payments outside App Store In-App Purchase are not supported yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La IA está disponible solo en la versión de App Store por ahora. Los pagos fuera de la compra dentro de la App Store no son compatibles todavía."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'IA n'est disponible que dans la version App Store pour l'instant. Les paiements en dehors de l'achat in-app de l'App Store ne sont pas encore pris en charge."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "AI वर्तमान में केवल ऐप स्टोर संस्करण में उपलब्ध है। ऐप स्टोर इन-ऐप खरीदारी के बाहर भुगतान अभी समर्थित नहीं हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'AI è disponibile solo nella versione App Store per ora. I pagamenti al di fuori dell'acquisto in-app dell'App Store non sono ancora supportati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、AI は App Store 版でのみ利用可能です。App Store のアプリ内購入以外の支払いはまだサポートされていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI는 현재 앱스토어 버전에서만 사용 가능합니다. 앱스토어 내 구매 외 결제는 지원되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "AI is momenteel alleen beschikbaar in de App Store-versie. Betalingen buiten de In-App Aankoop van de App Store worden nog niet ondersteund."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "AI jest dostępne tylko w wersji z App Store. Płatności poza zakupami w aplikacji App Store nie są jeszcze obsługiwane."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A IA está disponível apenas na versão da App Store por enquanto. Pagamentos fora da Compra In-App da App Store ainda não são suportados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Искусственный интеллект сейчас доступен только в версии из App Store. Платежи вне встроенных покупок в App Store пока не поддерживаются."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "AI มีให้บริการเฉพาะในเวอร์ชัน App Store ในตอนนี้ การชำระเงินนอก App Store ในการซื้อภายในแอปยังไม่รองรับ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu an için AI yalnızca App Store versiyonunda mevcuttur. App Store içi satın alımlar dışında ödeme desteklenmiyor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "AI chỉ có sẵn trong phiên bản App Store hiện tại. Các khoản thanh toán ngoài In-App Purchase của App Store chưa được hỗ trợ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前 AI 仅在 App Store 版本中可用。尚不支持 App Store 内购买以外的支付。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前AI僅在App Store版本中可用。尚不支持App Store內購之外的支付方式。"
          }
        }
      }
    },
