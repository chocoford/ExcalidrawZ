    "tipsAIOverviewDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اطلب من AI قراءة وشرح وتحرير لوحتك الحالية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte die KI, deine aktuelle Leinwand zu lesen, zu erklären und zu bearbeiten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask AI to read, explain, and edit your current canvas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pide a la IA que lea, explique y edite tu lienzo actual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez à l'IA de lire, d'expliquer et d'éditer votre canevas actuel."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "AI से अपने वर्तमान कैनवस को पढ़ने, समझाने और संपादित करने के लिए कहें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiedi all'AI di leggere, spiegare e modificare il tuo canvas attuale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIに現在のキャンバスを読み、説明し、編集させます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI에게 현재 캔버스를 읽고, 설명하고, 편집해 달라고 요청하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vraag AI om je huidige canvas te lezen, uit te leggen en te bewerken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poproś AI o przeczytanie, wyjaśnienie i edytowanie Twojego bieżącego płótna."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Peça à IA para ler, explicar e editar seu quadro atual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Попросите ИИ прочитать, объяснить и изменить ваш текущий холст."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขอให้ AI อ่าน อธิบาย และแก้ไขผ้าใบปัจจุบันของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "AI'den mevcut tuvalinizi okumasını, açıklamasını ve düzenlemesini isteyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy yêu cầu AI đọc, giải thích và chỉnh sửa canvas hiện tại của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请 AI 阅读、解释和编辑您当前的画布。"
          }
