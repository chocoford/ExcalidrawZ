    "deletedFileRecoverAlertMessage": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لتحرير هذا الملف، ستحتاج إلى استعادته."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um diese Datei zu bearbeiten, müssen Sie sie wiederherstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To edit this file, you’ll need to recover it."
          }
        },
        "es": {
