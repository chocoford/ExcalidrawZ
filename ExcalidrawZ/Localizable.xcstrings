    "paywallPlanStarterDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح الميزات الأساسية المميزة المثالية للمساهمين المنتظمين بسعر زهيد. يساعد في تغطية التكاليف التشغيلية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalten Sie essentielle Premium-Funktionen frei, die ideal für regelmäßige Mitarbeiter zu einem minimalen Preis sind. Hilft, die Betriebskosten zu decken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlimited collaboration and all core premium features."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloquea funciones premium esenciales ideales para colaboradores regulares a un precio mínimo. Ayudando a cubrir los costos operativos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Débloquez des fonctionnalités premium essentielles idéales pour les collaborateurs réguliers à un prix minimal. Aide à couvrir les coûts opérationnels."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "न्यूनतम मूल्य पर नियमित सहयोगियों के लिए आवश्यक प्रीमियम सुविधाओं को अनलॉक करें। संचालन लागत को कवर करने में मदद करना।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sblocca funzionalità premium essenziali ideali per collaboratori regolari a un prezzo minimo. Aiutando a coprire i costi operativi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "定期的なコラボレーターに最適な基本的なプレミアム機能を最小限の価格で解除します。運営コストのカバーを助けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정기적으로 협업하는 사용자에게 적합한 필수 프리미엄 기능을 최소한의 가격으로 잠금 해제합니다. 운영 비용을 충당하는 데 도움을 줍니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontgrendel essentiële premium functies ideaal voor regelmatige samenwerkers tegen een minimale prijs. Helpt de operationele kosten te dekken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odblokuj niezbędne funkcje premium idealne dla regularnych współpracowników w minimalnej cenie. Pomaga pokryć koszty operacyjne."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloqueie recursos premium essenciais ideais para colaboradores regulares a um preço mínimo. Ajudando a cobrir os custos operacionais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разблокируйте основные премиум функции, идеально подходящие для регулярных участников за минимальную цену. Помогая покрыть операционные расходы."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปลดล็อกฟีเจอร์พรีเมียมที่จำเป็นซึ่งเหมาะสำหรับผู้ที่ทำงานร่วมกันเป็นประจำในราคาที่ต่ำที่สุด ช่วยครอบคลุมค่าใช้จ่ายในการดำเนินงาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düzenli iş birliği yapanlar için ideal olan temel premium özellikleri minimal bir fiyatla açın. İşletme maliyetlerini karşılamaya yardımcı olun."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở khóa các tính năng cao cấp thiết yếu lý tưởng cho những người hợp tác thường xuyên với mức giá tối thiểu. Giúp trang trải chi phí hoạt động."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解锁适合定期合作者的基本高级功能，价格低廉，帮助覆盖运营成本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "解鎖理想的基本高級功能，適合定期合作的用戶，以最低價格幫助覆蓋運營成本。"
          }
        }
      }
    },
