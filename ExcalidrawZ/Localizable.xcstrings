    "settingsICloudDisableByAccountMessage": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرجى الذهاب إلى إعدادات iCloud الخاصة بك وتفعيل iCloud لتطبيق ExcalidrawZ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte gehen Sie zu Ihren iCloud-Einstellungen und aktivieren Sie iCloud für die ExcalidrawZ-App."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please go to your iCloud settings and enable iCloud for the ExcalidrawZ app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor, ve a la configuración de iCloud y habilita iCloud para la aplicación ExcalidrawZ."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veuillez aller dans vos paramètres iCloud et activer iCloud pour l'application ExcalidrawZ."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कृपया अपने iCloud सेटिंग्स पर जाएं और ExcalidrawZ ऐप के लिए iCloud सक्षम करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vai alle impostazioni di iCloud e abilita iCloud per l'app ExcalidrawZ."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud設定に移動し、ExcalidrawZアプリのためにiCloudを有効にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 설정으로 이동하여 ExcalidrawZ 앱에 대해 iCloud를 활성화하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ga naar uw iCloud-instellingen en schakel iCloud in voor de ExcalidrawZ-app."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przejdź do ustawień iCloud i włącz iCloud dla aplikacji ExcalidrawZ."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor, vá para as configurações do iCloud e ative o iCloud para o aplicativo ExcalidrawZ."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пожалуйста, перейдите в настройки iCloud и включите iCloud для приложения ExcalidrawZ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กรุณาไปที่การตั้งค่า iCloud ของคุณและเปิดใช้งาน iCloud สำหรับแอป ExcalidrawZ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lütfen iCloud ayarlarınıza gidin ve ExcalidrawZ uygulaması için iCloud'u etkinleştirin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vui lòng vào cài đặt iCloud của bạn và bật iCloud cho ứng dụng ExcalidrawZ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请前往您的 iCloud 设置，并为 ExcalidrawZ 应用启用 iCloud 功能。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請前往您的 iCloud 設定並為 ExcalidrawZ 應用啟用 iCloud。"
          }
        }
      }
    },
    "settingsICloudDisableByAccountTitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تعطيل مزامنة iCloud حسب إعدادات الحساب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud-Synchronisierung ist aufgrund der Kontoeinstellungen deaktiviert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud synchronization is disabled by account settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronización de iCloud está deshabilitada por la configuración de la cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La synchronisation iCloud est désactivée par les paramètres du compte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud समन्वय खाते की सेटिंग्स द्वारा अक्षम किया गया है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronizzazione iCloud è disabilitata dalle impostazioni dell'account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウント設定によってiCloud同期が無効になっています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 동기화가 계정 설정에 의해 비활성화되었습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud-synchronisatie is uitgeschakeld door accountinstellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronizacja iCloud jest wyłączona przez ustawienia konta."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A sincronização do iCloud está desativada pelas configurações da conta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронизация iCloud отключена по настройкам учетной записи."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การซิงค์ iCloud ถูกปิดใช้งานโดยการตั้งค่าบัญชี"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud senkronizasyonu hesap ayarlarıyla devre dışı bırakılmıştır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đồng bộ hóa iCloud bị vô hiệu hóa do cài đặt tài khoản."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由于账户设置原因，iCloud 同步已被禁用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 同步因帳戶設定而被禁用。"
          }
        }
      }
    },
    "settingsICloudRestartToApplyMessage": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب عليك إعادة فتح التطبيق لتطبيق التغييرات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie sollten die App neu öffnen, um die Änderungen anzuwenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You should reopen the app to apply the changes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Debes volver a abrir la aplicación para aplicar los cambios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous devez rouvrir l'application pour appliquer les modifications."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपको परिवर्तनों को लागू करने के लिए ऐप को फिर से खोलना चाहिए।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dovresti riaprire l'app per applicare le modifiche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更を適用するにはアプリを再起動してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "변경 사항을 적용하려면 앱을 다시 열어야 합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "U moet de app opnieuw openen om de wijzigingen toe te passen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powinieneś ponownie otworzyć aplikację, aby zastosować zmiany."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você deve reabrir o aplicativo para aplicar as alterações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вам следует перезапустить приложение, чтобы применить изменения."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณควรเปิดแอปใหม่เพื่อใช้การเปลี่ยนแปลง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değişiklikleri uygulamak için uygulamayı yeniden açmalısınız."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
