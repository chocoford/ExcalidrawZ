    "aiChatRevertConfirmationDialogMessage": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم استعادة اللوحة على الفور إلى النقطة المرجعية قبل هذه الرسالة، وتجاهل الرسائل اللاحقة، وإعادة ملء المدخل بهذا الطلب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird die Leinwand sofort auf den Punkt vor dieser Nachricht zurückgesetzt, spätere Chat-Nachrichten werden verworfen und der Eingabetext wird mit diesem Prompt aufgefüllt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will immediately restore the canvas to the checkpoint before this message, discard later chat messages, and refill the input with this prompt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto restaurará inmediatamente el lienzo al punto de control antes de este mensaje, descartará mensajes de chat posteriores y rellenará la entrada con este aviso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela restaurera immédiatement le canevas à l'instant précédent ce message, supprimera les messages de chat ultérieurs et remplira à nouveau l'entrée avec cette invite."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह तुरंत कैनवास को इस संदेश से पहले के चेकपॉइंट पर पुनर्स्थापित करेगा, बाद के चैट संदेशों को हटा देगा, और इस प्रॉम्प्ट के साथ इनपुट को फिर से भर देगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo ripristinerà immediatamente la tela al punto di controllo precedente a questo messaggio, scartando i messaggi di chat successivi e riempiendo l'input con questo messaggio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この操作により、キャンバスがこのメッセージの前のチェックポイントに即座に復元され、後のチャットメッセージが破棄され、入力がこのプロンプトで再充填されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 작업은 즉시 캔버스를 이 메시지 이전의 체크포인트로 복원하고, 이후의 채팅 메시지를 삭제하며, 이 프롬프트로 입력을 다시 채웁니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit herstelt het canvas onmiddellijk naar het controlepunt vóór dit bericht, verwerpt latere chatberichten en vult de invoer opnieuw met deze prompt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To natychmiast przywróci płótno do punktu kontrolnego sprzed tej wiadomości, odrzucając późniejsze wiadomości czatu i napełniając pole wejściowe tym zapytaniem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso restaurará imediatamente a tela para o ponto de verificação antes desta mensagem, descartará as mensagens de chat posteriores e preencherá a entrada com este prompt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это немедленно восстановит холст до контрольной точки перед этим сообщением,Discard later chat messages, и заполнит ввод этой подсказкой."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิ่งนี้จะคืนค่าผืนผ้าให้กลับไปยังจุดตรวจสอบก่อนข้อความนี้ เสียข้อความสนทนาที่เกิดขึ้นหลังจากนั้น และเติมข้อมูลในฟอร์มด้วยข้อความนี้อีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, kanvası bu mesajdan önceki duruma hemen geri yükleyecek, sonraki sohbet mesajlarını atacak ve girişi bu istemle dolduracak."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điều này sẽ ngay lập tức khôi phục canvas về điểm kiểm tra trước tin nhắn này, loại bỏ các tin nhắn trò chuyện sau và làm đầy lại đầu vào với lời nhắc này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将立即将画布恢复到此消息之前的检查点，丢弃后续聊天消息，并用此提示填充输入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這將立即將畫布恢復到此消息之前的檢查點，丟棄後續聊天消息，並用此提示重新填充輸入。"
          }
        }
      }
    },
