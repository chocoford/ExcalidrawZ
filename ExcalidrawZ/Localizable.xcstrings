    "migrationExtractMediaItemsDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحسّن أداء التطبيق عبر فصل ملفات الصور والوسائط عن بيانات المستند، مما يجعل عمليات الملفات أسرع وأكثر كفاءة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbessert die Leistung der App, indem Bild- und Mediendateien von den Dokumentdaten getrennt werden, sodass Dateioperationen schneller und effizienter ablaufen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optimizes app performance by separating image and media files from document data, making file operations faster and more efficient."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Optimiza el rendimiento de la aplicación separando los archivos de imagen y multimedia de los datos del documento, haciendo que las operaciones con archivos sean más rápidas y eficientes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Optimise les performances de l'application en séparant les fichiers image et multimédia des données des documents, ce qui rend les opérations sur les fichiers plus rapides et plus efficaces."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दस्तावेज़ डेटा से छवि और मीडिया फ़ाइलों को अलग करके ऐप के प्रदर्शन को अनुकूलित करता है, जिससे फ़ाइल संचालन तेज़ और अधिक कुशल होते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ottimizza le prestazioni dell'app separando i file immagine e multimediali dai dati dei documenti, rendendo le operazioni sui file più veloci ed efficienti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像やメディアファイルをドキュメントデータから分離することで、ファイル操作がより高速かつ効率的になり、アプリのパフォーマンスを最適化します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱 성능을 최적화하기 위해 이미지 및 미디어 파일을 문서 데이터와 분리하여 파일 작업을 더 빠르고 효율적으로 만듭니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Optimaliseert de app-prestaties door beeld- en mediabestanden van documentgegevens te scheiden, waardoor bestandsbewerkingen sneller en efficiënter verlopen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Optymalizuje działanie aplikacji poprzez oddzielenie plików graficznych i multimediów od danych dokumentów, co sprawia, że operacje na plikach są szybsze i bardziej wydajne."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Otimiza o desempenho do aplicativo ao separar arquivos de imagem e mídia dos dados do documento, tornando as operações de arquivo mais rápidas e eficientes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оптимизирует работу приложения, отделяя изображения и медиафайлы от данных документов, что делает операции с файлами быстрее и эффективнее."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มประสิทธิภาพแอปโดยการแยกไฟล์รูปภาพและสื่อออกจากข้อมูลเอกสาร ทำให้การจัดการไฟล์รวดเร็วและมีประสิทธิภาพยิ่งขึ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görüntü ve medya dosyalarını belge verilerinden ayırarak uygulama performansını optimize eder; dosya işlemlerini daha hızlı ve verimli hale getirir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tối ưu hiệu năng ứng dụng bằng cách tách các tệp ảnh và phương tiện khỏi dữ liệu tài liệu, giúp thao tác tệp nhanh hơn và hiệu quả hơn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过将图像和媒体文件与文档数据分离，优化应用性能，使文件操作更快、更高效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過將影像與媒體檔案從文件資料中分離，優化應用程式效能，使檔案操作更快速且更有效率。"
          }
        }
      }
    },
