    "aiChatEnableConsentDataMessage": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد يتم إرسال طلبك ومحتوى القماش ذات الصلة واستدعاءات الأدوات والنتائج والملفات أو الصور المرفقة وبيانات الحساب أو الائتمان عند الحاجة للرد على طلبك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Eingabetext, relevante Canvas-Inhalte, Toolaufrufe und Ergebnisse, angehängte Dateien oder Bilder sowie Konten- oder Kreditmetadaten können bei Bedarf gesendet werden, um Ihre Anfrage zu beantworten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your prompt, relevant canvas content, tool calls and results, attached files or images, and account or credit metadata may be sent when needed to answer your request."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su solicitud, el contenido relevante del lienzo, las llamadas a herramientas y los resultados, los archivos o imágenes adjuntos, y los metadatos de la cuenta o crédito pueden enviarse cuando sea necesario para responder a su solicitud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre prompt, le contenu pertinent du canvas, les appels et résultats des outils, les fichiers ou images joints, et les métadonnées de compte ou de crédit peuvent être envoyés si nécessaire pour répondre à votre demande."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका प्रॉम्प्ट, संबंधित कैनवास सामग्री, उपकरण कॉल और परिणाम, अटैच की गई फ़ाइलें या छवियाँ, और खाता या क्रेडिट मेटाडेटा आपकी अनुरोध का उत्तर देने के लिए आवश्यक होने पर भेजी जा सकती हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo prompt, contenuto pertinente della canvas, chiamate agli strumenti e risultati, file o immagini allegati, e metadati dell'account o del credito possono essere inviati quando necessario per rispondere alla tua richiesta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロンプト、関連するキャンバスの内容、ツールの呼び出しと結果、添付ファイルまたは画像、アカウントまたはクレジットのメタデータは、リクエストに応えるために必要に応じて送信される可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "귀하의 프롬프트, 관련 캔버스 콘텐츠, 도구 호출 및 결과, 첨부된 파일 또는 이미지, 계정 또는 크레딧 메타데이터는 귀하의 요청에 답하기 위해 필요할 때 전송될 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw prompt, relevante canvasinhoud, tooloproepen en resultaten, bijgevoegde bestanden of afbeeldingen, en account- of kredietmetadata kunnen worden verzonden wanneer dat nodig is om uw verzoek te beantwoorden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja sugestia, odpowiednie treści z płótna, wywołania narzędzi i wyniki, załączone pliki lub obrazy oraz dane metadane konta lub kredytów mogą być wysyłane, gdy jest to konieczne, aby odpowiedzieć na Twoje żądanie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu prompt, conteúdo relevante da tela, chamadas de ferramentas e resultados, arquivos ou imagens anexados e dados de conta ou créditos podem ser enviados quando necessário para responder à sua solicitação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш запрос, соответствующее содержимое холста, вызовы инструментов и результаты, прикрепленные файлы или изображения, а также метаданные учетной записи или кредита могут быть отправлены при необходимости для ответа на ваш запрос."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อความเสนอของคุณ, เนื้อหาภาพที่เกี่ยวข้อง, การเรียกเครื่องมือและผลลัพธ์, ไฟล์หรือภาพที่แนบมาทั้งหมด และข้อมูลเมตาของบัญชีหรือเครดิตอาจถูกส่งเมื่อจำเป็นเพื่อตอบคำขอของคุณ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Girdiğiniz, ilgili tuval içeriği, araç çağrıları ve sonuçlar, ekli dosyalar veya görseller ve hesap veya kredi meta verileri, talebinizi yanıtlamak için gerektiğinde gönderilebilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nội dung canvas liên quan đến yêu cầu của bạn, công cụ gọi và kết quả, tệp đính kèm hoặc hình ảnh, và siêu dữ liệu tài khoản hoặc tín dụng có thể được gửi khi cần thiết để trả lời yêu cầu của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的提示、相关画布内容、工具调用和结果、附加文件或图片以及帐户或信用元数据可能会在需要时发送，以回答您的请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為了回應您的請求，您的提示、相關的畫布內容、工具調用及結果、附加的檔案或圖像，以及帳戶或信用資料可能會在需要時發送。"
          }
        }
      }
    },
