    "aiChatClearChatConfimationDialogMessage": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم إزالة جميع الرسائل في هذه المحادثة. ملف الرسم غير متأثر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Nachrichten in diesem Gespräch werden entfernt. Die Zeichnungsdatei bleibt unberührt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All messages in this conversation will be removed. The drawing file is unaffected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los mensajes en esta conversación serán eliminados. El archivo de dibujo no se verá afectado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les messages de cette conversation seront supprimés. Le fichier de dessin reste inchangé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस बातचीत में सभी संदेश हटा दिए जाएंगे। चित्र फ़ाइल अप्रभावित रहेगी।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i messaggi in questa conversazione verranno rimossi. Il file di disegno non ne sarà influenzato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この会話のすべてのメッセージが削除されます。描画ファイルには影響しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 대화의 모든 메시지가 제거됩니다. 드로잉 파일에는 영향을 주지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle berichten in dit gesprek worden verwijderd. Het tekenbestand blijft onaangetast."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie wiadomości w tej rozmowie zostaną usunięte. Plik rysunku nie zostanie naruszony."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as mensagens nesta conversa serão removidas. O arquivo de desenho não será afetado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все сообщения в этом разговоре будут удалены. Файл рисования останется без изменений."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อความทั้งหมดในสนทนานี้จะถูกลบ ไฟล์วาดไม่ถูกกระทบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu konuşmadaki tüm mesajlar silinecek. Çizim dosyası etkilenmeyecek."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tất cả tin nhắn trong cuộc trò chuyện này sẽ bị xóa. Tệp vẽ sẽ không bị ảnh hưởng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此对话中的所有消息将被移除。绘图文件不受影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此對話中的所有消息將被移除。繪圖文件不受影響。"
          }
        }
      }
    },
