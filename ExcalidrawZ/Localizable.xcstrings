    "tipsLibraryDetailLibraryDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُساعدك المكتبة في ExcalidrawZ على إعادة استخدام العناصر وإدارة الأصول المخصّصة بكفاءة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bibliothek in ExcalidrawZ hilft dir, Elemente wiederzuverwenden und benutzerdefinierte Assets effizient zu verwalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Library in ExcalidrawZ helps you reuse elements and manage custom assets efficiently."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La biblioteca en ExcalidrawZ te ayuda a reutilizar elementos y a gestionar activos personalizados de manera eficiente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La bibliothèque d'ExcalidrawZ vous aide à réutiliser des éléments et à gérer efficacement des ressources personnalisées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ में लाइब्रेरी आपको तत्वों का पुनः उपयोग करने और कस्टम एसेट्स को प्रभावी ढंग से प्रबंधित करने में मदद करती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La Libreria di ExcalidrawZ ti aiuta a riutilizzare elementi e a gestire risorse personalizzate in modo efficiente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ のライブラリは要素の再利用やカスタムアセットの効率的な管理に役立ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ의 라이브러리는 요소를 재사용하고 사용자 지정 자산을 효율적으로 관리하는 데 도움이 됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De bibliotheek in ExcalidrawZ helpt je elementen hergebruiken en aangepaste assets efficiënt te beheren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Biblioteka w ExcalidrawZ pomaga ponownie wykorzystywać elementy i efektywnie zarządzać niestandardowymi zasobami."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A Biblioteca no ExcalidrawZ ajuda você a reutilizar elementos e gerenciar ativos personalizados de forma eficiente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Библиотека в ExcalidrawZ помогает повторно использовать элементы и эффективно управлять пользовательскими активами."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไลบรารีใน ExcalidrawZ ช่วยให้คุณนำองค์ประกอบกลับมาใช้ใหม่และจัดการองค์ประกอบที่กำหนดเองได้อย่างมีประสิทธิภาพ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ'deki kütüphane, öğeleri yeniden kullanmanıza ve özel varlıkları verimli bir şekilde yönetmenize yardımcı olur."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thư viện trong ExcalidrawZ giúp bạn tái sử dụng các phần tử và quản lý tài nguyên tùy chỉnh một cách hiệu quả."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ 中的库可帮助你重用元素并高效管理自定义素材。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ 的函式庫可幫助你重複使用元素並有效管理自訂資產。"
          }
        }
      }
    },
