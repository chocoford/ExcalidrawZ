    "recoveryKeySuggestionPasteFullKey": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصق مفتاح الاسترداد الكامل تمامًا كما تم عرضه عند قفل الملف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie den vollständigen Wiederherstellungsschlüssel genau so ein, wie er angezeigt wurde, als die Datei gesperrt wurde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste the full Recovery Key exactly as it was shown when the file was locked."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pega la clave de recuperación completa exactamente como se mostró cuando se bloqueó el archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Collez la clé de récupération complète exactement comme elle a été affichée lorsque le fichier a été verrouillé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूर्ण रिकवरी कुंजी को उसी तरह पेस्ट करें जैसे फ़ाइल लॉक होने पर दिखाया गया था।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Incolla il Recovery Key completo esattamente come è stato mostrato quando il file è stato bloccato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルがロックされているときに表示されたリカバリキーをそのまま貼り付けてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일이 잠겼을 때 보여진 그대로 전체 복구 키를 붙여넣으세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plak de volledige Herstelcode precies zoals deze werd weergegeven toen het bestand werd vergrendeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wklej pełny klucz odzyskiwania dokładnie tak, jak był pokazany, gdy plik był zablokowany."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cole a Chave de Recuperação completa exatamente como foi mostrada quando o arquivo foi bloqueado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставьте полный ключ восстановления точно так, как он был показан, когда файл был заблокирован."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วาง Recovery Key เต็ม ๆ ตามที่แสดงเมื่อไฟล์ถูกล็อก."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilitli dosya gösterildiği gibi tam Kurtarma Anahtarını birebir yapıştırın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dán Recovery Key đầy đủ chính xác như đã hiển thị khi tệp bị khóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "准确粘贴文件锁定时显示的完整恢复密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "精確貼上恢復金鑰，與檔案鎖定時顯示的相同。"
          }
        }
      }
    },
    "recoveryKeySuggestionTryAgainRestart": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حاول مرة أخرى. إذا استمرت هذه المشكلة، أعد تشغيل التطبيق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versuchen Sie es erneut. Wenn dies weiterhin passiert, starten Sie die App neu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again. If this keeps happening, restart the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Intenta de nuevo. Si esto sigue ocurriendo, reinicia la aplicación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayez à nouveau. Si cela continue de se produire, redémarrez l'application."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पुनः प्रयास करें। यदि ऐसा होता रहता है, तो ऐप को पुनः आरंभ करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riprova. Se questo continua a succedere, riavvia l'app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再試行してください。この問題が続く場合は、アプリを再起動してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 시도하세요. 문제가 계속 발생하면 앱을 재시작하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Probeer het opnieuw. Als dit blijft gebeuren, herstart de app."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spróbuj ponownie. Jeśli to się powtarza, zrestartuj aplikację."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tente novamente. Se isso continuar acontecendo, reinicie o aplicativo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Попробуйте еще раз. Если это продолжает происходить, перезапустите приложение."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลองอีกครั้ง หากปัญหานี้ยังเกิดขึ้น ให้รีสตาร์ทแอป."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekrar deneyin. Bu sürekli olursa, uygulamayı yeniden başlatın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thử lại. Nếu vấn đề này liên tục xảy ra, khởi động lại ứng dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "再试一次。如果这种情况持续，重启应用程序。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "再試一次。如果這種情況持續發生，請重啟應用程式。"
          }
        }
      }
    },
