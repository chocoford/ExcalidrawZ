    "settingsAIInformationControlsMessage": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك إيقاف ميزات الذكاء الصناعي في أي وقت. عند إيقافها، لن يقوم ExcalidrawZ بإرسال طلبات الذكاء الصناعي أو تحديث بيانات حساب الذكاء الصناعي ونقاط الائتمان."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie können AI-Funktionen jederzeit deaktivieren. Wenn sie deaktiviert sind, sendet ExcalidrawZ keine AI-Anfragen oder aktualisiert keine AI-Konto- und Guthabendaten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can turn AI features off at any time. When off, ExcalidrawZ will not send AI requests or refresh AI account and credits data."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes desactivar las funciones de IA en cualquier momento. Cuando están desactivadas, ExcalidrawZ no enviará solicitudes de IA ni actualizará datos de cuenta y créditos de IA."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez désactiver les fonctionnalités de l'IA à tout moment. Lorsque désactivé, ExcalidrawZ ne fera pas de demandes à l'IA ni ne rafraîchira les données du compte et des crédits de l'IA."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप किसी भी समय एआई सुविधाओं को बंद कर सकते हैं। जब यह बंद है, ExcalidrawZ एआई अनुरोध नहीं भेजेगा और एआई खाते और क्रेडिट डेटा को ताज़ा नहीं करेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi disattivare le funzionalità AI in qualsiasi momento. Quando è disattivato, ExcalidrawZ non invierà richieste AI né aggiornerà i dati dell'account e del credito AI."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AI機能はいつでもオフにできます。オフにすると、ExcalidrawZはAIリクエストを送信せず、AIアカウントやクレジットデータを更新しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "언제든지 AI 기능을 끌 수 있습니다. 기능이 꺼지면 ExcalidrawZ는 AI 요청을 전송하거나 AI 계정 및 크레딧 데이터를 새로 고치지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt AI-functies op elk moment uitschakelen. Wanneer deze zijn uitgeschakeld, zal ExcalidrawZ geen AI-verzoeken verzenden of de AI-account en kredietgegevens verversen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz wyłączyć funkcje AI w dowolnym momencie. Gdy są wyłączone, ExcalidrawZ nie będzie wysyłać żądań AI ani odświeżać danych o koncie AI i kredytach."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode desligar os recursos de IA a qualquer momento. Quando desligado, o ExcalidrawZ não enviará solicitações de IA ou atualizará os dados da conta e dos créditos de IA."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы можете отключить функции ИИ в любое время. Когда они выключены, ExcalidrawZ не будет отправлять запросы на ИИ и обновлять данные аккаунта и кредитов ИИ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณสามารถปิดฟีเจอร์ AI ได้ตลอดเวลา เมื่อติดปิด ExcalidrawZ จะไม่ส่งคำขอ AI หรือรีเฟรชข้อมูลบัญชีและเครดิต AI"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "AI özelliklerini her an kapatabilirsiniz. Kapatıldığında, ExcalidrawZ AI isteklerini göndermeyecek veya AI hesabı ve kredi verilerini güncellemeyecek."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể tắt các tính năng AI bất cứ lúc nào. Khi tắt, ExcalidrawZ sẽ không gửi yêu cầu AI hoặc làm mới dữ liệu tài khoản và tín dụng AI."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您可以随时关闭AI功能。当关闭时，ExcalidrawZ将不会发送AI请求或刷新AI账户和信用数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您隨時可以關閉 AI 功能。 關閉後，ExcalidrawZ 將不會發送 AI 請求或刷新 AI 帳戶和信用數據。"
          }
        }
      }
    },
