          "stringUnit": {
            "state": "translated",
            "value": "Şu anki kanvas üzerinden resim, PDF ve .excalidraw belgeleri dışa aktarın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xuất hình ảnh, PDF và các tác phẩm .excalidraw từ bề mặt hiện tại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
