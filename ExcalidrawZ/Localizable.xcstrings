    "whatsNewAIProposalCanvasDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اطلب من الذكاء الاصطناعي إعداد تغييرات على اللوحة كاقتراحات، ثم قم بمراجعتها وتطبيقها عندما تكون جاهزة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitten Sie die KI, Entwürfe für Änderungen am Canvas als Vorschläge zu erstellen, und überprüfen und wenden Sie diese an, wenn sie bereit sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask AI to draft canvas changes as proposals, then review and apply them when they are ready."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pida a la IA que redacte cambios en el lienzo como propuestas, luego revíselos y aplícelos cuando estén listos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez à l'IA de rédiger des modifications de canevas sous forme de propositions, puis examinez-les et appliquez-les lorsqu'elles sont prêtes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एआई से अनुरोध करें कि वह कैनवास परिवर्तनों को प्रस्तावों के रूप में तैयार करे, फिर जब वे तैयार हों, तो उन्हें समीक्षा करें और लागू करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiedi all'AI di elaborare modifiche al canvas come proposte, quindi rivedile e applicale quando sono pronte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIにキャンバスの変更を提案としてドラフトさせ、その後、準備が整ったらレビューして適用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI에게 캔버스 변경 사항을 제안서로 작성하도록 요청한 후, 준비가 완료되면 검토하고 적용하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vraag AI om canvaswijzigingen als voorstellen op te stellen, en bekijk en pas deze toe wanneer ze gereed zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poproś AI o przygotowanie zmian w kanwie jako propozycji, a następnie przeglądaj i stosuj je, gdy będą gotowe."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Peça ao AI para elaborar alterações no canvas como propostas, depois revise e aplique quando estiverem prontas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Попросите ИИ подготовить изменения для канваса в виде предложений, а затем проверьте и примените их, когда они будут готовы."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขอให้ AI ร่างการเปลี่ยนแปลง canvas เป็นข้อเสนอ จากนั้นตรวจสอบและนำไปใช้เมื่อพร้อม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yapay Zeka'dan tuval değişikliklerini öneri olarak taslağını istemek, sonra bunları incelip hazır olduklarında uygulamak."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yêu cầu AI soạn thảo các thay đổi của canvas dưới dạng đề xuất, sau đó xem xét và áp dụng khi chúng đã sẵn sàng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求 AI 起草画布更改作为提案，然后在准备好时进行审查和应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請 AI 擬定畫布變更為提案，然後在準備好後進行審查和應用。"
          }
        }
      }
    },
