    "aiChatDisabledMessage": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ميزاته الذكاء الاصطناعي غير مفعلة. لن تقوم ExcalidrawZ بإرسال طلبات الذكاء الاصطناعي أو تحديث بيانات حساب الذكاء الاصطناعي إلا بعد تفعيلها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-Funktionen sind deaktiviert. ExcalidrawZ wird keine AI-Anfragen senden oder AI-Kontodaten aktualisieren, bis Sie sie aktivieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI features are off. ExcalidrawZ will not send AI requests or refresh AI account data until you enable them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las funciones de IA están desactivadas. ExcalidrawZ no enviará solicitudes de IA ni actualizará los datos de la cuenta de IA hasta que las habilites."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fonctionnalités AI sont désactivées. ExcalidrawZ n'enverra pas de demandes AI ni ne mettra à jour les données de compte AI tant que vous ne les aurez pas activées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "AI सुविधाएँ बंद हैं। ExcalidrawZ AI अनुरोध नहीं भेजेगा या AI खाता डेटा को ताज़ा नहीं करेगा जब तक कि आप उन्हें सक्षम न करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le funzionalità AI sono disattivate. ExcalidrawZ non invierà richieste AI né aggiornerà i dati dell'account AI finché non le abiliti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AI機能はオフです。ExcalidrawZはAIリクエストを送信したり、AIアカウントデータを更新したりすることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 기능이 꺼져 있습니다. ExcalidrawZ는 AI 요청을 전송하거나 AI 계정 데이터를 새로 고치지 않습니다. 기능을 활성화하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-functies zijn uitgeschakeld. ExcalidrawZ zal geen AI-aanvragen versturen of AI-accountgegevens vernieuwen totdat je ze inschakelt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Funkcje AI są wyłączone. ExcalidrawZ nie będzie wysyłać zapytań do AI ani odświeżać danych konta AI, dopóki ich nie włączysz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os recursos de IA estão desligados. O ExcalidrawZ não enviará solicitações de IA nem atualizará os dados da conta de IA até que você os ative."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Функции ИИ отключены. ExcalidrawZ не будет отправлять запросы ИИ или обновлять данные учетной записи ИИ, пока вы не включите их."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฟีเจอร์ AI ปิดอยู่ ExcalidrawZ จะไม่ส่งคำขอ AI หรือรีเฟรชข้อมูลบัญชี AI จนกว่าคุณจะเปิดใช้งาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "AI özellikleri kapalı. ExcalidrawZ, AI isteklerini göndermeyecek veya AI hesap verilerini yenilemeyecek, ta ki onları etkinleştirin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các tính năng AI đã tắt. ExcalidrawZ sẽ không gửi yêu cầu AI hoặc làm mới dữ liệu tài khoản AI cho đến khi bạn bật chúng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI功能已关闭。ExcalidrawZ不会发送AI请求或刷新AI帐户数据，直到您启用它们。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 功能已關閉。ExcalidrawZ 將不會發送 AI 請求或更新 AI 帳戶數據，直到您啟用它們。"
          }
        }
      }
    },
