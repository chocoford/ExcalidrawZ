          "stringUnit": {
            "state": "translated",
            "value": "リカバリキーが不完全です。キーを確認して再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복구 키가 불완전합니다. 키를 확인하고 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De Herstelcode is onvolledig. Controleer de code en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klucz odzyskiwania jest niepełny. Sprawdź klucz i spróbuj ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A Chave de Recuperação está incompleta. Verifique a chave e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ восстановления неполный. Проверьте ключ и попробуйте снова."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Recovery Key ไม่ครบถ้วน ตรวจสอบคีย์และลองอีกครั้ง."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurtarma Anahtarı eksik. Anahtarı kontrol edin ve tekrar deneyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Recovery Key không đầy đủ. Kiểm tra khóa và thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复密钥不完整。请检查密钥并重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "恢復金鑰不完整。檢查金鑰並重試。"
          }
        }
      }
    },
