    "aiChatEmptyContentPlaceholderDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اطرح أسئلة حول المخططات الخاصة بك أو احصل على مساعدة بشأن ميزات Excalidraw."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellen Sie Fragen zu Ihren Diagrammen oder erhalten Sie Hilfe bei den Funktionen von Excalidraw."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask questions about your diagrams or get help with Excalidraw features."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz preguntas sobre tus diagramas o recibe ayuda con las funciones de Excalidraw."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Posez des questions sur vos diagrammes ou obtenez de l'aide sur les fonctionnalités d'Excalidraw."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने आरेखों के बारे में प्रश्न पूछें या Excalidraw सुविधाओं में मदद प्राप्त करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai domande sui tuoi diagrammi o chiedi aiuto con le funzionalità di Excalidraw."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "図面に関する質問をしたり、Excalidrawの機能についてのヘルプを受けたりしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다이어그램에 대한 질문을 하거나 Excalidraw 기능에 대한 도움이 필요합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel vragen over je diagrammen of krijg hulp bij Excalidraw-functies."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadawaj pytania dotyczące swoich diagramów lub uzyskuj pomoc w funkcjach Excalidraw."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça perguntas sobre seus diagramas ou obtenha ajuda com os recursos do Excalidraw."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задайте вопросы о своих диаграммах или получите помощь с функциями Excalidraw."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถามคำถามเกี่ยวกับไดอะแกรมของคุณหรือขอความช่วยเหลือเกี่ยวกับฟีเจอร์ของ Excalidraw"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diyagramlarınız hakkında sorular sorun veya Excalidraw özellikleriyle ilgili yardım alın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy đặt câu hỏi về các sơ đồ của bạn hoặc nhận trợ giúp với các tính năng của Excalidraw."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "询问有关您的图表的问题或获取 Excalidraw 功能的帮助。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請詢問有關您圖表的問題或獲取Excalidraw功能的幫助。"
          }
        }
      }
    },
