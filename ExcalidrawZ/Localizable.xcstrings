    "settingsAIInformationDataMessage": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند استخدام الذكاء الصناعي، قد يتم إرسال نص الطلب الخاص بك، ومحتوى اللوحة المعني، واستدعاءات الأدوات والنتائج، والطراز المحدد، والصور المرفقة حسب الحاجة للإجابة على طلبك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Sie AI verwenden, können Ihre Eingabeaufforderung, relevante Canvas-Inhalte, Tool-Aufrufe und Ergebnisse, das ausgewählte Modell und angehängte Bilder nach Bedarf gesendet werden, um Ihre Anfrage zu beantworten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you use AI, your prompt, relevant canvas content, tool calls and results, selected model, and attached images may be sent as needed to answer your request."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando uses IA, tu solicitud, contenido relevante del lienzo, llamadas a herramientas y resultados, modelo seleccionado e imágenes adjuntas pueden ser enviados según sea necesario para responder a tu solicitud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque vous utilisez l'IA, votre prompt, le contenu pertinent du canvas, les appels d'outils et les résultats, le modèle sélectionné et les images jointes peuvent être envoyés si nécessaire pour répondre à votre demande."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब आप एआई का उपयोग करते हैं, तो आपका प्रांप्ट, प्रासंगिक कैनवास सामग्री, टूल कॉल और परिणाम, चयनित मॉडल और संलग्न चित्र आपकी अनुरोध का उत्तर देने के लिए आवश्यकतानुसार भेजे जा सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando utilizzi l'AI, il tuo prompt, il contenuto pertinente della tela, le chiamate agli strumenti e i risultati, il modello selezionato e le immagini allegate possono essere inviati, se necessario, per rispondere alla tua richiesta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIを使用する際には、プロンプト、関連するキャンバス内容、ツールコールと結果、選択されたモデル、および必要に応じて添付画像があなたのリクエストに応えるために送信されることがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI를 사용할 때 귀하의 프롬프트, 관련 캔버스 콘텐츠, 도구 호출 및 결과, 선택된 모델, 첨부된 이미지가 요청에 답하기 위해 필요에 따라 전송될 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wanneer je AI gebruikt, kunnen je prompt, relevante canvasinhoud, gereedschapoproepen en resultaten, geselecteerd model en bijgevoegde beelden indien nodig worden verzonden om je verzoek te beantwoorden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiedy korzystasz z AI, twoje zapytanie, odpowiednie treści płótna, wywołania narzędzi i wyniki, wybrany model oraz dołączone obrazy mogą być przesyłane w miarę potrzeby, aby odpowiedzieć na twoje żądanie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando você usa IA, seu prompt, conteúdo relevante da tela, chamadas de ferramenta e resultados, modelo selecionado e imagens anexadas podem ser enviados conforme necessário para responder à sua solicitação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда вы используете ИИ, ваш запрос, соответствующее содержимое холста, вызовы инструментов и результаты, выбранная модель и прикрепленные изображения могут быть отправлены по мере необходимости для ответа на ваш запрос."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อคุณใช้ AI ข้อความที่คุณส่ง เนื้อหาของผืนผ้าใบที่เกี่ยวข้อง การเรียกใช้เครื่องมือและผลลัพธ์ โมเดลที่เลือก และภาพที่แนบอาจถูกส่งตามที่จำเป็นเพื่อตอบสนองต่อคำขอของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "AI'yi kullandığınızda, talebinizi yanıtlamak için gerekli olabilecek isteminiz, ilgili kanvas içeriği, araç çağrıları ve sonuçlar, seçilen model ve ekli resimler gönderilebilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi bạn sử dụng AI, câu lệnh của bạn, nội dung canvas liên quan, các cuộc gọi công cụ và kết quả, mô hình được chọn và hình ảnh đính kèm có thể được gửi khi cần để trả lời yêu cầu của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在使用AI时，您的提示、相关画布内容、工具调用和结果、选定的模型以及附件图片可能会根据需要发送，以回答您的请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當您使用 AI 時，您的提示、相關畫布內容、工具調用和結果、選定的模型及附加圖像可能會根據需要發送以回答您的請求。"
          }
        }
      }
    },
