    "iCloudSyncingDataDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم حالياً مزامنة البيانات مع iCloud. يرجى الانتظار لحظة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ synchronisiert derzeit Daten mit iCloud. Bitte einen Moment warten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ is currently syncing data with iCloud. Please wait a moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ está sincronizando datos con iCloud. Por favor, espere un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ synchronise actuellement des données avec iCloud. Veuillez patienter un moment."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ वर्तमान में iCloud के साथ डेटा सिंक कर रहा है। कृपया एक क्षण प्रतीक्षा करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ sta attualmente sincronizzando i dati con iCloud. Attendere un momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZは現在iCloudとデータを同期しています。しばらくお待ちください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ가 현재 iCloud와 데이터를 동기화하고 있습니다. 잠시 기다려 주세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ synchroniseert momenteel gegevens met iCloud. Even geduld alstublieft."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ aktualnie synchronizuje dane z iCloud. Proszę czekać chwilę."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ está sincronizando dados com o iCloud. Por favor, aguarde um momento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ в настоящее время синхронизирует данные с iCloud. Пожалуйста, подождите немного."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ กำลังซิงค์ข้อมูลกับ iCloud กรุณารอสักครู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ şu anda iCloud ile verileri senkronize ediyor. Lütfen bir süre bekleyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ đang đồng bộ hóa dữ liệu với iCloud. Vui lòng chờ một chút."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ 正在与 iCloud 同步数据。请稍等片刻。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ 正在與 iCloud 同步數據。請稍候。"
          }
        }
      }
    },
    "iCloudSyncingDataDescription2": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا كنت لا تحتاج إلى iCloud لمزامنة ملفاتك، يمكنك إيقاف ذلك في الإعدادات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Sie iCloud nicht zum Synchronisieren Ihrer Dateien benötigen, können Sie dies in den Einstellungen deaktivieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you don’t need iCloud to sync your files, you can turn this off in the settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si no necesita que iCloud sincronice sus archivos, puede desactivar esto en la configuración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous n'avez pas besoin d'iCloud pour synchroniser vos fichiers, vous pouvez désactiver cette option dans les paramètres."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यदि आपको अपने फ़ाइलों को सिंक करने के लिए iCloud की आवश्यकता नहीं है, तो आप इसे सेटिंग्स में बंद कर सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se non hai bisogno di iCloud per sincronizzare i tuoi file, puoi disattivarlo nelle impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloudでファイルを同期する必要がない場合は、設定でオフにできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일을 iCloud로 동기화할 필요가 없다면, 설정에서 이 기능을 끌 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je iCloud niet nodig hebt om je bestanden te synchroniseren, kun je dit uitschakelen in de instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli nie potrzebujesz, aby iCloud synchronizował Twoje pliki, możesz to wyłączyć w ustawieniach."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se você não precisar que o iCloud sincronize seus arquivos, pode desativar isso nas configurações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если вам не нужно, чтобы iCloud синхронизировал ваши файлы, вы можете отключить это в настройках."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากคุณไม่ต้องการให้ iCloud ซิงค์ไฟล์ของคุณ คุณสามารถปิดการทำงานนี้ในการตั้งค่า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyalarınızı senkronize etmek için iCloud'a ihtiyacınız yoksa, bunu ayarlardan kapatabilirsiniz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu bạn không cần iCloud để đồng bộ hóa tệp, bạn có thể tắt tính năng này trong cài đặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果您不需要 iCloud 同步您的文件，可以在设置中关闭此功能。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果您不需要 iCloud 同步您的檔案，您可以在設置中關閉此功能。"
          }
        }
      }
    },
