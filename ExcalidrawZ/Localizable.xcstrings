        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संपादक के ऊपर एक खींचने योग्य आइसलैंड के रूप में चैट को तैराएं"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fluttua la chat come un'isola trascinabile sopra l'editor"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エディタの上にドラッグ可能なアイランドとしてチャットを浮かせる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편집기 위에 드래그 가능한 아일랜드로 채팅 띄우기"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Druk chat als een sleepbare eiland boven de editor"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pływający czat jako przeciągalna wyspa nad edytorem"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Flutue o chat como uma ilha arrastável sobre o editor"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Плавающий чат как перетаскиваемый остров над редактором"
