    "whatsNewImportPDFDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استيراد ملفات PDF إلى Excalidraw وعرضها صفحةً تلو الأخرى أو وضعها مباشرة على اللوحة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "PDFs in Excalidraw importieren und seitenweise oder direkt auf der Leinwand anzeigen.\n"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import PDFs into Excalidraw and view them page-by-page or laid out directly on the canvas.\n"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos PDF se pueden importar en Excalidraw y verse página por página o dispuestos directamente en el lienzo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importez des PDF dans Excalidraw et consultez-les page par page ou disposés directement sur le canevas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF फ़ाइलों को Excalidraw में आयात करें और उन्हें पृष्ठ-दर-पृष्ठ देखें या सीधे कैनवास पर व्यवस्थित रूप में रखें。\n"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa file PDF in Excalidraw e visualizzali pagina per pagina o disposti direttamente sulla tela."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PDFをExcalidrawに取り込み、ページごとに表示したり、キャンバス上に直接レイアウトして表示できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF를 Excalidraw로 가져와 페이지별로 보거나 캔버스에 바로 배치하여 볼 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Importeer pdf-bestanden in Excalidraw en bekijk ze per pagina of direct op het canvas."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Importuj pliki PDF do Excalidraw i przeglądaj je stronę po stronie lub wyświetlaj rozłożone bezpośrednio na płótnie.\n"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Importe PDFs para o Excalidraw e visualize-os página a página ou dispostos diretamente na tela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Импортируйте PDF-файлы в Excalidraw и просматривайте их постранично или размещайте прямо на холсте.\n"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นำเข้าไฟล์ PDF ลงใน Excalidraw และดูทีละหน้า หรือวางเรียงแสดงบนผืนผ้าใบโดยตรง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF'leri Excalidraw'a aktarın ve sayfaları tek tek veya tuvalde doğrudan yerleştirilmiş olarak görüntüleyin.\n"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập tệp PDF vào Excalidraw và xem theo từng trang hoặc bố trí trực tiếp trên canvas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 PDF 导入 Excalidraw，可逐页查看或直接在画布上排版显示。\n"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將 PDF 匯入 Excalidraw，並可以逐頁檢視或直接在畫布上排版顯示。\n"
          }
        }
      }
    },
