        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ежедневные снимки"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ภาพรวมประจำวัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günlük anlık görüntüler"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản chụp hàng ngày"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每日快照"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每日快照"
          }
        }
      }
    },
    "settingsBackupsDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لضمان سلامة بياناتك، يتم إجراء النسخ الاحتياطية يوميًا والاحتفاظ بها لمدة أسبوع. بعد أسبوع، يتم الاحتفاظ بالنسخ الاحتياطية بفواصل أسبوعية، وبعد شهر، يتم الاحتفاظ بها بفواصل شهرية، وهكذا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um die Sicherheit Ihrer Daten zu gewährleisten, werden täglich Sicherungen erstellt und eine Woche lang aufbewahrt. Nach einer Woche werden die Sicherungen in wöchentlichen Abständen aufbewahrt, und nach einem Monat werden sie in monatlichen Abständen aufbewahrt, und so weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To ensure the safety of your data, backups are performed daily and retained for one week. Beyond one week, backups are kept at weekly intervals, and beyond one month, they are retained at monthly intervals, and so on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para garantizar la seguridad de tus datos, se realizan copias de seguridad diariamente y se retienen durante una semana. Más allá de una semana, las copias de seguridad se mantienen en intervalos semanales, y más allá de un mes, se retienen en intervalos mensuales, y así sucesivamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour garantir la sécurité de vos données, des sauvegardes sont effectuées quotidiennement et conservées pendant une semaine. Au-delà d'une semaine, les sauvegardes sont conservées par intervalles hebdomadaires, et au-delà d'un mois, elles sont conservées par intervalles mensuels, et ainsi de suite."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप数据 की सुरक्षा सुनिश्चित करने के लिए, बैकअप दैनिक रूप से किए जाते हैं और एक सप्ताह के लिए बनाए रखे जाते हैं। एक सप्ताह के बाद, बैकअप को साप्ताहिक अंतराल पर रखा जाता है, और एक महीने के बाद, उन्हें मासिक अंतराल पर बनाए रखा जाता है, और इसी तरह।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per garantire la sicurezza dei tuoi dati, i backup vengono eseguiti quotidianamente e conservati per una settimana. Oltre una settimana, i backup vengono mantenuti a intervalli settimanali, e oltre un mese, vengono conservati a intervalli mensili, e così via."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データの安全を確保するため、バックアップは毎日行われ、1週間保持されます。1週間を超えるバックアップは、週ごとに保持され、1か月を超えると月ごとに保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터의 안전을 보장하기 위해 백업은 매일 수행되며 일주일 동안 보관됩니다. 일주일이 지나면 주간 간격으로 백업이 유지되고, 한 달이 지나면 월간 간격으로 보관됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om de veiligheid van uw gegevens te waarborgen, worden er dagelijks back-ups gemaakt en deze worden gedurende een week bewaard. Na een week worden de back-ups op wekelijkse basis bewaard, en na een maand worden ze maandelijks bewaard, enzovoorts."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby zapewnić bezpieczeństwo Twoich danych, kopie zapasowe są wykonywane codziennie i przechowywane przez tydzień. Po upływie tygodnia, kopie zapasowe są przechowywane w odstępach tygodniowych, a po miesiącu w odstępach miesięcznych, i tak dalej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para garantir a segurança dos seus dados, backups são realizados diariamente e retidos por uma semana. Após uma semana, os backups são mantidos em intervalos semanais, e após um mês, são retidos em intervalos mensais, e assim por diante."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для обеспечения безопасности ваших данных резервные копии создаются ежедневно и хранятся в течение недели. После недели резервные копии хранятся с недельными интервалами, а после месяца — с месячными интервалами и так далее."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพื่อให้มั่นใจในความปลอดภัยของข้อมูลของคุณ การสำรองข้อมูลจะทำทุกวันและเก็บรักษาไว้เป็นเวลาหนึ่งสัปดาห์ หลังจากหนึ่งสัปดาห์ การสำรองข้อมูลจะถูกเก็บไว้ในช่วงเวลารายสัปดาห์ และหลังจากหนึ่งเดือนจะถูกเก็บรักษาไว้ในช่วงเวลารายเดือน และต่อ ๆ ไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verilerinizin güvenliğini sağlamak için yedeklemeler günlük olarak yapılmakta ve bir hafta süreyle saklanmaktadır. Bir haftanın ötesinde, yedeklemeler haftalık aralıklarla saklanır, bir ayın ötesinde ise aylık aralıklarla saklanır ve bu şekilde devam eder."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để đảm bảo an toàn cho dữ liệu của bạn, các bản sao lưu được thực hiện hàng ngày và lưu giữ trong một tuần. Sau một tuần, các bản sao lưu sẽ được lưu giữ theo tuần, và sau một tháng, chúng sẽ được lưu giữ theo tháng, và cứ như vậy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为了确保您的数据安全，我们会每天进行备份，并保留一周时间。一周后，备份将按照每周的频率保存；超过一个月后，备份将按照每月的频率保存，以此类推。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為確保您的數據安全，備份每天進行，並保留一周。超過一周後，備份按每周間隔保留，超過一個月後，按每月間隔保留，以此類推。"
          }
        }
      }
    },
    "settingsBackupsDescriptionSecondary": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الآن، يمكنك اختيار نسخة احتياطية محددة من الشريط الجانبي على اليسار وعرض تفاصيلها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jetzt können Sie ein bestimmtes Backup aus der linken Seitenleiste auswählen und dessen Details anzeigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Now, you can select a specific backup from the sidebar on the left and view its details."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora puedes seleccionar una copia de seguridad específica desde la barra lateral a la izquierda y ver sus detalles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenant, vous pouvez sélectionner une sauvegarde spécifique dans la barre latérale à gauche et voir ses détails."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अब, आप बाईं ओर के साइडबार से एक विशेष बैकअप का चयन कर सकते हैं और इसके विवरण देख सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ora puoi selezionare un backup specifico dalla barra laterale a sinistra e visualizzarne i dettagli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左側のサイドバーから特定のバックアップを選択し、その詳細を表示できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 왼쪽 사이드바에서 특정 백업을 선택하고 세부 정보를 볼 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu kunt u een specifieke back-up selecteren in de zijbalk aan de linkerkant en de details bekijken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Teraz możesz wybrać konkretną kopię zapasową z bocznego panelu po lewej stronie i zobaczyć jej szczegóły."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Agora, você pode selecionar um backup específico na barra lateral à esquerda e visualizar seus detalhes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Теперь вы можете выбрать конкретную резервную копию в боковой панели слева и просмотреть ее детали."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอนนี้คุณสามารถเลือกการสำรองข้อมูลเฉพาะจากแถบด้านซ้ายและดูรายละเอียดของมันได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Artık, soldaki kenar çubuğundan belirli bir yedeği seçebilir ve ayrıntılarını görüntüleyebilirsiniz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bây giờ, bạn có thể chọn một bản sao lưu cụ thể từ thanh bên trái và xem chi tiết của nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在，您可以从左侧边栏中选择一个特定的备份，并查看其详细信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "現在，您可以從左側邊欄選擇特定備份並查看其詳細信息。"
          }
        }
      }
    },
