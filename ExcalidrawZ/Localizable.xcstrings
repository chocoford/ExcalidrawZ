    "settingsAIMCPServerToggleHelp": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح لتطبيقات الذكاء الاصطناعي الخارجية بالاتصال بـ ExcalidrawZ من خلال MCP."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlauben Sie externen KI-Apps, sich über MCP mit ExcalidrawZ zu verbinden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow external AI apps to connect to ExcalidrawZ through MCP."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir que aplicaciones de IA externas se conecten a ExcalidrawZ a través de MCP."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser les applications AI externes à se connecter à ExcalidrawZ via MCP."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बाहरी एआई ऐप्स को MCP के माध्यम से ExcalidrawZ से कनेक्ट करने की अनुमति दें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti alle app AI esterne di connettersi a ExcalidrawZ tramite MCP."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "外部AIアプリがMCPを介してExcalidrawZに接続できるようにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "외부 AI 앱이 MCP를 통해 ExcalidrawZ에 연결할 수 있도록 허용합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta externe AI-apps toe om verbinding te maken met ExcalidrawZ via MCP."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zezwól zewnętrznym aplikacjom AI na połączenie z ExcalidrawZ przez MCP."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir que aplicativos de IA externos se conectem ao ExcalidrawZ através do MCP."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешить внешним AI-приложениям подключаться к ExcalidrawZ через MCP."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อนุญาตให้แอป AI ภายนอกเชื่อมต่อกับ ExcalidrawZ ผ่าน MCP"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dış AI uygulamalarının ExcalidrawZ'ye MCP aracılığıyla bağlanmasına izin verin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép các ứng dụng AI bên ngoài kết nối với ExcalidrawZ thông qua MCP."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许外部 AI 应用通过 MCP 连接到 ExcalidrawZ。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許外部 AI 應用通過 MCP 連接到 ExcalidrawZ。"
          }
        }
      }
    },
