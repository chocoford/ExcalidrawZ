    "settingsMediaCleanupTrashedFilesDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file is in Trash. Selecting it permanently deletes the file, its history, and media no longer used anywhere else."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件位于废纸篓。选择后会永久删除该文件及其历史记录，并清理未被其他内容使用的媒体。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此檔案位於垃圾桶。選取後會永久刪除該檔案及其歷史記錄，並清理未被其他內容使用的媒體。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الملف في سلة المحذوفات. تحديده يحذف الملف بشكل دائم، وتاريخه، والوسائط التي لم تعد مستخدمة في أي مكان آخر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei befindet sich im Papierkorb. Wenn Sie sie auswählen, wird die Datei, ihr Verlauf und Medien, die anderswo nicht mehr verwendet werden, dauerhaft gelöscht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo está en la Papelera. Al seleccionarlo, se elimina permanentemente el archivo, su historial y los medios que ya no se utilizan en ningún otro lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier est dans la Corbeille. Sa sélection supprimera définitivement le fichier, son historique et les médias qui ne sont plus utilisés ailleurs."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह फ़ाइल कचरे में है। इसे चुनने से फ़ाइल, इसका इतिहास, और अन्यत्र उपयोग नहीं की जाने वाली मीडिया स्थायी रूप से हटा दी जाएगी।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo file si trova nel Cestino. Selezionarlo eliminerà definitivamente il file, la sua cronologia e i media non più utilizzati altrove."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルはゴミ箱にあります。このファイルを選択すると、ファイル、その履歴、および他で使用されていないメディアは永久に削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 파일은 휴지통에 있습니다. 선택하면 파일, 그 기록 및 더 이상 사용되지 않는 미디어가 영구적으로 삭제됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit bestand bevindt zich in de Prullenbak. Het selecteren ervan verwijdert het bestand permanent, evenals de geschiedenis en media die nergens anders meer gebruikt worden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten plik znajduje się w Koszu. Wybranie go trwale usuwa plik, jego historię oraz media już nieużywane nigdzie indziej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este arquivo está na Lixeira. Selecioná-lo exclui permanentemente o arquivo, seu histórico e mídias que não são mais usadas em nenhum outro lugar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот файл находится в Корзине. Если вы выберете его, файл, его история и медиа, больше нигде не используемые, будут удалены окончательно."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์นี้อยู่ในถังขยะ การเลือกไฟล์นี้จะลบไฟล์อย่างถาวร ประวัติ และสื่อที่ไม่ถูกใช้งานที่ไหนอีก."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dosya Çöp Kutusunda. Seçmeniz, dosyayı, geçmişini ve başka yerde kullanılmayan medya dosyalarını kalıcı olarak siler."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tệp này đang ở thùng rác. Việc chọn nó sẽ xóa vĩnh viễn tệp, lịch sử của nó và các media không còn được sử dụng ở nơi khác."
          }
        }
      }
    },
    "settingsMediaCleanupTrashedFilesConfirmationMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%d selected files, their history, and media no longer used anywhere else will be permanently deleted. This cannot be undone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将永久删除所选的 %d 个文件、对应历史记录，以及未被其他内容使用的媒体。此操作无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將永久刪除所選的 %d 個檔案、對應歷史記錄，以及未被其他內容使用的媒體。此操作無法復原。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم حذف %d ملف محدد، وتاريخه، والوسائط التي لم تعد مستخدمة في أي مكان آخر بشكل دائم. لا يمكن التراجع عن ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%d ausgewählte Dateien, deren Verlauf und Medien, die anderswo nicht mehr verwendet werden, werden dauerhaft gelöscht. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán permanentemente %d archivos seleccionados, su historial y los medios que ya no se utilizan en ningún otro lugar. Esto no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%d fichiers sélectionnés, leur historique et les médias qui ne sont plus utilisés ailleurs seront supprimés définitivement. Cela ne peut pas être annulé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%d चयनित फ़ाइलें, उनका इतिहास, और अन्यत्र उपयोग नहीं की जाने वाली मीडिया स्थायी रूप से हटाई जाएंगी। यह पूर्ववत नहीं किया जा सकता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%d file selezionati, la loro cronologia e i media non più utilizzati altrove saranno eliminati permanentemente. Questa azione non può essere annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%d件の選択ファイル、その履歴、および他で使用されていないメディアは永久に削除されます。この操作は元に戻せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%d 선택된 파일과 그 기록, 그리고 더 이상 사용되지 않는 미디어가 영구적으로 삭제됩니다. 이 작업은 취소할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%d geselecteerde bestanden, hun geschiedenis en media die nergens anders meer gebruikt worden, worden permanent verwijderd. Dit kan niet ongedaan gemaakt worden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%d wybrane pliki, ich historia oraz media już nieużywane nigdzie indziej zostaną trwale usunięte. Nie można tego cofnąć."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%d arquivos selecionados, seu histórico e mídias que não são mais usadas em nenhum outro lugar serão excluídos permanentemente. Isso não pode ser desfeito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%d выбранных файлов, их история и медиа, больше нигде не используемые, будут удалены окончательно. Это действие нельзя будет отменить."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์ที่เลือก %d ไฟล์ ประวัติของพวกมัน และสื่อที่ไม่ถูกใช้งานที่ไหนอีกจะถูกลบอย่างถาวร ซึ่งไม่สามารถย้อนกลับได้."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%d seçilen dosya, geçmişleri ve başka yerde kullanılmayan medya kalıcı olarak silinecek. Bu işlem geri alınamaz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%d tệp đã chọn, lịch sử của chúng và các media không còn được sử dụng ở nơi khác sẽ bị xóa vĩnh viễn. Điều này không thể hoàn tác."
          }
        }
      }
    },
