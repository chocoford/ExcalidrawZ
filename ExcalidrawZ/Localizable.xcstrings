    "whatsnewAccesibleWithoutNetworkDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل ExcalidrawZ الآن بشكل مثالي دون اتصال بالإنترنت، لذا يمكنك الوصول إلى التطبيق واستخدامه حتى بدون اتصال بالإنترنت."
