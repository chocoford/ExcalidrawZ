    "whatsNewBetterDarkModeDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تعد الصور تفقد تشبع ألوانها، ولم تعد الرموز التعبيرية تُعكس، والمزيد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilder werden nicht mehr entsättigt, Emojis werden nicht mehr invertiert und vieles mehr.\n"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Images no longer desaturated, emojis no longer inverted, and more.\n"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las imágenes ya no aparecen desaturadas, los emojis ya no se invierten y más.\n"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les images ne sont plus désaturées, les emojis ne sont plus inversés, et plus encore.\n"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "छवियाँ अब रंगहीन नहीं होतीं, इमोजी अब उल्टे नहीं दिखते, और भी बहुत कुछ।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le immagini non vengono più desaturate, le emoji non vengono più invertite e altro ancora."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像の彩度が落とされなくなり、絵文字の反転もなくなりました。他にも改善があります。\n"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지의 채도가 낮아지지 않고, 이모지가 반전되지 않는 등 개선되었습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Afbeeldingen worden niet langer gedesatureerd, emoji's worden niet langer omgekeerd en meer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrazy nie są już odbarwione, emoji nie są już odwrócone i inne ulepszenia.\n"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Imagens não são mais dessaturadas, emojis não são mais invertidos e mais.\n"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изображения больше не обесцвечиваются, эмодзи больше не инвертируются и многое другое."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ภาพจะไม่ถูกลดความอิ่มตัวอีกต่อไป อิโมจิจะไม่ถูกกลับสีอีกต่อไป และมีการปรับปรุงอื่นๆ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görüntüler artık soluklaştırılmıyor, emojiler artık ters çevrilmiyor ve daha fazlası.\n"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hình ảnh không còn bị mất màu, biểu tượng cảm xúc không còn bị đảo màu, và nhiều cải tiến khác.\n"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片不再褪色，表情符号不再反色，等等。\n"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "圖片不再去飽和，表情符號不再反色，還有更多改進。\n"
          }
        }
      }
    },
    "whatsNewBetterMathToolDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إنشاء وتحرير صيغ LaTeX و مخططات الدوال مع معاينات حية، وقوالب، وألوان، وتوليد مساعد بالذكاء الاصطناعي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstellen und Bearbeiten von LaTeX-Formeln und Funktionsplots mit Live-Vorschauen, Vorlagen, Farben und KI-unterstützter Generierung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create and edit LaTeX formulas and function plots with live previews, templates, colors, and AI-assisted generation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea y edita fórmulas LaTeX y gráficos de funciones con vistas previas en vivo, plantillas, colores y generación asistida por IA."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez et éditez des formules LaTeX et des graphiques de fonctions avec des aperçus en direct, des modèles, des couleurs et une génération assistée par IA."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "LaTeX सूत्रों और फ़ंक्शन प्लॉट्स को लाइव पूर्वावलोकनों, टेम्पलेट्स, रंगों, और AI-सहायता उत्पन्न करने के साथ बनाएं और संपादित करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea ed edita formule LaTeX e grafici di funzioni con anteprime live, modelli, colori e generazione assistita dall'IA."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブプレビュー、テンプレート、色、AI支援生成を使って、LaTeX数式と関数プロットを作成および編集します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실시간 미리보기, 템플릿, 색상 및 AI 지원 생성을 통해 LaTeX 수식 및 함수 플롯을 만들고 편집하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak en bewerk LaTeX-formules en functieplots met live voorvertoningen, sjablonen, kleuren en AI-ondersteunde generatie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twórz i edytuj formuły LaTeX oraz wykresy funkcji z podglądem na żywo, szablonami, kolorami i generowaniem wspomaganym przez AI."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie e edite fórmulas LaTeX e gráficos de funções com visualizações ao vivo, modelos, cores e geração assistida por IA."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создавайте и редактируйте формулы LaTeX и графики функций с живыми превью, шаблонами, цветами и генерацией с помощью ИИ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สร้างและแก้ไขสูตร LaTeX และกราฟฟังก์ชันพร้อมการแสดงตัวอย่างสด แบบฟอร์ม สี และการสร้างที่ช่วยโดย AI"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Canlı önizlemeler, şablonlar, renkler ve AI destekli üretim ile LaTeX formülleri ve fonksiyon grafiklerini oluşturun ve düzenleyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tạo và chỉnh sửa các công thức LaTeX và đồ thị hàm với bản xem trước trực tiếp, mẫu, màu sắc và tạo dữ liệu hỗ trợ AI."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建和编辑 LaTeX 公式和函数图形，支持实时预览、模板、颜色和 AI 辅助生成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "創建和編輯 LaTeX 公式和函數圖，並具有實時預覽、模板、顏色和 AI 協助生成。"
          }
        }
      }
    },
