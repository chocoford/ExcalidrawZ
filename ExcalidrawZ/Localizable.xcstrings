          "stringUnit": {
            "state": "translated",
            "value": "إذا كنت قد قمت بالترحيل بالفعل على جهاز آخر، فسيستأنف التطبيق تلقائيًا بعد اكتمال المزامنة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Sie die Migration bereits auf einem anderen Gerät durchgeführt haben, wird die App nach der Synchronisierung automatisch fortfahren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you've already migrated on another device, the app will continue automatically after sync."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si ya has migrado en otro dispositivo, la app continuará automáticamente después de la sincronización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous avez déjà effectué la migration sur un autre appareil, l’application reprendra automatiquement après la synchronisation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यदि आपने पहले किसी अन्य डिवाइस पर माइग्रेशन कर लिया है, तो सिंक के बाद ऐप स्वचालित रूप से जारी रहेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se hai già eseguito la migrazione su un altro dispositivo, l'app continuerà automaticamente dopo la sincronizzazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のデバイスですでに移行を済ませている場合、同期が完了するとアプリは自動的に続行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 기기에서 이미 마이그레이션을 완료한 경우, 동기화가 완료된 후 앱이 자동으로 계속 진행됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je de migratie al op een ander apparaat hebt uitgevoerd, gaat de app na synchronisatie automatisch verder."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli migracja została już przeprowadzona na innym urządzeniu, aplikacja wznowi działanie automatycznie po synchronizacji."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Se você já migrou em outro dispositivo, o app continuará automaticamente após a sincronização."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если вы уже выполнили миграцию на другом устройстве, приложение автоматически продолжит работу после синхронизации."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากคุณได้ย้ายข้อมูลบนอุปกรณ์อื่นแล้ว แอปจะดำเนินการต่อโดยอัตโนมัติหลังการซิงค์เสร็จสิ้น."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eğer başka bir cihazda zaten taşıma yaptıysanız, uygulama eşitleme tamamlandıktan sonra otomatik olarak devam edecektir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu bạn đã thực hiện chuyển dữ liệu trên thiết bị khác, ứng dụng sẽ tiếp tục tự động sau khi đồng bộ hóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果您已在其他设备上完成迁移，同步后应用将自动继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果您已在其他裝置上完成遷移，應用程式會在同步後自動繼續。"
          }
        }
      }
    },
