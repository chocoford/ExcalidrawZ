          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wskazówki funkcji będą pokazane ponownie przy następnym otwarciu ExcalidrawZ."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
