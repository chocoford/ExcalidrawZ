    "whatsNewEnhanceInteractiveExperienceDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تحسين تفاصيل التفاعل لتحسين تجربة المستخدم — مثل السحب والإفلات لنقل وإعادة ترتيب الملفات والمجموعات، والنقر المزدوج على ملفات المكتبة (.lib) لفتحها مباشرة، والمزيد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfeinerte Interaktionsdetails zur Verbesserung der Benutzererfahrung — z. B. Drag & Drop zum Verschieben und Neuordnen von Dateien und Gruppen, Doppelklick auf Bibliotheksdateien (.lib), um sie direkt zu öffnen, und mehr."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refined interaction details to improve the user experience—e.g., drag-and-drop to move and reorder files and groups, double-clicking library (.lib) files to open them directly, and more."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detalles de interacción refinados para mejorar la experiencia de usuario — p. ej., arrastrar y soltar para mover y reordenar archivos y grupos, hacer doble clic en archivos de biblioteca (.lib) para abrirlos directamente, y más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affinement des interactions pour améliorer l'expérience utilisateur — par exemple : glisser-déposer pour déplacer et réorganiser les fichiers et les groupes, double-cliquer sur les fichiers de bibliothèque (.lib) pour les ouvrir directement, et plus encore."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इंटरैक्शन विवरणों को परिष्कृत किया गया है ताकि उपयोगकर्ता अनुभव बेहतर हो — उदाहरण के लिए फ़ाइलों और समूहों को स्थानांतरित और पुन:क्रमित करने के लिए ड्रैग-एंड-ड्रॉप, लाइब्रेरी (.lib) फ़ाइलों को सीधे खोलने के लिए डबल‑क्लिक, और भी बहुत कुछ।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dettagli delle interazioni perfezionati per migliorare l'esperienza utente — ad es. trascina e rilascia per spostare e riordinare file e gruppi, doppio clic sui file della libreria (.lib) per aprirli direttamente e altro ancora."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ユーザー体験を向上させるために操作の細部を改善しました。たとえば、ファイルやグループの移動・並べ替えがドラッグ＆ドロップで行えるようになり、ライブラリ（.lib）ファイルをダブルクリックで直接開けるようになったほか、その他の改善も含まれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자 경험을 개선하기 위해 상호작용 세부 사항을 다듬었습니다 — 예: 파일과 그룹을 이동하고 순서를 변경하는 드래그 앤 드롭, 라이브러리(.lib) 파일을 더블클릭하여 바로 열기 등."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfijnde interactiedetails om de gebruikerservaring te verbeteren — bijvoorbeeld slepen en neerzetten om bestanden en groepen te verplaatsen en opnieuw te ordenen, dubbelklikken op bibliotheekbestanden (.lib) om ze direct te openen, en meer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopracowano szczegóły interakcji, aby poprawić doświadczenie użytkownika — np. przeciąganie i upuszczanie w celu przenoszenia i zmiany kolejności plików i grup, podwójne kliknięcie plików biblioteki (.lib) umożliwiające ich bezpośrednie otwarcie i inne."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Detalhes de interação refinados para melhorar a experiência do usuário — por exemplo, arrastar e soltar para mover e reordenar arquivos e grupos, dar duplo clique em arquivos de biblioteca (.lib) para abri-los diretamente e muito mais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уточнены детали взаимодействия для улучшения удобства использования — например, перетаскивание для перемещения и смены порядка файлов и групп, двойной щелчок по файлам библиотеки (.lib) для их прямого открытия и многое другое."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปรับปรุงรายละเอียดการโต้ตอบเพื่อยกระดับประสบการณ์ผู้ใช้ — เช่น การลากแล้วปล่อยเพื่อย้ายและจัดเรียงไฟล์และกลุ่ม, ดับเบิลคลิกที่ไฟล์ไลบรารี (.lib) เพื่อเปิดโดยตรง และอื่นๆ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullanıcı deneyimini iyileştirmek için etkileşim ayrıntıları rafine edildi — örneğin dosya ve grupları taşımak ve yeniden sıralamak için sürükle-bırak, kütüphane (.lib) dosyalarına çift tıklayarak doğrudan açma ve daha fazlası."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinh chỉnh các chi tiết tương tác để nâng cao trải nghiệm người dùng — ví dụ: kéo và thả để di chuyển và sắp xếp lại các tệp và nhóm, nhấp đúp vào các tệp thư viện (.lib) để mở trực tiếp, v.v."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "优化了交互细节以提升用户体验——例如：可通过拖放来移动和重新排序文件与分组，双击库（.lib）文件可直接打开，等等。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "精緻化互動細節以提升使用者體驗，例如支援拖放以移動與重新排序檔案及群組、雙擊庫 (.lib) 檔以直接開啟等等。"
          }
        }
      }
    },
