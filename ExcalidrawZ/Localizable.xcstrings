          "stringUnit": {
            "state": "translated",
            "value": "Yapılandırma dosyası konumu"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vị trí tệp cấu hình"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配置文件位置"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "配置文件位置"
          }
        }
      }
    },
    "settingsAIMCPClaudeDesktopGuideMessage": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتصل Claude Desktop عبر mcp-remote، الذي يربط تكوين MCP القياسي لـ Claude بنقطة نهاية HTTP المحلية لـ ExcalidrawZ. احتفظ بـ ExcalidrawZ مفتوحًا وقم بتمكين خادم MCP أولاً."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Desktop verbindet sich über mcp-remote, das Claudes stdio MCP-Konfiguration mit dem lokalen HTTP MCP-Endpunkt von ExcalidrawZ verbindet. Halten Sie ExcalidrawZ offen und aktivieren Sie zuerst den MCP-Server."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Desktop connects through mcp-remote, which bridges Claude's stdio MCP config to ExcalidrawZ's local HTTP MCP endpoint. Keep ExcalidrawZ open and enable the MCP Server first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Desktop se conecta a través de mcp-remote, que vincula la configuración de stdio MCP de Claude al punto final HTTP MCP local de ExcalidrawZ. Mantén ExcalidrawZ abierto y habilita primero el Servidor MCP."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Desktop se connecte via mcp-remote, qui relie la configuration stdio MCP de Claude au point de terminaison MCP HTTP local d'ExcalidrawZ. Gardez ExcalidrawZ ouvert et activez d'abord le serveur MCP."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्लॉड डेस्कटॉप mcp-remote के माध्यम से कनेक्ट होता है, जो क्लॉड के stdio MCP कॉन्फ़िग को एक्स्कलिड्रॉज़ के स्थानीय HTTP MCP एंडपॉइंट से जोड़ता है। कृपया एक्स्कलिड्रॉज़ को खोला रखें और पहले MCP सर्वर सक्षम करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Desktop si connette tramite mcp-remote, che collega la configurazione stdio MCP di Claude all'endpoint MCP HTTP locale di ExcalidrawZ. Tieni ExcalidrawZ aperto e attiva prima il server MCP."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Claudeデスクトップはmcp-remoteを介して接続され、Claudeのstdio MCP設定をExcalidrawZのローカルHTTP MCPエンドポイントに橋渡しします。まずExcalidrawZを開き、MCPサーバーを有効にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클로드 데스크톱은 mcp-remote를 통해 연결되며, 이는 클로드의 stdio MCP 구성을 ExcalidrawZ의 로컬 HTTP MCP 엔드포인트에 연결합니다. ExcalidrawZ를 열어 두고 먼저 MCP 서버를 활성화하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Desktop maakt verbinding via mcp-remote, dat de stdio MCP-configuratie van Claude koppelt aan het lokale HTTP MCP-eindpunt van ExcalidrawZ. Houd ExcalidrawZ open en schakel eerst de MCP Server in."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Desktop łączy się przez mcp-remote, który łączy konfigurację stdio MCP Claude'a z lokalnym punktem końcowym HTTP MCP ExcalidrawZ. Najpierw otwórz ExcalidrawZ i włącz serwer MCP."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Claude Desktop conecta-se através do mcp-remote, que liga a configuração MCP stdio do Claude ao endpoint HTTP MCP local do ExcalidrawZ. Mantenha o ExcalidrawZ aberto e habilite o Servidor MCP primeiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Desktop подключается через mcp-remote, который связывает конфигурацию stdio MCP Claude с локальной HTTP MCP конечной точкой ExcalidrawZ. Сначала держите ExcalidrawZ открытым и включите MCP сервер."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Desktop เชื่อมต่อผ่าน mcp-remote ซึ่งเชื่อมต่อการตั้งค่า stdio MCP ของ Claude กับจุดสิ้นสุด HTTP MCP ภายในของ ExcalidrawZ โปรดเปิด ExcalidrawZ และเปิดใช้งาน MCP Server ก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Masaüstü, Claude'un stdio MCP yapılandırmasını ExcalidrawZ'in yerel HTTP MCP uç noktasına köprüleyen mcp-remote üzerinden bağlanır. Öncelikle ExcalidrawZ'i açık tutun ve MCP Sunucusunu etkinleştirin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Desktop kết nối thông qua mcp-remote, kết nối cấu hình stdio MCP của Claude với điểm cuối MCP HTTP cục bộ của ExcalidrawZ. Giữ ExcalidrawZ mở và kích hoạt máy chủ MCP trước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Desktop 通过 mcp-remote 连接，它会把 Claude 的 stdio MCP 配置桥接到 ExcalidrawZ 的本地 HTTP MCP 端点。请先保持 ExcalidrawZ 打开并启用 MCP 服务器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Desktop 透過 mcp-remote 連接，它會把 Claude 的 stdio MCP 配置橋接到 ExcalidrawZ 的本地 HTTP MCP 端點。請先保持 ExcalidrawZ 開啟並啟用 MCP 伺服器。"
          }
        }
      }
    },
    "settingsAIMCPClaudeDesktopGuideSteps": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في Claude Desktop، افتح الإعدادات > المطور > تعديل التكوين. الصق تكوين المcpServers أدناه في claude_desktop_config.json، واحفظ الملف، ثم أعد تشغيل Claude Desktop. هذا يتطلب Node.js/npx."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie in Claude Desktop die Einstellungen > Entwickler > Konfiguration bearbeiten. Fügen Sie die mcpServers-Konfiguration unten in die claude_desktop_config.json ein, speichern Sie die Datei und starten Sie Claude Desktop neu. Dies erfordert Node.js/npx."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Claude Desktop, open Settings > Developer > Edit Config. Paste the mcpServers configuration below into claude_desktop_config.json, save the file, then restart Claude Desktop. This requires Node.js/npx."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En Claude Desktop, abre Configuración > Desarrollador > Editar Config. Pega la configuración de mcpServers a continuación en claude_desktop_config.json, guarda el archivo y luego reinicia Claude Desktop. Esto requiere Node.js/npx."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans Claude Desktop, ouvrez Paramètres > Développeur > Modifier la configuration. Collez la configuration mcpServers ci-dessous dans claude_desktop_config.json, enregistrez le fichier, puis redémarrez Claude Desktop. Cela nécessite Node.js/npx."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्लॉड डेस्कटॉप में, सेटिंग्स > डेवलपर > कॉन्फ़िग संपादित करें खोलें। नीचे दिए गए mcpServers कॉन्फ़िगरेशन को claude_desktop_config.json में पेस्ट करें, फ़ाइल सहेजें, फिर क्लॉड डेस्कटॉप को फिर से चालू करें। इसके लिए Node.js/npx की आवश्यकता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In Claude Desktop, apri Impostazioni > Sviluppatore > Modifica Config. Incolla la configurazione mcpServers qui sotto in claude_desktop_config.json, salva il file e poi riavvia Claude Desktop. Questo richiede Node.js/npx."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Claudeデスクトップで、設定 > 開発者 > 設定の編集を開きます。以下のmcpServers設定をclaude_desktop_config.jsonに貼り付けて、ファイルを保存し、その後Claudeデスクトップを再起動してください。これはNode.js/npxを必要とします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클로드 데스크톱에서 설정 > 개발자 > 구성 편집을 엽니다. 아래의 mcpServers 구성을 claude_desktop_config.json에 붙여넣고 파일을 저장한 후 클로드 데스크톱을 재시작하십시오. Node.js/npx가 필요합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open in Claude Desktop Instellingen > Ontwikkelaar > Configuratie bewerken. Plak de mcpServers-configuratie hieronder in claude_desktop_config.json, sla het bestand op en herstart Claude Desktop. Dit vereist Node.js/npx."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W Claude Desktop otwórz Ustawienia > Deweloper > Edytuj konfigurację. Wklej konfigurację mcpServers poniżej do claude_desktop_config.json, zapisz plik, a następnie zrestartuj Claude Desktop. To wymaga Node.js/npx."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "No Claude Desktop, abra Configurações > Desenvolvedor > Editar Config. Cole a configuração mcpServers abaixo no claude_desktop_config.json, salve o arquivo e reinicie o Claude Desktop. Isso requer Node.js/npx."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В Claude Desktop откройте Настройки > Разработчик > Редактировать конфигурацию. Вставьте конфигурацию mcpServers ниже в файл claude_desktop_config.json, сохраните файл, затем перезапустите Claude Desktop. Для этого требуется Node.js/npx."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใน Claude Desktop ให้เปิด การตั้งค่า > นักพัฒนา > แก้ไขการตั้งค่า วางการตั้งค่าต่อไปนี้ลงใน claude_desktop_config.json บันทึกไฟล์ จากนั้นรีสตาร์ท Claude Desktop ทั้งนี้จำเป็นต้องใช้ Node.js/npx"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Masaüstü'nde Ayarlar > Geliştirici > Yapılandırmayı Düzenle bölümünü açın. Aşağıdaki mcpServers yapılandırmasını claude_desktop_config.json dosyasına yapıştırın, dosyayı kaydedin ve ardından Claude Masaüstü'nü yeniden başlatın. Bu, Node.js/npx gerektirir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trong Claude Desktop, mở Cài đặt > Nhà phát triển > Chỉnh sửa cấu hình. Dán cấu hình mcpServers bên dưới vào file claude_desktop_config.json, lưu tệp, sau đó khởi động lại Claude Desktop. Điều này yêu cầu Node.js/npx."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Claude Desktop 中，打开设置 > 开发者 > 编辑配置。将下面的 mcpServers 配置粘贴到 claude_desktop_config.json，保存文件，然后重启 Claude Desktop。此方式需要 Node.js/npx。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Claude Desktop 中，打開設置 > 開發者 > 編輯配置。將下面的 mcpServers 配置貼到 claude_desktop_config.json，保存文件，然後重新啟動 Claude Desktop。此方式需要 Node.js/npx。"
          }
        }
      }
    },
