        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien werden jetzt effizienter gespeichert, was die Zuverlässigkeit erhöht und künftige Verbesserungen der Synchronisation ermöglicht.\n"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files are now stored more efficiently for better reliability and future sync improvements.\n"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos ahora se almacenan de forma más eficiente para una mayor fiabilidad y futuras mejoras en la sincronización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers sont désormais stockés de manière plus efficace pour une meilleure fiabilité et pour de futures améliorations de la synchronisation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ाइलें अब बेहतर विश्वसनीयता और भविष्य के सिंक सुधारों के लिए अधिक कुशलता से संग्रहीत की जाती हैं。\n"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I file ora vengono archiviati in modo più efficiente per una maggiore affidabilità e per migliorare la sincronizzazione in futuro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルはより効率的に保存されるようになり、信頼性が向上するとともに、将来の同期改善に備えています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일이 이제 더 효율적으로 저장되어 안정성이 향상되고 향후 동기화 개선에 도움이 됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestanden worden nu efficiënter opgeslagen voor betere betrouwbaarheid en toekomstige synchronisatieverbeteringen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pliki są teraz przechowywane bardziej efektywnie, co poprawia niezawodność i umożliwia przyszłe usprawnienia synchronizacji.\n"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os arquivos agora são armazenados de forma mais eficiente para maior confiabilidade e para futuras melhorias na sincronização."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлы теперь хранятся более эффективно для повышения надежности и будущих улучшений синхронизации.\n"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์ถูกจัดเก็บอย่างมีประสิทธิภาพมากขึ้น เพื่อความเสถียรที่ดีขึ้นและรองรับการปรับปรุงการซิงค์ในอนาคต"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyalar artık daha güvenilir ve gelecekteki senkronizasyon iyileştirmeleri için daha verimli şekilde saklanıyor.\n"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các tệp hiện được lưu trữ hiệu quả hơn để tăng độ tin cậy và cải thiện đồng bộ trong tương lai."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件现在以更高效的方式存储，以提高可靠性并为未来的同步改进做准备。\n"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "現在以更有效率的方式儲存檔案，以提升可靠性並利於未來的同步改進。\n"
          }
        }
      }
    },
