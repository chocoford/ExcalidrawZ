        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この復旧キーを保存してください。すべてのロックされたExcalidrawZコンテンツのロックを解除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 복구 키를 저장하세요. 모든 잠긴 ExcalidrawZ 콘텐츠를 잠금 해제합니다."
          }
        },
        "nl": {
          "stringUnit": {
