    "whatsNewIOSMouseControlsDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "على iPad و iPhone، يمكن الآن للفأرات ولوحات التتبع المتصلة تمرير اللوحة والتكبير بشكل أكثر طبيعية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf iPad und iPhone können verbundene Mäuse und Trackpads jetzt die Leinwand scrollen und natürlicher zoomen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On iPad and iPhone, connected mice and trackpads can now scroll the canvas and zoom more naturally."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En iPad y iPhone, los ratones y trackpads conectados ahora pueden desplazar el lienzo y hacer zoom de manera más natural."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur iPad et iPhone, les souris et trackpads connectés peuvent désormais faire défiler le canevas et zoomer de manière plus naturelle."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आईपैड और आईफोन पर, जुड़े हुए माउस और ट्रैकपैड अब कैनवास को स्क्रॉल कर सकते हैं और अधिक स्वाभाविक रूप से ज़ूम कर सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Su iPad e iPhone, i mouse e i trackpad connessi possono ora scorrere la tela e zoomare in modo più naturale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPadとiPhoneでは、接続されたマウスやトラックパッドを使用して、キャンバスをより自然にスクロールしたりズームしたりできるようになりました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPad와 iPhone에서는 연결된 마우스와 트랙패드가 이제 캔스를 스크롤하고 더 자연스럽게 확대할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op iPad en iPhone kunnen aangesloten muizen en trackpads nu het canvas scrollen en natuurlijker inzoomen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na iPadzie i iPhonie podłączone myszy i gładziki mogą teraz przewijać płótno i powiększać w bardziej naturalny sposób."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "No iPad e iPhone, mouses e trackpads conectados agora podem rolar a tela e ampliar de forma mais natural."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На iPad и iPhone теперь можно прокручивать холст и зумировать более естественно с помощью подключенных мышей и трекпадов."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บน iPad และ iPhone เมาส์และแทร็คแพดที่เชื่อมต่อแล้วสามารถเลื่อนผืนผ้าและซูมได้อย่างเป็นธรรมชาติมากขึ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPad ve iPhone'da, bağlı fareler ve dokunmatik yüzeyler artık kanvası kaydırabilir ve daha doğal bir şekilde yakınlaştırabilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trên iPad và iPhone, chuột và bàn di được kết nối giờ đây có thể cuộn canvas và thu phóng một cách tự nhiên hơn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPad 和 iPhone 上，连接的鼠标和触控板现在可以更自然地滚动画布和进行缩放。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPad 和 iPhone 上，連接的滑鼠和觸控板現在可以更自然地滾動畫布和縮放。"
          }
        }
      }
    },
    "whatsNewIOSMouseControlsTitle": {
