    "whatsNewApplePencilToolbarDescrition": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختبر تحكمًا دقيقًا ورسمًا طبيعيًا مع شريط الأدوات الجديد المصمم خصيصًا لمستخدمي Apple Pencil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erleben Sie präzise Kontrolle und natürliches Zeichnen mit der brandneuen Werkzeugleiste, die speziell für Apple Pencil-Nutzer entwickelt wurde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Experience precise control and natural drawing with the brand new toolbar designed specifically for Apple Pencil users."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimenta un control preciso y un dibujo natural con la nueva barra de herramientas diseñada específicamente para usuarios de Apple Pencil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profitez d'un contrôle précis et d'un dessin naturel avec la toute nouvelle barre d'outils conçue spécialement pour les utilisateurs d'Apple Pencil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप्पल पेंसिल उपयोगकर्ताओं के लिए विशेष रूप से डिज़ाइन किए गए नए टूलबार के साथ सटीक नियंत्रण और प्राकृतिक चित्रण का अनुभव करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sperimenta un controllo preciso e un disegno naturale con la nuovissima barra degli strumenti progettata specificamente per gli utenti di Apple Pencil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Pencilユーザーのために特別に設計された新しいツールバーで、精密な操作と自然な描画を体験してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Pencil 사용자를 위해 특별히 설계된 새로운 툴바로 정밀한 제어와 자연스러운 드로잉을 경험하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ervaar nauwkeurige controle en natuurlijk tekenen met de gloednieuwe werkbalk die speciaal is ontworpen voor Apple Pencil-gebruikers."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doświadcz precyzyjnej kontroli i naturalnego rysowania dzięki nowemu paskowi narzędzi zaprojektowanemu specjalnie dla użytkowników Apple Pencil."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimente controle preciso e desenho natural com a nova barra de ferramentas projetada especificamente para usuários do Apple Pencil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте точный контроль и естественное рисование с совершенно новой панелью инструментов, специально разработанной для пользователей Apple Pencil."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สัมผัสการควบคุมที่แม่นยำและการวาดที่เป็นธรรมชาติด้วยแถบเครื่องมือใหม่ที่ออกแบบมาโดยเฉพาะสำหรับผู้ใช้ Apple Pencil."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Pencil kullanıcıları için özel olarak tasarlanmış yeni araç çubuğu ile hassas kontrol ve doğal çizim deneyimi yaşayın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trải nghiệm sự kiểm soát chính xác và vẽ tự nhiên với thanh công cụ hoàn toàn mới được thiết kế đặc biệt cho người dùng Apple Pencil."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "体验精确控制和自然绘画的新工具栏，专为苹果铅笔用户设计。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "體驗精確的控制和自然的繪畫，使用專為 Apple Pencil 用戶設計的全新工具欄。"
          }
        }
      }
    },
