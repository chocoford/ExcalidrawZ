          "stringUnit": {
            "state": "translated",
            "value": "قم بقفل الملفات الحساسة باستخدام التشفير، وافتحها باستخدام مصادقة النظام أو مفتاح الاسترداد، واحتفظ بالذكاء الاصطناعي بعيدًا عن قراءة المحتوى المقفل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sperren Sie sensible Dateien mit Verschlüsselung, entsperren Sie sie mit Systemauthentifizierung oder einem Wiederherstellungsschlüssel und verhindern Sie, dass die KI auf gesperrte Inhalte zugreift."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lock sensitive files with encryption, unlock them with system authentication or a Recovery Key, and keep AI from reading locked content."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquee archivos sensibles con cifrado, desbloquíelos con autenticación del sistema o una clave de recuperación, y evite que la IA lea el contenido bloqueado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrouillez des fichiers sensibles avec cryptage, déverrouillez-les avec une authentification système ou une clé de récupération, et empêchez l'IA de lire le contenu verrouillé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संवेदनशील फ़ाइलों को एन्क्रिप्शन के साथ लॉक करें, उन्हें सिस्टम प्रमाणन या एक रिकवरी कुंजी के साथ अनलॉक करें, और एआई को_locked_ सामग्री पढ़ने से रोकें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocca file sensibili con crittografia, sbloccali con autenticazione di sistema o una Chiave di Recupero e impedisci all'AI di leggere contenuti bloccati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "機密ファイルを暗号化してロックし、システム認証またはリカバリキーでアンロックし、AIがロックされたコンテンツを読み取れないようにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "민감한 파일을 암호화하여 잠금 설정 후, 시스템 인증 또는 복구 키를 사용하여 잠금을 해제하고 AI가 잠긴 내용을 읽지 못하도록 하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergrendel gevoelige bestanden met encryptie, ontgrendel ze met systeemauthenticatie of een herstelcode, en voorkom dat AI vergrendelde inhoud leest."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zablokuj wrażliwe pliki za pomocą szyfrowania, odblokowuj je za pomocą autoryzacji systemu lub klucza odzyskiwania i uniemożliwiaj AI odczytywanie zablokowanej zawartości."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueie arquivos sensíveis com criptografia, desbloqueie-os com autenticação do sistema ou uma Chave de Recuperação, e impeça que o AI leia o conteúdo bloqueado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Блокируйте конфиденциальные файлы с помощью шифрования, разблокируйте их с помощью системной аутентификации или ключа восстановления и предотвратите доступ ИИ к заблокированному содержимому."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ล็อกไฟล์ที่สำคัญด้วยการเข้ารหัส ปลดล็อกด้วยการพิสูจน์ตัวตนของระบบหรือ Recovery Key และป้องกัน AI ไม่ให้เข้าถึงเนื้อหาที่ถูกล็อก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hassas dosyaları şifreleme ile kilitleyin, sistem kimlik doğrulaması veya Kurtarma Anahtarı ile açın ve Yapay Zeka'nın kilitli içeriği okumasını engelleyin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khóa các tệp nhạy cảm bằng mã hóa, mở khóa chúng bằng xác thực hệ thống hoặc một mã Khôi phục, và ngăn AI đọc nội dung đã khóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用加密锁定敏感文件，通过系统身份验证或恢复密钥解锁，并阻止 AI 读取锁定内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用加密鎖定敏感文件，利用系統身份驗證或恢復金鑰解鎖，並防止 AI 閱讀鎖定內容。"
          }
        }
      }
    },
