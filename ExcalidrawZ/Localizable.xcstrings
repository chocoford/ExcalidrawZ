    "whatsNewCustomFileSortingDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك إعادة ترتيب الملفات بسهولة عن طريق سحبها إلى الموضع المطلوب، أو ترتيبها بسرعة باستخدام سمات محددة من خلال عناصر التحكم أدناه قائمة الملفات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien einfach neu anordnen, indem Sie sie an die gewünschte Position ziehen, oder schnell mit spezifischen Attributen mithilfe der Steuerelemente unter der Dateiliste sortieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Easily reorder files by dragging them into your desired position, or sort quickly using specific attributes with the controls below the file list."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reordene fácilmente los archivos arrastrándolos a la posición deseada, o clasifíquelos rápidamente utilizando atributos específicos con los controles debajo de la lista de archivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réorganisez facilement les fichiers en les faisant glisser à votre position désirée, ou triez rapidement en utilisant des attributs spécifiques avec les contrôles sous la liste de fichiers."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ाइलों को खींचकर अपनी इच्छित स्थिति में आसानी से पुनर्व्यवस्थित करें, या फ़ाइल सूची के नीचे नियंत्रणों का उपयोग करके विशिष्ट विशेषताओं के साथ जल्दी से क्रमबद्ध करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riordina facilmente i file trascinandoli nella posizione desiderata, oppure ordina rapidamente utilizzando attributi specifici con i controlli sotto l'elenco dei file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルをドラッグして希望の位置に簡単に並べ替えたり、ファイルリストの下にあるコントロールを使って特定の属性で素早く並べ替えたりできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원하는 위치로 드래그하여 파일의 순서를 쉽게 변경하거나, 파일 목록 아래의 컨트롤을 사용하여 특정 속성으로 빠르게 정렬할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herschik bestanden eenvoudig door ze naar de gewenste positie te slepen, of sorteer snel met specifieke attributen met de bedieningselementen onder de bestandenlijst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Łatwo zmieniaj kolejność plików, przeciągając je w żądane miejsce, lub szybko sortuj, używając określonych atrybutów za pomocą kontrolek poniżej listy plików."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Reordene facilmente os arquivos arrastando-os para a posição desejada ou classifique rapidamente usando atributos específicos com os controles abaixo da lista de arquivos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Легко изменяйте порядок файлов, перетаскивая их в нужное положение, или быстро сортируйте с помощью определённых атрибутов с помощью элементов управления под списком файлов."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จัดเรียงไฟล์ใหม่ได้อย่างง่ายดายโดยการลากไปยังตำแหน่งที่ต้องการ หรือเรียงลำดับอย่างรวดเร็วโดยใช้คุณสมบัติเฉพาะด้วยการควบคุมด้านล่างรายการไฟล์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyaları istediğiniz konuma sürükleyerek kolayca yeniden sıralayın veya dosya listesinin altındaki kontrolleri kullanarak belirli özelliklere göre hızlıca sıralayın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dễ dàng sắp xếp lại các tệp bằng cách kéo chúng vào vị trí mong muốn, hoặc sắp xếp nhanh chóng bằng cách sử dụng các thuộc tính cụ thể với các điều khiển bên dưới danh sách tệp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过拖动文件到您想要的位置轻松重新排序，或使用文件列表下方的控件快速按特定属性排序。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輕鬆通過拖動檔案到您想要的位置來重新排序，或使用檔案列表下方的控制項快速按特定屬性排序。"
          }
        }
      }
    },
