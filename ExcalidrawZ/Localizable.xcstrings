        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحكم فيما إذا كان بإمكان الذكاء الاصطناعي قراءة الملف الحالي. عند إخفائه، يمكن للذكاء الاصطناعي still الإجابة على الأسئلة العامة وإنشاء اقتراحات للتعديلات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steuern Sie, ob die KI die aktuelle Datei lesen kann. Wenn sie ausgeblendet ist, kann die KI trotzdem allgemeine Fragen beantworten und Vorschlagänderungen erstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Control whether AI can read the current file. When hidden, AI can still answer general questions and create proposal edits."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Controla si la IA puede leer el archivo actual. Cuando está oculto, la IA aún puede responder preguntas generales y crear ediciones propuestas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contrôlez si l'IA peut lire le fichier actuel. Lorsqu'il est caché, l'IA peut toujours répondre à des questions générales et créer des propositions de modifications."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस फ़ाइल को AI द्वारा पढ़े जाने की अनुमति नियंत्रित करें। जब फ़ाइल छिपी होती है, AI सामान्य प्रश्नों का उत्तर देने और प्रस्ताव संपादनों को बनाने में सक्षम होता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla se l'AI può leggere il file attuale. Quando è nascosto, l'AI può comunque rispondere a domande generali e creare proposte di modifiche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のファイルをAIが読み取れるかどうかを制御します。非表示にしても、AIは一般的な質問に答えたり、提案の編集を作成したりすることができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 파일을 AI가 읽을 수 있는지 제어합니다. 숨겨질 경우, AI는 일반 질문에 답하고 제안 수정을 생성할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beheer of AI het huidige bestand kan lezen. Wanneer verborgen, kan AI nog steeds algemene vragen beantwoorden en voorstelwijzigingen aanbrengen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontroluj, czy AI może odczytać bieżący plik. Gdy jest ukryty, AI wciąż może odpowiadać na ogólne pytania i tworzyć propozycje edycji."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Controle se a IA pode ler o arquivo atual. Quando oculto, a IA ainda pode responder perguntas gerais e criar edições propostas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Управляйте тем, может ли ИИ читать текущий файл. При скрытии ИИ всё равно может отвечать на общие вопросы и предлагать изменения."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ควบคุมว่า AI สามารถอ่านไฟล์ปัจจุบันได้หรือไม่ เมื่อล แต่ AI ยังคงสามารถตอบคำถามทั่วไปและสร้างการแก้ไขข้อเสนอได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "AI'nın mevcut dosyayı okuyup okuyamayacağını kontrol edin. Gizlendiğinde, AI genel soruları yanıtlayabilir ve öneri düzenlemeleri oluşturabilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiểm soát xem AI có thể đọc tệp hiện tại hay không. Khi bị ẩn, AI vẫn có thể trả lời các câu hỏi chung và tạo đề xuất chỉnh sửa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "控制AI是否可以读取当前文件。当文件被隐藏时，AI仍然可以回答一般问题并创建提议编辑。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "控制 AI 是否可以閱讀當前檔案。當檔案隱藏時，AI 仍然可以回答一般問題並創建提案編輯。"
          }
        }
      }
    },
