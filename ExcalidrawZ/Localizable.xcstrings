    "settingsAIMCPServiceModeFeatureOptimizedMathBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل صيغ LaTeX ومخططات الدوال من خلال عارض الرياضيات الأصلي لإكزاليدراو زد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie LaTeX-Formeln und Funktionsdiagramme über den nativen Mathematik-Renderer von ExcalidrawZ ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Insert LaTeX formulas and function plots through ExcalidrawZ's native math renderer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserta fórmulas LaTeX y gráficos de funciones a través del renderizador de matemáticas nativo de ExcalidrawZ."
          }
        },
        "fr": {
          "stringUnit": {
