    "aiChatEnableConsentSensitiveMessage": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تجنب إدخال كلمات المرور أو مفاتيح API أو تفاصيل الدفع أو معلومات الصحة أو محتوى خاص آخر لا تريد معالجته بواسطة خدمات AI السحابية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vermeiden Sie die Eingabe von Passwörtern, API-Schlüsseln, Zahlungsdaten, Gesundheitsinformationen oder anderen privaten Inhalten, die Sie nicht von Cloud-AI-Diensten verarbeitet haben möchten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Avoid entering passwords, API keys, payment details, health information, or other private content that you do not want processed by cloud AI services."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Evite ingresar contraseñas, claves de API, detalles de pago, información de salud u otro contenido privado que no desee que sea procesado por servicios de IA en la nube."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Évitez de saisir des mots de passe, des clés API, des détails de paiement, des informations de santé ou d'autres contenus privés que vous ne souhaitez pas traiter par des services d'IA cloud."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पासवर्ड, एपीआई कुंजी, भुगतान विवरण, स्वास्थ्य जानकारी, या अन्य निजी सामग्री दर्ज करने से बचें जिसे आप क्लाउड एआई सेवाओं द्वारा प्रोसेस करना नहीं चाहते।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Evita di inserire password, chiavi API, dettagli di pagamento, informazioni sanitarie o altri contenuti privati che non desideri vengano elaborati dai servizi AI cloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラウドAIサービスによって処理されることを望まないパスワード、APIキー、支払い詳細、健康情報、またはその他のプライベートな内容を入力しないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비밀번호, API 키, 결제 세부정보, 건강 정보 또는 클라우드 AI 서비스에 의해 처리되기 원하지 않는 기타 개인적인 콘텐츠는 입력하지 마십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vermijd het invoeren van wachtwoorden, API-sleutels, betalingsgegevens, gezondheidsinformatie of andere privé-inhoud die u niet wilt dat door cloud-AI-diensten wordt verwerkt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Unikaj wprowadzania haseł, kluczy API, danych płatności, informacji o zdrowiu lub innych prywatnych treści, których przetwarzania przez usługi AI w chmurze nie chcesz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Evite inserir senhas, chaves de API, detalhes de pagamento, informações de saúde ou outro conteúdo privado que você não deseja que seja processado por serviços de IA em nuvem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Избегайте ввода паролей, API-ключей, платежных данных, информации о здоровье или другого личного контента, который вы не хотите, чтобы обрабатывали облачные AI-сервисы."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หลีกเลี่ยงการป้อนรหัสผ่าน, คีย์ API, รายละเอียดการชำระเงิน, ข้อมูลสุขภาพ หรือเนื้อหาส่วนตัวอื่นที่คุณไม่ต้องการให้บริการ AI ในคลาวด์ประมวลผล."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bulut AI hizmetleri tarafından işlenmesini istemediğiniz şifreler, API anahtarları, ödeme bilgileri, sağlık bilgileri veya diğer özel içerikleri girmemeye özen gösterin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tránh nhập mật khẩu, khóa API, chi tiết thanh toán, thông tin sức khỏe hoặc nội dung riêng tư khác mà bạn không muốn được xử lý bởi dịch vụ AI đám mây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "避免输入密码、API 密钥、付款详情、健康信息或其他您不希望被云 AI 服务处理的私人内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請避免輸入密碼、API 金鑰、支付詳情、健康信息或其他您不希望被雲端 AI 服務處理的私人內容。"
          }
        }
      }
    },
