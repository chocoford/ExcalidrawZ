    "aiChatButtonIslandModeHelp": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عارض الدردشة كجزيرة قابلة للسحب فوق المحرر"
