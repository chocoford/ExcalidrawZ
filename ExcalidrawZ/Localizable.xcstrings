    "featureTipsLockFileMessage": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتشفير هذا الملف لحماية محتواه المحفوظ. تظل الملفات المقفلة غير متاحة أيضًا للذكاء الاصطناعي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschlüsseln Sie diese Datei, um ihren gespeicherten Inhalt zu schützen. Gesperrte Dateien stehen der KI ebenfalls nicht zur Verfügung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Encrypt this file to protect its saved content. Locked files also stay unavailable to AI."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cifra este archivo para proteger su contenido guardado. Los archivos bloqueados también permanecen inaccesibles para la IA."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiffrez ce fichier pour protéger son contenu enregistré. Les fichiers verrouillés restent également inaccessibles à l'IA."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस फ़ाइल को एन्क्रिप्ट करें ताकि इसकी संचित सामग्री को सुरक्षित रखा जा सके। लॉक की गई फ़ाइलें AI के लिए भी अनुपलब्ध रहती हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cripta questo file per proteggere il suo contenuto salvato. I file bloccati rimangono anche non disponibili per l'AI."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルを暗号化して保存された内容を保護します。ロックされたファイルはAIに対しても利用できなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 파일을 암호화하여 저장된 콘텐츠를 보호합니다. 잠긴 파일은 AI에 대해 접근할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Versleutel dit bestand om de opgeslagen inhoud te beschermen. Gedeactiveerde bestanden zijn ook niet beschikbaar voor AI."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szyfruj ten plik, aby chronić jego zapisane treści. Zablokowane pliki są również niedostępne dla AI."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Criptografe este arquivo para proteger seu conteúdo salvo. Arquivos bloqueados também permanecem inacessíveis à IA."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зашифруйте этот файл, чтобы защитить его содержимое. Locked files также будут недоступны для ИИ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เข้ารหัสไฟล์นี้เพื่อปกป้องเนื้อหาที่บันทึกไว้ ไฟล์ที่ล็อกจะไม่สามารถเข้าถึงได้โดย AI"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dosyayı şifreleyerek kaydedilen içeriğini koruyun. Kilitli dosyalar AI için de erişilemez olur."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mã hóa tệp này để bảo vệ nội dung đã lưu của nó. Các tệp đã khóa cũng không khả dụng cho AI."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加密此文件以保护其保存的内容。被锁定的文件也对AI不可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加密此檔案以保護其保存的內容。鎖定的檔案對 AI 也保持不可用。"
          }
        }
      }
    },
