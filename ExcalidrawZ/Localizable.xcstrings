          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualmente, o único método de pagamento suportado é através da App Store."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В данный момент единственным поддерживаемым способом оплаты является App Store."
          }
        },
        "th": {
