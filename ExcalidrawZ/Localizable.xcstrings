    "whatsNewSupportMathDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتحسين مخططاتك بصيغ رياضية مصاغة بشكل جميل باستخدام LaTeX - مثالي للملاحظات والمعادلات والعروض التقديمية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbessern Sie Ihre Diagramme mit schön gerenderten LaTeX-Mathematikformeln – perfekt für Notizen, Gleichungen und Präsentationen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enhance your diagrams with beautifully rendered LaTeX mathematical formulas—perfect for notes, equations, and presentations."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mejora tus diagramas con fórmulas matemáticas LaTeX bellamente renderizadas—perfectas para notas, ecuaciones y presentaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Améliorez vos diagrammes avec de magnifiques formules mathématiques LaTeX—parfaites pour les notes, les équations et les présentations."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सुंदर रूप से प्रस्तुत LaTeX गणितीय सूत्रों के साथ अपने आरेखों को बढ़ाएँ—नोट्स, समीकरणों और प्रस्तुतियों के लिए बिल्कुल सही।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Migliora i tuoi diagrammi con formule matematiche LaTeX splendidamente renderizzate—perfette per appunti, equazioni e presentazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "美しくレンダリングされたLaTeX数式で図を強化しましょう。ノート、方程式、プレゼンテーションに最適です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아름답게 렌더링된 LaTeX 수학 공식을 통해 다이어그램을 향상시키세요—노트, 방정식 및 프레젠테이션에 완벽합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbeter je diagrammen met prachtig weergegeven LaTeX-wiskundige formules—perfect voor notities, vergelijkingen en presentaties."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ulepsz swoje diagramy pięknie renderowanymi wzorami matematycznymi LaTeX—idealnymi do notatek, równań i prezentacji."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Melhore seus diagramas com fórmulas matemáticas LaTeX lindamente renderizadas—perfeito para anotações, equações e apresentações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Улучшайте свои диаграммы красиво оформленными математическими формулами LaTeX — идеально для заметок, уравнений и презентаций."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มความสวยงามให้กับแผนภาพของคุณด้วยสูตรคณิตศาสตร์ LaTeX ที่แสดงผลอย่างสวยงาม—เหมาะสำหรับบันทึก, สมการ, และการนำเสนอ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diyagramlarınızı güzel bir şekilde işlenmiş LaTeX matematik formülleri ile zenginleştirin—notlar, denklemler ve sunumlar için mükemmel."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nâng cao sơ đồ của bạn với các công thức toán học LaTeX được hiển thị đẹp mắt—hoàn hảo cho ghi chú, phương trình và bài thuyết trình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过精美渲染的 LaTeX 数学公式增强您的图表—完美适用于笔记、方程和演示文稿。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用美觀的 LaTeX 數學公式增強您的圖表—非常適合筆記、方程和演示。"
          }
        }
      }
    },
