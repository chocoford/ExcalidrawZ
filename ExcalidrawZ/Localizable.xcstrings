    "paywallAICloudDisclosure": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم معالجة طلبات الذكاء الاصطناعي بواسطة خدمات AI السحابية لـ ExcalidrawZ وقد يتم توجيهها إلى مقدمي نماذج من طرف ثالث."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-Anfragen werden von den ExcalidrawZ Cloud-AI-Diensten verarbeitet und können an Drittanbieter-Modellanbieter weitergeleitet werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI requests are processed by ExcalidrawZ cloud AI services and may be routed to third-party model providers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las solicitudes de IA son procesadas por los servicios de IA en la nube de ExcalidrawZ y pueden ser dirigidas a proveedores de modelos de terceros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les requêtes d'IA sont traitées par les services d'IA cloud d'ExcalidrawZ et peuvent être acheminées vers des fournisseurs de modèles tiers."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एआई अनुरोध ExcalidrawZ क्लाउड एआई सेवाओं द्वारा प्रोसेस किए जाते हैं और तीसरे पक्ष के मॉडल प्रदाताओं को प्रेषित किए जा सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le richieste AI vengono elaborate dai servizi AI cloud di ExcalidrawZ e possono essere instradate a fornitori di modelli di terze parti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIリクエストはExcalidrawZのクラウドAIサービスによって処理され、サードパーティモデルプロバイダーにルーティングされる場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 요청은 ExcalidrawZ 클라우드 AI 서비스에 의해 처리되며 제3자 모델 제공업체로 라우팅될 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-verzoeken worden verwerkt door de cloud-AI-diensten van ExcalidrawZ en kunnen worden doorgestuurd naar externe modelproviders."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żądania AI są przetwarzane przez usługi AI w chmurze ExcalidrawZ i mogą być kierowane do zewnętrznych dostawców modeli."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As solicitações de IA são processadas pelos serviços de IA em nuvem do ExcalidrawZ e podem ser direcionadas a provedores de modelos de terceiros."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запросы AI обрабатываются облачными AI-сервисами ExcalidrawZ и могут быть направлены к поставщикам моделей третьих сторон."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำขอ AI ถูกประมวลผลโดยบริการ AI ในคลาวด์ของ ExcalidrawZ และอาจถูกส่งไปยังผู้ให้บริการโมเดลบุคคลที่สาม."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "AI talepleri ExcalidrawZ bulut AI hizmetleri tarafından işlenir ve üçüncü parti model sağlayıcılarına yönlendirilebilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các yêu cầu AI được xử lý bởi dịch vụ AI đám mây ExcalidrawZ và có thể được chuyển tới các nhà cung cấp mô hình bên thứ ba."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 请求由 ExcalidrawZ 云 AI 服务处理，并可能被转发到第三方模型提供商。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 請求由 ExcalidrawZ 雲端 AI 服務處理，並可能被路由到第三方模型提供者。"
          }
        }
      }
    },
