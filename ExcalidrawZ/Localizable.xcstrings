    "collaborationNewRoomConfirmationDialogMessage": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر كيف تريد بدء مساحة التعاون الخاصة بك. يمكنك البدء بغرفة فارغة أو استيراد محتوى من ملف موجود."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle, wie du deinen gemeinsamen Arbeitsbereich starten möchtest. Du kannst mit einem leeren Raum beginnen oder Inhalte aus einer vorhandenen Datei importieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose how you’d like to start your collaborative space. You can begin with a blank room or import content from an existing file."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige cómo te gustaría comenzar tu espacio colaborativo. Puedes empezar con una sala en blanco o importar contenido de un archivo existente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez comment vous souhaitez démarrer votre espace collaboratif. Vous pouvez commencer avec une salle vierge ou importer du contenu à partir d'un fichier existant."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुनें कि आप अपना सहयोगात्मक स्थान कैसे शुरू करना चाहते हैं। आप एक खाली कमरे से शुरू कर सकते हैं या मौजूदा फ़ाइल से सामग्री आयात कर सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli come vuoi iniziare il tuo spazio di collaborazione. Puoi iniziare con una stanza vuota o importare contenuti da un file esistente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コラボレーティブスペースの開始方法を選択してください。空の部屋から始めるか、既存のファイルからコンテンツをインポートできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "협업 공간을 시작하는 방법을 선택하세요. 빈 방으로 시작하거나 기존 파일에서 내용을 가져올 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies hoe je je samenwerkingsruimte wilt starten. Je kunt beginnen met een lege kamer of inhoud importeren vanuit een bestaand bestand."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz, jak chciałbyś rozpocząć swoją przestrzeń do współpracy. Możesz zacząć od pustego pokoju lub zaimportować treści z istniejącego pliku."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha como você gostaria de iniciar seu espaço colaborativo. Você pode começar com uma sala em branco ou importar conteúdo de um arquivo existente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите, как вы хотите начать ваше совместное пространство. Вы можете начать с пустой комнаты или импортировать содержимое из существующего файла."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกวิธีที่คุณต้องการเริ่มพื้นที่การทำงานร่วมกันของคุณ คุณสามารถเริ่มด้วยห้องว่างหรือดึงเนื้อหาจากไฟล์ที่มีอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşbirlikçi alanınızı başlatmak için nasıl bir yol seçmek istersiniz? Boş bir oda ile başlayabilir veya mevcut bir dosyadan içerik içe aktarabilirsiniz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn cách bạn muốn bắt đầu không gian hợp tác của mình. Bạn có thể bắt đầu với một phòng trống hoặc nhập nội dung từ một tệp hiện có."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择你希望如何开始你的协作空间。你可以从空房间开始或从现有文件导入内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇你希望如何開始你的協作空間。你可以從空白房間開始或從現有文件導入內容。"
          }
        }
      }
    },
