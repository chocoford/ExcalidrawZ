    "WhatsNewItemPreventImageAutoInvertDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في الوضع الداكن، أصبحت الصور الآن محمية من عكس الألوان افتراضيًا. يمكنك تغيير هذه الميزة في الإعدادات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Dunkelmodus wird nun standardmäßig verhindert, dass Bilder die Farben umkehren. Sie können diese Funktion in den Einstellungen ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In dark mode, images are now prevented from inverting colors by default. You can change this feature in the Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En modo oscuro, ahora se evita que las imágenes inviertan colores por defecto. Puedes cambiar esta función en la Configuración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En mode sombre, les images sont désormais empêchées d'inverser les couleurs par défaut. Vous pouvez changer cette fonctionnalité dans les paramètres."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डार्क मोड में, चित्रों को अब डिफ़ॉल्ट रूप से रंगों को उलटने से रोका गया है। आप इस सुविधा को सेटिंग्स में बदल सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In modalità scura, ora si evita che le immagini invertano i colori per impostazione predefinita. Puoi cambiare questa funzione nelle Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダークモードでは、画像がデフォルトで色を反転することが防止されました。この機能は設定で変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어두운 모드에서는 이미지가 기본적으로 색상이 반전되는 것을 방지합니다. 이 기능은 설정에서 변경할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In de donkere modus worden afbeeldingen nu standaard voorkomen van het omkeren van kleuren. Je kunt deze functie wijzigen in de instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W trybie ciemnym, obrazy są teraz domyślnie zapobiegane przed inwersją kolorów. Możesz zmienić tę funkcję w Ustawieniach."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "No modo escuro, as imagens agora são impedidas de inverter as cores por padrão. Você pode alterar esse recurso nas Configurações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В темном режиме изображения теперь по умолчанию не переворачиваются. Вы можете изменить эту функцию в Настройках."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ในโหมดมืด รูปภาพจะไม่ถูกเปลี่ยนสีโดยอัตโนมัติเป็นค่าเริ่มต้น คุณสามารถเปลี่ยนฟีเจอร์นี้ในการตั้งค่า."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Karanlık modda, resimlerin renklerinin otomatik olarak tersine çevrilmesi artık varsayılan olarak engellenmiştir. Bu özelliği Ayarlar'da değiştirebilirsiniz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trong chế độ tối, hình ảnh giờ đây được ngăn không bị đảo ngược màu sắc theo mặc định. Bạn có thể thay đổi tính năng này trong Cài đặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在深色模式下，图像默认不会反转颜色。您可以在设置中更改此功能。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在深色模式下，現在默認防止圖片顏色反轉。你可以在設置中更改此功能。"
          }
        }
      }
    },
