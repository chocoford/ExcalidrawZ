    "whatsNewCanvasSearchDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابحث عن أي نص أو إطار على اللوحة مع تمييز مباشر، ومطابقة حساسة لحالة الأحرف، والتنقل السريع بالقفز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beliebigen Text oder Rahmen auf der Leinwand finden – mit Live-Hervorhebungen, Berücksichtigung der Groß-/Kleinschreibung und Schnellnavigation."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find any text or frame on the canvas with live highlights, case-sensitive matching, and quick-jump navigation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuentra cualquier texto o marco en el lienzo con resaltado en vivo, coincidencia sensible a mayúsculas y navegación de salto rápido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouvez n'importe quel texte ou cadre sur le canevas grâce aux surlignages en temps réel, à la recherche sensible à la casse et à la navigation par saut rapide."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लाइव हाइलाइट्स, केस-सेंसिटिव मिलान और त्वरित-जम्प नेविगेशन के साथ कैनवास पर किसी भी टेक्स्ट या फ़्रेम को खोजें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trova qualsiasi testo o frame sul canvas con evidenziazione in tempo reale, ricerca sensibile alle maiuscole/minuscole e navigazione a salto rapido."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブハイライト、大文字小文字を区別する検索、クイックジャンプでキャンバス上の任意のテキストやフレームを見つけられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실시간 하이라이트, 대소문자 구분 검색 및 빠른 이동으로 캔버스의 모든 텍스트나 프레임을 찾아보세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vind tekst en frames op het canvas met live markeringen, hoofdlettergevoelige overeenkomsten en snelle navigatie om er direct naartoe te springen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Znajdź dowolny tekst lub ramkę na płótnie dzięki podświetlaniu na żywo, rozróżnianiu wielkości liter i możliwości szybkiego przeskoku."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontre qualquer texto ou quadro no canvas com realce em tempo real, busca sensível a maiúsculas e minúsculas e navegação de salto rápido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Найдите любой текст или фрейм на холсте с подсветкой в реальном времени, учетом регистра и быстрой навигацией."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค้นหาข้อความหรือเฟรมใดๆ บนแคนวาส พร้อมไฮไลต์แบบเรียลไทม์ การจับคู่แบบแยกตัวพิมพ์ใหญ่/ตัวพิมพ์เล็ก และการนำทางแบบกระโดดอย่างรวดเร็ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuvaldeki herhangi bir metni veya çerçeveyi canlı vurgulamalar, büyük/küçük harf duyarlı eşleştirme ve hızlı atlama ile bulun."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tìm bất kỳ văn bản hoặc khung nào trên khung vẽ với làm nổi bật trực tiếp, so khớp phân biệt chữ hoa chữ thường và điều hướng nhảy nhanh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在画布上查找任意文字或画框，支持实时高亮、区分大小写匹配和快速跳转导航。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在畫布上尋找任何文字或框架，支援即時高亮、區分大小寫比對與快速跳轉導覽。"
          }
        }
      }
    },
