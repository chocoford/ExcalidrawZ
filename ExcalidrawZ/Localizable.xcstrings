    "settingsExcalidrawToolbarOrderFooter": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بسحب الأدوات لتغيير ترتيب شريط الأدوات. تتبع الاختصارات الرقمية الأدوات الأولى في هذه القائمة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen Sie die Werkzeuge, um die Reihenfolge der Werkzeugleiste zu ändern. Die Nummern-Tastenkombinationen folgen den ersten Werkzeugen in dieser Liste."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag tools to change the toolbar order. Number shortcuts follow the first tools in this list."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra las herramientas para cambiar el orden de la barra de herramientas. Los accesos directos numéricos siguen a las primeras herramientas en esta lista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser les outils pour changer l'ordre de la barre d'outils. Les raccourcis numériques suivent les premiers outils de cette liste."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टूल्स को खींचें ताकि टूलबार के क्रम को बदल सकें। संख्या शॉर्टकट इस सूची में पहले टूल्स का पालन करते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina gli strumenti per cambiare l'ordine della toolbar. Le scorciatoie numeriche seguono i primi strumenti in questa lista."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツールをドラッグしてツールバーの順序を変更します。番号ショートカットはこのリストの最初のツールに従います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도구를 드래그하여 툴바 순서를 변경하세요. 번호 단축키는 이 목록의 첫 번째 도구를 따릅니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep gereedschappen om de volgorde van de werkbalk te wijzigen. Nummer snelkoppelingen volgen de eerste gereedschappen in deze lijst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij narzędzia, aby zmienić kolejność na pasku narzędzi. Skróty numeryczne podążają za pierwszymi narzędziami na tej liście."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste as ferramentas para mudar a ordem da barra de ferramentas. Os atalhos numéricos seguem as primeiras ferramentas nesta lista."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите инструменты, чтобы изменить порядок панели инструментов. Номерные комбинации следуют за первыми инструментами в этом списке."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลากเครื่องมือเพื่อเปลี่ยนลำดับแถบเครื่องมือ ชอร์ตคัตหมายเลขจะตามเครื่องมือแรกในรายการนี้。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Araçları sürükleyerek araç çubuğu sırasını değiştirin. Sayı kısayolları bu listedeki ilk araçları takip eder."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kéo công cụ để thay đổi thứ tự thanh công cụ. Các phím tắt số theo sau các công cụ đầu tiên trong danh sách này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动工具以更改工具栏顺序。数字快捷键遵循此列表中的第一个工具。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖動工具以更改工具欄順序。數字快捷方式跟隨此列表中的第一個工具。"
          }
        }
      }
    },
