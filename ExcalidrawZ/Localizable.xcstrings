    "settingsMediaCleanupOrphanedDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These items are not referenced by a current file or any checkpoint and can be removed safely."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些媒体未被当前文件或任何检查点引用，可以安全删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些媒體未被目前檔案或任何檢查點參考，可以安全刪除。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه العناصر غير مرجعة بواسطة ملف حالي أو أي نقطة فحص ويمكن إزالتها بأمان."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Elemente werden von einer aktuellen Datei oder einem Kontrollpunkt nicht referenziert und können sicher entfernt werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos elementos no son referenciados por un archivo actual ni por ningún punto de control y se pueden eliminar de manera segura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces éléments ne sont référencés par aucun fichier actuel ni aucun point de contrôle et peuvent être supprimés en toute sécurité."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ये आइटम किसी वर्तमान फ़ाइल या किसी चेकपॉइंट द्वारा संदर्भित नहीं हैं और इन्हें सुरक्षित रूप से हटाया जा सकता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questi elementi non sono riferiti da un file attuale o da un checkpoint e possono essere rimossi in sicurezza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのアイテムは現在のファイルやチェックポイントで参照されておらず、安全に削除できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 항목은 현재 파일이나 어떤 체크포인트에서도 참조되지 않으며 안전하게 제거할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze items worden niet vermeld door een huidig bestand of enige checkpoint en kunnen veilig verwijderd worden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te elementy nie są odniesione przez bieżący plik ani żaden punkt kontrolny i mogą być bezpiecznie usunięte."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Estes itens não são referenciados por um arquivo atual ou qualquer ponto de verificação e podem ser removidos com segurança."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти элементы не ссылаются на текущий файл или какую-либо контрольную точку и могут быть безопасно удалены."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายการเหล่านี้ไม่ได้ถูกอ้างอิงโดยไฟล์ปัจจุบันหรือจุดตรวจใดๆ และสามารถลบออกได้อย่างปลอดภัย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu öğeler, mevcut bir dosya veya herhangi bir kontrol noktası tarafından referans alınmamaktadır ve güvenli bir şekilde kaldırılabilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các mục này không được tham chiếu bởi tệp hiện tại hoặc bất kỳ điểm kiểm tra nào và có thể được xóa một cách an toàn."
          }
        }
      }
