    "missingFileMenuCannotRecoverAlertMessage": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن استرداد هذا الملف من iCloud ولا يتوفر له سجل لنقاط التحقق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei kann nicht aus iCloud wiederhergestellt werden und hat keinen Checkpoint-Verlauf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file cannot be recovered from iCloud and has no checkpoint history available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo no se puede recuperar desde iCloud y no tiene historial de puntos de control disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier ne peut pas être récupéré depuis iCloud et aucun historique de points de contrôle n'est disponible."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस फ़ाइल को iCloud से पुनर्प्राप्त नहीं किया जा सकता और इसका कोई चेकपॉइंट इतिहास उपलब्ध नहीं है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo file non può essere recuperato da iCloud e non dispone di alcuna cronologia dei checkpoint."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルはiCloudから復元できず、チェックポイントの履歴も利用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 파일은 iCloud에서 복구할 수 없으며 체크포인트 기록이 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit bestand kan niet uit iCloud worden hersteld en heeft geen beschikbare controlepunthistorie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten plik nie może zostać odzyskany z iCloud i nie ma dostępnej historii punktów kontrolnych."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este arquivo não pode ser recuperado do iCloud e não possui histórico de pontos de verificação disponível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот файл нельзя восстановить из iCloud, и история контрольных точек недоступна."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์นี้ไม่สามารถกู้คืนจาก iCloud ได้ และไม่มีประวัติการเช็กพอยต์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dosya iCloud'dan geri yüklenemiyor ve kontrol noktası geçmişi yok."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tệp này không thể khôi phục từ iCloud và không có lịch sử điểm khôi phục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件无法从 iCloud 恢复，且没有可用的检查点历史记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此檔案無法從 iCloud 還原，且沒有可用的檢查點歷史記錄。"
          }
        }
      }
    },
