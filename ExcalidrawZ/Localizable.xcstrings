        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सभी फ़ाइलों का निर्यात करें और उन्हें नए संस्करण में आयात करें ExcalidrawZ।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esporta tutti i file e importali nella nuova versione di ExcalidrawZ."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのファイルをエクスポートし、新しいバージョンの ExcalidrawZ にインポートしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 파일을 내보내고 새 버전의 ExcalidrawZ에 가져오세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporteer alle bestanden en importeer ze naar de nieuwe versie van ExcalidrawZ."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksportuj wszystkie pliki i zaimportuj je do nowej wersji ExcalidrawZ."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporte todos os arquivos e importe-os para a nova versão do ExcalidrawZ."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экспортируйте все файлы и импортируйте их в новую версию ExcalidrawZ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งออกรายการทั้งหมดและนำเข้าไปยังเวอร์ชันใหม่ของ ExcalidrawZ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm dosyaları dışa aktarın ve bunları yeni ExcalidrawZ sürümüne içe aktarın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xuất tất cả tệp và nhập chúng vào phiên bản mới của ExcalidrawZ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导出所有文件并将其导入新版 ExcalidrawZ。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "導出所有文件並將其導入到新的 ExcalidrawZ 版本中。"
          }
        }
      }
    },
