    "whatsNewIOSToolbarDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شريط أدوات iPhone وiPad أنظف وأكثر مباشرة، مع وصول أسرع إلى المكتبة، البحث، تاريخ الملفات، الذكاء الاصطناعي، وإعدادات التحرير."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die iPhone- und iPad-Werkzeugleiste ist übersichtlicher und direkter, mit schnellerem Zugriff auf Bibliothek, Suche, Dateihistory, KI und Bearbeitungswerkzeuge."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The iPhone and iPad toolbar is cleaner and more direct, with faster access to Library, Search, File History, AI, and editing controls."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra de herramientas de iPhone y iPad es más limpia y directa, con acceso más rápido a Biblioteca, Búsqueda, Historial de Archivos, IA y controles de edición."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La barre d'outils iPhone et iPad est plus épurée et directe, avec un accès plus rapide à la bibliothèque, à la recherche, à l'historique des fichiers, à l'IA et aux contrôles d'édition."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आईफोन और आईपैड टूलबार और अधिक साफ और प्रत्यक्ष है, पुस्तकालय, खोज, फ़ाइल इतिहास, एआई, और संपादन नियंत्रणों तक तेज़ पहुंच के साथ।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra degli strumenti per iPhone e iPad è più pulita e diretta, con accesso più veloce a Libreria, Ricerca, Cronologia File, AI e controlli di modifica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneとiPadのツールバーは、ライブラリ、検索、ファイル履歴、AI、および編集コントロールへの迅速なアクセスを提供し、よりクリーンで直接的になりました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 및 iPad 도구 모음이 더 깔끔하고 직관적이며, 라이브러리, 검색, 파일 기록, AI 및 편집 제어에 더 빠르게 접근할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De iPhone- en iPad-toolbalk is schoner en directer, met snellere toegang tot Bibliotheek, Zoeken, Bestandsgeschiedenis, AI en bewerkingscontroles."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasek narzędzi na iPhonie i iPadzie jest bardziej przejrzysty i bezpośredni, z szybszym dostępem do Biblioteki, Wyszukiwania, Historii Plików, AI i narzędzi edycyjnych."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A barra de ferramentas do iPhone e iPad está mais limpa e direta, com acesso mais rápido à Biblioteca, Pesquisa, Histórico de Arquivos, AI e controles de edição."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Панель инструментов на iPhone и iPad более упрощенная и прямолинейная, с более быстрым доступом к Библиотеке, Поиску, Истории файлов, ИИ и средствам редактирования."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แถบเครื่องมือสำหรับ iPhone และ iPad สะอาดและตรงไปตรงมามากขึ้น โดยมีการเข้าถึง Library, ค้นหา, ประวัติไฟล์, AI และการควบคุมการแก้ไขที่รวดเร็วขึ้น."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone ve iPad araç çubuğu daha temiz ve daha doğrudan, Kütüphane, Arama, Dosya Geçmişi, AI ve düzenleme kontrolüne daha hızlı erişim sağlıyor."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thanh công cụ trên iPhone và iPad đã sạch hơn và trực tiếp hơn, với quyền truy cập nhanh hơn vào Thư viện, Tìm kiếm, Lịch sử tệp, AI và các điều khiển chỉnh sửa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 和 iPad 的工具栏更加简洁直接，可以更快访问库、搜索、文件历史、AI 和编辑控制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 和 iPad 工具列更清晰、更直接，能更快訪問庫、搜尋、文件歷史、AI 和編輯控制。"
          }
        }
      }
    },
