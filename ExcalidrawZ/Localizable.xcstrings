        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスでバックアップファイルの復号に失敗しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 장치에서 백업 파일을 복호화할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het backupbestand kon op dit apparaat niet worden ontsleuteld."
