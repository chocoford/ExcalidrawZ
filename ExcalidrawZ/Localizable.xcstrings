    "whatsNewLosslessPDFExportDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مع عرض متقدم للمتجهات، يحتفظ تصدير PDF بكل التفاصيل، مما يوفر رسومات واضحة وقابلية توسيع مثالية لأي استخدام."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit fortschrittlichem Vektorrendering bewahrt der PDF-Export jedes Detail und liefert scharfe Grafiken sowie perfekte Skalierbarkeit für jeden Einsatz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With advanced vector rendering, PDF export preserves every detail, delivering sharp graphics and perfect scalability for any use."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con la renderización vectorial avanzada, la exportación a PDF preserva cada detalle, ofreciendo gráficos nítidos y una escalabilidad perfecta para cualquier uso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec un rendu vectoriel avancé, l'exportation PDF préserve chaque détail, offrant des graphiques nets et une évolutivité parfaite pour tout usage."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उन्नत वेक्टर रेंडरिंग के साथ, PDF निर्यात हर विवरण को संरक्षित करता है, किसी भी उपयोग के लिए तेज ग्राफिक्स और सही स्केलेबिलिटी प्रदान करता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con un rendering vettoriale avanzato, l'esportazione in PDF preserva ogni dettaglio, offrendo grafica nitida e perfetta scalabilità per qualsiasi utilizzo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高度なベクター描画により、PDFエクスポートはすべての詳細を保持し、シャープなグラフィックスと完璧なスケーラビリティを提供します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고급 벡터 렌더링을 통해 PDF 내보내기가 모든 세부 사항을 보존하여 선명한 그래픽과 완벽한 확장성을 제공합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met geavanceerde vector rendering behoudt de PDF-export elk detail, waardoor scherpe graphics en perfecte schaalbaarheid voor elk gebruik worden geleverd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzięki zaawansowanemu renderowaniu wektorowemu, eksport PDF zachowuje każdy detal, dostarczając wyraźną grafikę i idealną skalowalność do każdego zastosowania."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Com renderização vetorial avançada, a exportação em PDF preserva cada detalhe, oferecendo gráficos nítidos e perfeita escalabilidade para qualquer uso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С помощью продвинутой векторной отрисовки экспорт PDF сохраняет каждую деталь, обеспечивая четкую графику и идеальную масштабируемость для любого использования."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ด้วยการเรนเดอร์เวกเตอร์ขั้นสูง การส่งออก PDF จะรักษาทุกรายละเอียดไว้ ส่งมอบกราฟิกที่คมชัดและสามารถปรับขนาดได้อย่างสมบูรณ์แบบสำหรับการใช้งานใดๆ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelişmiş vektör render'ı ile PDF dışa aktarma, her detayı koruyarak keskin grafikler ve her kullanım için mükemmel ölçeklenebilirlik sunar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Với công nghệ vẽ vector tiên tiến, xuất PDF giữ lại mọi chi tiết, mang đến đồ họa sắc nét và khả năng mở rộng hoàn hảo cho mọi mục đích sử dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过先进的矢量渲染，PDF 导出保留每一个细节，提供清晰的图形和完美的可扩展性，适用于任何用途。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過先進的向量渲染，PDF 匯出能夠保留每一個細節，提供清晰的圖形和完美的可伸縮性，適用於任何用途。"
          }
        }
      }
    },
