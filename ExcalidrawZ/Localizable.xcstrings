        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 대화가 존재하지 않습니다. 먼저 한 개의 메시지를 전송한 후 다음 요청 컨텍스트를 미리 봅니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
