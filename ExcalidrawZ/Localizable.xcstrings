    "settingsAIMCPServiceModeHelp": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعرف على ما يمكن أن تفعله أوضاع MCP الأساسية والمُحسّنة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfahren Sie, was die Basis- und optimierten MCP-Modi tun können."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Learn what Basic and Optimized MCP modes can do."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprende lo que los modos MCP Básico y Optimizado pueden hacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Découvrez ce que peuvent faire les modes MCP de base et optimisé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जानें कि बुनियादी और अनुकूलित MCP मोड क्या कर सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scopri cosa possono fare le modalità MCP Base e Ottimizzata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "基本および最適化されたMCPモードが何をできるかを学びます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 및 최적화된 MCP 모드가 할 수 있는 일을 알아보세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer wat Basis en Geoptimaliseerde MCP-modi kunnen doen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dowiedz się, co mogą zrobić tryby podstawowy i zoptymalizowany MCP."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Saiba o que os modos MCP Básico e Otimizado podem fazer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Узнайте, что могут сделать базовые и оптимизированные режимы MCP."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เรียนรู้ว่าสถานะ MCP ขั้นพื้นฐานและขั้นสูงสามารถทำอะไรได้บ้าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temel ve Optimize edilmiş MCP modlarının neler yapabileceğini öğrenin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tìm hiểu những gì các chế độ MCP Cơ bản và Tối ưu hóa có thể làm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "了解基本和优化的 MCP 模式可以做什么。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "了解基本和優化的 MCP 模式可以做什麼。"
          }
        }
      }
    },
    "settingsAIMCPServiceModeOptimizedHelp": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مصممة لتجارب عمل ExcalidrawZ الكاملة، بدءًا من تحرير الملفات الحالية إلى التحقق، والتصدير، وإعادة استخدام محتوى التطبيق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entwickelt für vollständige ExcalidrawZ-Workflows, von der Bearbeitung bestehender Dateien bis hin zu Überprüfungen, Exporten und der Wiederverwendung von App-Inhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Designed for full ExcalidrawZ workflows, from editing existing files to checking, exporting, and reusing app content."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Diseñado para flujos de trabajo completos de ExcalidrawZ, desde la edición de archivos existentes hasta la revisión, exportación y reutilización del contenido de la aplicación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conçu pour des flux de travail complets avec ExcalidrawZ, de l'édition de fichiers existants à la vérification, l'exportation et la réutilisation du contenu de l'application."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूर्ण ExcalidrawZ कार्यप्रवाहों के लिए डिज़ाइन किया गया, जो मौजूदा फ़ाइलों को संपादित करने से लेकर, सामग्री की जाँच, निर्यात और पुनः उपयोग तक है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Progettato per flussi di lavoro completi di ExcalidrawZ, dalla modifica di file esistenti al controllo, esportazione e riutilizzo del contenuto dell'app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既存のファイルの編集からチェック、エクスポート、アプリコンテンツの再利用まで、完全なExcalidrawZワークフローに対応しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기존 파일 편집부터 내용 확인, 내보내기 및 재사용에 이르기까지 전체 ExcalidrawZ 워크플로를 위해 설계되었습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontworpen voor volledige ExcalidrawZ-workflows, van het bewerken van bestaande bestanden tot het controleren, exporteren en hergebruiken van app-inhoud."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaprojektowane dla pełnych przepływów pracy ExcalidrawZ, od edytowania istniejących plików po sprawdzanie, eksportowanie i ponowne używanie zawartości aplikacji."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Projetado para fluxos de trabalho completos do ExcalidrawZ, desde a edição de arquivos existentes até a verificação, exportação e reutilização do conteúdo do aplicativo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создано для полной работы с ExcalidrawZ, от редактирования существующих файлов до проверки, экспорта и повторного использования контента приложения."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ออกแบบมาสำหรับการทำงานที่ครบถ้วนของ ExcalidrawZ ตั้งแต่การแก้ไขไฟล์ที่มีอยู่ไปจนถึงการตรวจสอบ การส่งออก และการนำเนื้อหาแอปกลับมาใช้ใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mevcut dosyaları düzenlemekten kontrol etmeye, dışa aktarmaya ve uygulama içeriğini yeniden kullanmaya kadar, tam ExcalidrawZ iş akışları için tasarlandı."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Được thiết kế cho các quy trình làm việc hoàn chỉnh của ExcalidrawZ, từ việc chỉnh sửa các tệp hiện có đến kiểm tra, xuất và tái sử dụng nội dung ứng dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为完整的 ExcalidrawZ 工作流设计，从编辑现有文件到检查、导出和重用应用内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設計以支持完整的 ExcalidrawZ 工作流程，從編輯現有檔案到檢查、導出和重用應用內容。"
          }
        }
      }
    },
