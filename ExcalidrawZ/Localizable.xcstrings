    "lockedContentRecoveryKeyInstruction": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احفظ هذا مفتاح الاسترداد. إنه يفتح جميع محتويات ExcalidrawZ المقفلة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichern Sie diesen Wiederherstellungsschlüssel. Er entsperrt alle gesperrten ExcalidrawZ-Inhalte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save this Recovery Key. It unlocks all locked ExcalidrawZ content."
          }
        },
        "es": {
