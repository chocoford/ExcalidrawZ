    "applePencilConnectionTips": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك تفعيل وضع القلم عن طريق النقر على اللوحة باستخدام قلم أبل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst den Stiftmodus aktivieren, indem du mit deinem Apple Pencil auf die Leinwand tippst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can activate pencil mode by tapping on the canvas with your Apple Pencil."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes activar el modo lápiz tocando el lienzo con tu Apple Pencil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez activer le mode crayon en tapotant sur la toile avec votre Apple Pencil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप अपने Apple Pencil से कैनवास पर टैप करके पेंसिल मोड सक्रिय कर सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi attivare la modalità matita toccando la tela con la tua Apple Pencil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Pencilでキャンバスをタップすることで、ペンシルモードをアクティブにできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Pencil로 캔버스를 탭하여 펜슬 모드를 활성화할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt de potloodmodus activeren door op het canvas te tikken met je Apple Pencil."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz aktywować tryb pióra, dotykając płótna swoim Apple Pencil."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode ativar o modo lápis tocando na tela com seu Apple Pencil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы можете активировать режим карандаша, коснувшись холста с помощью вашего Apple Pencil."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณสามารถเปิดโหมดดินสอโดยการแตะที่ผืนผ้าใบด้วย Apple Pencil ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Pencil ile tuval üzerine dokunarak kalem modunu etkinleştirebilirsiniz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể kích hoạt chế độ bút bằng cách chạm vào canvas với Apple Pencil của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您可以通过用 Apple Pencil 点击画布来激活铅笔模式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您可以通過用 Apple Pencil 點擊畫布來啟用鉛筆模式。"
          }
        }
      }
    },
