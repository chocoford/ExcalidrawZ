    "settingsAIInformationProvidersMessage": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعتمادًا على النموذج المحدد، قد يتم توجيه الطلبات إلى مقدمي نماذج الطرف الثالث مثل OpenAI أو Anthropic أو Google."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Je nach ausgewähltem Modell können Anfragen an Drittanbieter von Modellen wie OpenAI, Anthropic oder Google weitergeleitet werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Depending on the selected model, requests may be routed to third-party model providers such as OpenAI, Anthropic, or Google."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dependiendo del modelo seleccionado, las solicitudes pueden dirigirse a proveedores de modelos de terceros como OpenAI, Anthropic o Google."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En fonction du modèle sélectionné, les demandes peuvent être redirigées vers des fournisseurs de modèles tiers tels qu'OpenAI, Anthropic ou Google."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुने गए मॉडल के आधार पर, अनुरोधों को OpenAI, Anthropic, या Google जैसे तीसरे पक्ष के मॉडल प्रदाताओं के पास भेजा जा सकता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A seconda del modello selezionato, le richieste possono essere indirizzate a fornitori di modelli di terze parti come OpenAI, Anthropic o Google."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したモデルに応じて、リクエストはOpenAI、Anthropic、Googleなどのサードパーティモデルプロバイダーにルーティングされる場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 모델에 따라 요청이 OpenAI, Anthropic 또는 Google과 같은 제3자 모델 제공자로 라우팅될 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Afhankelijk van het geselecteerde model kunnen verzoeken worden doorgestuurd naar externe modelproviders zoals OpenAI, Anthropic of Google."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W zależności od wybranego modelu, żądania mogą być kierowane do zewnętrznych dostawców modeli, takich jak OpenAI, Anthropic lub Google."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Dependendo do modelo selecionado, as solicitações podem ser direcionadas a fornecedores de modelos de terceiros, como OpenAI, Anthropic ou Google."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В зависимости от выбранной модели запросы могут направляться к сторонним поставщикам моделей, таким как OpenAI, Anthropic или Google."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขึ้นอยู่กับโมเดลที่เลือก คำขออาจถูกส่งต่อไปยังผู้ให้บริการโมเดลของบุคคลที่สาม เช่น OpenAI, Anthropic หรือ Google。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilen modele bağlı olarak, talepler OpenAI, Anthropic veya Google gibi üçüncü parti model sağlayıcılarına yönlendirilebilir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tùy thuộc vào mô hình đã chọn, các yêu cầu có thể được chuyển đến các nhà cung cấp mô hình bên thứ ba như OpenAI, Anthropic hoặc Google."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据所选模型，请求可能会被路由到第三方模型提供商，如 OpenAI、Anthropic 或 Google。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "根據所選模型，請求可能會路由到第三方模型提供者，如 OpenAI、Anthropic 或 Google。"
          }
        }
      }
    },
