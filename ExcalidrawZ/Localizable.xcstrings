    "sidebarLocalFolderEmptyPlaceholder": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتيح لك المجلدات المرتبطة الوصول إلى ملفات Excalidraw المخزنة على قرصك والعمل عليها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verknüpfte Ordner ermöglichen es dir, Excalidraw-Dateien, die auf deiner Festplatte gespeichert sind, einzubinden und mit ihnen zu arbeiten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Linked folders allow you to reference and work with Excalidraw files stored on your disk."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las carpetas vinculadas te permiten hacer referencia y trabajar con archivos de Excalidraw almacenados en tu disco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dossiers liés vous permettent de référencer et de travailler sur des fichiers Excalidraw stockés sur votre disque."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लिंक किए गए फ़ोल्डर आपको डिस्क पर संग्रहीत Excalidraw फ़ाइलों को संदर्भित करने और उनके साथ काम करने की अनुमति देते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le cartelle collegate ti permettono di fare riferimento ai file di Excalidraw presenti sul tuo disco e di lavorarci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンク済みフォルダでは、ディスクに保存されているExcalidrawファイルを参照して作業できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결된 폴더를 통해 디스크에 저장된 Excalidraw 파일을 참조하고 작업할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gekoppelde mappen maken het mogelijk om te verwijzen naar en te werken met Excalidraw-bestanden die op je schijf zijn opgeslagen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiązane foldery umożliwiają dostęp do plików Excalidraw przechowywanych na dysku i pracę z nimi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pastas vinculadas permitem que você acesse e trabalhe com arquivos do Excalidraw armazenados no seu disco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Локальные папки позволяют работать с файлами Excalidraw, хранящимися на вашем диске."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โฟลเดอร์ที่เชื่อมโยงช่วยให้คุณเข้าถึงและทำงานกับไฟล์ Excalidraw ที่เก็บไว้บนดิสก์ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlı klasörler, diskinizde saklanan Excalidraw dosyalarına erişmenizi ve onlarla çalışmanızı sağlar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các thư mục liên kết cho phép bạn tham chiếu và làm việc với các tệp Excalidraw được lưu trên ổ đĩa của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已链接的文件夹允许你访问并处理存储在磁盘上的 Excalidraw 文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已連結的資料夾可讓您存取並操作儲存在磁碟上的 Excalidraw 檔案。"
          }
        }
      }
