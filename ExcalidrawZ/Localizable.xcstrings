    "settingsAIMCPServiceModeFeatureOptimizedLibraryBody": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تصفح وتطبيق مكتبات إكزاليدراو والعناصر القابلة لإعادة الاستخدام من التطبيق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durchsuchen und Anwenden von Excalidraw-Bibliotheken und wiederverwendbaren Elementen aus der App."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Browse and apply Excalidraw libraries and reusable items from the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Navega y aplica bibliotecas de Excalidraw y elementos reutilizables desde la aplicación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parcourez et appliquez des bibliothèques Excalidraw et des éléments réutilisables depuis l'application."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप से Excalidraw पुस्तकालयों और पुन: प्रयोज्य वस्तुओं को ब्राउज़ और लागू करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sfoglia e applica librerie Excalidraw e oggetti riutilizzabili dall'app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリからExcalidrawライブラリや再利用可能なアイテムを参照して適用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱에서 Excalidraw 라이브러리와 재사용 가능한 항목을 탐색하고 적용하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blader door en pas Excalidraw-bibliotheken en herbruikbare items uit de app toe."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeglądaj i stosuj biblioteki Excalidraw oraz elementy wielokrotnego użytku z aplikacji."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Navegue e aplique bibliotecas Excalidraw e itens reutilizáveis a partir do aplicativo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Просмотр и применение библиотек Excalidraw и повторно используемых элементов из приложения."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เรียกดูและใช้ไลบรารี Excalidraw และรายการที่นำกลับมาใช้ซ้ำได้จากแอป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamadan Excalidraw kütüphanelerini ve yeniden kullanılabilir öğeleri görüntüleyin ve uygulayın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Duyệt và áp dụng các thư viện Excalidraw và các vật phẩm tái sử dụng từ ứng dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "浏览并应用来自应用的 Excalidraw 库和可重用项目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
