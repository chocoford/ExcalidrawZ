    "whatsnewExportImageWithoutBackgroundDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند تصدير صورة، سيؤدي إلغاء تحديد خيار الخلفية إلى تصدير الصورة بدون خلفية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Exportieren eines Bildes wird das Deaktivieren der Hintergrundoption das Bild ohne Hintergrund exportieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When exporting an image, unchecking the background option will export the image without a background."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al exportar una imagen, desmarcar la opción de fondo exportará la imagen sin fondo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lors de l'exportation d'une image, décocher l'option arrière-plan exportera l'image sans arrière-plan."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब एक चित्र का निर्यात करते हैं, तो पृष्ठभूमि विकल्प को अनचेक करने से चित्र बिना पृष्ठभूमि के निर्यात होगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando esporti un'immagine, deselezionando l'opzione sfondo, l'immagine verrà esportata senza sfondo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像をエクスポートする際、背景オプションのチェックを外すと、背景なしで画像がエクスポートされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미지를 내보낼 때 배경 옵션을 체크 해제하면 배경 없이 이미지를 내보낼 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bij het exporteren van een afbeelding, zal het uitvinken van de achtergrondoptie de afbeelding zonder achtergrond exporteren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podczas eksportowania obrazu, odznaczenie opcji tła wyeksportuje obraz bez tła."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao exportar uma imagem, desmarcar a opção de fundo exportará a imagem sem fundo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При экспорте изображения снятие отметки с опции фона экспортирует изображение без фона."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อส่งออกรูปภาพ การไม่เลือกตัวเลือกพื้นหลังจะส่งออกรูปภาพโดยไม่มีพื้นหลัง."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir resmi dışa aktarırken, arka plan seçeneğini işaretlemeyi kaldırmak, resmi arka plansız dışa aktarır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi xuất hình ảnh, bỏ chọn tùy chọn nền sẽ xuất hình ảnh mà không có nền."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在导出图像时，取消勾选背景选项将导出没有背景的图像。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在導出圖片時，取消選中背景選項將導出無背景的圖片。"
          }
        }
      }
    },
