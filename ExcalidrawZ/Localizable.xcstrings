        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप `.excalidrawlib` फ़ाइलें खींच सकते हैं या आयात कर सकते हैं और शुरू कर सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi trascinare o importare file `.excalidrawlib` e iniziare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "`.excalidrawlib` ファイルをドラッグまたはインポートして開始できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "`.excalidrawlib` 파일을 드래그하거나 가져와 시작할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt `.excalidrawlib`-bestanden slepen of importeren en aan de slag gaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz przeciągnąć lub zaimportować pliki `.excalidrawlib` i zacząć."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode arrastar ou importar arquivos `.excalidrawlib` e começar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы можете перетаскивать или импортировать файлы `.excalidrawlib` и начать."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณสามารถลากหรือนำเข้าไฟล์ `.excalidrawlib` และเริ่มต้นได้เลย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlamak için `.excalidrawlib` dosyalarını sürükleyebilir veya içe aktarabilirsiniz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể kéo hoặc nhập các tệp `.excalidrawlib` và bắt đầu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
