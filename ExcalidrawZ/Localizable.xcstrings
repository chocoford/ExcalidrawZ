    "settingsAIMCPConnectHelp": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اتصل بعملاء MCP المتوافقين باستخدام خادم HTTP المحلي لExcalidrawZ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinden Sie kompatible MCP-Clients über den lokalen HTTP-Server von ExcalidrawZ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect compatible MCP clients using ExcalidrawZ's local HTTP server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta clientes MCP compatibles usando el servidor HTTP local de ExcalidrawZ."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez des clients MCP compatibles en utilisant le serveur HTTP local d'ExcalidrawZ."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ के स्थानीय HTTP सर्वर का उपयोग करके संगत MCP क्लाइंट को कनेक्ट करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Collega i client MCP compatibili utilizzando il server HTTP locale di ExcalidrawZ."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZのローカルHTTPサーバーを使用して、互換性のあるMCPクライアントを接続します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ의 로컬 HTTP 서버를 사용하여 호환 가능한 MCP 클라이언트를 연결하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbind compatibele MCP-clients met de lokale HTTP-server van ExcalidrawZ."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połącz zgodne klienty MCP korzystając z lokalnego serwera HTTP ExcalidrawZ."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte clientes MCP compatíveis usando o servidor HTTP local do ExcalidrawZ."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключите совместимые клиенты MCP, используя локальный HTTP-сервер ExcalidrawZ."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชื่อมต่อคลินต์ MCP ที่เข้ากันได้โดยใช้เซิร์ฟเวอร์ HTTP ท้องถิ่นของ ExcalidrawZ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ'nin yerel HTTP sunucusunu kullanarak uyumlu MCP istemcilerini bağlayın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết nối các khách hàng MCP tương thích bằng máy chủ HTTP cục bộ của ExcalidrawZ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 ExcalidrawZ 的本地 HTTP 服务器连接兼容的 MCP 客户端。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 ExcalidrawZ 的本地 HTTP 伺服器連接兼容的 MCP 客戶端。"
          }
        }
      }
    },
