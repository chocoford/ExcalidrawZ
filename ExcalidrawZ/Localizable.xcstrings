    "settingsAIInformationPoliciesMessage": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "راجع سياسة الخصوصية الحالية وشروط الاستخدام لمزيد من التفاصيل حول معالجة بيانات الذكاء الاصطناعي، ومقدمي الخدمات، والاشتراكات، وشروط الاستخدام."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überprüfen Sie die aktuelle Datenschutzrichtlinie und die Nutzungsbedingungen für Details zur Verarbeitung von AI-Daten, Dienstanbietern, Abonnements und Nutzungsbedingungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review the current Privacy Policy and Terms of Use for details about AI data processing, service providers, subscriptions, and usage terms."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revise la Política de Privacidad y los Términos de Uso actuales para obtener detalles sobre el procesamiento de datos de IA, proveedores de servicios, suscripciones y términos de uso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veuillez consulter la Politique de confidentialité et les Conditions d'utilisation actuelles pour des détails sur le traitement des données par l'IA, les fournisseurs de services, les abonnements, et les conditions d'utilisation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एआई डेटा प्रोसेसिंग, सेवा प्रदाताओं, सब्सक्रिप्शन, और उपयोग के शर्तों के विवरण के लिए वर्तमान गोपनीयता नीति और उपयोग की शर्तों की समीक्षा करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisione dell'attuale Informativa sulla Privacy e dei Termini di Utilizzo per dettagli sul trattamento dei dati AI, fornitori di servizi, abbonamenti e termini di utilizzo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIデータ処理、サービスプロバイダー、サブスクリプション、および利用規約に関する詳細については、現在のプライバシーポリシーおよび利用規約を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 개인정보 보호정책 및 이용약관을 검토하여 AI 데이터 처리, 서비스 제공자, 구독 및 이용 약관에 대한 세부정보를 확인하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekijk het huidige Privacybeleid en de Gebruiksvoorwaarden voor details over de verwerking van AI-gegevens, dienstverlener, abonnementen en gebruiksvoorwaarden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przejrzyj aktualną Politykę Prywatności oraz Warunki Użytkowania, aby uzyskać szczegóły dotyczące przetwarzania danych AI, dostawców usług, subskrypcji i warunków użytkowania."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Revise a Política de Privacidade e os Termos de Uso atuais para detalhes sobre processamento de dados de IA, fornecedores de serviços, assinaturas e termos de uso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Просмотрите текущую Политику конфиденциальности и Условия использования для получения информации о обработке данных ИИ, поставщиках услуг, подписках и условиях использования."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบนโยบายความเป็นส่วนตัวและข้อกำหนดในการใช้บริการปัจจุบันสำหรับรายละเอียดเกี่ยวกับการประมวลผลข้อมูล AI ผู้ให้บริการ บริการสมัครสมาชิก และข้อกำหนดการใช้งาน。"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "AI veri işleme, hizmet sağlayıcılar, abonelikler ve kullanım şartları hakkında ayrıntılar için mevcut Gizlilik Politikasını ve Kullanım Şartlarını gözden geçirin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xem lại Chính sách Quyền riêng tư và Điều khoản Sử dụng hiện tại để biết thông tin về quy trình xử lý dữ liệu AI, nhà cung cấp dịch vụ, đăng ký và các điều kiện sử dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看当前的隐私政策和使用条款，以获取有关AI数据处理、服务提供商、订阅和使用条款的详细信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "查看當前的隱私政策和使用條款，以了解有關 AI 數據處理、服務提供商、訂閱和使用條款的詳細信息。"
          }
        }
      }
    },
