            "state": "translated",
            "value": "เชื่อมต่อกับดินสอ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaleme bağlan"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết nối với bút"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接到铅笔"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連接到鉛筆"
          }
        }
      }
    },
    "applePencilInterationModeOneFingerMoveDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "**تحرك بإصبع واحد**\n    • استخدم إصبع واحد لتحريك اللوحة\n    • استخدم إصبعين للتحريك أو التكبير اللوحة\n    • اختر باستخدام الأداة المخصصة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Mit einem Finger bewegen**\n    • Benutze einen Finger, um die Leinwand zu bewegen\n    • Benutze zwei Finger, um die Leinwand zu verschieben oder zu zoomen\n    • Mit dem speziellen Werkzeug auswählen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Move with one finger**\n    • Use one finger to move the canvas\n    • Use two fingers to move or zoom the canvas\n    • Select with the dedicated tool"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Mover con un dedo**\n    • Usa un dedo para mover el lienzo\n    • Usa dos dedos para mover o hacer zoom en el lienzo\n    • Selecciona con la herramienta dedicada"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Déplacer avec un doigt**\n    • Utilisez un doigt pour déplacer la toile\n    • Utilisez deux doigts pour déplacer ou zoomer sur la toile\n    • Sélectionnez avec l'outil dédié"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "**एक उंगली से स्थानांतरित करें**\n    • कैनवास को स्थानांतरित करने के लिए एक उंगली का उपयोग करें\n    • कैनवास को स्थानांतरित या ज़ूम करने के लिए दो उंगलियों का उपयोग करें\n    • समर्पित उपकरण से चयन करें"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "**Muovi con un dito**\n    • Usa un dito per muovere la tela\n    • Usa due dita per muovere o zoomare la tela\n    • Seleziona con lo strumento dedicato"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**指一本で移動**\n    • 指一本でキャンバスを移動\n    • 指二本でキャンバスを移動またはズーム\n    • 専用ツールで選択"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "**한 손가락으로 이동**\n    • 한 손가락으로 캔버스를 이동\n    • 두 손가락으로 캔버스를 이동하거나 확대/축소\n    • 전용 도구로 선택"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "**Beweeg met één vinger**\n    • Gebruik één vinger om het canvas te verplaatsen\n    • Gebruik twee vingers om het canvas te verplaatsen of in te zoomen\n    • Selecteer met de speciale tool"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "**Przesuwaj jednym palcem**\n    • Użyj jednego palca, aby przesunąć płótno\n    • Użyj dwóch palców, aby przesunąć lub powiększyć płótno\n    • Wybierz za pomocą dedykowanego narzędzia"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "**Mover com um dedo**\n    • Use um dedo para mover a tela\n    • Use dois dedos para mover ou ampliar a tela\n    • Selecione com a ferramenta dedicada"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "**Перемещение одним пальцем**\n    • Используйте один палец, чтобы перемещать холст\n    • Используйте два пальца, чтобы перемещать или увеличивать холст\n    • Выбирайте с помощью специального инструмента"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "**เลื่อนด้วยนิ้วเดียว**\n    • ใช้นิ้วเดียวเพื่อเลื่อนผืนผ้าใบ\n    • ใช้นิ้วสองนิ้วเพื่อเลื่อนหรือซูมผืนผ้าใบ\n    • เลือกด้วยเครื่องมือที่กำหนด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Bir parmakla hareket ettirin**\n    • Tuvali hareket ettirmek için bir parmak kullanın\n    • Tuvali hareket ettirmek veya yakınlaştırmak için iki parmak kullanın\n    • Özel araç ile seçim yapın"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "**Di chuyển bằng một ngón tay**\n    • Sử dụng một ngón tay để di chuyển canvas\n    • Sử dụng hai ngón tay để di chuyển hoặc phóng to canvas\n    • Chọn với công cụ chuyên dụng"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**用一根手指移动**\n    • 使用一根手指移动画布\n    • 使用两根手指移动或缩放画布\n    • 使用专用工具选择"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "**單指移動**\n    • 使用一根手指移動畫布\n    • 使用兩根手指移動或縮放畫布\n    • 使用專用工具進行選擇"
          }
        }
      }
    },
