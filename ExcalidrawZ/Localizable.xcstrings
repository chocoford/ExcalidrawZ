    "settingsSecurityLostRecoveryKeyMessage": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احذف المحتوى المقفل الذي لا يمكن فتحه بعد الآن، ثم ابدأ من جديد بمفتاح استرداد جديد في المرة القادمة التي تقفل فيها ملفًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löschen Sie gesperrte Inhalte, die nicht mehr entsperrt werden können, und beginnen Sie dann mit einem neuen Wiederherstellungsschlüssel, wenn Sie das nächste Mal eine Datei sperren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete locked content that can no longer be unlocked, then start over with a new Recovery Key the next time you lock a file."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina el contenido bloqueado que ya no se puede desbloquear, luego comienza de nuevo con una nueva clave de recuperación la próxima vez que bloquees un archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimez le contenu verrouillé qui ne peut plus être déverrouillé, puis recommencez avec une nouvelle clé de récupération la prochaine fois que vous verrouillez un fichier."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लॉक की गई सामग्री को हटा दें जिसे अब अनलॉक नहीं किया जा सकता, फिर अगली बार जब आप कोई फ़ाइल लॉक करें तो नई रिकवरी कुंजी के साथ शुरुआत करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina i contenuti bloccati che non possono più essere sbloccati, quindi ricomincia con una nuova Chiave di Recupero la prossima volta che blocchi un file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう解除できないロックされたコンテンツを削除し、次回ファイルをロックする際に新しいリカバリーキーでやり直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 이상 잠금을 해제할 수 없는 잠금된 콘텐츠를 삭제한 후, 다음에 파일을 잠글 때 새 복구 키로 새로 시작하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijder vergrendelde inhoud die niet meer kan worden ontgrendeld, en begin opnieuw met een nieuwe Herstelcode de volgende keer dat je een bestand vergrendelt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuń zablokowaną zawartość, której nie można już odblokować, a następnie rozpocznij od nowa z nowym kluczem odzyskiwania następnym razem, gdy zablokujesz plik."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Exclua o conteúdo bloqueado que não pode mais ser desbloqueado, depois comece de novo com uma nova Chave de Recuperação na próxima vez que você bloquear um arquivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалите заблокированный контент, который больше не может быть разблокирован, а затем начните заново с новым ключом восстановления, когда в следующий раз заблокируете файл."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบเนื้อหาที่ถูกล็อคซึ่งไม่สามารถปลดล็อกได้ จากนั้นเริ่มใหม่ด้วยกุญแจการกู้คืนใหม่ในครั้งถัดไปที่คุณล็อกไฟล์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Artık açılamayan kilitli içeriği silin, ardından bir dosyayı kilitlediğinizde yeni bir Kurtarma Anahtarı ile yeniden başlayın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa nội dung bị khóa không còn có thể mở khóa, sau đó bắt đầu lại với một Khóa Khôi phục mới lần sau khi bạn khóa một tệp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除无法解锁的锁定内容，然后在下次锁定文件时重新开始并使用新的恢复密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除無法解鎖的鎖定內容，然後在下次鎖定文件時重新開始並獲取新的恢復金鑰。"
          }
        }
      }
    },
