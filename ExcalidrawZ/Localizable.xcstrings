    "aiChatWelcomeFeatureDrawSubtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عدل العناصر، وضع الأشكال، أو أعد تصميم الرسومات الحالية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Elemente anpassen, Formen positionieren oder bestehende Zeichnungen umgestalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjust elements, position shapes, or restyle existing drawings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta elementos, posiciona formas o reestiliza dibujos existentes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajustez les éléments, positionnez les formes ou redessinez les dessins existants."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तत्वों को समायोजित करें, आकारों को स्थिति दें, या मौजूदा चित्रों को पुनः शैली दें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Regola gli elementi, posiziona le forme o modifica i disegni esistenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "要素を調整したり、形状の位置を変更したり、既存の図面をスタイル変更します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요소 조정, 도형 위치 변경 또는 기존 그림 스타일 변경."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas elementen aan, positioneer vormen of verander de stijl van bestaande tekeningen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostosuj elementy, ustaw kształty lub zmień styl istniejących rysunków."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste elementos, posicione formas ou reestilize desenhos existentes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Регулируйте элементы, размещайте фигуры или изменяйте стиль существующих рисунков."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปรับเปลี่ยนองค์ประกอบ, วางตำแหน่งรูปทรง, หรือเปลี่ยนสไตล์การวาดที่มีอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ögeleri ayarlayın, şekilleri konumlandırın veya mevcut çizimleri yeniden stilize edin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Căn chỉnh các yếu tố, định vị hình dạng hoặc làm mới phong cách các bản vẽ hiện có."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调整元素、定位形状或重新设计现有绘图。"
          }
