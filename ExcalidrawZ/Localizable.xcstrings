    "aiChatUserMessageActionEditHelp": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعد تحميل هذه الرسالة إلى صندوق الإدخال حتى تتمكن من تعديلها وإعادة إرسالها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Nachricht in das Eingabefeld neu laden, damit Sie sie bearbeiten und erneut senden können."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reload this message into the input box so you can edit and resend it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a cargar este mensaje en el cuadro de entrada para que puedas editarlo y reenvíarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recharger ce message dans la zone de saisie afin que vous puissiez l'éditer et le renvoyer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस संदेश को इनपुट बॉक्स में पुनः लोड करें ताकि आप इसे संपादित कर सकें और फिर से भेज सकें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricarica questo messaggio nella casella di input in modo da poterlo modificare e inviare nuovamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このメッセージを入力ボックスに再読み込みして、編集して再送信できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 메시지를 입력 상자로 다시 로드하여 수정하고 재전송할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herlaad dit bericht in het invoerveld zodat je het kunt bewerken en opnieuw verzenden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Załaduj tę wiadomość do pola wejściowego, aby móc ją edytować i ponownie wysłać."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Recarregue esta mensagem na caixa de entrada para que você possa editar e reenviá-la."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перезагрузите это сообщение в поле ввода, чтобы вы могли отредактировать и отправить его снова."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โหลดข้อความนี้กลับเข้าสู่กล่องป้อนข้อมูลเพื่อให้คุณสามารถแก้ไขและส่งใหม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu mesajı girdi kutusuna yeniden yükleyerek düzenleyebilir ve tekrar gönderebilirsiniz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tải lại tin nhắn này vào ô nhập để bạn có thể chỉnh sửa và gửi lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将此消息重新加载到输入框中，以便您可以编辑并重新发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將此消息重新加載到輸入框中，便於您進行編輯和重新發送。"
          }
        }
      }
    },
