    "settingsAIInformationFilesMessage": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يتم تحميل ملفاتك بالكامل. يتلقى الذكاء الصناعي فقط المحتوى المتعلق بالطلب، مثل بيانات اللوحة النشطة أو نتائج محددة تم إرجاعها بواسطة الأدوات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Dateien werden nicht im Ganzen hochgeladen. AI erhält nur Inhalte, die für die Anfrage relevant sind, wie z. B. die aktiven Canvas-Daten oder spezifische Ergebnisse von Tools."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your files are not uploaded wholesale. AI only receives content involved in the request, such as the active canvas data or specific results returned by tools."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus archivos no se cargan en su totalidad. La IA solo recibe el contenido involucrado en la solicitud, como los datos del lienzo activo o resultados específicos devueltos por las herramientas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos fichiers ne sont pas téléchargés en entier. L'IA ne reçoit que le contenu impliqué dans la demande, tel que les données de canvas actives ou les résultats spécifiques retournés par les outils."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी फ़ाइलें समग्र रूप से अपलोड नहीं की जाती हैं। एआई केवल अनुरोध में शामिल सामग्री प्राप्त करता है, जैसे सक्रिय कैनवास डेटा या टूल द्वारा लौटाए गए विशिष्ट परिणाम।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi file non vengono caricati in blocco. L'AI riceve solo il contenuto coinvolto nella richiesta, come i dati della tela attiva o risultati specifici restituiti dagli strumenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルは一括でアップロードされません。AIは、アクティブなキャンバスデータやツールによって返された特定の結果など、リクエストに関係するコンテンツのみを受け取ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "귀하의 파일은 일괄적으로 업로드되지 않습니다. AI는 요청에 관련된 콘텐츠, 즉 활성 캔버스 데이터나 도구에서 반환된 특정 결과만 수신합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bestanden worden niet in bulk geüpload. AI ontvangt alleen inhoud die betrokken is bij het verzoek, zoals de actieve canvasgegevens of specifieke resultaten die door tools zijn teruggegeven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje pliki nie są przesyłane hurtowo. AI otrzymuje tylko treści związane z żądaniem, takie jak dane aktywnego płótna lub konkretne wyniki zwracane przez narzędzia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus arquivos não são carregados integralmente. A IA recebe apenas o conteúdo envolvido na solicitação, como os dados da tela ativa ou resultados específicos retornados pelas ferramentas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши файлы не загружаются в полном объеме. ИИ получает только содержимое, относящееся к запросу, такое как данные активного холста или конкретные результаты, возвращенные инструментами."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์ของคุณจะไม่ได้ถูกอัปโหลดทั้งหมด AI จะได้รับเฉพาะเนื้อหาที่เกี่ยวข้องกับคำขอ เช่น ข้อมูลผืนผ้าใบที่ใช้งานอยู่หรือผลลัพธ์เฉพาะที่ส่งกลับโดยเครื่องมือ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyalarınız topluca yüklenmez. AI, yalnızca istekte bulunan aktif kanvas verileri veya araçlar tarafından döndürülen belirli sonuçlar gibi taleple ilgili içeriği alır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các tệp của bạn không được tải lên toàn bộ. AI chỉ nhận nội dung liên quan đến yêu cầu, chẳng hạn như dữ liệu canvas đang hoạt động hoặc các kết quả cụ thể được trả về bởi các công cụ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的文件不会被全部上传。AI仅接收与请求相关的内容，例如活动画布数据或工具返回的特定结果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的文件不會整體上傳。 AI 僅接收與請求相關的內容，例如活動畫布數據或工具返回的特定結果。"
          }
        }
      }
    },
