    "librariesNoItemsDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك سحب أو استيراد ملفات `.excalidrawlib` والبدء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie können `.excalidrawlib`-Dateien ziehen oder importieren und loslegen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can drag or import `.excalidrawlib` files and get started."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes arrastrar o importar archivos `.excalidrawlib` y empezar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez faire glisser ou importer des fichiers `.excalidrawlib` et commencer."
