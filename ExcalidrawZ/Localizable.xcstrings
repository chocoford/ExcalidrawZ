    "aiChatEnableConsentSubtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرجى مراجعة كيفية عمل الذكاء الاصطناعي في ExcalidrawZ قبل تفعيله. يمكنك إيقاف تشغيل الذكاء الاصطناعي مرة أخرى في الإعدادات في أي وقت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte überprüfen Sie, wie KI in ExcalidrawZ funktioniert, bevor Sie sie aktivieren. Sie können die KI jederzeit in den Einstellungen wieder deaktivieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please review how AI works in ExcalidrawZ before enabling it. You can turn AI off again in Settings at any time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor, revise cómo funciona la IA en ExcalidrawZ antes de habilitarla. Puede desactivar la IA en la Configuración en cualquier momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veuillez examiner comment fonctionne l'IA dans ExcalidrawZ avant de l'activer. Vous pouvez désactiver l'IA à tout moment dans les paramètres."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कृपया इसे सक्षम करने से पहले ExcalidrawZ में एआई कैसे काम करता है, इसकी समीक्षा करें। आप किसी भी समय सेटिंग्स में फिर से एआई बंद कर सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si prega di rivedere come funziona l'AI in ExcalidrawZ prima di abilitarla. Puoi disattivare l'AI in qualsiasi momento nelle Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効にする前に、ExcalidrawZのAIの動作を確認してください。設定でいつでもAIを無効にできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 기능을 활성화하기 전에 ExcalidrawZ에서 AI가 어떻게 작동하는지 검토해 주십시오. 언제든지 설정에서 AI를 다시 끌 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekijk hoe AI werkt in ExcalidrawZ voordat u het inschakelt. U kunt AI op elk moment weer uitschakelen in Instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Proszę zapoznać się z tym, jak działa AI w ExcalidrawZ, przed włączeniem go. Możesz wyłączyć AI w Ustawieniach w dowolnym momencie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor, revise como a IA funciona no ExcalidrawZ antes de ativá-la. Você pode desativar a IA novamente em Configurações a qualquer momento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пожалуйста, ознакомьтесь с тем, как работает AI в ExcalidrawZ, перед его включением. Вы можете отключить AI в любой момент в настройках."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กรุณาทบทวนว่า AI ทำงานอย่างไรใน ExcalidrawZ ก่อนที่จะเปิดใช้งาน คุณสามารถปิด AI ได้อีกครั้งในการตั้งค่าได้ตลอดเวลา."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "AI etkinleştirilmeden önce ExcalidrawZ'de AI'nin nasıl çalıştığını gözden geçirmenizi rica ederiz. AI'yi tekrar kapatmak için istediğiniz zaman Ayarlar'dan kapatabilirsiniz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vui lòng xem xét cách AI hoạt động trong ExcalidrawZ trước khi bật nó lên. Bạn có thể tắt AI bất cứ lúc nào trong Cài đặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在启用 AI 之前，请查看 ExcalidrawZ 中 AI 的工作原理。您可以随时在设置中关闭 AI。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在開啟 AI 功能之前，請查看 ExcalidrawZ 中 AI 的運作方式。您可以隨時在設置中關閉 AI 功能。"
          }
        }
      }
    },
