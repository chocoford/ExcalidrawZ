    "whatsNewPerformanceImprovementsDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This update focuses on performance improvements across file loading, saving, covers, and everyday canvas interactions."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次更新主要优化性能，改进了文件加载、保存、封面生成以及日常画布操作的流畅度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本次更新主要優化效能，改善了檔案載入、儲存、封面生成以及日常畫布操作的流暢度。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تركز هذه التحديثات على تحسين الأداء في تحميل الملفات، والحفظ، والأغطية، وتفاعلات القماش اليومية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Update konzentriert sich auf Leistungsverbesserungen beim Laden von Dateien, Speichern, Abdeckungen und alltäglichen Interaktionen mit der Leinwand."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta actualización se centra en mejoras de rendimiento en la carga de archivos, guardado, cubiertas e interacciones diarias en el lienzo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette mise à jour se concentre sur des améliorations de performance dans le chargement et la sauvegarde des fichiers, les couvertures et les interactions quotidiennes avec le canevas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह अपडेट फ़ाइल लोडिंग, सहेजने, कवरों, और दैनिक कैनवास इंटरैक्शन में प्रदर्शन सुधार पर केंद्रित है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo aggiornamento si concentra sui miglioramenti delle prestazioni nel caricamento, salvataggio, copertine e interazioni quotidiane con la tela."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この更新は、ファイルの読み込み、保存、カバー、および日常的なキャンバスの操作におけるパフォーマンスの改善に焦点を当てています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이번 업데이트는 파일 로딩, 저장, 표지 및 일상적인 캔버스 상호작용의 성능 개선에 중점을 두었습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze update richt zich op prestatieverbeteringen bij het laden, opslaan, dekkingen en dagelijkse canvasinteracties."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta aktualizacja koncentruje się na poprawie wydajności w zakresie ładowania plików, zapisywania, omów i codziennych interakcji na płótnie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta atualização foca em melhorias de desempenho no carregamento, salvamento de arquivos, capas e interações diárias no canvas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это обновление сосредоточено на улучшении производительности при загрузке файлов, сохранении, обложках и повседневных взаимодействиях с холстом."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การอัปเดตนี้มุ่งเน้นที่การปรับปรุงประสิทธิภาพทั่วทั้งการโหลดไฟล์ การบันทึก การครอบคลุม และการทำงานทั่วไปบนแคนวาส"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu güncelleme, dosya yükleme, kaydetme, kapaklar ve günlük tuval etkileşimleri boyunca performans iyileştirmelerine odaklanmaktadır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cập nhật này tập trung vào cải thiện hiệu suất trong việc tải tệp, lưu trữ, bìa và tương tác canvas hàng ngày."
          }
        }
      }
    },
