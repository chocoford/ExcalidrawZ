    "settingsMediaCleanupDeleteConfirmationMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selected files and their history will be permanently deleted. Selected media used only by file history will also remove the affected checkpoints. Media still used by other files will be kept. This cannot be undone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选文件及其历史记录将被永久删除。若所选媒体仅被文件历史引用，相关检查点也会被删除。仍被其他文件使用的媒体会予以保留。此操作无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所選檔案及其歷史記錄將被永久刪除。若所選媒體僅被檔案歷史參考，相關檢查點也會被刪除。仍被其他檔案使用的媒體會予以保留。此操作無法復原。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم حذف الملفات المحددة وتاريخها بشكل دائم. سيتم أيضًا إزالة الوسائط المحددة المستخدمة فقط بواسطة تاريخ الملف النقاط المتأثرة. ستظل الوسائط المستخدمة بواسطة ملفات أخرى محفوظة. لا يمكن التراجع عن ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgewählte Dateien und deren Verlauf werden dauerhaft gelöscht. Ausgewählte Mediendateien, die nur im Datei Verlauf verwendet werden, entfernen auch die betroffenen Kontrollpunkte. Medien, die weiterhin von anderen Dateien verwendet werden, bleiben erhalten. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos seleccionados y su historial serán eliminados permanentemente. Los medios seleccionados utilizados solo por el historial de archivos también eliminarán los puntos de control afectados. Los medios que aún son utilizados por otros archivos se conservarán. Esto no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers sélectionnés et leur historique seront définitivement supprimés. Le média sélectionné utilisé uniquement par l'historique des fichiers supprimera également les points de contrôle concernés. Le média encore utilisé par d'autres fichiers sera conservé. Ceci ne peut pas être annulé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुने गए फ़ाइलें और उनका इतिहास स्थायी रूप से हटा दिया जाएगा। फ़ाइल इतिहास द्वारा केवल उपयोग में लाई गई चुनी गई मीडिया भी प्रभावित चेकपॉइंट हटा देगी। अन्य फ़ाइलों द्वारा अभी भी उपयोग की जाने वाली मीडिया रखी जाएगी। इसे पूर्ववत नहीं किया जा सकता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I file selezionati e la loro cronologia verranno eliminati definitivamente. I media selezionati utilizzati solo dalla cronologia dei file rimuoveranno anche i checkpoint interessati. I media ancora utilizzati da altri file verranno mantenuti. Questa operazione non può essere annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したファイルとその履歴は永久に削除されます。ファイル履歴のみで使用されている選択メディアも影響を受けたチェックポイントを削除します。他のファイルでまだ使用されているメディアは保持されます。これは元に戻せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 파일과 해당 이력은 영구적으로 삭제됩니다. 파일 이력에서만 사용되는 선택된 미디어도 영향을 받는 체크포인트와 함께 삭제됩니다. 다른 파일에서 여전히 사용되는 미디어는 유지됩니다. 이는 되돌릴 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geselecteerde bestanden en hun geschiedenis worden permanent verwijderd. Geselecteerde media die alleen door de bestandsgeschiedenis worden gebruikt, zullen ook de aangetaste checkpoints verwijderen. Media die nog door andere bestanden worden gebruikt, blijven behouden. Dit kan niet ongedaan gemaakt worden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybrane pliki i ich historia zostaną trwale usunięte. Wybrane media używane tylko przez historię plików również usuną dotknięte punkty kontrolne. Media nadal używane przez inne pliki zostaną zachowane. Tego nie można cofnąć."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os arquivos selecionados e seu histórico serão excluídos permanentemente. A mídia selecionada usada apenas pelo histórico de arquivos também removerá os pontos de verificação afetados. A mídia ainda utilizada por outros arquivos será mantida. Isso não pode ser desfeito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбранные файлы и их история будут навсегда удалены. Выбранные медиа, используемые только историей файлов, также удалят затронутые контрольные точки. Медиа, все еще используемые другими файлами, будут сохранены. Это действие нельзя отменить."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไฟล์ที่เลือกและประวัติของมันจะถูกลบอย่างถาวร ไฟล์มีเดียที่เลือกซึ่งใช้โดยประวัติไฟล์เท่านั้นจะลบจุดตรวจที่ได้รับผลกระทบออกด้วย มีเดียที่ยังคงใช้งานโดยไฟล์อื่นจะถูกเก็บไว้ ซึ่งไม่สามารถทำการย้อนกลับได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilen dosyalar ve geçmişleri kalıcı olarak silinecektir. Sadece dosya geçmişi tarafından kullanılan seçilen medyalar da etkilenen kontrol noktalarını kaldıracaktır. Diğer dosyalar tarafından hâlâ kullanılan medya korunacaktır. Bu geri alınamaz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các tệp đã chọn và lịch sử của chúng sẽ bị xóa vĩnh viễn. Các phương tiện đã chọn chỉ được sử dụng bởi lịch sử tệp cũng sẽ xóa các điểm kiểm tra bị ảnh hưởng. Các phương tiện vẫn được sử dụng bởi các tệp khác sẽ được giữ lại. Điều này không thể được khôi phục."
          }
        }
      }
    },
