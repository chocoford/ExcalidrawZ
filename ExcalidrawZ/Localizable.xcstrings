    "whatsNewNewDrawFromClipboardDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتحويل الصور من الحافظة إلى رسومات جديدة على الفور. طريقة أسرع لبدء رسم أفكارك!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwandeln Sie Bilder aus Ihrer Zwischenablage sofort in neue Zeichnungen. Ein schnellere Möglichkeit, um mit dem Skizzieren Ihrer Ideen zu beginnen!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Instantly turn images from your clipboard into new drawings. A quicker way to start sketching your ideas!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Convierte instantáneamente imágenes de tu portapapeles en nuevos dibujos. ¡Una forma más rápida de comenzar a esbozar tus ideas!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transformez instantanément les images de votre presse-papiers en nouveaux dessins. Une manière plus rapide de commencer à esquisser vos idées !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने क्लिपबोर्ड से छवियों को तुरंत नए चित्रों में बदलें। अपने विचारों को स्केच करने का एक तेज़ तरीका!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trasforma istantaneamente le immagini dagli appunti in nuovi disegni. Un modo più veloce per iniziare a schizzare le tue idee!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップボードの画像を瞬時に新しいドローイングに変換します。アイデアをスケッチするためのより迅速な方法です！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클립보드의 이미지를 즉시 새로운 드로잉으로 변환하세요. 아이디어를 스케치하는 더 빠른 방법입니다!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet afbeeldingen van je klembord direct om in nieuwe tekeningen. Een snellere manier om je ideeën te schetsen!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Natychmiast przekształć obrazy z schowka w nowe rysunki. Szybszy sposób na rozpoczęcie szkicowania swoich pomysłów!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Transforme instantaneamente imagens da sua área de transferência em novos desenhos. Uma maneira mais rápida de começar a esboçar suas ideias!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мгновенно превращайте изображения из вашего буфера обмена в новые рисунки. Быстрый способ начать рисовать ваши идеи!"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปลี่ยนภาพจากคลิปบอร์ดของคุณให้เป็นการวาดใหม่ได้ทันที วิธีที่รวดเร็วกว่าในการเริ่มร่างแนวคิดของคุณ!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Panodaki görüntüleri anında yeni çizimlere dönüştürün. Fikirlerinizi çizmeye başlamak için daha hızlı bir yol!"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Biến ngay lập tức hình ảnh từ clipboard của bạn thành những bản vẽ mới. Một cách nhanh chóng để bắt đầu phác thảo ý tưởng của bạn!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "瞬间将剪贴板中的图像转化为新绘图。这是更快开始草绘您想法的方式！"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "瞬間將剪貼板中的圖片轉化為新的畫作。更快速地開始草擬您的想法！"
          }
        }
      }
    },
