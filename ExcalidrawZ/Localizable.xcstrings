    "settingsBackupsLockedPreviewMessage": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتوي هذا النسخة الاحتياطية القديمة على ملف مقفل من قبل المستخدم. افتحه باستخدام مفتاح الاسترداد لمعاينته أو تصديره."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses ältere Backup enthält eine benutzergesperrte Datei. Entsperren Sie sie mit dem Wiederherstellungsschlüssel, um sie anzuzeigen oder zu exportieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This older backup contains a user-locked file. Unlock it with the Recovery Key to preview or export it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta copia de seguridad anterior contiene un archivo bloqueado por el usuario. Desbloquéalo con la Clave de Recuperación para previsualizarlo o exportarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette ancienne sauvegarde contient un fichier verrouillé par l'utilisateur. Déverrouillez-le avec la clé de récupération pour l'aperçu ou l'exportation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस पुराने बैकअप में एक उपयोगकर्ता-लॉक की गई फ़ाइल है। इसे पूर्वावलोकन या निर्यात करने के लिए पुनर्प्राप्ति कुंजी के साथ अनलॉक करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo backup più vecchio contiene un file bloccato dall'utente. Sbloccalo con la Chiave di Recupero per visualizzarlo o esportarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この古いバックアップにはユーザーがロックしたファイルが含まれています。プレビューまたはエクスポートするには、リカバリーキーでロックを解除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 오래된 백업에는 사용자 잠금 파일이 포함되어 있습니다. 미리보기 또는 내보내려면 복구 키로 잠금을 해제하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze oudere back-up bevat een door de gebruiker vergrendeld bestand. Ontgrendel het met de Herstelcode om het te bekijken of te exporteren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten starszy kopia zapasowa zawiera plik zablokowany przez użytkownika. Odblokuj go za pomocą Klucza Odzyskiwania, aby podglądać lub eksportować."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este backup mais antigo contém um arquivo bloqueado pelo usuário. Desbloqueie-o com a Chave de Recuperação para visualizar ou exportá-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот старый резервный файл содержит заблокированный пользователем файл. Разблокируйте его с помощью ключа восстановления, чтобы предварительно просмотреть или экспортировать его."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สำเนาสำรองเก่านี้มีไฟล์ที่ถูกล็อคโดยผู้ใช้ ปลดล็อคด้วย Recovery Key เพื่อแสดงตัวอย่างหรือส่งออกไฟล์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu eski yedek, kullanıcı tarafından kilitlenmiş bir dosya içerir. Önizlemek veya dışa aktarmak için Kurtarma Anahtarı ile kilidini açın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vị trí sao lưu cũ này chứa một tập tin bị khóa bởi người dùng. Mở khóa nó bằng Khóa Khôi Phục để xem trước hoặc xuất nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此旧备份包含一个用户锁定的文件。使用恢复密钥解锁以预览或导出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此舊備份包含用戶鎖定的檔案。使用恢復密鑰解鎖以預覽或導出它。"
          }
        }
      }
    },
