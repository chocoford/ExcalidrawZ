        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ now works perfectly offline, so you can access and use the app even without an internet connection."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ ahora funciona perfectamente sin conexión, por lo que puedes acceder y usar la aplicación incluso sin conexión a internet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ fonctionne désormais parfaitement hors ligne, vous pouvez donc accéder et utiliser l'application même sans connexion Internet."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ अब पूरी तरह से ऑफ़लाइन काम करता है, इसलिए आप इंटरनेट कनेक्शन के बिना भी ऐप का उपयोग कर सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ ora funziona perfettamente offline, quindi puoi accedere e utilizzare l'app anche senza una connessione internet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZはオフラインでも完璧に動作するため、インターネット接続がなくてもアプリにアクセスして使用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ는 이제 오프라인에서도 완벽하게 작동하므로 인터넷 연결 없이도 앱에 접근하고 사용할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ werkt nu perfect offline, zodat je de app kunt openen en gebruiken, zelfs zonder internetverbinding."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ teraz działa doskonale offline, więc możesz uzyskać dostęp i korzystać z aplikacji nawet bez połączenia z internetem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ agora funciona perfeitamente offline, permitindo que você acesse e use o aplicativo mesmo sem uma conexão com a internet."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ теперь отлично работает в оффлайне, так что вы можете получить доступ к приложению и использовать его даже без подключения к интернету."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ ตอนนี้ทำงานได้อย่างสมบูรณ์แบบแบบออฟไลน์ ดังนั้นคุณสามารถเข้าถึงและใช้แอปได้แม้ไม่มีการเชื่อมต่ออินเทอร์เน็ต."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ artık çevrimdışı mükemmel çalışıyor, bu nedenle internet bağlantınız olmasa bile uygulamaya erişebilir ve kullanabilirsiniz."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ giờ đây hoạt động hoàn hảo ngoại tuyến, vì vậy bạn có thể truy cập và sử dụng ứng dụng ngay cả khi không có kết nối internet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ 现在可以完美离线使用，因此即使没有互联网连接，您也可以访问和使用该应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "ExcalidrawZ 現在在離線模式下運行完美，因此即使在沒有互聯網連接的情況下，你也可以訪問和使用該應用程序。"
          }
        }
      }
    },
