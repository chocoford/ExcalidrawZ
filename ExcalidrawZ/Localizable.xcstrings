    "settingsSecurityResetRecoveryKeyMessage": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احفظ هذا المفتاح الجديد للاسترداد قبل المتابعة. سيتم تحديث الملفات المقفلة ونقاط التحقق لاستخدامه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichern Sie diesen neuen Wiederherstellungsschlüssel, bevor Sie fortfahren. Gesperrte Dateien und Prüfpunkte werden aktualisiert, um ihn zu verwenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save this new Recovery Key before continuing. Locked files and checkpoints will be updated to use it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda esta nueva clave de recuperación antes de continuar. Los archivos bloqueados y los puntos de control se actualizarán para usarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez cette nouvelle clé de récupération avant de continuer. Les fichiers verrouillés et les points de contrôle seront mis à jour pour l'utiliser."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जारी रखने से पहले इस नई रिकवरी कुंजी को सहेज लें। लॉक की गई फ़ाइलें और चेकप्वाइंट इसे उपयोग करने के लिए अपडेट किए जाएंगे।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva questa nuova Chiave di Recupero prima di continuare. I file bloccati e i checkpoint saranno aggiornati per utilizzarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "続行する前に、この新しいリカバリーキーを保存してください。ロックされたファイルとチェックポイントはこれを使用するように更新されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계속하기 전에 이 새로운 복구 키를 저장하세요. 잠금된 파일 및 체크포인트가 이를 사용하도록 업데이트됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaar deze nieuwe herstelsleutel voordat je verdergaat. Vergrendelde bestanden en controlepunten worden bijgewerkt om deze te gebruiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisz ten nowy klucz odzyskiwania przed kontynuowaniem. Zablokowane pliki i punkty kontrolne zostaną zaktualizowane, aby go używać."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Salve esta nova Chave de Recuperação antes de continuar. Arquivos e pontos de verificação bloqueados serão atualizados para usá-la."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраните этот новый ключ восстановления перед продолжением. Заблокированные файлы и контрольные точки будут обновлены для его использования."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึก Recovery Key ใหม่ก่อนดำเนินการต่อ ไฟล์ที่ถูกล็อคและจุดตรวจจะถูกอัปเดตให้ใช้คีย์นี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Devam etmeden önce bu yeni Kurtarma Anahtarını kaydedin. Kilitli dosyalar ve kontrol noktaları bunu kullanacak şekilde güncellenecektir."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy lưu khóa phục hồi mới này trước khi tiếp tục. Các tệp bị khóa và các điểm kiểm tra sẽ được cập nhật để sử dụng nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在继续之前保存这个新的恢复密钥。锁定的文件和检查点将更新以使用它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在繼續之前請保存這個新的恢復金鑰。鎖定的檔案和檢查點將會更新為使用它。"
          }
        }
      }
    },
