    "settingsExcalidrawAntiInvertImageMessage": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تحتاج إلى إعدادات دقيقة لكل ملف على حدة؟ انضم إلى خادمنا على Discord وأخبرني!"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Brauchst du die genauen Einstellungen für jede einzelne Datei? Komm auf Discord vorbei und sag mir Bescheid!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Need the precise settings for each individual file? Come to Discord and let me know!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Necesitas la configuración exacta para cada archivo? ¡Pásate por Discord y dímelo!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez besoin des paramètres précis pour chaque fichier ? Venez sur Discord et dites-moi !"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या आपको प्रत्येक फ़ाइल के लिए सटीक सेटिंग्स चाहिए? Discord पर आएँ और मुझे बताइए!"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuoi le impostazioni precise per ogni singolo file? Vieni su Discord e fammi sapere!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各ファイルごとの正確な設定が必要ですか？Discordに来て教えてください！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 파일의 정확한 설정이 필요하신가요? Discord에 와서 알려주세요!"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Heb je de precieze instellingen voor elk afzonderlijk bestand nodig? Kom naar Discord en laat het me weten!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrzebujesz dokładnych ustawień dla każdego pliku? Dołącz na Discordzie i daj mi znać!"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Precisa das configurações exatas para cada arquivo? Entre no Discord e me avise!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужны точные настройки для каждого отдельного файла? Заходите в Discord и сообщите мне!"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต้องการการตั้งค่าที่แม่นยำสำหรับแต่ละไฟล์หรือไม่? เข้าร่วม Discord แล้วแจ้งให้เราทราบ!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her bir dosya için kesin ayarlar mı istiyorsunuz? Discord'a gelin ve bana bildirin!"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần cài đặt chính xác cho từng tệp riêng lẻ? Hãy vào Discord và cho tôi biết!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要每个文件的精确设置吗？来 Discord 告诉我！"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要針對每個檔案的精確設定嗎？到 Discord 告訴我！"
          }
        }
      }
    },
