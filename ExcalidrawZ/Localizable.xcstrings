    "encryptedBackupErrorDecryptionFailed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يمكن فك تشفير ملف النسخ الاحتياطي على هذا الجهاز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sicherungsdatei konnte auf diesem Gerät nicht entschlüsselt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The backup file could not be decrypted on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo de respaldo no pudo ser descifrado en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier de sauvegarde n'a pas pu être décrypté sur cet appareil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस पर बैकअप फ़ाइल को डिक्रिप्ट नहीं किया जा सका।"
          }
        },
        "it": {
          "stringUnit": {
