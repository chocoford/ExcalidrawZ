    "whatsNewCustomToolOrderDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعادة ترتيب أدوات الرسم في الإعدادات. تصميم شريط الأدوات وعدد الاختصارات يتبع ترتيبك المخصص."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordnen Sie die Zeichenwerkzeuge in den Einstellungen neu an. Das Layout der Symbolleiste und die Tastenkombinationen folgen Ihrer benutzerdefinierten Reihenfolge."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reorder drawing tools in Settings. The toolbar layout and number shortcuts follow your custom order."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reordena las herramientas de dibujo en Configuración. La disposición de la barra de herramientas y los atajos numéricos siguen tu orden personalizado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réorganisez les outils de dessin dans les paramètres. La disposition de la barre d'outils et les raccourcis numériques suivent votre ordre personnalisé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेटिंग्स में ड्राइंग टूल्स को पुनर्व्यवस्थित करें। टूलबार लेआउट और संख्या शॉर्टकट आपके कस्टम क्रम का पालन करते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riordina gli strumenti di disegno nelle Impostazioni. Il layout della barra degli strumenti e i collegamenti numerici seguono il tuo ordine personalizzato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定で描画ツールの順序を変更します。ツールバーのレイアウトとショートカットの番号は、あなたのカスタム順序に従います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정에서 그리기 도구의 순서를 재배치하세요. 툴바 레이아웃과 번호 단축키는 사용자 지정 순서를 따릅니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herordenen van tekengereedschappen in Instellingen. De indeling van de werkbalk en de nummering van sneltoetsen volgen jouw aangepaste volgorde."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmień kolejność narzędzi rysunkowych w Ustawieniach. Układ paska narzędzi i skróty klawiszowe będą podążać za Twoją niestandardową kolejnością."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Reordene as ferramentas de desenho nas Configurações. O layout da barra de ferramentas e os atalhos de número seguem sua ordem personalizada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Измените порядок инструментов рисования в настройках. Расположение панели инструментов и номера горячих клавиш соответствуют вашему пользовательскому порядку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จัดเรียงเครื่องมือวาดในการตั้งค่า เลย์เอาต์ของแถบเครื่องมือและหมายเลขลัดจะตามลำดับที่กำหนดเองของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayarlar bölümünde çizim araçlarını yeniden sıralayın. Araç çubuğu düzeni ve kısayol numaraları, sizin özel sıralamanızı takip eder."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sắp xếp lại công cụ vẽ trong Cài đặt. Bố cục thanh công cụ và số phím tắt theo thứ tự tùy chỉnh của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在设置中重新排列绘图工具。工具栏布局和数字快捷键遵循您的自定义顺序。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在設置中重新排序繪圖工具。工具欄佈局和快捷鍵數字遵循您的自定義順序。"
          }
        }
      }
    },
