    "paywallFeatureSyncMessage": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بالمزامنة وإعادة الاستخدام واحتفظ بالعمل متاحًا عبر الأجهزة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisieren, wiederverwenden und darüber hinaus die Arbeiten auf allen Geräten verfügbar halten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync, reuse, and keep work available across devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincroniza, reutiliza y mantén tu trabajo disponible en todos los dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisez, réutilisez et gardez votre travail disponible sur tous vos appareils."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संपर्क करें, पुन: उपयोग करें, और कार्यों को उपकरणों के बीच उपलब्ध रखें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronizza, riutilizza e mantieni il lavoro disponibile su tutti i dispositivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイス間で作業を同期、再利用し、利用可能に保ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 간 작업을 동기화하고 재사용하며 유지하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchroniseer, hergebruik en houd werk beschikbaar op meerdere apparaten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronizuj, korzystaj ponownie i utrzymuj pracę dostępną na różnych urządzeniach."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronize, reutilize e mantenha o trabalho disponível em todos os dispositivos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронизируйте, повторно используйте и сохраняйте работу доступной на всех устройствах."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ซิงค์ ใช้งานซ้ำ และเก็บงานให้พร้อมใช้งานบนอุปกรณ์ต่าง ๆ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cihazlar arasında senkronize edin, yeniden kullanın ve çalışmayı erişilebilir tutun."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đồng bộ, tái sử dụng và giữ công việc luôn có sẵn trên các thiết bị."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在设备之间同步、重用并保持工作可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同步、重用，並保持跨設備可用的工作。"
          }
        }
      }
    },
