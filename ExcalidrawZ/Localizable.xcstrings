    "settingsAIInformationCloudMessage": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الدردشة الذكية مقدمة من خلال خدمات الذكاء الصناعي السحابية ExcalidrawZ. تتم معالجة الطلبات عبر الإنترنت بدلاً من أن تتم بالكامل على هذا الجهاز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der AI-Chat wird über die ExcalidrawZ Cloud-AI-Dienste bereitgestellt. Anfragen werden online und nicht vollständig auf diesem Gerät verarbeitet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI chat is provided through ExcalidrawZ cloud AI services. Requests are processed online rather than entirely on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El chat de IA se proporciona a través de los servicios de IA en la nube de ExcalidrawZ. Las solicitudes se procesan en línea en lugar de completamente en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chat IA est fourni par les services d'IA cloud d'ExcalidrawZ. Les requêtes sont traitées en ligne plutôt que entièrement sur cet appareil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एआई चैट ExcalidrawZ क्लाउड एआई सेवाओं के माध्यम से प्रदान की जाती है। अनुरोध ऑनलाइन प्रोसेस किए जाते हैं न कि पूरी तरह से इस डिवाइस पर।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La chat AI è fornita tramite i servizi cloud AI di ExcalidrawZ. Le richieste vengono elaborate online piuttosto che interamente su questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AIチャットはExcalidrawZのクラウドAIサービスを通じて提供されます。リクエストはこのデバイスで完全に処理されるのではなく、オンラインで処理されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 채팅은 ExcalidrawZ 클라우드 AI 서비스를 통해 제공됩니다. 요청은 이 기기에서 전적으로 처리되지 않고 온라인에서 처리됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "AI-chat wordt geleverd via de ExcalidrawZ cloud AI-diensten. Verzoeken worden online verwerkt in plaats van volledig op dit apparaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czaty AI są udostępniane przez usługi chmurowe AI ExcalidrawZ. Żądania są przetwarzane online, a nie całkowicie na tym urządzeniu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O chat de IA é fornecido através dos serviços de IA em nuvem do ExcalidrawZ. As solicitações são processadas online em vez de completamente neste dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чат с ИИ предоставляется через облачные ИИ-сервисы ExcalidrawZ. Запросы обрабатываются онлайн, а не полностью на этом устройстве."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแชท AI ถูกจัดเตรียมผ่านบริการคลาวด์ AI ของ ExcalidrawZ คำขอจะถูกประมวลผลออนไลน์แทนที่จะใช้ทั้งหมดบนอุปกรณ์นี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "AI sohbeti ExcalidrawZ bulut AI hizmetleri aracılığıyla sağlanır. Talepler çevrimiçi olarak işlenir, tamamen bu cihazda değil."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat AI được cung cấp thông qua dịch vụ AI đám mây ExcalidrawZ. Các yêu cầu được xử lý trực tuyến thay vì hoàn toàn trên thiết bị này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 聊天通过 ExcalidrawZ 云 AI 服务提供。请求在线处理，而不是完全在此设备上处理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 聊天功能通過 ExcalidrawZ 雲端 AI 服務提供。請求是在網上處理，而不是完全在此設備上進行。"
          }
        }
      }
    },
