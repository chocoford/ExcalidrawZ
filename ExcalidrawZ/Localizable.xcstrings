    "applePencilInterationModeOneFingerSelectDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "**اختر بإصبع واحد**\n    • اسحب بإصبع واحد للاختيار\n    • استخدم إصبعين للتحريك أو التكبير اللوحة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Mit einem Finger auswählen**\n    • Ziehe mit einem Finger, um auszuwählen\n    • Benutze zwei Finger, um die Leinwand zu verschieben oder zu zoomen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Select with one finger**\n    • Drag with one finger to select\n    • Use two fingers to move or zoom the canvas"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "**Seleccionar con un dedo**\n    • Arrastra con un dedo para seleccionar\n    • Usa dos dedos para mover o hacer zoom en el lienzo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Sélectionner avec un doigt**\n    • Faites glisser avec un doigt pour sélectionner\n    • Utilisez deux doigts pour déplacer ou zoomer sur la toile"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "**एक उंगली से चयन करें**\n    • चयन करने के लिए एक उंगली से खींचें\n    • कैनवास को स्थानांतरित या ज़ूम करने के लिए दो उंगलियों का उपयोग करें"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "**Seleziona con un dito**\n    • Trascina con un dito per selezionare\n    • Usa due dita per muovere o zoomare la tela"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "**指一本で選択**\n    • 指一本でドラッグして選択\n    • 指二本でキャンバスを移動またはズーム"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "**한 손가락으로 선택**\n    • 한 손가락으로 드래그하여 선택\n    • 두 손가락으로 캔버스를 이동하거나 확대/축소"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "**Selecteer met één vinger**\n    • Sleep met één vinger om te selecteren\n    • Gebruik twee vingers om het canvas te verplaatsen of in te zoomen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "**Wybieraj jednym palcem**\n    • Przeciągnij jednym palcem, aby zaznaczyć\n    • Użyj dwóch palców, aby przesunąć lub powiększyć płótno"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "**Selecionar com um dedo**\n    • Arraste com um dedo para selecionar\n    • Use dois dedos para mover ou ampliar a tela"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "**Выбор одним пальцем**\n    • Перетащите одним пальцем, чтобы выбрать\n    • Используйте два пальца, чтобы перемещать или увеличивать холст"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "**เลือกด้วยนิ้วเดียว**\n    • ลากด้วยนิ้วเดียวเพื่อเลือก\n    • ใช้นิ้วสองนิ้วเพื่อเลื่อนหรือซูมผืนผ้าใบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "**Bir parmakla seçin**\n    • Seçmek için bir parmakla sürükleyin\n    • Tuvali hareket ettirmek veya yakınlaştırmak için iki parmak kullanın"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "**Chọn bằng một ngón tay**\n    • Kéo bằng một ngón tay để chọn\n    • Sử dụng hai ngón tay để di chuyển hoặc phóng to canvas"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**用一根手指选择**\n    • 用一根手指拖动以选择\n    • 使用两根手指移动或缩放画布"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "**單指選擇**\n    • 用一根手指拖動以選擇\n    • 使用兩根手指移動或縮放畫布"
          }
        }
      }
    },
